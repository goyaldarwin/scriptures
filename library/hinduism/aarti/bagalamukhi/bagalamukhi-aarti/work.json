{"id":"bagalamukhi-aarti","lang":"hi","title":{"hi":"जय जय श्री बगलामुखी माता","en":"Jai Jai Shri Baglamukhi Mata"},"by":{"hi":"माँ बगलामुखी","en":"Mother Baglamukhi"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"जय जय श्री बगलामुखी माता","en":"Jai Jai Shri Baglamukhi Mata"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["जय जय श्री बगलामुखी माता ।","आरति करहुँ तुम्हारी ॥"],"c":"","t":["jaya jaya śrī bagalāmukhī mātā,","ārati karahum̐ tumhārī."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["पीत वसन तन पर तव सोहै ।","कुण्डल की छबि न्यारी ॥१॥"],"c":"1","t":["pīta vasana tana para tava sohai,","kuṇḍala kī chabi nyārī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["कर-कमलों में मुद्गर धारै ।","अस्तुति करहिं सकल नर-नारी ॥२॥"],"c":"2","t":["kara-kamaloṁ meṁ mudgara dhārai,","astuti karahiṁ sakala nara-nārī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["चम्पक माल गले लहरावे ।","सुर नर मुनि जय जयति उचारी ॥३॥"],"c":"3","t":["campaka māla gale laharāve,","sura nara muni jaya jayati ucārī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["त्रिविध ताप मिटि जात सकल सब ।","भक्ति सदा तव है सुखकारी ॥४॥"],"c":"4","t":["trividha tāpa miṭi jāta sakala saba,","bhakti sadā tava hai sukhakārī ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["पालत हरत सृजत तुम जग को ।","सब जीवन की हो रखवारी ॥५॥"],"c":"5","t":["pālata harata sr̥jata tuma jaga ko,","saba jīvana kī ho rakhavārī ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["मोह निशा में भ्रमत सकल जन ।","करहु हृदय महँ तुम उजियारी ॥६॥"],"c":"6","t":["moha niśā meṁ bhramata sakala jana,","karahu hr̥daya maham̐ tuma ujiyārī ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["तिमिर नशावहु ज्ञान बढ़ावहु ।","अम्बे तुमही हो असु