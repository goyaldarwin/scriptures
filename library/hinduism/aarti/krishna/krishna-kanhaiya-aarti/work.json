{"id":"krishna-kanhaiya-aarti","lang":"hi","title":{"hi":"आरती श्रीकृष्ण कन्हैया की","en":"Aarti Shri Krishna Kanhaiya Ki"},"by":{"hi":"भगवान श्रीकृष्ण","en":"Bhagwan Shri Krishna"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"आरती श्रीकृष्ण कन्हैया की","en":"Aarti Shri Krishna Kanhaiya Ki"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["आरती श्रीकृष्ण कन्हैया की ॥"],"c":"","t":["āratī śrīkr̥ṣṇa kanhaiyā kī."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["मथुरा कारागृह अवतारी ।","गोकुल जसुदा गोद विहारी ।","नन्दलाल नटवर गिरधारी ।","वासुदेव हलधर भैया की ॥१॥"],"c":"1","t":["mathurā kārāgr̥ha avatārī,","gokula jasudā goda vihārī,","nandalāla naṭavara giradhārī,","vāsudeva haladhara bhaiyā kī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["मोर मुकुट पीताम्बर छाजै ।","कटि काछनि कर मुरलि विराजै ।","पूर्ण सरद ससि मुख लखि लाजै ।","काम कोटि छवि जितवैया की ॥२॥"],"c":"2","t":["mora mukuṭa pītāmbara chājai,","kaṭi kāchani kara murali virājai,","pūrṇa sarada sasi mukha lakhi lājai,","kāma koṭi chavi jitavaiyā kī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["गोपीजन रस रास विलासी ।","कौरव कालिय कंस बिनासी ।","हिमकर भानु कृसानु प्रकासी ।","सर्वभूत हिय बसवैया की ॥३॥"],"c":"3","t":["gopījana rasa rāsa vilāsī,","kaurava kāliya kaṁsa bināsī,","himakara bhānu kr̥sānu prakāsī,","sarvabhūta hiya basavaiyā kī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["कहुँ रन चढ़ै भागि कहुँ जावै ।","कहुँ नृप कर कहुँ गाय चरावै ।","कहुँ जागेस बेद जस गावै ।","जग नचाय ब्रज नचवैया की ॥४॥"],"c":"4","t":["kahum̐ rana caṛhai bhāgi kahum̐ jāvai,","kahum̐ nr̥pa kara kahum̐ gāya carāvai,","kahum̐ jāgesa beda jasa gāvai,","jaga nacāya braja nacavaiyā kī ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["अगुन सगुन लीला बपु धारी ।","अनुपम गीता ज्ञान प्रचारी ।","दामोदर सब विधि बलिहारी ।","विप्र धेनु सुर रखवैया की ॥५॥"],"c":"5","t":["aguna saguna līlā bapu dhārī,","anupama gītā jñāna pracārī,","dāmodara saba vidhi balihārī,","vipra dhenu sura rakhavaiyā kī ॥5॥"]}],"topics":[{"id":"aarti.tek","hi":"आरती श्रीकृष्ण कन्हैया की","en":"Aarti Shri Krishna Kanhaiya Ki"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]}}