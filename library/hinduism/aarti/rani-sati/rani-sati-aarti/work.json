{"id":"rani-sati-aarti","lang":"hi","title":{"hi":"जय श्री राणी सती मैया","en":"Jai Shri Rani Sati Maiya"},"by":{"hi":"राणी सती","en":"Rani Sati"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"जय श्री राणी सती मैया","en":"Jai Shri Rani Sati Maiya"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["जय श्री राणी सती मैया ।","जय जगदम्ब सती जी ।","अपने भक्तजनों की दूर करो विपती ॥"],"c":"","t":["jaya śrī rāṇī satī maiyā,","jaya jagadamba satī jī,","apane bhaktajanoṁ kī dūra karo vipatī."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["अपनि अनन्तर ज्योति अखण्डित मंडित चहुँककूंभा ।","दुरजन दलन खडग की ।","विद्युतसम प्रतिभा ॥१॥"],"c":"1","t":["apani anantara jyoti akhaṇḍita maṁḍita cahum̐kakūṁbhā,","durajana dalana khaḍaga kī,","vidyutasama pratibhā ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["मरकत मणि मन्दिर अति मंजुल ।","शोभा लखि न बड़े ।","ललित ध्वजा चहुँ ओर ।","कंचन कलश धरे ॥२॥"],"c":"2","t":["marakata maṇi mandira ati maṁjula,","śobhā lakhi na baṛe,","lalita dhvajā cahum̐ ora,","kaṁcana kalaśa dhare ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["घण्टा घनन घड़ावल बाजत ।","शंख मृदंग घुरे ।","किन्नर गायन करते ।","वेद ध्वनि उचरे ॥३॥"],"c":"3","t":["ghaṇṭā ghanana ghaṛāvala bājata,","śaṁkha mr̥daṁga ghure,","kinnara gāyana karate,","veda dhvani ucare ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["सप्त मातृका करें आरती ।","सुरगम ध्यान धरे ।","विविध प्रकार के व्यंजन ।","श्री फल भेंट धरे ॥४॥"],"c":"4","t":["sapta mātr̥kā kareṁ āratī,","suragama dhyāna dhare,","vividha prakāra ke vyaṁjana,","śrī phala bheṁṭa dhare ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["संकट विकट विदारणी ।","नाशनी हो कुमति ।","सेवक जन हृदय पटले ।","मृदुल करन सुमति ॥५॥"],"c":"5","t":["saṁkaṭa vikaṭa vidāraṇī,","nāśanī ho kumati,","sevaka jana hr̥daya paṭale,","mr̥dula karana sumati ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["अमल कमल दल लोचनी ।","मोचनी त्रय तापा ।","दास आयो शरण आपकी ।","लाज रखो माता ॥६॥"],"c":"6","t":["amala kamala dala locanī,","mocanī traya tāpā,","dāsa āyo śaraṇa āpakī,","lāja rakho mātā ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["श्री राणीसती मैयाजी की आरती ।","जो कोई नर गावे ।","सदनसिद्धि नवनिधि ।","मनवांछित फल पावे ॥७॥"],"c":"7","t":["śrī rāṇīsatī maiyājī kī āratī,","jo koī nara gāve,","sadanasiddhi navanidhi,","manavāṁchita phala pāve ॥7॥"]}],"topics":[{"id":"aarti.tek","hi":"जय श्री राणी सती मैया","en":"Jai Shri Rani Sati Maiya"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]},"glossary":true}