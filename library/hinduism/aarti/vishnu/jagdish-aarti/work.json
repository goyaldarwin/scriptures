{"id":"jagdish-aarti","lang":"hi","title":{"hi":"ॐ जय जगदीश हरे","en":"Om Jaya Jagadīśa Hare"},"by":{"hi":"भगवान विष्णु (जगदीश)","en":"Bhagavān Viṣṇu (Jagadīśa)"},"parts":{"name":{"hi":"आरती","en":"Āratī"},"list":[{"hi":"ॐ जय जगदीश हरे","en":"Om Jaya Jagadīśa Hare"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (ṭeka)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["ॐ जय जगदीश हरे,","स्वामी जय जगदीश हरे ।","भक्त जनों के संकट,","दास जनों के संकट,","क्षण में दूर करे ।।"],"t":["oṁ jaya jagadīśa hare,","svāmī jaya jagadīśa hare,","bhakta jano̐ ke saṁkaṭa,","dāsa jano̐ ke saṁkaṭa,","kṣaṇa me̐ dūra kare."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["जो ध्यावे फल पावे,","दुःख बिनसे मन का,","स्वामी दुःख बिनसे मन का ।","सुख सम्पति घर आवे,","सुख सम्पति घर आवे,","कष्ट मिटे तन का ।।१।।"],"t":["jo dhyāve phala pāve,","duḥkha binase mana kā,","svāmī duḥkha binase mana kā,","sukha sampati ghara āve,","sukha sampati ghara āve,","kaṣṭa miṭe tana kā ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["मात पिता तुम मेरे,","शरण गहूं किसकी,","स्वामी शरण गहूं मैं किसकी ।","तुम बिन और न दूजा,","तुम बिन और न दूजा,","आस करूं मैं जिसकी ।।२।।"],"t":["māta pitā tuma mere,","śaraṇa gahūṁ kisakī,","svāmī śaraṇa gahūṁ maiṁ kisakī,","tuma bina aura na dūjā,","tuma bina aura na dūjā,","āsa karūṁ maiṁ jisakī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["तुम पूरण परमात्मा,","तुम अन्तर्यामी,","स्वामी तुम अन्तर्यामी ।","पारब्रह्म परमेश्वर,","पारब्रह्म परमेश्वर,","तुम सब के स्वामी ।।३।।"],"t":["tuma pūraṇa paramātmā,","tuma antaryāmī,","svāmī tuma antaryāmī,","pārabrahma parameśvara,","pārabrahma parameśvara,","tuma saba ke svāmī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["तुम करुणा के सागर,","तुम पालनकर्ता,","स्वामी तुम पालनकर्ता ।","मैं मूरख फलकामी,","मैं सेवक तुम स्वामी,","कृपा करो भर्ता ।।४।।"],"t":["tuma karuṇā ke sāgara,","tuma pālanakartā,","svāmī tuma pālanakartā,","maiṁ mūrakha phalakāmī,","maiṁ sevaka tuma svāmī,","kr̥pā karo bhartā ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["तुम हो एक अगोचर,","सबके प्राणपति,","स्वामी सबके प्राणपति ।","किस विधि मिलूं दयामय,","किस विधि मिलूं दयामय,","तुमको मैं कुमति ।।५।।"],"t":["tuma ho eka agocara,","sabake prāṇapati,","svāmī sabake prāṇapati,","kisa vidhi milūṁ dayāmaya,","kisa vidhi milūṁ dayāmaya,","tumako maiṁ kumati ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["दीन-बन्धु दुःख-हर्ता,","ठाकुर तुम मेरे,","स्वामी रक्षक तुम मेरे ।","अपने हाथ उठाओ,","अपने शरण लगाओ,","द्वार पड़ा तेरे ।।६।।"],"t":["dīna-bandhu duḥkha-hartā,","ṭhākura tuma mere,","svāmī rakṣaka tuma mere,","apane hātha uṭhāo,","apane śaraṇa lagāo,","dvāra paṛā tere ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["विषय-विकार मिटाओ,","पाप हरो देवा,","स्वामी पाप हरो देवा ।","श्रद्धा भक्ति बढ़ाओ,","श्रद्धा भक्ति बढ़ाओ,","सन्तन की सेवा ।।७।।"],"t":["viṣaya-vikāra miṭāo,","pāpa haro devā,","svāmī pāpa haro devā,","śraddhā bhakti baṛhāo,","śraddhā bhakti baṛhāo,","santana kī sevā ॥7॥"]}],"topics":[{"id":"aarti.tek","hi":"ॐ जय जगदीश हरे","en":"Om Jaya Jagadīśa Hare"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[{"id":"mahendra-kapoor","file":"audio/mahendra-kapoor","title":{"hi":"महेन्द्र कपूर","en":"Mahendra Kapoor"}}]}}