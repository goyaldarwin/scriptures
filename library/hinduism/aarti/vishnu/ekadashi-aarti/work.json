{"id":"ekadashi-aarti","lang":"hi","title":{"hi":"ॐ जय एकादशी","en":"Om Jai Ekadashi"},"by":{"hi":"एकादशी माता","en":"Mother Ekadashi"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"ॐ जय एकादशी","en":"Om Jai Ekadashi"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["ॐ जय एकादशी जय एकादशी ।","जय एकादशी माता ।","विष्णु पूजा व्रत को धारण कर ।","शक्ति मुक्ति पाता ॥"],"c":"","t":["oṁ jaya ekādaśī jaya ekādaśī,","jaya ekādaśī mātā,","viṣṇu pūjā vrata ko dhāraṇa kara,","śakti mukti pātā."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["तेरे नाम गिनाऊं देवी ।","भक्ति प्रदान करनी ।","गण गौरव की देनी माता ।","शास्त्रों में वरनी ॥१॥"],"c":"1","t":["tere nāma gināūṁ devī,","bhakti pradāna karanī,","gaṇa gaurava kī denī mātā,","śāstroṁ meṁ varanī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["मार्गशीर्ष के कृष्णपक्ष की उत्पन्ना ।","विश्वतारनी जन्मी ।","शुक्ल पक्ष में हुई मोक्षदा ।","मुक्तिदाता बन आई ॥२॥"],"c":"2","t":["mārgaśīrṣa ke kr̥ṣṇapakṣa kī utpannā,","viśvatāranī janmī,","śukla pakṣa meṁ huī mokṣadā,","muktidātā bana āī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["पौष के कृष्णपक्ष की ।","सफला नामक है ।","शुक्लपक्ष में होय पुत्रदा ।","आनन्द अधिक रहै ॥३॥"],"c":"3","t":["pauṣa ke kr̥ṣṇapakṣa kī,","saphalā nāmaka hai,","śuklapakṣa meṁ hoya putradā,","ānanda adhika rahai ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["नाम षटतिला माघ मास में ।","कृष्णपक्ष आवै ।","शुक्लपक्ष में जया कहावै ।","विजय सदा पावै ॥४॥"],"c":"4","t":["nāma ṣaṭatilā māgha māsa meṁ,","kr̥ṣṇapakṣa āvai,","śuklapakṣa meṁ jayā kahāvai,","vijaya sadā pāvai ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["विजया फागुन कृष्णपक्ष में ।","शुक्ला आमलकी ।","पापमोचनी कृष्ण पक्ष में ।","चैत्र महाबलि की ॥५॥"],"c":"5","t":["vijayā phāguna kr̥ṣṇapakṣa meṁ,","śuklā āmalakī,","pāpamocanī kr̥ṣṇa pakṣa meṁ,","caitra mahābali kī ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["चैत्र शुक्ल में नाम कामदा ।","धन देने वाली ।","नाम वरूथिनी कृष्णपक्ष में ।","वैसाख माह वाली ॥६॥"],"c":"6","t":["caitra śukla meṁ nāma kāmadā,","dhana dene vālī,","nāma varūthinī kr̥ṣṇapakṣa meṁ,","vaisākha māha vālī ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["शुक्ल पक्ष में होय मोहिनी ।","अपरा ज्येष्ठ कृष्णपक्षी ।","नाम निर्जला सब सुख करनी ।","शुक्लपक्ष रखी ॥७॥"],"c":"7","t":["śukla pakṣa meṁ hoya mohinī,","aparā jyeṣṭha kr̥ṣṇapakṣī,","nāma nirjalā saba sukha karanī,","śuklapakṣa rakhī ॥7॥"]},{"id":"aarti.pad8","p":0,"s":"aarti","y":"pad","n":"8","v":["योगिनी नाम आषाढ में जानों ।","कृष्णपक्ष करनी ।","देवशयनी नाम कहायो ।","शुक्लपक्ष धरनी ॥८॥"],"c":"8","t":["yoginī nāma āṣāḍha meṁ jānoṁ,","kr̥ṣṇapakṣa karanī,","devaśayanī nāma kahāyo,","śuklapakṣa dharanī ॥8॥"]},{"id":"aarti.pad9","p":0,"s":"aarti","y":"pad","n":"9","v":["कामिका श्रावण मास में आवै ।","कृष्णपक्ष कहिए ।","श्रावण शुक्ला होय पवित्रा ।","आनन्द से रहिए ॥९॥"],"c":"9","t":["kāmikā śrāvaṇa māsa meṁ āvai,","kr̥ṣṇapakṣa kahie,","śrāvaṇa śuklā hoya pavitrā,","ānanda se rahie ॥9॥"]},{"id":"aarti.pad10","p":0,"s":"aarti","y":"pad","n":"10","v":["अजा भाद्रपद कृष्णपक्ष की ।","परिवर्तिनी शुक्ला ।","इन्द्रा आश्विन कृष्णपक्ष में ।","व्रत से भवसागर निकला ॥१०॥"],"c":"10","t":["ajā bhādrapada kr̥ṣṇapakṣa kī,","parivartinī śuklā,","indrā āśvina kr̥ṣṇapakṣa meṁ,","vrata se bhavasāgara nikalā ॥10॥"]},{"id":"aarti.pad11","p":0,"s":"aarti","y":"pad","n":"11","v":["पापांकुशा है शुक्ल पक्ष में ।","आप हरनहारी ।","रमा मास कार्तिक में आवै ।","सुखदायक भारी ॥११॥"],"c":"11","t":["pāpāṁkuśā hai śukla pakṣa meṁ,","āpa haranahārī,","ramā māsa kārtika meṁ āvai,","sukhadāyaka bhārī ॥11॥"]},{"id":"aarti.pad12","p":0,"s":"aarti","y":"pad","n":"12","v":["देवोत्थानी शुक्लपक्ष की ।","दुखनाशक मैया ।","पावन मास में करूं विनती ।","पार करो नैया ॥१२॥"],"c":"12","t":["devotthānī śuklapakṣa kī,","dukhanāśaka maiyā,","pāvana māsa meṁ karūṁ vinatī,","pāra karo naiyā ॥12॥"]},{"id":"aarti.pad13","p":0,"s":"aarti","y":"pad","n":"13","v":["परमा कृष्णपक्ष में होती ।","जन मंगल करनी ।","शुक्ल मास में होय पद्मिनी ।","दुख दारिद्र हरनी ॥१३॥"],"c":"13","t":["paramā kr̥ṣṇapakṣa meṁ hotī,","jana maṁgala karanī,","śukla māsa meṁ hoya padminī,","dukha dāridra haranī ॥13॥"]},{"id":"aarti.pad14","p":0,"s":"aarti","y":"pad","n":"14","v":["जो कोई आरती एकादशी की ।","भक्ति सहित गावै ।","जन गुरदिता स्वर्ग का वासा ।","निश्चय वह पावै ॥१४॥"],"c":"14","t":["jo koī āratī ekādaśī kī,","bhakti sahita gāvai,","jana guraditā svarga kā vāsā,","niścaya vaha pāvai ॥14॥"]}],"topics":[{"id":"aarti.tek","hi":"ॐ जय एकादशी","en":"Om Jai Ekadashi"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"},"lines":true}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"},"lines":true}],"au":[{"id":"spiritual-activity","file":"audio/spiritual-activity","title":{"hi":"स्पिरिचुअल एक्टिविटी","en":"Spiritual Activity"},"draft":true}]},"glossary":true}