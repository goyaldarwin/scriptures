{"id":"ravidas-aarti","lang":"hi","title":{"hi":"नामु तेरो आरती मजनु मुरारे","en":"Namu Tero Aarti Majanu Murare"},"by":{"hi":"गुरु रविदास","en":"Guru Ravidas"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"नामु तेरो आरती मजनु मुरारे","en":"Namu Tero Aarti Majanu Murare"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["नामु तेरो आरती मजनु मुरारे ।","हरि के नाम बिनु झूठे सगल पसारे ॥"],"c":"","t":["nāmu tero āratī majanu murāre,","hari ke nāma binu jhūṭhe sagala pasāre."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["नाम तेरा आसनो नाम तेरा उरसा ।","नामु तेरा केसरो ले छिटकारो ।","नाम तेरा अंभुला नाम तेरा चंदनोघसि ।","जपे नाम ले तुझहि कउ चारे ॥१॥"],"c":"1","t":["nāma terā āsano nāma terā urasā,","nāmu terā kesaro le chiṭakāro,","nāma terā aṁbhulā nāma terā caṁdanoghasi,","jape nāma le tujhahi kaü cāre ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["नाम तेरा दीवा नाम तेरो बाती ।","नाम तेरो तेल ले माहि पसारे ।","नाम तेरे की ज्योति जगाई ।","भइलो उजिआरो भवन सगलारे ॥२॥"],"c":"2","t":["nāma terā dīvā nāma tero bātī,","nāma tero tela le māhi pasāre,","nāma tere kī jyoti jagāī,","bhaïlo ujiāro bhavana sagalāre ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["नाम तेरो तागा नाम फूल माला ।","भार अठारह सगल जूठारे ।","तेरो कियो तुझ ही किया अरपउ ।","नाम तेरो तुही चंवर ढोलारे ॥३॥"],"c":"3","t":["nāma tero tāgā nāma phūla mālā,","bhāra aṭhāraha sagala jūṭhāre,","tero kiyo tujha hī kiyā arapaü,","nāma tero tuhī caṁvara ḍholāre ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["दस अठा अठसठे चारे खानी ।","इहै वरतणि है सगल संसारे ।","कहै रविदास नाम तेरो आरती ।","सतिनाम है हरिभोग तुम्हारे ॥४॥"],"c":"4","t":["dasa aṭhā aṭhasaṭhe cāre khānī,","ihai varataṇi hai sagala saṁsāre,","kahai ravidāsa nāma tero āratī,","satināma hai haribhoga tumhāre ॥4॥"]}],"topics":[{"id":"aarti.tek","hi":"नामु तेरो आरती मजनु मुरारे","en":"Namu Tero Aarti Majanu Murare"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]},"glossary":true}