{"id":"shiv-aarti","lang":"hi","title":{"hi":"ॐ जय शिव ओंकारा","en":"Om Jaya Śiva Oṅkārā"},"by":{"hi":"भगवान शिव","en":"Bhagavān Śiva"},"parts":{"name":{"hi":"आरती","en":"Āratī"},"list":[{"hi":"ॐ जय शिव ओंकारा","en":"Om Jaya Śiva Oṅkārā"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (ṭeka)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["ॐ जय शिव ओंकारा, स्वामी जय शिव ओंकारा ।","ब्रह्मा, विष्णु, सदाशिव, अर्द्धांगी धारा ॥"],"t":["oṁ jaya śiva oṁkārā, svāmī jaya śiva oṁkārā,","brahmā, viṣṇu, sadāśiva, arddhāṁgī dhārā."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["एकानन चतुरानन पंचानन राजे,","हंसासन गरुड़ासन वृषवाहन साजे ॥१॥"],"t":["ekānana caturānana paṁcānana rāje,","haṁsāsana garuṛāsana vr̥ṣavāhana sāje ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["दो भुज चारु चतुर्भुज दस भुज अति सोहे,","तीनों रूप निरखता त्रिभुवन जन मोहे ॥२॥"],"t":["do bhuja cāru caturbhuja dasa bhuja ati sohe,","tīnoṁ rūpa nirakhatā tribhuvana jana mohe ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["अक्षमाला वनमाला मुण्डमाला धारी,","चंदन मृगमद सोहै, भाले शशिधारी ॥३॥"],"t":["akṣamālā vanamālā muṇḍamālā dhārī,","caṁdana mr̥gamada sohai, bhāle śaśidhārī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["श्वेताम्बर पीताम्बर बाघम्बर अंगे,","ब्रह्मादिक सनकादिक भूतादिक संगे ॥४॥"],"t":["śvetāmbara pītāmbara bāghambara aṁge,","brahmādika sanakādika bhūtādika saṁge ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["कर के मध्य कमण्डलु चक्र त्रिशूल धर्ता,","जगकर्ता जगहर्ता जग पालनकर्ता ॥५॥"],"t":["kara ke madhya kamaṇḍalu cakra triśūla dhartā,","jagakartā jagahartā jaga pālanakartā ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["ब्रह्मा विष्णु सदाशिव जानत अविवेका,","प्रणवाक्षर के मध्ये ये तीनों एका ॥६॥"],"t":["brahmā viṣṇu sadāśiva jānata avivekā,","praṇavākṣara ke madhye ye tīnoṁ ekā ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["त्रिगुणस्वामी जी की आरती जो कोइ नर गावे,","कहत शिवानन्द स्वामी मनवांछित फल पावे ॥७॥"],"t":["triguṇasvāmī jī kī āratī jo koi nara gāve,","kahata śivānanda svāmī manavāṁchita phala pāve ॥7॥"]},{"id":"aarti.tek2","p":0,"s":"aarti","y":"tek","n":"","v":["जय शिव ओंकारा, हर ॐ शिव ओंकारा ।","ब्रह्मा, विष्णु, सदाशिव, अर्द्धांगी धारा ॥"],"t":["jaya śiva oṁkārā, hara oṁ śiva oṁkārā,","brahmā, viṣṇu, sadāśiva, arddhāṁgī dhārā."]}],"topics":[{"id":"aarti.tek","hi":"ॐ जय शिव ओंकारा","en":"Om Jaya Śiva Oṅkārā"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[{"id":"anuradha-paudwal","file":"audio/anuradha-paudwal","title":{"hi":"अनुराधा पौडवाल","en":"Anuradha Paudwal"}}]},"glossary":true}