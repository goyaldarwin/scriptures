{"id":"shiv-aarti","lang":"hi","title":{"hi":"ॐ जय शिव ओंकारा","en":"Om Jaya Śiva Oṅkārā"},"by":{"hi":"भगवान शिव","en":"Bhagavān Śiva"},"parts":{"name":{"hi":"आरती","en":"Āratī"},"list":[{"hi":"ॐ जय शिव ओंकारा","en":"Om Jaya Śiva Oṅkārā"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (ṭeka)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["ॐ जय शिव ओंकारा, स्वामी जय शिव ओंकारा ।","ब्रह्मा, विष्णु, सदाशिव, अर्द्धांगी धारा ।।"],"t":["oṁ jaya śiva oṁkārā, svāmī jaya śiva oṁkārā,","brahmā, viṣṇu, sadāśiva, arddhāṁgī dhārā."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["एकानन चतुरानन पंचानन राजे,","हंसासन गरुड़ासन वृषवाहन साजे ।।१।।"],"t":["ekānana caturānana paṁcānana rāje,","haṁsāsana garuṛāsana vr̥ṣavāhana sāje ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["दो भुज चार चतुर्भुज दस भुज अति सोहे,","त्रिगुण रूप निरखते, त्रिभुवन जन मोहे ।।२।।"],"t":["do bhuja cāra caturbhuja dasa bhuja ati sohe,","triguṇa rūpa nirakhate, tribhuvana jana mohe ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["अक्षमाला वनमाला मुण्डमाला धारी,","त्रिपुरारी कंसारी कर माला धारी ।।३।।"],"t":["akṣamālā vanamālā muṇḍamālā dhārī,","tripurārī kaṁsārī kara mālā dhārī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["श्वेताम्बर पीताम्बर बाघम्बर अंगे,","सनकादिक गरुणादिक भूतादिक संगे ।।४।।"],"t":["śvetāmbara pītāmbara bāghambara aṁge,","sanakādika garuṇādika bhūtādika saṁge ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["कर के मध्य कमण्डलु चक्र त्रिशूल धर्ता,","जगकर्ता जगभर्ता जग संहारकर्ता ।।५।।"],"t":["kara ke madhya kamaṇḍalu cakra triśūla dhartā,","jagakartā jagabhartā jaga saṁhārakartā ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["ब्रह्मा विष्णु सदाशिव जानत अविवेका,","प्रणवाक्षर में शोभित यह त्रिवेद का टीका ।।६।।"],"t":["brahmā viṣṇu sadāśiva jānata avivekā,","praṇavākṣara me̐ śobhita yaha triveda kā ṭīkā ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["शिव ओंकारा शिव ओंकारा हर ऊंकारा,","ब्रह्मा विष्णु सदाशिव अर्द्धांगी धारा ।।७।।"],"t":["śiva oṁkārā śiva oṁkārā hara ūṁkārā,","brahmā viṣṇu sadāśiva arddhāṁgī dhārā ॥7॥"]}],"topics":[{"id":"aarti.tek","hi":"ॐ जय शिव ओंकारा","en":"Om Jaya Śiva Oṅkārā"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[{"id":"anuradha-paudwal","file":"audio/anuradha-paudwal","title":{"hi":"अनुराधा पौडवाल","en":"Anuradha Paudwal"},"draft":true}]},"glossary":true}