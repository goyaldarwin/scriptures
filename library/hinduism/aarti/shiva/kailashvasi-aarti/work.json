{"id":"kailashvasi-aarti","lang":"hi","title":{"hi":"शीश गंग अर्धन्ग पार्वती","en":"Shish Gang Ardhang Parvati"},"by":{"hi":"भगवान शिव","en":"Bhagwan Shiv"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"शीश गंग अर्धन्ग पार्वती","en":"Shish Gang Ardhang Parvati"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["शीश गंग अर्धन्ग पार्वती ।","सदा विराजत कैलासी ।","नन्दी भृन्गी नृत्य करत हैं ।","धरत ध्यान सुर सुखरासी ॥१॥"],"c":"1","t":["śīśa gaṁga ardhanga pārvatī,","sadā virājata kailāsī,","nandī bhr̥ngī nr̥tya karata haiṁ,","dharata dhyāna sura sukharāsī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["शीतल मन्द सुगन्ध पवन बह ।","बैठे हैं शिव अविनाशी ।","करत गान गन्धर्व सप्त स्वर ।","राग रागिनी मधुरासी ॥२॥"],"c":"2","t":["śītala manda sugandha pavana baha,","baiṭhe haiṁ śiva avināśī,","karata gāna gandharva sapta svara,","rāga rāginī madhurāsī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["यक्ष-रक्ष-भैरव जहँ डोलत ।","बोलत हैं वनके वासी ।","कोयल शब्द सुनावत सुन्दर ।","भ्रमर करत हैं गुन्जा-सी ॥३॥"],"c":"3","t":["yakṣa-rakṣa-bhairava jaham̐ ḍolata,","bolata haiṁ vanake vāsī,","koyala śabda sunāvata sundara,","bhramara karata haiṁ gunjā-sī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["कल्पद्रुम अरु पारिजात तरु ।","लाग रहे हैं लक्षासी ।","कामधेनु कोटिन जहँ डोलत ।","करत दुग्ध की वर्षा-सी ॥४॥"],"c":"4","t":["kalpadruma aru pārijāta taru,","lāga rahe haiṁ lakṣāsī,","kāmadhenu koṭina jaham̐ ḍolata,","karata dugdha kī varṣā-sī ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["सूर्यकान्त सम पर्वत शोभित ।","चन्द्रकान्त सम हिमराशी ।","नित्य छहों ऋतु रहत सुशोभित ।","सेवत सदा प्रकृति-दासी ॥५॥"],"c":"5","t":["sūryakānta sama parvata śobhita,","candrakānta sama himarāśī,","nitya chahoṁ r̥tu rahata suśobhita,","sevata sadā prakr̥ti-dāsī ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["ऋषि-मुनि देव दनुज नित सेवत ।","गान करत श्रुति गुणराशी ।","ब्रह्मा-विष्णु निहारत निसिदिन ।","कछु शिव हमकूँ फरमासी ॥६॥"],"c":"6","t":["r̥ṣi-muni deva danuja nita sevata,","gāna karata śruti guṇarāśī,","brahmā-viṣṇu nihārata nisidina,","kachu śiva hamakūm̐ pharamāsī ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["ऋद्धि सिद्धिके दाता शंकर ।","नित सत् चित् आनँदराशी ।","जिनके सुमिरत ही कट जाती ।","कठिन काल-यमकी फाँसी ॥७॥"],"c":"7","t":["r̥ddhi siddhike dātā śaṁkara,","nita sat cit ānam̐darāśī,","jinake sumirata hī kaṭa jātī,","kaṭhina kāla-yamakī phām̐sī ॥7॥"]},{"id":"aarti.pad8","p":0,"s":"aarti","y":"pad","n":"8","v":["त्रिशूलधरजीका नाम निरन्तर ।","प्रेम सहित जो नर गासी ।","दूर होय विपदा उस नर की ।","जन्म-जन्म शिवपद पासी ॥८॥"],"c":"8","t":["triśūladharajīkā nāma nirantara,","prema sahita jo nara gāsī,","dūra hoya vipadā usa nara kī,","janma-janma śivapada pāsī ॥8॥"]},{"id":"aarti.pad9","p":0,"s":"aarti","y":"pad","n":"9","v":["कैलासी काशी के वासी ।","अविनाशी मेरी सुध लीजो ।","सेवक जान सदा चरनन को ।","अपनो जान कृपा कीजो ॥९॥"],"c":"9","t":["kailāsī kāśī ke vāsī,","avināśī merī sudha lījo,","sevaka jāna sadā caranana ko,","apano jāna kr̥pā kījo ॥9॥"]},{"id":"aarti.pad10","p":0,"s":"aarti","y":"pad","n":"10","v":["तुम तो प्रभुजी सदा दयामय ।","अवगुण मेरे सब ढकियो ।","सब अपराध क्षमाकर शंकर ।","किंकरकी विनती सुनियो ॥१०॥"],"c":"10","t":["tuma to prabhujī sadā dayāmaya,","avaguṇa mere saba ḍhakiyo,","saba aparādha kṣamākara śaṁkara,","kiṁkarakī vinatī suniyo ॥10॥"]}],"topics":[{"id":"aarti.pad1","hi":"शीश गंग अर्धन्ग पार्वती","en":"Shish Gang Ardhang Parvati"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"},"lines":true}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"},"lines":true}],"au":[]}}