{"id":"gangadhar-aarti","lang":"hi","title":{"hi":"ॐ जय गङ्गाधर","en":"Om Jai Gangadhar"},"by":{"hi":"भगवान शिव","en":"Bhagwan Shiv"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"ॐ जय गङ्गाधर","en":"Om Jai Gangadhar"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["ॐ जय गङ्गाधर जय हर जय गिरिजाधीशा ।","त्वं मां पालय नित्यं कृपया जगदीशा ॥"],"c":"","t":["oṁ jaya gaṅgādhara jaya hara jaya girijādhīśā,","tvaṁ māṁ pālaya nityaṁ kr̥payā jagadīśā."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["कैलासे गिरिशिखरे कल्पद्रुमविपिने ।","गुन्जति मधुकरपुन्जे कुन्जवने गहने ।","कोकिलकूजित खेलत हन्सावन ललिता ।","रचयति कलाकलापं नृत्यति मुदसहिता ॥१॥"],"c":"1","t":["kailāse giriśikhare kalpadrumavipine,","gunjati madhukarapunje kunjavane gahane,","kokilakūjita khelata hansāvana lalitā,","racayati kalākalāpaṁ nr̥tyati mudasahitā ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["तस्मिँल्ललितसुदेशे शाला मणिरचिता ।","तन्मध्ये हरनिकटे गौरी मुदसहिता ।","क्रीडा रचयति भूषारञ्जित निजमीशम् ।","इन्द्रादिक सुर सेवत नामयते शीशम् ॥२॥"],"c":"2","t":["tasmim̐llalitasudeśe śālā maṇiracitā,","tanmadhye haranikaṭe gaurī mudasahitā,","krīḍā racayati bhūṣārañjita nijamīśam,","indrādika sura sevata nāmayate śīśam ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["बिबुधबधू बहु नृत्यत हृदये मुदसहिता ।","किन्नर गायन कुरुते सप्त स्वरसहिता ।","धिनकत थै थै धिनकत मृदङ्ग वादयते ।","क्वण क्वण ललिता वेणुं मधुरं नाटयते ॥३॥"],"c":"3","t":["bibudhabadhū bahu nr̥tyata hr̥daye mudasahitā,","kinnara gāyana kurute sapta svarasahitā,","dhinakata thai thai dhinakata mr̥daṅga vādayate,","kvaṇa kvaṇa lalitā veṇuṁ madhuraṁ nāṭayate ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["रुण रुण चरणे रचयति नूपुरमुज्ज्वलिता ।","चक्रावर्ते भ्रमयति कुरुते तां धिक तां ।","तां तां लुप चुप तां तां डमरू वादयते ।","अङ्गुष्ठांगुलिनादं लासकतां कुरुते ॥४॥"],"c":"4","t":["ruṇa ruṇa caraṇe racayati nūpuramujjvalitā,","cakrāvarte bhramayati kurute tāṁ dhika tāṁ,","tāṁ tāṁ lupa cupa tāṁ tāṁ ḍamarū vādayate,","aṅguṣṭhāṁgulinādaṁ lāsakatāṁ kurute ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["कर्पूरद्युतिगौरं पन्चाननसहितम् ।","त्रिनयनशशिधरमौलिं विषधरकण्ठयुतम् ।","सुन्दरजटाकलापं पावकयुतभालम् ।","डमरुत्रिशूलपिनाकं करधृतनृकपालम् ॥५॥"],"c":"5","t":["karpūradyutigauraṁ pancānanasahitam,","trinayanaśaśidharamauliṁ viṣadharakaṇṭhayutam,","sundarajaṭākalāpaṁ pāvakayutabhālam,","ḍamarutriśūlapinākaṁ karadhr̥tanr̥kapālam ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["मुण्डै रचयति माला पन्नगमुपवीतम् ।","वामविभागे गिरिजारूपं अतिललितम् ।","सुन्दरसकलशरीरे कृतभस्माभरणम् ।","इति वृषभध्वजरूपं तापत्रयहरणम् ॥६॥"],"c":"6","t":["muṇḍai racayati mālā pannagamupavītam,","vāmavibhāge girijārūpaṁ atilalitam,","sundarasakalaśarīre kr̥tabhasmābharaṇam,","iti vr̥ṣabhadhvajarūpaṁ tāpatrayaharaṇam ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["शङ्खनिनदम् कृत्वा झल्लरि नादयते ।","नीराजयते ब्रह्मा वेद-ऋचां पठते ।","अतिमृदुचरणसरोजं हृत्कमले धृत्वा ।","अवलोकयति महेशं ईशं अभिनत्वा ॥७॥"],"c":"7","t":["śaṅkhaninadam kr̥tvā jhallari nādayate,","nīrājayate brahmā veda-r̥cāṁ paṭhate,","atimr̥ducaraṇasarojaṁ hr̥tkamale dhr̥tvā,","avalokayati maheśaṁ īśaṁ abhinatvā ॥7॥"]},{"id":"aarti.pad8","p":0,"s":"aarti","y":"pad","n":"8","v":["ध्यानं आरति समये हृदये अति कृत्वा ।","रामस्त्रिजटानाथं ईशं अभिनत्वा ।","सन्गतिमेवं प्रतिदिन पठनं यः कुरुते ।","शिवसायुज्यं गच्छति भक्त्या यः शृणुते ॥८॥"],"c":"8","t":["dhyānaṁ ārati samaye hr̥daye ati kr̥tvā,","rāmastrijaṭānāthaṁ īśaṁ abhinatvā,","sangatimevaṁ pratidina paṭhanaṁ yaḥ kurute,","śivasāyujyaṁ gacchati bhaktyā yaḥ śr̥ṇute ॥8॥"]}],"topics":[{"id":"aarti.tek","hi":"ॐ जय गङ्गाधर","en":"Om Jai Gangadhar"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]}}