{"id":"har-har-mahadev-aarti","lang":"hi","title":{"hi":"हर हर हर महादेव","en":"Har Har Har Mahadev"},"by":{"hi":"भगवान शिव","en":"Bhagwan Shiv"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"हर हर हर महादेव","en":"Har Har Har Mahadev"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["हर हर हर महादेव ॥"],"c":"","t":["hara hara hara mahādeva."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["सत्य सनातन सुन्दर शिव सबके स्वामी ।","अविकारी अविनाशी अज अन्तर्यामी ॥१॥"],"c":"1","t":["satya sanātana sundara śiva sabake svāmī,","avikārī avināśī aja antaryāmī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["आदि अनन्त अनामय अकल कलाधारी ।","अमल अरूप अगोचर अविचल अघहारी ॥२॥"],"c":"2","t":["ādi ananta anāmaya akala kalādhārī,","amala arūpa agocara avicala aghahārī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["ब्रह्मा विष्णु महेश्वर तुम त्रिमूर्तिधारी ।","कर्ता भर्ता धर्ता तुम ही संहारी ॥३॥"],"c":"3","t":["brahmā viṣṇu maheśvara tuma trimūrtidhārī,","kartā bhartā dhartā tuma hī saṁhārī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["रक्षक भक्षक प्रेरक प्रिय औढरदानी ।","साक्षी परम अकर्ता कर्ता अभिमानी ॥४॥"],"c":"4","t":["rakṣaka bhakṣaka preraka priya auḍharadānī,","sākṣī parama akartā kartā abhimānī ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["मणिमय-भवन निवासी अति भोगी रागी ।","सदा श्मशान विहारी योगी वैरागी ॥५॥"],"c":"5","t":["maṇimaya-bhavana nivāsī ati bhogī rāgī,","sadā śmaśāna vihārī yogī vairāgī ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["छाल-कपाल गरल-गल मुण्डमाल व्याली ।","चिता भस्मतन त्रिनयन अयनमहाकाली ॥६॥"],"c":"6","t":["chāla-kapāla garala-gala muṇḍamāla vyālī,","citā bhasmatana trinayana ayanamahākālī ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["प्रेत-पिशाच-सुसेवित पीत जटाधारी ।","विवसन विकट रूपधर रुद्र प्रलयकारी ॥७॥"],"c":"7","t":["preta-piśāca-susevita pīta jaṭādhārī,","vivasana vikaṭa rūpadhara rudra pralayakārī ॥7॥"]},{"id":"aarti.pad8","p":0,"s":"aarti","y":"pad","n":"8","v":["शुभ्र-सौम्य सुरसरिधर शशिधर सुखकारी ।","अतिकमनीय शान्तिकर शिवमुनि मन-हारी ॥८॥"],"c":"8","t":["śubhra-saumya surasaridhara śaśidhara sukhakārī,","atikamanīya śāntikara śivamuni mana-hārī ॥8॥"]},{"id":"aarti.pad9","p":0,"s":"aarti","y":"pad","n":"9","v":["निर्गुण सगुण निरञ्जन जगमय नित्य प्रभो ।","कालरूप केवल हर कालातीत विभो ॥९॥"],"c":"9","t":["nirguṇa saguṇa nirañjana jagamaya nitya prabho,","kālarūpa kevala hara kālātīta vibho ॥9॥"]},{"id":"aarti.pad10","p":0,"s":"aarti","y":"pad","n":"10","v":["सत् चित् आनन्द रसमय करुणामय धाता ।","प्रेम-सुधा-निधि प्रियतम अखिल विश्व त्राता ॥१०॥"],"c":"10","t":["sat cit ānanda rasamaya karuṇāmaya dhātā,","prema-sudhā-nidhi priyatama akhila viśva trātā ॥10॥"]},{"id":"aarti.pad11","p":0,"s":"aarti","y":"pad","n":"11","v":["हम अतिदीन दयामय चरण-शरण दीजै ।","सब विधि निर्मल मति कर अपना कर लीजै ॥११॥"],"c":"11","t":["hama atidīna dayāmaya caraṇa-śaraṇa dījai,","saba vidhi nirmala mati kara apanā kara lījai ॥11॥"]}],"topics":[{"id":"aarti.tek","hi":"हर हर हर महादेव","en":"Har Har Har Mahadev"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"},"lines":true}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"},"lines":true}],"au":[]}}