{"id":"jai-shani-deva-aarti","lang":"hi","title":{"hi":"जय शनि देवा","en":"Jai Shani Deva"},"by":{"hi":"शनिदेव","en":"Shani Dev"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"जय शनि देवा","en":"Jai Shani Deva"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["जय शनि देवा जय शनि देवा ।","जय जय जय शनि देवा ।","अखिल सृष्टि में कोटि-कोटि ।","जन करें तुम्हारी सेवा ॥"],"c":"","t":["jaya śani devā jaya śani devā,","jaya jaya jaya śani devā,","akhila sr̥ṣṭi meṁ koṭi-koṭi,","jana kareṁ tumhārī sevā."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["जा पर कुपित होउ तुम स्वामी ।","घोर कष्ट वह पावे ।","धन वैभव और मान-कीर्ति ।","सब पलभर में मिट जावे ।","राजा नल को लगी शनि दशा ।","राजपाट हर लेवा ॥१॥"],"c":"1","t":["jā para kupita hou tuma svāmī,","ghora kaṣṭa vaha pāve,","dhana vaibhava aura māna-kīrti,","saba palabhara meṁ miṭa jāve,","rājā nala ko lagī śani daśā,","rājapāṭa hara levā ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["जा पर प्रसन्न होउ तुम स्वामी ।","सकल सिद्धि वह पावे ।","तुम्हारी कृपा रहे तो ।","उसको जग में कौन सतावे ।","ताँबा तेल और तिल से जो ।","करें भक्तजन सेवा ॥२॥"],"c":"2","t":["jā para prasanna hou tuma svāmī,","sakala siddhi vaha pāve,","tumhārī kr̥pā rahe to,","usako jaga meṁ kauna satāve,","tām̐bā tela aura tila se jo,","kareṁ bhaktajana sevā ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["हर शनिवार तुम्हारी ।","जय-जय कार जगत में होवे ।","कलियुग में शनिदेव महात्तम ।","दुःख दरिद्रता धोवे ।","करूं आरती भक्ति भाव से ।","भेंट चढ़ाऊं मेवा ॥३॥"],"c":"3","t":["hara śanivāra tumhārī,","jaya-jaya kāra jagata meṁ hove,","kaliyuga meṁ śanideva mahāttama,","duḥkha daridratā dhove,","karūṁ āratī bhakti bhāva se,","bheṁṭa caṛhāūṁ mevā ॥3॥"]}],"topics":[{"id":"aarti.tek","hi":"जय शनि देवा","en":"Jai Shani Deva"}],"sources