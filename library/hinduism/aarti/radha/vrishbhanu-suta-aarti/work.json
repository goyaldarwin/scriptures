{"id":"vrishbhanu-suta-aarti","lang":"hi","title":{"hi":"आरती श्री वृषभानुसुता की","en":"Aarti Shri Vrishbhanu Suta Ki"},"by":{"hi":"श्रीराधा","en":"Shri Radha"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"आरती श्री वृषभानुसुता की","en":"Aarti Shri Vrishbhanu Suta Ki"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["आरती श्री वृषभानुसुता की ।","मंजुल मूर्ति मोहन ममता की ॥"],"c":"","t":["āratī śrī vr̥ṣabhānusutā kī,","maṁjula mūrti mohana mamatā kī."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["त्रिविध तापयुत संसृति नाशिनि ।","विमल विवेकविराग विकासिनि ।","पावन प्रभु पद प्रीति प्रकाशिनि ।","सुन्दरतम छवि सुन्दरता की ॥१॥"],"c":"1","t":["trividha tāpayuta saṁsr̥ti nāśini,","vimala vivekavirāga vikāsini,","pāvana prabhu pada prīti prakāśini,","sundaratama chavi sundaratā kī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["मुनि मन मोहन मोहन मोहनि ।","मधुर मनोहर मूरति सोहनि ।","अविरलप्रेम अमिय रस दोहनि ।","प्रिय अति सदा सखी ललिता की ॥२॥"],"c":"2","t":["muni mana mohana mohana mohani,","madhura manohara mūrati sohani,","aviralaprema amiya rasa dohani,","priya ati sadā sakhī lalitā kī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["संतत सेव्य सत मुनि जनकी ।","आकर अमित दिव्यगुन गनकी ।","आकर्षिणी कृष्ण तन मन की ।","अति अमूल्य सम्पति समता की ॥३॥"],"c":"3","t":["saṁtata sevya sata muni janakī,","ākara amita divyaguna ganakī,","ākarṣiṇī kr̥ṣṇa tana mana kī,","ati amūlya sampati samatā kī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["कृष्णात्मिका कृष्ण सहचारिणि ।","चिन्मयवृन्दा विपिन विहारिणि ।","जगज्जननि जग दुःखनिवारिणि ।","आदि अनादि शक्ति विभुता की ॥४॥"],"c":"4","t":["kr̥ṣṇātmikā kr̥ṣṇa sahacāriṇi,","cinmayavr̥ndā vipina vihāriṇi,","jagajjanani jaga duḥkhanivāriṇi,","ādi anādi śakti vibhutā kī ॥4॥"]}],"topics":[{"id":"aarti.tek","hi":"आरती श्री वृषभानुसुता की","en":"Aarti Shri Vrishbhanu Suta Ki"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]}}