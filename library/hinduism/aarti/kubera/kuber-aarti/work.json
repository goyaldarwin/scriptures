{"id":"kuber-aarti","lang":"hi","title":{"hi":"ॐ जै यक्ष कुबेर हरे","en":"Om Jai Yaksha Kuber Hare"},"by":{"hi":"कुबेर","en":"Kuber"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"ॐ जै यक्ष कुबेर हरे","en":"Om Jai Yaksha Kuber Hare"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["ॐ जै यक्ष कुबेर हरे ।","स्वामी जै यक्ष जै यक्ष कुबेर हरे ।","शरण पड़े भगतों के ।","भण्डार कुबेर भरे ॥"],"c":"","t":["oṁ jai yakṣa kubera hare,","svāmī jai yakṣa jai yakṣa kubera hare,","śaraṇa paṛe bhagatoṁ ke,","bhaṇḍāra kubera bhare."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["शिव भक्तों में भक्त कुबेर बड़े ।","स्वामी भक्त कुबेर बड़े ।","दैत्य दानव मानव से ।","कई-कई युद्ध लड़े ॥१॥"],"c":"1","t":["śiva bhaktoṁ meṁ bhakta kubera baṛe,","svāmī bhakta kubera baṛe,","daitya dānava mānava se,","kaī-kaī yuddha laṛe ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["स्वर्ण सिंहासन बैठे ।","सिर पर छत्र फिरे ।","स्वामी सिर पर छत्र फिरे ।","योगिनी मंगल गावैं ।","सब जय जय कार करैं ॥२॥"],"c":"2","t":["svarṇa siṁhāsana baiṭhe,","sira para chatra phire,","svāmī sira para chatra phire,","yoginī maṁgala gāvaiṁ,","saba jaya jaya kāra karaiṁ ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["गदा त्रिशूल हाथ में ।","शस्त्र बहुत धरे ।","स्वामी शस्त्र बहुत धरे ।","दुख भय संकट मोचन ।","धनुष टंकार करें ॥३॥"],"c":"3","t":["gadā triśūla hātha meṁ,","śastra bahuta dhare,","svāmī śastra bahuta dhare,","dukha bhaya saṁkaṭa mocana,","dhanuṣa ṭaṁkāra kareṁ ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["भाँति भाँति के व्यंजन बहुत बने ।","स्वामी व्यंजन बहुत बने ।","मोहन भोग लगावैं ।","साथ में उड़द चने ॥४॥"],"c":"4","t":["bhām̐ti bhām̐ti ke vyaṁjana bahuta bane,","svāmī vyaṁjana bahuta bane,","mohana bhoga lagāvaiṁ,","sātha meṁ uṛada cane ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["बल बुद्धि विद्या दाता ।","हम तेरी शरण पड़े ।","स्वामी हम तेरी शरण पड़े ।","अपने भक्त जनों के ।","सारे काम संवारे ॥५॥"],"c":"5","t":["bala buddhi vidyā dātā,","hama terī śaraṇa paṛe,","svāmī hama terī śaraṇa paṛe,","apane bhakta janoṁ ke,","sāre kāma saṁvāre ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["मुकुट मणी की शोभा ।","मोतियन हार गले ।","स्वामी मोतियन हार गले ।","अगर कपूर की बाती ।","घी की जोत जले ॥६॥"],"c":"6","t":["mukuṭa maṇī kī śobhā,","motiyana hāra gale,","svāmī motiyana hāra gale,","agara kapūra kī bātī,","ghī kī jota jale ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["यक्ष कुबेर जी की आरती ।","जो कोई नर गावे ।","स्वामी जो कोई नर गावे ।","कहत प्रेमपाल स्वामी ।","मनवांछित फल पावे ॥७॥"],"c":"7","t":["yakṣa kubera jī kī āratī,","jo koī nara gāve,","svāmī jo koī nara gāve,","kahata premapāla svāmī,","manavāṁchita phala pāve ॥7॥"]}],"topics":[{"id":"aarti.tek","hi":"ॐ जै यक्ष कुबेर हरे","en":"Om Jai Yaksha Kuber Hare"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"},"lines":true}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"},"lines":true}],"au":[]},"glossary":true}