{"id":"ramayan-aarti","lang":"awa","title":{"hi":"आरति श्रीरामायनजी की","en":"Aarti Shri Ramayanji Ki"},"by":{"hi":"श्रीरामायणजी","en":"Shri Ramayanji"},"edition":{"hi":"गीताप्रेस, गोरखपुर (श्रीरामचरितमानस)","en":"Gita Press, Gorakhpur (Shri Ramcharitmanas)"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"आरति श्रीरामायनजी की","en":"Aarti Shri Ramayanji Ki"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["आरति श्रीरामायनजी की ।","कीरति कलित ललित सिय पी की ॥"],"c":"","t":["ārati śrīrāmāyanajī kī,","kīrati kalita lalita siya pī kī."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["गावत ब्रह्मादिक मुनि नारद ।","बालमीक बिग्यान बिसारद ॥","सुक सनकादि सेष अरु सारद ।","बरनि पवनसुत कीरति नीकी ॥"],"c":"1","t":["gāvata brahmādika muni nārada,","bālamīka bigyāna bisārada.","suka sanakādi seṣa aru sārada,","barani pavanasuta kīrati nīkī."]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["गावत बेद पुरान अष्टदस ।","छओ सास्त्र सब ग्रंथन को रस ॥","मुनि जन धन संतन को सरबस ।","सार अंस संमत सबही की ॥"],"c":"2","t":["gāvata beda purāna aṣṭadasa,","chao sāstra saba graṁthana ko rasa.","muni jana dhana saṁtana ko sarabasa,","sāra aṁsa saṁmata sabahī kī."]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["गावत संतत संभु भवानी ।","अरु घटसंभव मुनि बिग्यानी ॥","ब्यास आदि कबिबर्ज बखानी ।","कागभुसुंडि गरुड के ही की ॥"],"c":"3","t":["gāvata saṁtata saṁbhu bhavānī,","aru ghaṭasaṁbhava muni bigyānī.","byāsa ādi kabibarja bakhānī,","kāgabhusuṁḍi garuḍa ke hī kī."]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["कलिमल हरनि बिषय रस फीकी ।","सुभग सिंगार मुक्ति जुबती की ॥","दलन रोग भव मूरि अमी की ।","तात मात सब बिधि तुलसी की ॥"],"c":"4","t":["kalimala harani biṣaya rasa phīkī,","subhaga siṁgāra mukti jubatī kī.","dalana roga bhava mūri amī kī,","tāta māta saba bidhi tulasī kī."]}],"topics":[{"id":"aarti.tek","hi":"आरति श्रीरामायनजी की","en":"Aarti Shri Ramayanji Ki"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[{"id":"kamlesh-upadhyay","file":"audio/kamlesh-upadhyay","title":{"hi":"पं. कमलेश उपाध्याय “हरिपुरी”","en":"Pt. Kamlesh Upadhyay “Haripuri”"}}]}}