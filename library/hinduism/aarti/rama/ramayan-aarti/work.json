{"id":"ramayan-aarti","lang":"hi","title":{"hi":"आरती श्री रामायण जी की","en":"Aarti Shri Ramayan Ji Ki"},"by":{"hi":"भगवान श्रीराम","en":"Bhagwan Shri Ram"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"आरती श्री रामायण जी की","en":"Aarti Shri Ramayan Ji Ki"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["आरती श्री रामायण जी की ।","कीरति कलित ललित सिय पी की ॥"],"c":"","t":["āratī śrī rāmāyaṇa jī kī,","kīrati kalita lalita siya pī kī."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["गावत ब्रह्मादिक मुनि नारद ।","वाल्मीकि विग्यान विसारद ।","सुक सनकादि शेष अरु सारद ।","बरनि पवनसुत कीरति नीकी ॥१॥"],"c":"1","t":["gāvata brahmādika muni nārada,","vālmīki vigyāna visārada,","suka sanakādi śeṣa aru sārada,","barani pavanasuta kīrati nīkī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["गावत वेद पुरान अष्टदस ।","छहों शास्त्र सब ग्रंथन को रस ।","मुनिजन धन संतन को सरबस ।","सार अंस संमत सबही की ॥२॥"],"c":"2","t":["gāvata veda purāna aṣṭadasa,","chahoṁ śāstra saba graṁthana ko rasa,","munijana dhana saṁtana ko sarabasa,","sāra aṁsa saṁmata sabahī kī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["गावत संतत संभु भवानी ।","अरु घटसंभव मुनि बिग्यानी ।","व्यास आदि कबिबर्ज बखानी ।","कागभुसुंडि गरुड़ के ही की ॥३॥"],"c":"3","t":["gāvata saṁtata saṁbhu bhavānī,","aru ghaṭasaṁbhava muni bigyānī,","vyāsa ādi kabibarja bakhānī,","kāgabhusuṁḍi garuṛa ke hī kī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["कलि मल हरनि विषयरस फीकी ।","सुभग सिंगार मुक्ति जुबती की ।","दलन रोग भव मूरि अमी की ।","तात मात सब विधि तुलसी की ॥४॥"],"c":"4","t":["kali mala harani viṣayarasa phīkī,","subhaga siṁgāra mukti jubatī kī,","dalana roga bhava mūri amī kī,","tāta māta saba vidhi tulasī kī ॥4॥"]}],"topics":[{"id":"aarti.tek","hi":"आरती श्री रा