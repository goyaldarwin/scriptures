{"id":"ganpati-seva-aarti","lang":"hi","title":{"hi":"गणपति की सेवा मंगल मेवा","en":"Ganpati Ki Seva Mangal Meva"},"by":{"hi":"भगवान श्री गणेश","en":"Bhagwan Shri Ganesh"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"गणपति की सेवा मंगल मेवा","en":"Ganpati Ki Seva Mangal Meva"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["गणपति की सेवा मंगल मेवा ।","सेवा से सब विघ्न टरैं ।","तीन लोक के सकल देवता ।","द्वार खड़े नित अर्ज करैं ॥"],"c":"","t":["gaṇapati kī sevā maṁgala mevā,","sevā se saba vighna ṭaraiṁ,","tīna loka ke sakala devatā,","dvāra khaṛe nita arja karaiṁ."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["रिद्धि-सिद्धि दक्षिण वाम विराजें ।","अरु आनन्द सों चमर करैं ।","धूप-दीप अरू लिए आरती ।","भक्त खड़े जयकार करैं ॥१॥"],"c":"1","t":["riddhi-siddhi dakṣiṇa vāma virājeṁ,","aru ānanda soṁ camara karaiṁ,","dhūpa-dīpa arū lie āratī,","bhakta khaṛe jayakāra karaiṁ ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["गुड़ के मोदक भोग लगत हैं ।","मूषक वाहन चढ्या सरैं ।","सौम्य रूप को देख गणपति के ।","विघ्न भाग जा दूर परैं ॥२॥"],"c":"2","t":["guṛa ke modaka bhoga lagata haiṁ,","mūṣaka vāhana caḍhyā saraiṁ,","saumya rūpa ko dekha gaṇapati ke,","vighna bhāga jā dūra paraiṁ ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["भादो मास अरु शुक्ल चतुर्थी ।","दिन दोपारा दूर परैं ।","लियो जन्म गणपति प्रभु जी ।","दुर्गा मन आनन्द भरैं ॥३॥"],"c":"3","t":["bhādo māsa aru śukla caturthī,","dina dopārā dūra paraiṁ,","liyo janma gaṇapati prabhu jī,","durgā mana ānanda bharaiṁ ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["अद्भुत बाजा बजा इन्द्र का ।","देव बंधु सब गान करैं ।","श्री शंकर के आनन्द उपज्या ।","नाम सुन्यो सब विघ्न टरैं ॥४॥"],"c":"4","t":["adbhuta bājā bajā indra kā,","deva baṁdhu saba gāna karaiṁ,","śrī śaṁkara ke ānanda upajyā,","nāma sunyo saba vighna ṭaraiṁ ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["आनि विधाता बैठे आसन ।","इन्द्र अप्सरा नृत्य करैं ।","देख वेद ब्रह्मा जी जाको ।","विघ्न विनाशक नाम धरैं ॥५॥"],"c":"5","t":["āni vidhātā baiṭhe āsana,","indra apsarā nr̥tya karaiṁ,","dekha veda brahmā jī jāko,","vighna vināśaka nāma dharaiṁ ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["एकदन्त गजवदन विनायक ।","त्रिनयन रूप अनूप धरैं ।","पगथंभा सा उदर पुष्ट है ।","देव चन्द्रमा हास्य करैं ॥६॥"],"c":"6","t":["ekadanta gajavadana vināyaka,","trinayana rūpa anūpa dharaiṁ,","pagathaṁbhā sā udara puṣṭa hai,","deva candramā hāsya karaiṁ ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["दे शराप श्री चन्द्रदेव को ।","कलाहीन तत्काल करैं ।","चौदह लोक में फिरें गणपति ।","तीन लोक में राज्य करैं ॥७॥"],"c":"7","t":["de śarāpa śrī candradeva ko,","kalāhīna tatkāla karaiṁ,","caudaha loka meṁ phireṁ gaṇapati,","tīna loka meṁ rājya karaiṁ ॥7॥"]},{"id":"aarti.pad8","p":0,"s":"aarti","y":"pad","n":"8","v":["उठि प्रभात जप करैं ध्यान कोई ।","ताके कारज सर्व सरैं ।","पूजा काल आरती गावैं ।","ताके शिर यश छत्र फिरैं ॥८॥"],"c":"8","t":["uṭhi prabhāta japa karaiṁ dhyāna koī,","tāke kāraja sarva saraiṁ,","pūjā kāla āratī gāvaiṁ,","tāke śira yaśa chatra phiraiṁ ॥8॥"]},{"id":"aarti.pad9","p":0,"s":"aarti","y":"pad","n":"9","v":["गणपति की पूजा पहले करने से ।","काम सभी निर्विघ्न सरैं ।","सभी भक्त गणपति जी के ।","हाथ जोड़कर स्तुति करैं ॥९॥"],"c":"9","t":["gaṇapati kī pūjā pahale karane se,","kāma sabhī nirvighna saraiṁ,","sabhī bhakta gaṇapati jī ke,","hātha joṛakara stuti karaiṁ ॥9॥"]}],"topics":[{"id":"aarti.tek","hi":"गणपति की सेवा मंगल मेवा","en":"Ganpati Ki Seva Mangal Meva"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]},"glossary":true}