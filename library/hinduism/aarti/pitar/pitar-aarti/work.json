{"id":"pitar-aarti","lang":"hi","title":{"hi":"जय जय पितरजी महाराज","en":"Jai Jai Pitarji Maharaj"},"by":{"hi":"पितर","en":"Pitars (the ancestors)"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"जय जय पितरजी महाराज","en":"Jai Jai Pitarji Maharaj"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["जय जय पितरजी महाराज ।","मैं शरण पड़यो हूँ थारी ।","शरण पड़यो हूँ थारी बाबा ।","शरण पड़यो हूँ थारी ॥"],"c":"","t":["jaya jaya pitarajī mahārāja,","maiṁ śaraṇa paṛayo hūm̐ thārī,","śaraṇa paṛayo hūm̐ thārī bābā,","śaraṇa paṛayo hūm̐ thārī."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["आप ही रक्षक आप ही दाता ।","आप ही खेवनहारे ।","मैं मूरख हूँ कछु नहि जाणू ।","आप ही हो रखवारे ॥१॥"],"c":"1","t":["āpa hī rakṣaka āpa hī dātā,","āpa hī khevanahāre,","maiṁ mūrakha hūm̐ kachu nahi jāṇū,","āpa hī ho rakhavāre ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["आप खड़े हैं हरदम हर घड़ी ।","करने मेरी रखवारी ।","हम सब जन हैं शरण आपकी ।","है ये अरज गुजारी ॥२॥"],"c":"2","t":["āpa khaṛe haiṁ haradama hara ghaṛī,","karane merī rakhavārī,","hama saba jana haiṁ śaraṇa āpakī,","hai ye araja gujārī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["देश और परदेश सब जगह ।","आप ही करो सहाई ।","काम पड़े पर नाम आपको ।","लगे बहुत सुखदाई ॥३॥"],"c":"3","t":["deśa aura paradeśa saba jagaha,","āpa hī karo sahāī,","kāma paṛe para nāma āpako,","lage bahuta sukhadāī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["भक्त सभी हैं शरण आपकी ।","अपने सहित परिवार ।","रक्षा करो आप ही सबकी ।","रटूँ मैं बारम्बार ॥४॥"],"c":"4","t":["bhakta sabhī haiṁ śaraṇa āpakī,","apane sahita parivāra,","rakṣā karo āpa hī sabakī,","raṭūm̐ maiṁ bārambāra ॥4॥"]}],"topics":[{"id":"aarti.tek","hi":"जय जय पितरजी महाराज","en":"Jai Jai Pitarji Maharaj"}],"sources":{"hi":[{"id":