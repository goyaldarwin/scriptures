{"id":"durga-aarti","lang":"hi","title":{"hi":"अम्बे तू है जगदम्बे काली","en":"Ambe Tu Hai Jagdambe Kali"},"by":{"hi":"माँ दुर्गा","en":"Mother Durga"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"अम्बे तू है जगदम्बे काली","en":"Ambe Tu Hai Jagdambe Kali"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["अम्बे तू है जगदम्बे काली ।","जय दुर्गे खप्पर वाली ।","तेरे ही गुन गायें भारती ।","ओ मैया हम सब उतारें तेरी आरती ॥"],"c":"","t":["ambe tū hai jagadambe kālī,","jaya durge khappara vālī,","tere hī guna gāyeṁ bhāratī,","o maiyā hama saba utāreṁ terī āratī."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["तेरे भक्त जनों पर माता ।","भीर पड़ी है भारी ।","दानव दल पर टूट पड़ो माँ ।","करके सिंह सवारी ।","सौ सौ सिंहों से बलशाली ।","है अष्ट भुजाओं वाली ।","दुखियों के दुखड़े निवारती ॥१॥"],"c":"1","t":["tere bhakta janoṁ para mātā,","bhīra paṛī hai bhārī,","dānava dala para ṭūṭa paṛo mām̐,","karake siṁha savārī,","sau sau siṁhoṁ se balaśālī,","hai aṣṭa bhujāoṁ vālī,","dukhiyoṁ ke dukhaṛe nivāratī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["मां बेटे का है इस जग में ।","बड़ा ही निर्मल नाता ।","पूत कपूत सुने हैं ।","पर ना माता सुनी कुमाता ।","सब पर करुणा दरसाने वाली ।","अमृत बरसाने वाली ।","दुखियों के दुखड़े निवारती ॥२॥"],"c":"2","t":["māṁ beṭe kā hai isa jaga meṁ,","baṛā hī nirmala nātā,","pūta kapūta sune haiṁ,","para nā mātā sunī kumātā,","saba para karuṇā darasāne vālī,","amr̥ta barasāne vālī,","dukhiyoṁ ke dukhaṛe nivāratī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["नहीं मांगते धन और दौलत ।","ना चांदी ना सोना ।","हम तो मांगे माँ तेरे मन में ।","एक छोटा सा कोना ।","सबकी बिगड़ी बनाने वाली ।","लाज बचाने वाली ।","सतियों के सत को संवारती ॥३॥"],"c":"3","t":["nahīṁ māṁgate dhana aura daulata,","nā cāṁdī nā sonā,","hama to māṁge mām̐ tere mana meṁ,","eka choṭā sā konā,","sabakī bigaṛī banāne vālī,","lāja bacāne vālī,","satiyoṁ ke sata ko saṁvāratī ॥3॥"]}],"topics":[{"id":"aarti.tek","hi":"अम्बे तू है जगदम्बे काली","en":"Ambe Tu Hai Jagdambe Kali"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"},"lines":true}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"},"lines":true}],"au":[{"id":"anuradha-paudwal","file":"audio/anuradha-paudwal","title":{"hi":"अनुराधा पौडवाल","en":"Anuradha Paudwal"}}]},"glossary":true}