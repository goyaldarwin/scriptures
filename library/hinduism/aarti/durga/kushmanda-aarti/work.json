{"id":"kushmanda-aarti","lang":"hi","title":{"hi":"कूष्माण्डा जय जग सुखदानी","en":"Kushmanda Jai Jag Sukhdani"},"by":{"hi":"माँ दुर्गा","en":"Mother Durga"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"कूष्माण्डा जय जग सुखदानी","en":"Kushmanda Jai Jag Sukhdani"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["कूष्माण्डा जय जग सुखदानी ।","मुझ पर दया करो महारानी ।","पिङ्गला ज्वालामुखी निराली ।","शाकम्बरी माँ भोली भाली ॥१॥"],"c":"1","t":["kūṣmāṇḍā jaya jaga sukhadānī,","mujha para dayā karo mahārānī,","piṅgalā jvālāmukhī nirālī,","śākambarī mām̐ bholī bhālī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["लाखों नाम निराले तेरे ।","भक्त कई मतवाले तेरे ।","भीमा पर्वत पर है डेरा ।","स्वीकारो प्रणाम ये मेरा ॥२॥"],"c":"2","t":["lākhoṁ nāma nirāle tere,","bhakta kaī matavāle tere,","bhīmā parvata para hai ḍerā,","svīkāro praṇāma ye merā ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["सबकी सुनती हो जगदम्बे ।","सुख पहुँचती हो माँ अम्बे ।","तेरे दर्शन का मैं प्यासा ।","पूर्ण कर दो मेरी आशा ॥३॥"],"c":"3","t":["sabakī sunatī ho jagadambe,","sukha pahum̐catī ho mām̐ ambe,","tere darśana kā maiṁ pyāsā,","pūrṇa kara do merī āśā ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["माँ के मन में ममता भारी ।","क्यों ना सुनेगी अरज हमारी ।","तेरे दर पर किया है डेरा ।","दूर करो माँ संकट मेरा ॥४॥"],"c":"4","t":["mām̐ ke mana meṁ mamatā bhārī,","kyoṁ nā sunegī araja hamārī,","tere dara para kiyā hai ḍerā,","dūra karo mām̐ saṁkaṭa merā ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["मेरे कारज पूरे कर दो ।","मेरे तुम भण्डारे भर दो ।","तेरा दास तुझे ही ध्याये ।","भक्त तेरे दर शीश झुकाये ॥५॥"],"c":"5","t":["mere kāraja pūre kara do,","mere tuma bhaṇḍāre bhara do,","terā dāsa tujhe hī dhyāye,","bhakta tere dara śīśa jhukāye ॥