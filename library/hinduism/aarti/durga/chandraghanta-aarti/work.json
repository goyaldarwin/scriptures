{"id":"chandraghanta-aarti","lang":"hi","title":{"hi":"जय माँ चन्द्रघण्टा सुख धाम","en":"Jai Maa Chandraghanta Sukh Dham"},"by":{"hi":"माँ दुर्गा","en":"Mother Durga"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"जय माँ चन्द्रघण्टा सुख धाम","en":"Jai Maa Chandraghanta Sukh Dham"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["जय माँ चन्द्रघण्टा सुख धाम ।","पूर्ण कीजो मेरे काम ।","चन्द्र समान तू शीतल दाती ।","चन्द्र तेज किरणों में समाती ॥१॥"],"c":"1","t":["jaya mām̐ candraghaṇṭā sukha dhāma,","pūrṇa kījo mere kāma,","candra samāna tū śītala dātī,","candra teja kiraṇoṁ meṁ samātī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["मन की मालक मन भाती हो ।","चन्द्रघण्टा तुम वर दाती हो ।","सुन्दर भाव को लाने वाली ।","हर संकट में बचाने वाली ॥२॥"],"c":"2","t":["mana kī mālaka mana bhātī ho,","candraghaṇṭā tuma vara dātī ho,","sundara bhāva ko lāne vālī,","hara saṁkaṭa meṁ bacāne vālī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["हर बुधवार जो तुझे ध्याये ।","श्रद्धा सहित जो विनय सुनाये ।","मूर्ति चन्द्र आकार बनाये ।","सन्मुख घी की ज्योत जलाये ॥३॥"],"c":"3","t":["hara budhavāra jo tujhe dhyāye,","śraddhā sahita jo vinaya sunāye,","mūrti candra ākāra banāye,","sanmukha ghī kī jyota jalāye ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["शीश झुका कहे मन की बाता ।","पूर्ण आस करो जगत दाता ।","कांचीपुर स्थान तुम्हारा ।","कर्नाटिका में मान तुम्हारा ॥४॥"],"c":"4","t":["śīśa jhukā kahe mana kī bātā,","pūrṇa āsa karo jagata dātā,","kāṁcīpura sthāna tumhārā,","karnāṭikā meṁ māna tumhārā ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["नाम तेरा रटू महारानी ।","भक्त की रक्षा करो भवानी ॥५॥"],"c":"5","t":["nāma terā raṭū mahārānī,","bhakta kī rakṣā karo bhavānī ॥5॥"]}],"topics":[{"id":"aarti.pad1","hi":"जय माँ चन्द्रघण्टा सुख धाम","en":"Jai Maa Chandraghanta Sukh Dham"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"},"lines":true}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"},"lines":true}],"au":[{"id":"bhakti-dhaara","file":"audio/bhakti-dhaara","title":{"hi":"भक्ति धारा","en":"Bhakti Dhaara"}}]},"glossary":true}