{"id":"skandamata-aarti","lang":"hi","title":{"hi":"जय तेरी हो स्कन्द माता","en":"Jai Teri Ho Skand Mata"},"by":{"hi":"माँ दुर्गा","en":"Mother Durga"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"जय तेरी हो स्कन्द माता","en":"Jai Teri Ho Skand Mata"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["जय तेरी हो स्कन्द माता ।","पाँचवाँ नाम तुम्हारा आता ।","सबके मन की जानन हारी ।","जग जननी सबकी महतारी ॥१॥"],"c":"1","t":["jaya terī ho skanda mātā,","pām̐cavām̐ nāma tumhārā ātā,","sabake mana kī jānana hārī,","jaga jananī sabakī mahatārī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["तेरी जोत जलाता रहूँ मैं ।","हरदम तुझे ध्याता रहूँ मैं ।","कई नामों से तुझे पुकारा ।","मुझे एक है तेरा सहारा ॥२॥"],"c":"2","t":["terī jota jalātā rahūm̐ maiṁ,","haradama tujhe dhyātā rahūm̐ maiṁ,","kaī nāmoṁ se tujhe pukārā,","mujhe eka hai terā sahārā ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["कहीं पहाड़ों पर है डेरा ।","कई शहरों में तेरा बसेरा ।","हर मन्दिर में तेरे नजारे ।","गुण गाये तेरे भक्त प्यारे ॥३॥"],"c":"3","t":["kahīṁ pahāṛoṁ para hai ḍerā,","kaī śaharoṁ meṁ terā baserā,","hara mandira meṁ tere najāre,","guṇa gāye tere bhakta pyāre ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["भक्ति अपनी मुझे दिला दो ।","शक्ति मेरी बिगड़ी बना दो ।","इन्द्र आदि देवता मिल सारे ।","करे पुकार तुम्हारे द्वारे ॥४॥"],"c":"4","t":["bhakti apanī mujhe dilā do,","śakti merī bigaṛī banā do,","indra ādi devatā mila sāre,","kare pukāra tumhāre dvāre ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["दुष्ट दैत्य जब चढ़ कर आये ।","तू ही खण्डा हाथ उठाये ।","दासों को सदा बचाने आयी ।","भक्त की आस पुजाने आयी ॥५॥"],"c":"5","t":["duṣṭa daitya jaba caṛha kara āye,","tū hī khaṇḍā hātha uṭhāye,","dāsoṁ ko sadā bacāne āyī,","bhakta kī āsa pujāne āyī ॥5॥"]}],"topics":[{"id":"aarti.pad1","hi":"जय तेरी हो स्कन्द माता","en":"Jai Teri Ho Skand Mata"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]}}