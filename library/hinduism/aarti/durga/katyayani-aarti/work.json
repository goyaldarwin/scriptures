{"id":"katyayani-aarti","lang":"hi","title":{"hi":"जय जय अम्बे जय कात्यायनी","en":"Jai Jai Ambe Jai Katyayani"},"by":{"hi":"माँ दुर्गा","en":"Mother Durga"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"जय जय अम्बे जय कात्यायनी","en":"Jai Jai Ambe Jai Katyayani"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["जय जय अम्बे जय कात्यायनी ।","जय जग माता जग की महारानी ।","बैजनाथ स्थान तुम्हारा ।","वहाँ वरदाती नाम पुकारा ॥१॥"],"c":"1","t":["jaya jaya ambe jaya kātyāyanī,","jaya jaga mātā jaga kī mahārānī,","baijanātha sthāna tumhārā,","vahām̐ varadātī nāma pukārā ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["कई नाम हैं कई धाम हैं ।","यह स्थान भी तो सुखधाम है ।","हर मन्दिर में ज्योत तुम्हारी ।","कही योगेश्वरी महिमा न्यारी ॥२॥"],"c":"2","t":["kaī nāma haiṁ kaī dhāma haiṁ,","yaha sthāna bhī to sukhadhāma hai,","hara mandira meṁ jyota tumhārī,","kahī yogeśvarī mahimā nyārī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["हर जगह उत्सव होते रहते ।","हर मन्दिर में भगत है कहते ।","कत्यानी रक्षक काया की ।","ग्रन्थि काटे मोह माया की ॥३॥"],"c":"3","t":["hara jagaha utsava hote rahate,","hara mandira meṁ bhagata hai kahate,","katyānī rakṣaka kāyā kī,","granthi kāṭe moha māyā kī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["झूठे मोह से छुड़ाने वाली ।","अपना नाम जपाने वाली ।","बृहस्पतिवार को पूजा करिये ।","ध्यान कात्यानी का धरिये ॥४॥"],"c":"4","t":["jhūṭhe moha se chuṛāne vālī,","apanā nāma japāne vālī,","br̥haspativāra ko pūjā kariye,","dhyāna kātyānī kā dhariye ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["हर संकट को दूर करेगी ।","भण्डारे भरपूर करेगी ।","जो भी माँ को भक्त पुकारे ।","कात्यायनी सब कष्ट निवारे ॥५॥"],"c":"5","t":["hara saṁkaṭa ko dūra karegī,","bhaṇḍāre bharapūra karegī,","jo bhī mām̐ ko bhakta pukāre,","kātyāyanī saba kaṣṭa nivāre ॥5॥"]}],"topics":[{"id":"aarti.pad1","hi":"जय जय अम्बे जय कात्यायनी","en":"Jai Jai Ambe Jai Katyayani"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]},"glossary":true}