{"id":"brahmacharini-aarti","lang":"hi","title":{"hi":"जय अम्बे ब्रह्मचारिणी माता","en":"Jai Ambe Brahmacharini Mata"},"by":{"hi":"माँ दुर्गा","en":"Mother Durga"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"जय अम्बे ब्रह्मचारिणी माता","en":"Jai Ambe Brahmacharini Mata"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["जय अम्बे ब्रह्मचारिणी माता ।","जय चतुरानन प्रिय सुख दाता ।","ब्रह्मा जी के मन भाती हो ।","ज्ञान सभी को सिखलाती हो ॥१॥"],"c":"1","t":["jaya ambe brahmacāriṇī mātā,","jaya caturānana priya sukha dātā,","brahmā jī ke mana bhātī ho,","jñāna sabhī ko sikhalātī ho ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["ब्रह्म मन्त्र है जाप तुम्हारा ।","जिसको जपे सरल संसारा ।","जय गायत्री वेद की माता ।","जो जन जिस दिन तुम्हें ध्याता ॥२॥"],"c":"2","t":["brahma mantra hai jāpa tumhārā,","jisako jape sarala saṁsārā,","jaya gāyatrī veda kī mātā,","jo jana jisa dina tumheṁ dhyātā ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["कमी कोई रहने ना पाये ।","कोई भी दुख सहने न पाये ।","उसकी विरति रहे ठिकाने ।","जो तेरी महिमा को जाने ॥३॥"],"c":"3","t":["kamī koī rahane nā pāye,","koī bhī dukha sahane na pāye,","usakī virati rahe ṭhikāne,","jo terī mahimā ko jāne ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["रुद्राक्ष की माला ले कर ।","जपे जो मन्त्र श्रद्धा दे कर ।","आलस छोड़ करे गुणगाना ।","माँ तुम उसको सुख पहुँचाना ॥४॥"],"c":"4","t":["rudrākṣa kī mālā le kara,","jape jo mantra śraddhā de kara,","ālasa choṛa kare guṇagānā,","mām̐ tuma usako sukha pahum̐cānā ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["ब्रह्मचारिणी तेरो नाम ।","पूर्ण करो सब मेरे काम ।","भक्त तेरे चरणों का पुजारी ।","रखना लाज मेरी महतारी ॥५॥"],"c":"5","t":["brahmacāriṇī tero nāma,","pūrṇa karo saba mere kāma,","bhakta tere caraṇoṁ kā pujārī,","rakhanā lāja merī mahatārī ॥5॥"]}],"topics":[{"id":"aarti.pad1","hi":"जय अम्बे ब्रह्मचारिणी माता","en":"Jai Ambe Brahmacharini Mata"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]}}