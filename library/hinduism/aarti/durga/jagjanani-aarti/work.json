{"id":"jagjanani-aarti","lang":"hi","title":{"hi":"जगजननी जय जय","en":"Jagjanani Jai Jai"},"by":{"hi":"माँ दुर्गा","en":"Mother Durga"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"जगजननी जय जय","en":"Jagjanani Jai Jai"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["जगजननी जय जय ।","भयहारिणि भवतारिणि भवभामिनि जय जय ॥"],"c":"","t":["jagajananī jaya jaya,","bhayahāriṇi bhavatāriṇi bhavabhāmini jaya jaya."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["तू ही सत-चित-सुखमय शुद्ध ब्रह्मरूपा ।","सत्य सनातन सुन्दर पर-शिव सुर-भूपा ॥१॥"],"c":"1","t":["tū hī sata-cita-sukhamaya śuddha brahmarūpā,","satya sanātana sundara para-śiva sura-bhūpā ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["आदि अनादि अनामय अविचल अविनाशी ।","अमल अनन्त अगोचर अज आनँदराशी ॥२॥"],"c":"2","t":["ādi anādi anāmaya avicala avināśī,","amala ananta agocara aja ānam̐darāśī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["अविकारी अघहारी अकल कलाधारी ।","कर्त्ता विधि भर्त्ता हरि हर सँहारकारी ॥३॥"],"c":"3","t":["avikārī aghahārī akala kalādhārī,","karttā vidhi bharttā hari hara sam̐hārakārī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["तू विधिवधू रमा तू उमा महामाया ।","मूल प्रकृति विद्या तू तू जननी जाया ॥४॥"],"c":"4","t":["tū vidhivadhū ramā tū umā mahāmāyā,","mūla prakr̥ti vidyā tū tū jananī jāyā ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["राम कृष्ण तू सीता व्रजरानी राधा ।","तू वांछाकल्पद्रुम हारिणि सब बाधा ॥५॥"],"c":"5","t":["rāma kr̥ṣṇa tū sītā vrajarānī rādhā,","tū vāṁchākalpadruma hāriṇi saba bādhā ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["दश विद्या नव दुर्गा नानाशस्त्रकरा ।","अष्टमातृका योगिनि नव नव रूप धरा ॥६॥"],"c":"6","t":["daśa vidyā nava durgā nānāśastrakarā,","aṣṭamātr̥kā yogini nava nava rūpa dharā ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["तू परधामनिवासिनि महाविलासिनि तू ।","तू ही श्मशानविहारिणि ताण्डवलासिनि तू ॥७॥"],"c":"7","t":["tū paradhāmanivāsini mahāvilāsini tū,","tū hī śmaśānavihāriṇi tāṇḍavalāsini tū ॥7॥"]},{"id":"aarti.pad8","p":0,"s":"aarti","y":"pad","n":"8","v":["सुर-मुनि-मोहिनि सौम्या तू शोभाऽऽधारा ।","विवसन विकट-सरुपा प्रलयमयी धारा ॥८॥"],"c":"8","t":["sura-muni-mohini saumyā tū śobhā’’dhārā,","vivasana vikaṭa-sarupā pralayamayī dhārā ॥8॥"]},{"id":"aarti.pad9","p":0,"s":"aarti","y":"pad","n":"9","v":["तू ही स्नेह-सुधामयि तू अति गरलमना ।","रत्नविभूषित तू ही तू ही अस्थि-तना ॥९॥"],"c":"9","t":["tū hī sneha-sudhāmayi tū ati garalamanā,","ratnavibhūṣita tū hī tū hī asthi-tanā ॥9॥"]},{"id":"aarti.pad10","p":0,"s":"aarti","y":"pad","n":"10","v":["मूलाधारनिवासिनि इह-पर-सिद्धिप्रदे ।","कालातीता काली कमला तू वरदे ॥१०॥"],"c":"10","t":["mūlādhāranivāsini iha-para-siddhiprade,","kālātītā kālī kamalā tū varade ॥10॥"]},{"id":"aarti.pad11","p":0,"s":"aarti","y":"pad","n":"11","v":["शक्ति शक्तिधर तू ही नित्य अभेदमयी ।","भेदप्रदर्शिनि वाणी विमले वेदत्रयी ॥११॥"],"c":"11","t":["śakti śaktidhara tū hī nitya abhedamayī,","bhedapradarśini vāṇī vimale vedatrayī ॥11॥"]},{"id":"aarti.pad12","p":0,"s":"aarti","y":"pad","n":"12","v":["हम अति दीन दुखी मा विपत-जाल घेरे ।","हैं कपूत अति कपटी पर बालक तेरे ॥१२॥"],"c":"12","t":["hama ati dīna dukhī mā vipata-jāla ghere,","haiṁ kapūta ati kapaṭī para bālaka tere ॥12॥"]},{"id":"aarti.pad13","p":0,"s":"aarti","y":"pad","n":"13","v":["निज स्वभाववश जननी दयादृष्टि कीजै ।","करुणा कर करुणामयि चरण-शरण दीजै ॥१३॥"],"c":"13","t":["nija svabhāvavaśa jananī dayādr̥ṣṭi kījai,","karuṇā kara karuṇāmayi caraṇa-śaraṇa dījai ॥13॥"]}],"topics":[{"id":"aarti.tek","hi":"जगजननी जय जय","en":"Jagjanani Jai Jai"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]}}