{"id":"shailputri-aarti","lang":"hi","title":{"hi":"शैलपुत्री माँ बैल असवार","en":"Shailputri Maa Bail Asvar"},"by":{"hi":"माँ दुर्गा","en":"Mother Durga"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"शैलपुत्री माँ बैल असवार","en":"Shailputri Maa Bail Asvar"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["शैलपुत्री माँ बैल असवार ।","करें देवता जय जयकार ।","शिव-शंकर की प्रिय भवानी ।","तेरी महिमा किसी ने न जानी ॥१॥"],"c":"1","t":["śailaputrī mām̐ baila asavāra,","kareṁ devatā jaya jayakāra,","śiva-śaṁkara kī priya bhavānī,","terī mahimā kisī ne na jānī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["पार्वती तू उमा कहलावे ।","जो तुझे सुमिरे सो सुख पावे ।","रिद्धि सिद्धि परवान करे तू ।","दया करे धनवान करे तू ॥२॥"],"c":"2","t":["pārvatī tū umā kahalāve,","jo tujhe sumire so sukha pāve,","riddhi siddhi paravāna kare tū,","dayā kare dhanavāna kare tū ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["सोमवार को शिव संग प्यारी ।","आरती जिसने तेरी उतारी ।","उसकी सगरी आस पुजा दो ।","सगरे दुःख तकलीफ मिटा दो ॥३॥"],"c":"3","t":["somavāra ko śiva saṁga pyārī,","āratī jisane terī utārī,","usakī sagarī āsa pujā do,","sagare duḥkha takalīpha miṭā do ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["घी का सुन्दर दीप जला के ।","गोला गरी का भोग लगा के ।","श्रद्धा भाव से मन्त्र जपायें ।","प्रेम सहित फिर शीश झुकायें ॥४॥"],"c":"4","t":["ghī kā sundara dīpa jalā ke,","golā garī kā bhoga lagā ke,","śraddhā bhāva se mantra japāyeṁ,","prema sahita phira śīśa jhukāyeṁ ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["जय गिरराज किशोरी अम्बे ।","शिव मुख चन्द्र चकोरी अम्बे ।","मनोकामना पूर्ण कर दो ।","चमन सदा सुख सम्पत्ति भर दो ॥५॥"],"c":"5","t":["jaya girarāja kiśorī ambe,","śiva mukha candra cakorī ambe,","manokāmanā pūrṇa kara do,","camana sadā sukha sampatti bhara do ॥5॥"]}],"topics":[{"id":"aarti.pad1","hi":"शैलपुत्री माँ बैल असवार","en":"Shailputri Maa Bail Asvar"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"},"lines":true}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"},"lines":true}],"au":[]},"glossary":true}