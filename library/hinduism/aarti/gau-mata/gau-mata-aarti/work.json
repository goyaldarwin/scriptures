{"id":"gau-mata-aarti","lang":"hi","title":{"hi":"आरती श्री गैया मैया की","en":"Aarti Shri Gaiya Maiya Ki"},"by":{"hi":"गौ माता","en":"Gau Mata"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"आरती श्री गैया मैया की","en":"Aarti Shri Gaiya Maiya Ki"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["आरती श्री गैया मैया की ।","आरती हरनि विश्वधैया की ॥"],"c":"","t":["āratī śrī gaiyā maiyā kī,","āratī harani viśvadhaiyā kī."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["अर्थकाम सद्धर्म प्रदायिनि ।","अविचल अमल मुक्तिपददायिनि ।","सुर मानव सौभाग्यविधायिनि ।","प्यारी पूज्य नंद छैया की ॥१॥"],"c":"1","t":["arthakāma saddharma pradāyini,","avicala amala muktipadadāyini,","sura mānava saubhāgyavidhāyini,","pyārī pūjya naṁda chaiyā kī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["अखिल विश्व प्रतिपालिनि माता ।","मधुर अमिय दुग्धान्न प्रदाता ।","रोग शोक संकट परित्राता ।","भवसागर हित दृढ़ नैया की ॥२॥"],"c":"2","t":["akhila viśva pratipālini mātā,","madhura amiya dugdhānna pradātā,","roga śoka saṁkaṭa paritrātā,","bhavasāgara hita dr̥ṛha naiyā kī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["आयु ओज आरोग्यविकाशिनि ।","दुख दैन्य दारिद्र्य विनाशिनि ।","सुष्मा सौख्य समृद्धि प्रकाशिनि ।","विमल विवेक बुद्धि दैया की ॥३॥"],"c":"3","t":["āyu oja ārogyavikāśini,","dukha dainya dāridrya vināśini,","suṣmā saukhya samr̥ddhi prakāśini,","vimala viveka buddhi daiyā kī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["सेवक हो चाहे दुखदाई ।","सम पय सुधा पियावति माई ।","शत्रु-मित्र सबको सुखदायी ।","स्नेह स्वभाव विश्व जैया की ॥४॥"],"c":"4","t":["sevaka ho cāhe dukhadāī,","sama paya sudhā piyāvati māī,","śatru-mitra sabako sukhadāyī,","sneha svabhāva viśva jaiyā kī ॥4॥"]}],"topics":[{"id":"aarti.tek","hi":"आरती श्री गैया मैया की","en