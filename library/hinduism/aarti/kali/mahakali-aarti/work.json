{"id":"mahakali-aarti","lang":"hi","title":{"hi":"मंगल की सेवा सुन मेरी देवा","en":"Mangal Ki Seva Sun Meri Deva"},"by":{"hi":"माँ काली","en":"Mother Kali"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"मंगल की सेवा सुन मेरी देवा","en":"Mangal Ki Seva Sun Meri Deva"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["मंगल की सेवा सुन मेरी देवा ।","हाथ जोड़ तेरे द्वार खड़े ।","पान सुपारी ध्वजा नारियल ।","ले ज्वाला तेरी भेंट धरे ।","सुन जगदम्बे कर न विलम्बे ।","संतन के भण्डार भरे ।","संतन-प्रतिपाली सदा खुशहाली ।","मैया जै काली कल्याण करे ॥"],"c":"","t":["maṁgala kī sevā suna merī devā,","hātha joṛa tere dvāra khaṛe,","pāna supārī dhvajā nāriyala,","le jvālā terī bheṁṭa dhare,","suna jagadambe kara na vilambe,","saṁtana ke bhaṇḍāra bhare,","saṁtana-pratipālī sadā khuśahālī,","maiyā jai kālī kalyāṇa kare."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["बुद्धि विधाता तू जग माता ।","मेरा कारज सिद्ध करे ।","चरण कमल का लिया आसरा ।","शरण तुम्हारी आन परे ।","जब-जब भीर पड़ी भक्तन पर ।","तब-तब आय सहाय करे ॥१॥"],"c":"1","t":["buddhi vidhātā tū jaga mātā,","merā kāraja siddha kare,","caraṇa kamala kā liyā āsarā,","śaraṇa tumhārī āna pare,","jaba-jaba bhīra paṛī bhaktana para,","taba-taba āya sahāya kare ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["बार-बार तैं सब जग मोहयो ।","तरुणी रूप अनूप धरे ।","माता होकर पुत्र खिलावे ।","कहीं भार्या भोग करे ।","सन्तन सुखदाई सदा सहाई ।","सन्त खड़े जयकार करे ॥२॥"],"c":"2","t":["bāra-bāra taiṁ saba jaga mohayo,","taruṇī rūpa anūpa dhare,","mātā hokara putra khilāve,","kahīṁ bhāryā bhoga kare,","santana sukhadāī sadā sahāī,","santa khaṛe jayakāra kare ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["ब्रह्मा विष्णु महेश सहसफण लिए ।","भेंट देन तेरे द्वार खड़े ।","अटल सिंहासन बैठी मेरी माता ।","सिर सोने का छत्र फिरे ।","वार शनिश्चर कुंकुम बरणो ।","जब लुँकड़ पर हुकुम करे ॥३॥"],"c":"3","t":["brahmā viṣṇu maheśa sahasaphaṇa lie,","bheṁṭa dena tere dvāra khaṛe,","aṭala siṁhāsana baiṭhī merī mātā,","sira sone kā chatra phire,","vāra śaniścara kuṁkuma baraṇo,","jaba lum̐kaṛa para hukuma kare ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["खड्ग खप्पर त्रिशूल हाथ लिए ।","रक्त बीज को भस्म करे ।","शुंभ निशुंभ को क्षण में मारे ।","महिषासुर को पकड़ दले ।","आदित वारी आदि भवानी ।","जन अपने का कष्ट हरे ॥४॥"],"c":"4","t":["khaḍga khappara triśūla hātha lie,","rakta bīja ko bhasma kare,","śuṁbha niśuṁbha ko kṣaṇa meṁ māre,","mahiṣāsura ko pakaṛa dale,","ādita vārī ādi bhavānī,","jana apane kā kaṣṭa hare ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["कुपित होय के दानव मारे ।","चण्ड मुण्ड सब चूर करे ।","जब तुम देखी दया रूप हो ।","पल में संकट दूर करे ।","सौम्य स्वभाव धरयो मेरी माता ।","जन की अर्ज कबूल करे ॥५॥"],"c":"5","t":["kupita hoya ke dānava māre,","caṇḍa muṇḍa saba cūra kare,","jaba tuma dekhī dayā rūpa ho,","pala meṁ saṁkaṭa dūra kare,","saumya svabhāva dharayo merī mātā,","jana kī arja kabūla kare ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["सात बार की महिमा बरनी ।","सब गुण कौन बखान करे ।","सिंह पीठ पर चढ़ी भवानी ।","अटल भवन में राज करे ।","दर्शन पावें मंगल गावें ।","सिद्ध साधक तेरी भेंट धरे ॥६॥"],"c":"6","t":["sāta bāra kī mahimā baranī,","saba guṇa kauna bakhāna kare,","siṁha pīṭha para caṛhī bhavānī,","aṭala bhavana meṁ rāja kare,","darśana pāveṁ maṁgala gāveṁ,","siddha sādhaka terī bheṁṭa dhare ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["ब्रह्मा वेद पढ़े तेरे द्वारे ।","शिव शंकर ध्यान धरे ।","इन्द्र कृष्ण तेरी करे आरती ।","चँवर कुबेर डुलाय रहे ।","जय जननी जय मातु भवानी ।","अचल भवन में राज करे ॥७॥"],"c":"7","t":["brahmā veda paṛhe tere dvāre,","śiva śaṁkara dhyāna dhare,","indra kr̥ṣṇa terī kare āratī,","cam̐vara kubera ḍulāya rahe,","jaya jananī jaya mātu bhavānī,","acala bhavana meṁ rāja kare ॥7॥"]}],"topics":[{"id":"aarti.tek","hi":"मंगल की सेवा सुन मेरी देवा","en":"Mangal Ki Seva Sun Meri Deva"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]}}