{"id":"bhairav-aarti","lang":"hi","title":{"hi":"सुनो जी भैरव लाड़िले","en":"Suno Ji Bhairav Ladile"},"by":{"hi":"भगवान भैरव","en":"Bhagwan Bhairav"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"सुनो जी भैरव लाड़िले","en":"Suno Ji Bhairav Ladile"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["सुनो जी भैरव लाड़िले ।","कर जोड़ कर विनती करूँ ।","कृपा तुम्हारी चाहिए ।","मैं ध्यान तुम्हारा ही धरूँ ॥"],"c":"","t":["suno jī bhairava lāṛile,","kara joṛa kara vinatī karūm̐,","kr̥pā tumhārī cāhie,","maiṁ dhyāna tumhārā hī dharūm̐."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["मैं चरण छूता आपके ।","अर्जी मेरी सुन लीजिये ।","मैं हूँ मति का मन्द ।","मेरी कुछ मदद तो कीजिये ।","महिमा तुम्हारी बहुत ।","कुछ थोड़ी सी मैं वर्णन करूँ ॥१॥"],"c":"1","t":["maiṁ caraṇa chūtā āpake,","arjī merī suna lījiye,","maiṁ hūm̐ mati kā manda,","merī kucha madada to kījiye,","mahimā tumhārī bahuta,","kucha thoṛī sī maiṁ varṇana karūm̐ ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["करते सवारी स्वान की ।","चारों दिशा में राज्य है ।","जितने भूत और प्रेत ।","सबके आप ही सरताज हैं ।","हथियार हैं जो आपके ।","उसका क्या वर्णन करूँ ॥२॥"],"c":"2","t":["karate savārī svāna kī,","cāroṁ diśā meṁ rājya hai,","jitane bhūta aura preta,","sabake āpa hī saratāja haiṁ,","hathiyāra haiṁ jo āpake,","usakā kyā varṇana karūm̐ ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["माता जी के सामने तुम ।","नृत्य भी करते सदा ।","गा गा के गुण अनुवाद से ।","उनको रिझाते हो सदा ।","एक सांकली है आपकी ।","तारीफ उसकी क्या करूँ ॥३॥"],"c":"3","t":["mātā jī ke sāmane tuma,","nr̥tya bhī karate sadā,","gā gā ke guṇa anuvāda se,","unako rijhāte ho sadā,","eka sāṁkalī hai āpakī,","tārīpha usakī kyā karūm̐ ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["बहुत सी महिमा तुम्हारी ।","मेंहदीपुर सरनाम है ।","आते जगत के यात्री ।","बजरंग का स्थान है ।","श्री प्रेतराज सरकार के ।","मैं शीश चरणों में धरूँ ॥४॥"],"c":"4","t":["bahuta sī mahimā tumhārī,","meṁhadīpura saranāma hai,","āte jagata ke yātrī,","bajaraṁga kā sthāna hai,","śrī pretarāja sarakāra ke,","maiṁ śīśa caraṇoṁ meṁ dharūm̐ ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["निशदिन तुम्हारे खेल से ।","माताजी खुश रहें ।","सिर पर तुम्हारे हाथ रख कर ।","आशीर्वाद देती रहें ।","कर जोड़ कर विनती करूँ ।","अरु शीश चरणों में धरूँ ॥५॥"],"c":"5","t":["niśadina tumhāre khela se,","mātājī khuśa raheṁ,","sira para tumhāre hātha rakha kara,","āśīrvāda detī raheṁ,","kara joṛa kara vinatī karūm̐,","aru śīśa caraṇoṁ meṁ dharūm̐ ॥5॥"]}],"topics":[{"id":"aarti.tek","hi":"सुनो जी भैरव लाड़िले","en":"Suno Ji Bhairav Ladile"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"},"lines":true}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"},"lines":true}],"au":[{"id":"brijwani","file":"audio/brijwani","title":{"hi":"बृजवाणी","en":"Brijwani"}}]}}