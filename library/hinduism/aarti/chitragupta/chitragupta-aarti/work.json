{"id":"chitragupta-aarti","lang":"hi","title":{"hi":"ॐ जय चित्रगुप्त हरे","en":"Om Jai Chitragupt Hare"},"by":{"hi":"भगवान चित्रगुप्त","en":"Bhagwan Chitragupta"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"ॐ जय चित्रगुप्त हरे","en":"Om Jai Chitragupt Hare"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["ॐ जय चित्रगुप्त हरे ।","स्वामी जय चित्रगुप्त हरे ।","भक्त जनों के इच्छित ।","फल को पूर्ण करे ॥"],"c":"","t":["oṁ jaya citragupta hare,","svāmī jaya citragupta hare,","bhakta janoṁ ke icchita,","phala ko pūrṇa kare."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["विघ्न विनाशक मंगलकर्ता ।","सन्तन सुखदायी ।","भक्तन के प्रतिपालक ।","त्रिभुवन यश छायी ॥१॥"],"c":"1","t":["vighna vināśaka maṁgalakartā,","santana sukhadāyī,","bhaktana ke pratipālaka,","tribhuvana yaśa chāyī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["रूप चतुर्भुज श्यामल मूरति ।","पीताम्बर राजै ।","मातु इरावती दक्षिणा ।","वाम अङ्ग साजै ॥२॥"],"c":"2","t":["rūpa caturbhuja śyāmala mūrati,","pītāmbara rājai,","mātu irāvatī dakṣiṇā,","vāma aṅga sājai ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["कष्ट निवारण दुष्ट संहारण ।","प्रभु अन्तर्यामी ।","सृष्टि संहारण जन दुःख हारण ।","प्रकट हुये स्वामी ॥३॥"],"c":"3","t":["kaṣṭa nivāraṇa duṣṭa saṁhāraṇa,","prabhu antaryāmī,","sr̥ṣṭi saṁhāraṇa jana duḥkha hāraṇa,","prakaṭa huye svāmī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["कलम दवात शङ्ख पत्रिका ।","कर में अति सोहै ।","वैजयन्ती वनमाला ।","त्रिभुवन मन मोहै ॥४॥"],"c":"4","t":["kalama davāta śaṅkha patrikā,","kara meṁ ati sohai,","vaijayantī vanamālā,","tribhuvana mana mohai ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["सिंहासन का कार्य सम्भाला ।","ब्रह्मा हर्षाये ।","तैंतीस कोटि देवता ।","चरणन में धाये ॥५॥"],"c":"5","t":["siṁhāsana kā kārya sambhālā,","brahmā harṣāye,","taiṁtīsa koṭi devatā,","caraṇana meṁ dhāye ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["नृपति सौदास भीष्म पितामह ।","याद तुम्हें कीन्हा ।","वेगि विलम्ब न लायो ।","इच्छित फल दीन्हा ॥६॥"],"c":"6","t":["nr̥pati saudāsa bhīṣma pitāmaha,","yāda tumheṁ kīnhā,","vegi vilamba na lāyo,","icchita phala dīnhā ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["दारा सुत भगिनी ।","सब अपने स्वास्थ के कर्ता ।","जाऊँ कहाँ शरण में किसकी ।","तुम तज मैं भर्ता ॥७॥"],"c":"7","t":["dārā suta bhaginī,","saba apane svāstha ke kartā,","jāūm̐ kahām̐ śaraṇa meṁ kisakī,","tuma taja maiṁ bhartā ॥7॥"]},{"id":"aarti.pad8","p":0,"s":"aarti","y":"pad","n":"8","v":["बन्धु पिता तुम स्वामी ।","शरण गहूँ किसकी ।","तुम बिन और न दूजा ।","आस करूँ जिसकी ॥८॥"],"c":"8","t":["bandhu pitā tuma svāmī,","śaraṇa gahūm̐ kisakī,","tuma bina aura na dūjā,","āsa karūm̐ jisakī ॥8॥"]},{"id":"aarti.pad9","p":0,"s":"aarti","y":"pad","n":"9","v":["जो जन चित्रगुप्त जी की आरती ।","प्रेम सहित गावैं ।","चौरासी से निश्चित छूटैं ।","इच्छित फल पावैं ॥९॥"],"c":"9","t":["jo jana citragupta jī kī āratī,","prema sahita gāvaiṁ,","caurāsī se niścita chūṭaiṁ,","icchita phala pāvaiṁ ॥9॥"]},{"id":"aarti.pad10","p":0,"s":"aarti","y":"pad","n":"10","v":["न्यायाधीश बैकुण्ठ निवासी ।","पाप पुण्य लिखते ।","हम हैं शरण तिहारी ।","आस न दूजी करते ॥१०॥"],"c":"10","t":["nyāyādhīśa baikuṇṭha nivāsī,","pāpa puṇya likhate,","hama haiṁ śaraṇa tihārī,","āsa na dūjī karate ॥10॥"]}],"topics":[{"id":"aarti.tek","hi":"ॐ जय चित्रगुप्त हरे","en":"Om Jai Chitragupt Hare"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]},"glossary":true}