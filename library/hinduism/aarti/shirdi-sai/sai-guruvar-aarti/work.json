{"id":"sai-guruvar-aarti","lang":"hi","title":{"hi":"आरती श्री साई गुरुवर की","en":"Aarti Shri Sai Guruvar Ki"},"by":{"hi":"शिर्डी साईबाबा","en":"Shirdi Sai Baba"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"आरती श्री साई गुरुवर की","en":"Aarti Shri Sai Guruvar Ki"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["आरती श्री साई गुरुवर की ।","परमानन्द सदा सुरवर की ।","जा की कृपा विपुल सुखकारी ।","दुःख शोक संकट भयहारी ॥"],"c":"","t":["āratī śrī sāī guruvara kī,","paramānanda sadā suravara kī,","jā kī kr̥pā vipula sukhakārī,","duḥkha śoka saṁkaṭa bhayahārī."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["शिर्डी में अवतार रचाया ।","चमत्कार से तत्त्व दिखाया ।","कितने भक्त चरण पर आये ।","वे सुख शान्ति चिरंतन पाये ॥१॥"],"c":"1","t":["śirḍī meṁ avatāra racāyā,","camatkāra se tattva dikhāyā,","kitane bhakta caraṇa para āye,","ve sukha śānti ciraṁtana pāye ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["भाव धरै जो मन में जैसा ।","पावत अनुभव वो ही वैसा ।","गुरु की उदी लगावे तन को ।","समाधान लाभत उस मन को ॥२॥"],"c":"2","t":["bhāva dharai jo mana meṁ jaisā,","pāvata anubhava vo hī vaisā,","guru kī udī lagāve tana ko,","samādhāna lābhata usa mana ko ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["साई नाम सदा जो गावे ।","सो फल जग में शाश्वत पावे ।","गुरुवासर करि पूजा-सेवा ।","उस पर कृपा करत गुरुदेवा ॥३॥"],"c":"3","t":["sāī nāma sadā jo gāve,","so phala jaga meṁ śāśvata pāve,","guruvāsara kari pūjā-sevā,","usa para kr̥pā karata gurudevā ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["राम कृष्ण हनुमान रूप में ।","दे दर्शन जानत जो मन में ।","विविध धर्म के सेवक आते ।","दर्शन कर इच्छित फल पाते ॥४॥"],"c":"4","t":["rāma kr̥ṣṇa hanumāna rūpa meṁ,","de darśana jānata jo mana meṁ,","vividha dharma ke sevaka āte,","darśana kara icchita phala pāte ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["जै बोलो साई बाबा की ।","जै बोलो अवधूत गुरु की ।","साईदास आरती को गावै ।","घर में बसि सुख मंगल पावे ॥५॥"],"c":"5","t":["jai bolo sāī bābā kī,","jai bolo avadhūta guru kī,","sāīdāsa āratī ko gāvai,","ghara meṁ basi sukha maṁgala pāve ॥5॥"]}],"topics":[{"id":"aarti.tek","hi":"आरती श्री साई गुरुवर की","en":"Aarti Shri Sai Guruvar Ki"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"},"lines":true}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"},"lines":true}],"au":[]},"glossary":true}