{"id":"pavansut-hanuman-aarti","lang":"hi","title":{"hi":"जयति मंगलागार","en":"Jayati Mangalagar"},"by":{"hi":"श्रीहनुमान","en":"Shri Hanuman"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"जयति मंगलागार","en":"Jayati Mangalagar"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["जयति मंगलागार संसार ।","भारापहर वानराकार विग्रह पुरारी ।","राम-रोषानल ज्वालमाला ।","मिषध्वान्तचर-सलभ-संहारकारी ॥१॥"],"c":"1","t":["jayati maṁgalāgāra saṁsāra,","bhārāpahara vānarākāra vigraha purārī,","rāma-roṣānala jvālamālā,","miṣadhvāntacara-salabha-saṁhārakārī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["जयति मरुदन्जनामोद-मन्दिर ।","नतग्रीवसुग्रीव-दुःखैकबन्धो ।","यातुधानोद्धत-क्रुद्ध-कालाग्निहर ।","सिद्ध-सुर-सज्जनानन्दसिन्धो ॥२॥"],"c":"2","t":["jayati marudanjanāmoda-mandira,","natagrīvasugrīva-duḥkhaikabandho,","yātudhānoddhata-kruddha-kālāgnihara,","siddha-sura-sajjanānandasindho ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["जयति रुद्राग्रणी विश्ववन्द्याग्रणी ।","विश्वविख्यात-भट-चक्रवर्ती ।","सामगाताग्रणी कामजेताग्रणी ।","रामहित रामभक्तानुवर्ती ॥३॥"],"c":"3","t":["jayati rudrāgraṇī viśvavandyāgraṇī,","viśvavikhyāta-bhaṭa-cakravartī,","sāmagātāgraṇī kāmajetāgraṇī,","rāmahita rāmabhaktānuvartī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["जयति संग्रामजय रामसन्देशहर ।","कौशला-कुशल-कल्याणभाषी ।","राम-विरहार्क-संतप्त-भरतादि ।","नर-नारि-शीतलकरणकल्पशाखी ॥४॥"],"c":"4","t":["jayati saṁgrāmajaya rāmasandeśahara,","kauśalā-kuśala-kalyāṇabhāṣī,","rāma-virahārka-saṁtapta-bharatādi,","nara-nāri-śītalakaraṇakalpaśākhī ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["जयति सिंहासनासीन सीतारमण ।","निरखि निर्भर हरष नृत्यकारी ।","राम संभ्राज शोभा-सहित सर्वदा ।","तुलसि-मानस-रामपुर-विहारी ॥५॥"],"c":"5","t":["jayati siṁhāsanāsīn