{"id":"mangal-murti-hanuman-aarti","lang":"hi","title":{"hi":"मंगल मूरति जय जय हनुमन्ता","en":"Mangal Murti Jai Jai Hanumanta"},"by":{"hi":"श्रीहनुमान","en":"Shri Hanuman"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"मंगल मूरति जय जय हनुमन्ता","en":"Mangal Murti Jai Jai Hanumanta"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["मंगल मूरति जय जय हनुमन्ता ।","मंगल-मंगल देव अनन्ता ॥"],"c":"","t":["maṁgala mūrati jaya jaya hanumantā,","maṁgala-maṁgala deva anantā."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["हाथ वज्र और ध्वजा विराजे ।","कांधे मूंज जनेऊ साजे ।","शंकर सुवन केसरी नन्दन ।","तेज प्रताप महा जग वन्दन ॥१॥"],"c":"1","t":["hātha vajra aura dhvajā virāje,","kāṁdhe mūṁja janeū sāje,","śaṁkara suvana kesarī nandana,","teja pratāpa mahā jaga vandana ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["लाल लंगोट लाल दोऊ नयना ।","पर्वत सम फारत है सेना ।","काल अकाल जुद्ध किलकारी ।","देश उजारत क्रुद्ध अपारी ॥२॥"],"c":"2","t":["lāla laṁgoṭa lāla doū nayanā,","parvata sama phārata hai senā,","kāla akāla juddha kilakārī,","deśa ujārata kruddha apārī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["रामदूत अतुलित बलधामा ।","अंजनि पुत्र पवनसुत नामा ।","महावीर विक्रम बजरंगी ।","कुमति निवार सुमति के संगी ॥३॥"],"c":"3","t":["rāmadūta atulita baladhāmā,","aṁjani putra pavanasuta nāmā,","mahāvīra vikrama bajaraṁgī,","kumati nivāra sumati ke saṁgī ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["भूमि पुत्र कंचन बरसावे ।","राजपाट पुर देश दिवावे ।","शत्रुन काट-काट महिं डारे ।","बन्धन व्याधि विपत्ति निवारें ॥४॥"],"c":"4","t":["bhūmi putra kaṁcana barasāve,","rājapāṭa pura deśa divāve,","śatruna kāṭa-kāṭa mahiṁ ḍāre,","bandhana vyādhi vipatti nivāreṁ ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["आपन तेज सम्हारो आपै ।","तीनों लोक हांक तें कांपै ।","सब सुख लहैं तुम्हारी शरणा ।","तुम रक्षक काहू को डरना ॥५॥"],"c":"5","t":["āpana teja samhāro āpai,","tīnoṁ loka hāṁka teṁ kāṁpai,","saba sukha lahaiṁ tumhārī śaraṇā,","tuma rakṣaka kāhū ko ḍaranā ॥5॥"]},{"id":"aarti.pad6","p":0,"s":"aarti","y":"pad","n":"6","v":["तुम्हरे भजन सकल संसारा ।","दया करो सुख दृष्टि अपारा ।","रामदण्ड कालहु को दण्डा ।","तुम्हरे परस होत जब खण्डा ॥६॥"],"c":"6","t":["tumhare bhajana sakala saṁsārā,","dayā karo sukha dr̥ṣṭi apārā,","rāmadaṇḍa kālahu ko daṇḍā,","tumhare parasa hota jaba khaṇḍā ॥6॥"]},{"id":"aarti.pad7","p":0,"s":"aarti","y":"pad","n":"7","v":["पवन पुत्र धरती के पूता ।","दोऊ मिल काज करो अवधूता ।","हर प्राणी शरणागत आये ।","चरण कमल में शीश नवाये ॥७॥"],"c":"7","t":["pavana putra dharatī ke pūtā,","doū mila kāja karo avadhūtā,","hara prāṇī śaraṇāgata āye,","caraṇa kamala meṁ śīśa navāye ॥7॥"]},{"id":"aarti.pad8","p":0,"s":"aarti","y":"pad","n":"8","v":["रोग शोक बहुत विपत्ति घिराने ।","दरिद्र दुःख बन्धन प्रकटाने ।","तुम तज और न मेटनहारा ।","दोऊ तुम हो महावीर अपारा ॥८॥"],"c":"8","t":["roga śoka bahuta vipatti ghirāne,","daridra duḥkha bandhana prakaṭāne,","tuma taja aura na meṭanahārā,","doū tuma ho mahāvīra apārā ॥8॥"]},{"id":"aarti.pad9","p":0,"s":"aarti","y":"pad","n":"9","v":["दारिद्र दहन ऋण त्रासा ।","करो रोग दुःख स्वप्न विनाशा ।","शत्रुन करो चरन के चेरे ।","तुम स्वामी हम सेवक तेरे ॥९॥"],"c":"9","t":["dāridra dahana r̥ṇa trāsā,","karo roga duḥkha svapna vināśā,","śatruna karo carana ke cere,","tuma svāmī hama sevaka tere ॥9॥"]},{"id":"aarti.pad10","p":0,"s":"aarti","y":"pad","n":"10","v":["विपत्ति हरण मंगल देवा ।","अङ्गीकार करो यह सेवा ।","मुदित भक्त विनती यह मोरी ।","देऊ महाधन लाख करोरी ॥१०॥"],"c":"10","t":["vipatti haraṇa maṁgala devā,","aṅgīkāra karo yaha sevā,","mudita bhakta vinatī yaha morī,","deū mahādhana lākha karorī ॥10॥"]},{"id":"aarti.pad11","p":0,"s":"aarti","y":"pad","n":"11","v":["श्री मंगल जी की आरती ।","हनुमत सहितासु गाई ।","होई मनोरथ सिद्ध जब ।","अन्त विष्णुपुर जाई ॥११॥"],"c":"11","t":["śrī maṁgala jī kī āratī,","hanumata sahitāsu gāī,","hoī manoratha siddha jaba,","anta viṣṇupura jāī ॥11॥"]}],"topics":[{"id":"aarti.tek","hi":"मंगल मूरति जय जय हनुमन्ता","en":"Mangal Murti Jai Jai Hanumanta"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"},"lines":true}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"},"lines":true}],"au":[{"id":"amal-bhakti","file":"audio/amal-bhakti","title":{"hi":"अमल भक्ति","en":"Amal Bhakti"},"draft":true}]}}