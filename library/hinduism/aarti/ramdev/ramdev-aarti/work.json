{"id":"ramdev-aarti","lang":"hi","title":{"hi":"ॐ जय श्री रामादे","en":"Om Jai Shri Ramade"},"by":{"hi":"बाबा रामदेव","en":"Baba Ramdev"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"ॐ जय श्री रामादे","en":"Om Jai Shri Ramade"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.tek","p":0,"s":"aarti","y":"tek","n":"","v":["ॐ जय श्री रामादे स्वामी जय श्री रामादे ।","पिता तुम्हारे अजमल मैया मेनादे ॥"],"c":"","t":["oṁ jaya śrī rāmāde svāmī jaya śrī rāmāde,","pitā tumhāre ajamala maiyā menāde."]},{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["रूप मनोहर जिसका घोड़े असवारी ।","कर में सोहे भाला मुक्तामणि धारी ॥१॥"],"c":"1","t":["rūpa manohara jisakā ghoṛe asavārī,","kara meṁ sohe bhālā muktāmaṇi dhārī ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["विष्णु रूप तुम स्वामी कलियुग अवतारी ।","सुरनर मुनिजन ध्यावे जावे बलिहारी ॥२॥"],"c":"2","t":["viṣṇu rūpa tuma svāmī kaliyuga avatārī,","suranara munijana dhyāve jāve balihārī ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["दुःख दलजी का तुमने पल भर में टारा ।","सरजीवन भाण को तुमने कर डारा ॥३॥"],"c":"3","t":["duḥkha dalajī kā tumane pala bhara meṁ ṭārā,","sarajīvana bhāṇa ko tumane kara ḍārā ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["नाव सेठ की तारी दानव को मारा ।","पल में कीना तुमने सरवर को खारा ॥४॥"],"c":"4","t":["nāva seṭha kī tārī dānava ko mārā,","pala meṁ kīnā tumane saravara ko khārā ॥4॥"]}],"topics":[{"id":"aarti.tek","hi":"ॐ जय श्री रामादे","en":"Om Jai Shri Ramade"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]}}