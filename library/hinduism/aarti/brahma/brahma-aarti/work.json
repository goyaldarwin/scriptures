{"id":"brahma-aarti","lang":"hi","title":{"hi":"पितु मातु सहायक स्वामी सखा","en":"Pitu Matu Sahayak Swami Sakha"},"by":{"hi":"भगवान ब्रह्मा","en":"Bhagwan Brahma"},"parts":{"name":{"hi":"आरती","en":"Aarti"},"list":[{"hi":"पितु मातु सहायक स्वामी सखा","en":"Pitu Matu Sahayak Swami Sakha"}]},"types":{"tek":{"name":{"hi":"टेक","en":"Refrain (tek)"},"short":{"hi":"टेक","en":"Ref."}},"pad":{"name":{"hi":"पद","en":"Stanza"},"short":{"hi":"पद","en":"St."}}},"items":[{"id":"aarti.pad1","p":0,"s":"aarti","y":"pad","n":"1","v":["पितु मातु सहायक स्वामी सखा ।","तुम ही एक नाथ हमारे हो ।","जिनके कुछ और आधार नहीं ।","तिनके तुम ही रखवारे हो ॥१॥"],"c":"1","t":["pitu mātu sahāyaka svāmī sakhā,","tuma hī eka nātha hamāre ho,","jinake kucha aura ādhāra nahīṁ,","tinake tuma hī rakhavāre ho ॥1॥"]},{"id":"aarti.pad2","p":0,"s":"aarti","y":"pad","n":"2","v":["सब भाँति सदा सुखदायक हो ।","दुःख दुर्गुण नाशन हारे हो ।","प्रतिपाल करो सिगरे जग को ।","अतिशय करुणा उर धारे हो ॥२॥"],"c":"2","t":["saba bhām̐ti sadā sukhadāyaka ho,","duḥkha durguṇa nāśana hāre ho,","pratipāla karo sigare jaga ko,","atiśaya karuṇā ura dhāre ho ॥2॥"]},{"id":"aarti.pad3","p":0,"s":"aarti","y":"pad","n":"3","v":["भुलि हैं हम तो तुमको तुम तो ।","हमरी सुधि नाहिं बिसारे हो ।","उपकारन को कछु अन्त नहीं ।","छिन ही छिन जो विस्तारे हो ॥३॥"],"c":"3","t":["bhuli haiṁ hama to tumako tuma to,","hamarī sudhi nāhiṁ bisāre ho,","upakārana ko kachu anta nahīṁ,","china hī china jo vistāre ho ॥3॥"]},{"id":"aarti.pad4","p":0,"s":"aarti","y":"pad","n":"4","v":["महाराज महा महिमा तुम्हरी ।","मुझसे बिरले बुधवारे हो ।","शुभ शान्ति निकेतन प्रेमनिधि ।","मन मन्दिर के उजियारे हो ॥४॥"],"c":"4","t":["mahārāja mahā mahimā tumharī,","mujhase birale budhavāre ho,","śubha śānti niketana premanidhi,","mana mandira ke ujiyāre ho ॥4॥"]},{"id":"aarti.pad5","p":0,"s":"aarti","y":"pad","n":"5","v":["इस जीवन के तुम जीवन हो ।","इन प्राणन के तुम प्यारे हो ।","तुम सों प्रभु पाय प्रताप हरि ।","केहि के अब और सहारे हो ॥५॥"],"c":"5","t":["isa jīvana ke tuma jīvana ho,","ina prāṇana ke tuma pyāre ho,","tuma soṁ prabhu pāya pratāpa hari,","kehi ke aba aura sahāre ho ॥5॥"]}],"topics":[{"id":"aarti.pad1","hi":"पितु मातु सहायक स्वामी सखा","en":"Pitu Matu Sahayak Swami Sakha"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]},"glossary":true}