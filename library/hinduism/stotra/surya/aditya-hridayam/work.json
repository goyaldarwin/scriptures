{"id":"aditya-hridayam","lang":"sa","title":{"hi":"आदित्यहृदयम्","en":"Aditya Hridayam"},"by":{"hi":"महर्षि वाल्मीकि","en":"Maharshi Valmiki"},"from":{"hi":"श्रीमद्वाल्मीकीय रामायण, युद्धकाण्ड, सर्ग १०५","en":"Shrimad Valmiki Ramayan, Yuddha Kand, Sarga 105"},"edition":{"hi":"sanskritdocuments.org","en":"sanskritdocuments.org"},"parts":{"name":{"hi":"पाठ","en":"Paath"},"list":[{"hi":"आदित्यहृदयम्","en":"Aditya Hridayam"}]},"types":{"viniyoga":{"name":{"hi":"विनियोग","en":"Viniyoga"},"short":{"hi":"विनि॰","en":"Vin."}},"nyasa":{"name":{"hi":"न्यास","en":"Nyas"},"short":{"hi":"न्या॰","en":"Nya."}},"shloka":{"name":{"hi":"श्लोक","en":"Shloka"},"short":{"hi":"श्लो॰","en":"Shl."}},"iti":{"name":{"hi":"समापन (पुष्पिका)","en":"Closing words (iti)"},"short":{"hi":"इति","en":"Iti"}}},"items":[{"id":"viniyoga","p":0,"s":"viniyoga","y":"viniyoga","n":"","v":["ॐ अस्य श्रीआदित्यहृदयस्तोत्रमन्त्रस्य श्रीअगस्त्यऋषिः ।","अनुष्टुप्छन्दः ।","श्रीआदित्यहृदयभूतो भगवान्ब्रह्मा देवता ।","ॐ बीजम् ।","रश्मिमतेरिति शक्तिः ।","ॐ तत्सवितुरित्यादिगायत्री कीलकम् ।","निरस्ताशेषविघ्नतया ब्रह्मविद्यासिद्धौ सर्वत्र जयसिद्धौ च विनियोगः ॥"],"c":"","t":["oṁ asya śrīādityahr̥dayastotramantrasya śrīagastyar̥ṣiḥ,","anuṣṭupchandaḥ,","śrīādityahr̥dayabhūto bhagavānbrahmā devatā,","oṁ bījam,","raśmimateriti śaktiḥ,","oṁ tatsaviturityādigāyatrī kīlakam,","nirastāśeṣavighnatayā brahmavidyāsiddhau sarvatra jayasiddhau ca viniyogaḥ."]},{"id":"rishyadi","p":0,"s":"rishyadi","y":"nyasa","n":"","v":["ॐ अगस्त्यऋषये नमः शिरसि ।","अनुष्टुप्छन्दसे नमः मुखे ।","आदित्यहृदयभूतब्रह्मदेवतायै नमः हृदि ।","ॐ बीजाय नमः गुह्ये ।","ॐ रश्मिमते शक्तये नमः पादयोः ।","ॐ तत्सवितुरित्यादिगायत्री कीलकाय नमः नाभौ ।","विनियोगाय नमः सर्वाङ्गे ॥"],"c":"","t":["oṁ agastyar̥ṣaye namaḥ śirasi,","anuṣṭupchandase namaḥ mukhe,","ādityahr̥dayabhūtabrahmadevatāyai namaḥ hr̥di,","oṁ bījāya namaḥ guhye,","oṁ raśmimate śaktaye namaḥ pādayoḥ,","oṁ tatsaviturityādigāyatrī kīlakāya namaḥ nābhau,","viniyogāya namaḥ sarvāṅge."]},{"id":"kara","p":0,"s":"kara","y":"nyasa","n":"","v":["ॐ रश्मिमते अङ्गुष्ठाभ्यां नमः ।","ॐ समुद्यते तर्जनीभ्यां नमः ।","ॐ देवासुरनमस्कृताय मध्यमाभ्यां नमः ।","ॐ विवस्वते अनामिकाभ्यां नमः ।","ॐ भास्कराय कनिष्ठिकाभ्यां नमः ।","ॐ भुवनेश्वराय करतलकरपृष्ठाभ्यां नमः ॥"],"c":"","t":["oṁ raśmimate aṅguṣṭhābhyāṁ namaḥ,","oṁ samudyate tarjanībhyāṁ namaḥ,","oṁ devāsuranamaskr̥tāya madhyamābhyāṁ namaḥ,","oṁ vivasvate anāmikābhyāṁ namaḥ,","oṁ bhāskarāya kaniṣṭhikābhyāṁ namaḥ,","oṁ bhuvaneśvarāya karatalakarapr̥ṣṭhābhyāṁ namaḥ."]},{"id":"anga","p":0,"s":"anga","y":"nyasa","n":"","v":["ॐ रश्मिमते हृदयाय नमः ।","ॐ समुद्यते शिरसे स्वाहा ।","ॐ देवासुरनमस्कृताय शिखायै वषट् ।","ॐ विवस्वते कवचाय हुम् ।","ॐ भास्कराय नेत्रत्रयाय वौषट् ।","ॐ भुवनेश्वराय अस्त्राय फट् ॥"],"c":"","t":["oṁ raśmimate hr̥dayāya namaḥ,","oṁ samudyate śirase svāhā,","oṁ devāsuranamaskr̥tāya śikhāyai vaṣaṭ,","oṁ vivasvate kavacāya hum,","oṁ bhāskarāya netratrayāya vauṣaṭ,","oṁ bhuvaneśvarāya astrāya phaṭ."]},{"id":"sh1","p":0,"s":"sh1","y":"shloka","n":"1","v":["ततो युद्धपरिश्रान्तं समरे चिन्तया स्थितम् ।","रावणं चाग्रतो दृष्ट्वा युद्धाय समुपस्थितम् ॥१॥"],"c":"1","t":["tato yuddhapariśrāntaṁ samare cintayā sthitam,","rāvaṇaṁ cāgrato dr̥ṣṭvā yuddhāya samupasthitam ॥1॥"]},{"id":"sh2","p":0,"s":"sh2","y":"shloka","n":"2","v":["दैवतैश्च समागम्य द्रष्टुमभ्यागतो रणम् ।","उपागम्याब्रवीद्राममगस्त्यो भगवानृषिः ॥२॥"],"c":"2","t":["daivataiśca samāgamya draṣṭumabhyāgato raṇam,","upāgamyābravīdrāmamagastyo bhagavānr̥ṣiḥ ॥2॥"]},{"id":"sh3","p":0,"s":"sh3","y":"shloka","n":"3","v":["राम राम महाबाहो शृणु गुह्यं सनातनम् ।","येन सर्वानरीन्वत्स समरे विजयिष्यसि ॥३॥"],"c":"3","t":["rāma rāma mahābāho śr̥ṇu guhyaṁ sanātanam,","yena sarvānarīnvatsa samare vijayiṣyasi ॥3॥"]},{"id":"sh4","p":0,"s":"sh4","y":"shloka","n":"4","v":["आदित्यहृदयं पुण्यं सर्वशत्रुविनाशनम् ।","जयावहं जपेन्नित्यमक्षयं परमं शिवम् ॥४॥"],"c":"4","t":["ādityahr̥dayaṁ puṇyaṁ sarvaśatruvināśanam,","jayāvahaṁ japennityamakṣayaṁ paramaṁ śivam ॥4॥"]},{"id":"sh5","p":0,"s":"sh5","y":"shloka","n":"5","v":["सर्वमङ्गलमाङ्गल्यं सर्वपापप्रणाशनम् ।","चिन्ताशोकप्रशमनम् आयुर्वर्धनमुत्तमम् ॥५॥"],"c":"5","t":["sarvamaṅgalamāṅgalyaṁ sarvapāpapraṇāśanam,","cintāśokapraśamanam āyurvardhanamuttamam ॥5॥"]},{"id":"sh6","p":0,"s":"sh6","y":"shloka","n":"6","v":["रश्मिमन्तं समुद्यन्तं देवासुरनमस्कृतम् ।","पूजयस्व विवस्वन्तं भास्करं भुवनेश्वरम् ॥६॥"],"c":"6","t":["raśmimantaṁ samudyantaṁ devāsuranamaskr̥tam,","pūjayasva vivasvantaṁ bhāskaraṁ bhuvaneśvaram ॥6॥"]},{"id":"sh7","p":0,"s":"sh7","y":"shloka","n":"7","v":["सर्वदेवात्मको ह्येष तेजस्वी रश्मिभावनः ।","एष देवासुरगणाँल्लोकान्पाति गभस्तिभिः ॥७॥"],"c":"7","t":["sarvadevātmako hyeṣa tejasvī raśmibhāvanaḥ,","eṣa devāsuragaṇām̐llokānpāti gabhastibhiḥ ॥7॥"]},{"id":"sh8","p":0,"s":"sh8","y":"shloka","n":"8","v":["एष ब्रह्मा च विष्णुश्च शिवः स्कन्दः प्रजापतिः ।","महेन्द्रो धनदः कालो यमः सोमो ह्यपां पतिः ॥८॥"],"c":"8","t":["eṣa brahmā ca viṣṇuśca śivaḥ skandaḥ prajāpatiḥ,","mahendro dhanadaḥ kālo yamaḥ somo hyapāṁ patiḥ ॥8॥"]},{"id":"sh9","p":0,"s":"sh9","y":"shloka","n":"9","v":["पितरो वसवः साध्या ह्यश्विनौ मरुतो मनुः ।","वायुर्वह्निः प्रजाप्राण ऋतुकर्ता प्रभाकरः ॥९॥"],"c":"9","t":["pitaro vasavaḥ sādhyā hyaśvinau maruto manuḥ,","vāyurvahniḥ prajāprāṇa r̥tukartā prabhākaraḥ ॥9॥"]},{"id":"sh10","p":0,"s":"sh10","y":"shloka","n":"10","v":["आदित्यः सविता सूर्यः खगः पूषा गभस्तिमान् ।","सुवर्णसदृशो भानुर्हिरण्यरेता दिवाकरः ॥१०॥"],"c":"10","t":["ādityaḥ savitā sūryaḥ khagaḥ pūṣā gabhastimān,","suvarṇasadr̥śo bhānurhiraṇyaretā divākaraḥ ॥10॥"]},{"id":"sh11","p":0,"s":"sh11","y":"shloka","n":"11","v":["हरिदश्वः सहस्रार्चिः सप्तसप्तिर्मरीचिमान् ।","तिमिरोन्मथनः शम्भुस्त्वष्टा मार्तण्डकोंऽशुमान् ॥११॥"],"c":"11","t":["haridaśvaḥ sahasrārciḥ saptasaptirmarīcimān,","timironmathanaḥ śambhustvaṣṭā mārtaṇḍakoṁ’śumān ॥11॥"]},{"id":"sh12","p":0,"s":"sh12","y":"shloka","n":"12","v":["हिरण्यगर्भः शिशिरस्तपनो भास्करो रविः ।","अग्निगर्भोऽदितेः पुत्रः शङ्खः शिशिरनाशनः ॥१२॥"],"c":"12","t":["hiraṇyagarbhaḥ śiśirastapano bhāskaro raviḥ,","agnigarbho’diteḥ putraḥ śaṅkhaḥ śiśiranāśanaḥ ॥12॥"]},{"id":"sh13","p":0,"s":"sh13","y":"shloka","n":"13","v":["व्योमनाथस्तमोभेदी ऋग्यजुःसामपारगः ।","घनवृष्टिरपां मित्रो विन्ध्यवीथीप्लवङ्गमः ॥१३॥"],"c":"13","t":["vyomanāthastamobhedī r̥gyajuḥsāmapāragaḥ,","ghanavr̥ṣṭirapāṁ mitro vindhyavīthīplavaṅgamaḥ ॥13॥"]},{"id":"sh14","p":0,"s":"sh14","y":"shloka","n":"14","v":["आतपी मण्डली मृत्युः पिङ्गलः सर्वतापनः ।","कविर्विश्वो महातेजा रक्तः सर्वभवोद्भवः ॥१४॥"],"c":"14","t":["ātapī maṇḍalī mr̥tyuḥ piṅgalaḥ sarvatāpanaḥ,","kavirviśvo mahātejā raktaḥ sarvabhavodbhavaḥ ॥14॥"]},{"id":"sh15","p":0,"s":"sh15","y":"shloka","n":"15","v":["नक्षत्रग्रहताराणामधिपो विश्वभावनः ।","तेजसामपि तेजस्वी द्वादशात्मन्नमोऽस्तु ते ॥१५॥"],"c":"15","t":["nakṣatragrahatārāṇāmadhipo viśvabhāvanaḥ,","tejasāmapi tejasvī dvādaśātmannamo’stu te ॥15॥"]},{"id":"sh16","p":0,"s":"sh16","y":"shloka","n":"16","v":["नमः पूर्वाय गिरये पश्चिमायाद्रये नमः ।","ज्योतिर्गणानां पतये दिनाधिपतये नमः ॥१६॥"],"c":"16","t":["namaḥ pūrvāya giraye paścimāyādraye namaḥ,","jyotirgaṇānāṁ pataye dinādhipataye namaḥ ॥16॥"]},{"id":"sh17","p":0,"s":"sh17","y":"shloka","n":"17","v":["जयाय जयभद्राय हर्यश्वाय नमो नमः ।","नमो नमः सहस्रांशो आदित्याय नमो नमः ॥१७॥"],"c":"17","t":["jayāya jayabhadrāya haryaśvāya namo namaḥ,","namo namaḥ sahasrāṁśo ādityāya namo namaḥ ॥17॥"]},{"id":"sh18","p":0,"s":"sh18","y":"shloka","n":"18","v":["नम उग्राय वीराय सारङ्गाय नमो नमः ।","नमः पद्मप्रबोधाय मार्तण्डाय नमो नमः ॥१८॥"],"c":"18","t":["nama ugrāya vīrāya sāraṅgāya namo namaḥ,","namaḥ padmaprabodhāya mārtaṇḍāya namo namaḥ ॥18॥"]},{"id":"sh19","p":0,"s":"sh19","y":"shloka","n":"19","v":["ब्रह्मेशानाच्युतेशाय सूर्यायादित्यवर्चसे ।","भास्वते सर्वभक्षाय रौद्राय वपुषे नमः ॥१९॥"],"c":"19","t":["brahmeśānācyuteśāya sūryāyādityavarcase,","bhāsvate sarvabhakṣāya raudrāya vapuṣe namaḥ ॥19॥"]},{"id":"sh20","p":0,"s":"sh20","y":"shloka","n":"20","v":["तमोघ्नाय हिमघ्नाय शत्रुघ्नायामितात्मने ।","कृतघ्नघ्नाय देवाय ज्योतिषां पतये नमः ॥२०॥"],"c":"20","t":["tamoghnāya himaghnāya śatrughnāyāmitātmane,","kr̥taghnaghnāya devāya jyotiṣāṁ pataye namaḥ ॥20॥"]},{"id":"sh21","p":0,"s":"sh21","y":"shloka","n":"21","v":["तप्तचामीकराभाय वह्नये विश्वकर्मणे ।","नमस्तमोऽभिनिघ्नाय रुचये लोकसाक्षिणे ॥२१॥"],"c":"21","t":["taptacāmīkarābhāya vahnaye viśvakarmaṇe,","namastamo’bhinighnāya rucaye lokasākṣiṇe ॥21॥"]},{"id":"sh22","p":0,"s":"sh22","y":"shloka","n":"22","v":["नाशयत्येष वै भूतं तदेव सृजति प्रभुः ।","पायत्येष तपत्येष वर्षत्येष गभस्तिभिः ॥२२॥"],"c":"22","t":["nāśayatyeṣa vai bhūtaṁ tadeva sr̥jati prabhuḥ,","pāyatyeṣa tapatyeṣa varṣatyeṣa gabhastibhiḥ ॥22॥"]},{"id":"sh23","p":0,"s":"sh23","y":"shloka","n":"23","v":["एष सुप्तेषु जागर्ति भूतेषु परिनिष्ठितः ।","एष एवाग्निहोत्रं च फलं चैवाग्निहोत्रिणाम् ॥२३॥"],"c":"23","t":["eṣa supteṣu jāgarti bhūteṣu pariniṣṭhitaḥ,","eṣa evāgnihotraṁ ca phalaṁ caivāgnihotriṇām ॥23॥"]},{"id":"sh24","p":0,"s":"sh24","y":"shloka","n":"24","v":["वेदाश्च क्रतवश्चैव क्रतूनां फलमेव च ।","यानि कृत्यानि लोकेषु सर्व एष रविः प्रभुः ॥२४॥"],"c":"24","t":["vedāśca kratavaścaiva kratūnāṁ phalameva ca,","yāni kr̥tyāni lokeṣu sarva eṣa raviḥ prabhuḥ ॥24॥"]},{"id":"sh25","p":0,"s":"sh25","y":"shloka","n":"25","v":["एनमापत्सु कृच्छ्रेषु कान्तारेषु भयेषु च ।","कीर्तयन्पुरुषः कश्चिन्नावसीदति राघव ॥२५॥"],"c":"25","t":["enamāpatsu kr̥cchreṣu kāntāreṣu bhayeṣu ca,","kīrtayanpuruṣaḥ kaścinnāvasīdati rāghava ॥25॥"]},{"id":"sh26","p":0,"s":"sh26","y":"shloka","n":"26","v":["पूजयस्वैनमेकाग्रो देवदेवं जगत्पतिम् ।","एतत्त्रिगुणितं जप्त्वा युद्धेषु विजयिष्यसि ॥२६॥"],"c":"26","t":["pūjayasvainamekāgro devadevaṁ jagatpatim,","etattriguṇitaṁ japtvā yuddheṣu vijayiṣyasi ॥26॥"]},{"id":"sh27","p":0,"s":"sh27","y":"shloka","n":"27","v":["अस्मिन्क्षणे महाबाहो रावणं त्वं वधिष्यसि ।","एवमुक्त्वा तदाऽगस्त्यो जगाम च यथागतम् ॥२७॥"],"c":"27","t":["asminkṣaṇe mahābāho rāvaṇaṁ tvaṁ vadhiṣyasi,","evamuktvā tadā’gastyo jagāma ca yathāgatam ॥27॥"]},{"id":"sh28","p":0,"s":"sh28","y":"shloka","n":"28","v":["एतच्छ्रुत्वा महातेजा नष्टशोकोऽभवत्तदा ।","धारयामास सुप्रीतो राघवः प्रयतात्मवान् ॥२८॥"],"c":"28","t":["etacchrutvā mahātejā naṣṭaśoko’bhavattadā,","dhārayāmāsa suprīto rāghavaḥ prayatātmavān ॥28॥"]},{"id":"sh29","p":0,"s":"sh29","y":"shloka","n":"29","v":["आदित्यं प्रेक्ष्य जप्त्वा तु परं हर्षमवाप्तवान् ।","त्रिराचम्य शुचिर्भूत्वा धनुरादाय वीर्यवान् ॥२९॥"],"c":"29","t":["ādityaṁ prekṣya japtvā tu paraṁ harṣamavāptavān,","trirācamya śucirbhūtvā dhanurādāya vīryavān ॥29॥"]},{"id":"sh30","p":0,"s":"sh30","y":"shloka","n":"30","v":["रावणं प्रेक्ष्य हृष्टात्मा युद्धाय समुपागमत् ।","सर्वयत्नेन महता वधे तस्य धृतोऽभवत् ॥३०॥"],"c":"30","t":["rāvaṇaṁ prekṣya hr̥ṣṭātmā yuddhāya samupāgamat,","sarvayatnena mahatā vadhe tasya dhr̥to’bhavat ॥30॥"]},{"id":"sh31","p":0,"s":"sh31","y":"shloka","n":"31","v":["अथ रविरवदन्निरीक्ष्य रामं","मुदितमनाः परमं प्रहृष्यमाणः ।","निशिचरपतिसङ्क्षयं विदित्वा","सुरगणमध्यगतो वचस्त्वरेति ॥३१॥"],"c":"31","t":["atha raviravadannirīkṣya rāmaṁ","muditamanāḥ paramaṁ prahr̥ṣyamāṇaḥ,","niśicarapatisaṅkṣayaṁ viditvā","suragaṇamadhyagato vacastvareti ॥31॥"]},{"id":"iti","p":0,"s":"iti","y":"iti","n":"","v":["॥ इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चाधिकशततमः सर्गः ॥"],"c":"","t":["॥ ityārṣe śrīmadrāmāyaṇe vālmīkīye ādikāvye yuddhakāṇḍe pañcādhikaśatatamaḥ sargaḥ ॥"]}],"topics":[{"id":"viniyoga","hi":"विनियोग और न्यास","en":"Viniyoga and Nyas"},{"id":"sh1","hi":"अगस्त्यजीका श्रीरामजीके पास आना","en":"Sage Agastya comes to Shri Ram"},{"id":"sh6","hi":"सूर्यदेवकी स्तुति","en":"Praise of the Sun god"},{"id":"sh25","hi":"फलश्रुति","en":"Phalashruti"},{"id":"sh28","hi":"श्रीरामजीका पाठ करके युद्धके लिये बढ़ना","en":"Shri Ram recites it and goes forward to battle"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"},"lines":true}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"},"lines":true}],"au":[{"id":"sri-sathya-sai","file":"audio/sri-sathya-sai","title":{"hi":"श्री सत्य साई (आधिकारिक)","en":"Sri Sathya Sai Official"}},{"id":"braja-beats","file":"audio/braja-beats","title":{"hi":"ब्रज बीट्स","en":"Braja Beats"}},{"id":"the-sanskrit-channel","file":"audio/the-sanskrit-channel","title":{"hi":"द संस्कृत चैनल","en":"The Sanskrit Channel"}}]},"glossary":true}