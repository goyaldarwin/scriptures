{"id":"bilvashtakam","lang":"sa","title":{"hi":"बिल्वाष्टकम्","en":"Bilvāṣṭakam"},"by":{"hi":"पारम्परिक स्तोत्र","en":"Traditional"},"edition":{"hi":"साउंड्स ऑफ़ ईशा; sanskritdocuments.org","en":"Sounds of Isha; sanskritdocuments.org"},"parts":{"name":{"hi":"पाठ","en":"Pāṭha"},"list":[{"hi":"बिल्वाष्टकम्","en":"Bilvāṣṭakam"}]},"types":{"shloka":{"name":{"hi":"श्लोक","en":"Śloka"},"short":{"hi":"श्लो॰","en":"Śl."}},"phalashruti":{"name":{"hi":"फलश्रुति","en":"Phalaśruti"},"short":{"hi":"फल॰","en":"Phala."}},"iti":{"name":{"hi":"समापन (पुष्पिका)","en":"Closing words (iti)"},"short":{"hi":"इति","en":"Iti"}}},"items":[{"id":"sh1","p":0,"s":"sh1","y":"shloka","n":"1","v":["त्रिदलं त्रिगुणाकारं त्रिनेत्रं च त्रियायुधम् ।","त्रिजन्मपापसंहारम् एकबिल्वं शिवार्पणम् ॥१॥"],"t":["tridalaṁ triguṇākāraṁ trinetraṁ ca triyāyudham,","trijanmapāpasaṁhāram ekabilvaṁ śivārpaṇam ॥1॥"]},{"id":"sh2","p":0,"s":"sh2","y":"shloka","n":"2","v":["त्रिशाखैः बिल्वपत्रैश्च ह्यच्छिद्रैः कोमलैः शुभैः ।","शिवपूजां करिष्यामि ह्येकबिल्वं शिवार्पणम् ॥२॥"],"t":["triśākhaiḥ bilvapatraiśca hyacchidraiḥ komalaiḥ śubhaiḥ,","śivapūjāṁ kariṣyāmi hyekabilvaṁ śivārpaṇam ॥2॥"]},{"id":"sh3","p":0,"s":"sh3","y":"shloka","n":"3","v":["अखण्ड बिल्वपत्रेण पूजिते नन्दिकेश्वरे ।","शुद्ध्यन्ति सर्वपापेभ्यो ह्येकबिल्वं शिवार्पणम् ॥३॥"],"t":["akhaṇḍa bilvapatreṇa pūjite nandikeśvare,","śuddhyanti sarvapāpebhyo hyekabilvaṁ śivārpaṇam ॥3॥"]},{"id":"sh4","p":0,"s":"sh4","y":"shloka","n":"4","v":["शालिग्राम शिलामेकां विप्राणां जातु चार्पयेत् ।","सोमयज्ञ महापुण्यम् एकबिल्वं शिवार्पणम् ॥४॥"],"t":["śāligrāma śilāmekāṁ viprāṇāṁ jātu cārpayet,","somayajña mahāpuṇyam ekabilvaṁ śivārpaṇam ॥4॥"]},{"id":"sh5","p":0,"s":"sh5","y":"shloka","n":"5","v":["दन्तिकोटि सहस्राणि वाजपेय शतानि च ।","कोटिकन्या महादानम् एकबिल्वं शिवार्पणम् ॥५॥"],"t":["dantikoṭi sahasrāṇi vājapeya śatāni ca,","koṭikanyā mahādānam ekabilvaṁ śivārpaṇam ॥5॥"]},{"id":"sh6","p":0,"s":"sh6","y":"shloka","n":"6","v":["लक्ष्म्यास्तनुत उत्पन्नं महादेवस्य च प्रियम् ।","बिल्ववृक्षं प्रयच्छामि ह्येकबिल्वं शिवार्पणम् ॥६॥"],"t":["lakṣmyāstanuta utpannaṁ mahādevasya ca priyam,","bilvavr̥kṣaṁ prayacchāmi hyekabilvaṁ śivārpaṇam ॥6॥"]},{"id":"sh7","p":0,"s":"sh7","y":"shloka","n":"7","v":["दर्शनं बिल्ववृक्षस्य स्पर्शनं पापनाशनम् ।","अघोरपापसंहारम् एकबिल्वं शिवार्पणम् ॥७॥"],"t":["darśanaṁ bilvavr̥kṣasya sparśanaṁ pāpanāśanam,","aghorapāpasaṁhāram ekabilvaṁ śivārpaṇam ॥7॥"]},{"id":"kashi","p":0,"s":"kashi","y":"shloka","n":"","v":["काशीक्षेत्रनिवासं च कालभैरवदर्शनम् ।","प्रयागमाधवं दृष्ट्वा ह्येकबिल्वं शिवार्पणम् ॥"],"t":["kāśīkṣetranivāsaṁ ca kālabhairavadarśanam,","prayāgamādhavaṁ dr̥ṣṭvā hyekabilvaṁ śivārpaṇam."]},{"id":"sh8","p":0,"s":"sh8","y":"shloka","n":"8","v":["मूलतो ब्रह्मरूपाय मध्यतो विष्णुरूपिणे ।","अग्रतः शिवरूपाय ह्येकबिल्वं शिवार्पणम् ॥८॥"],"t":["mūlato brahmarūpāya madhyato viṣṇurūpiṇe,","agrataḥ śivarūpāya hyekabilvaṁ śivārpaṇam ॥8॥"]},{"id":"phala","p":0,"s":"phala","y":"phalashruti","n":"","v":["बिल्वाष्टकमिदं पुण्यं यः पठेत् शिवसन्निधौ ।","सर्वपाप विनिर्मुक्तः शिवलोकमवाप्नुयात् ॥"],"t":["bilvāṣṭakamidaṁ puṇyaṁ yaḥ paṭhet śivasannidhau,","sarvapāpa vinirmuktaḥ śivalokamavāpnuyāt."]},{"id":"iti","p":0,"s":"iti","y":"iti","n":"","v":["॥ इति बिल्वाष्टकम् ॥"],"t":["॥ iti bilvāṣṭakam ॥"]}],"topics":[{"id":"sh1","hi":"बिल्वपत्रकी महिमा","en":"The glory of the bilva leaf"},{"id":"sh6","hi":"बिल्ववृक्षकी महिमा","en":"The glory of the bilva tree"},{"id":"phala","hi":"फलश्रुति","en":"Phalaśruti"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}},{"id":"en-sanskritdocuments","file":"meanings/en-sanskritdocuments","title":{"hi":"sanskritdocuments.org — अंग्रेज़ी अर्थ (एन. बालसुब्रमण्यन्)","en":"sanskritdocuments.org — English meaning (N. Balasubramanian)"}}],"au":[{"id":"sounds-of-isha","file":"audio/sounds-of-i