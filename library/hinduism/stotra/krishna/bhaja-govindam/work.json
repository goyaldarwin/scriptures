{"id":"bhaja-govindam","lang":"sa","title":{"hi":"भज गोविन्दम्","en":"Bhaja Govindam"},"by":{"hi":"आदि शंकराचार्य","en":"Ādi Śaṅkarācārya"},"edition":{"hi":"sanskritdocuments.org","en":"sanskritdocuments.org"},"parts":{"name":{"hi":"पाठ","en":"Pāṭha"},"list":[{"hi":"भज गोविन्दम्","en":"Bhaja Govindam"}]},"types":{"shloka":{"name":{"hi":"श्लोक","en":"Śloka"},"short":{"hi":"श्लो॰","en":"Śl."}}},"items":[{"id":"sh1","p":0,"s":"sh1","y":"shloka","n":"1","v":["भज गोविन्दं भज गोविन्दं","गोविन्दं भज मूढमते ।","सम्प्राप्ते सन्निहिते काले","नहि नहि रक्षति डुकृङ्करणे ॥१॥"],"t":["bhaja govindaṁ bhaja govindaṁ","govindaṁ bhaja mūḍhamate,","samprāpte sannihite kāle","nahi nahi rakṣati ḍukr̥ṅkaraṇe ॥1॥"]},{"id":"sh2","p":0,"s":"sh2","y":"shloka","n":"2","v":["मूढ जहीहि धनागमतृष्णां","कुरु सद्बुद्धिं मनसि वितृष्णाम् ।","यल्लभसे निजकर्मोपात्तं","वित्तं तेन विनोदय चित्तम् ॥२॥"],"t":["mūḍha jahīhi dhanāgamatr̥ṣṇāṁ","kuru sadbuddhiṁ manasi vitr̥ṣṇām,","yallabhase nijakarmopāttaṁ","vittaṁ tena vinodaya cittam ॥2॥"]},{"id":"sh3","p":0,"s":"sh3","y":"shloka","n":"3","v":["नारीस्तनभरनाभीदेशं","दृष्ट्वा मा गा मोहावेशम् ।","एतन्मांसवसादिविकारं","मनसि विचिन्तय वारं वारम् ॥३॥"],"t":["nārīstanabharanābhīdeśaṁ","dr̥ṣṭvā mā gā mohāveśam,","etanmāṁsavasādivikāraṁ","manasi vicintaya vāraṁ vāram ॥3॥"]},{"id":"sh4","p":0,"s":"sh4","y":"shloka","n":"4","v":["नलिनीदलगतजलमतितरलं","तद्वज्जीवितमतिशयचपलम् ।","विद्धि व्याध्यभिमानग्रस्तं","लोकं शोकहतं च समस्तम् ॥४॥"],"t":["nalinīdalagatajalamatitaralaṁ","tadvajjīvitamatiśayacapalam,","viddhi vyādhyabhimānagrastaṁ","lokaṁ śokahataṁ ca samastam ॥4॥"]},{"id":"sh5","p":0,"s":"sh5","y":"shloka","n":"5","v":["यावद्वित्तोपार्जनसक्तस्तावन्निजपरिवारो रक्तः ।","पश्चाज्जीवति जर्जरदेहे","वार्तां कोऽपि न पृच्छति गेहे ॥५॥"],"t":["yāvadvittopārjanasaktastāvannijaparivāro raktaḥ,","paścājjīvati jarjaradehe","vārtāṁ ko’pi na pr̥cchati gehe ॥5॥"]},{"id":"sh6","p":0,"s":"sh6","y":"shloka","n":"6","v":["यावत्पवनो निवसति देहे","तावत्पृच्छति कुशलं गेहे ।","गतवति वायौ देहापाये","भार्या बिभ्यति तस्मिन्काये ॥६॥"],"t":["yāvatpavano nivasati dehe","tāvatpr̥cchati kuśalaṁ gehe,","gatavati vāyau dehāpāye","bhāryā bibhyati tasminkāye ॥6॥"]},{"id":"sh7","p":0,"s":"sh7","y":"shloka","n":"7","v":["बालस्तावत्क्रीडासक्तः","तरुणस्तावत्तरुणीसक्तः ।","वृद्धस्तावच्चिन्तासक्तः","परमे ब्रह्मणि कोऽपि न सक्तः ॥७॥"],"t":["bālastāvatkrīḍāsaktaḥ","taruṇastāvattaruṇīsaktaḥ,","vr̥ddhastāvaccintāsaktaḥ","parame brahmaṇi ko’pi na saktaḥ ॥7॥"]},{"id":"sh8","p":0,"s":"sh8","y":"shloka","n":"8","v":["का ते कान्ता कस्ते पुत्रः","संसारोऽयमतीव विचित्रः ।","कस्य त्वं कः कुत आयातस्तत्त्वं चिन्तय तदिह भ्रातः ॥८॥"],"t":["kā te kāntā kaste putraḥ","saṁsāro’yamatīva vicitraḥ,","kasya tvaṁ kaḥ kuta āyātastattvaṁ cintaya tadiha bhrātaḥ ॥8॥"]},{"id":"sh9","p":0,"s":"sh9","y":"shloka","n":"9","v":["सत्सङ्गत्वे निस्सङ्गत्वं","निस्सङ्गत्वे निर्मोहत्वम् ।","निर्मोहत्वे निश्चलतत्त्वं","निश्चलतत्त्वे जीवन्मुक्तिः ॥९॥"],"t":["satsaṅgatve nissaṅgatvaṁ","nissaṅgatve nirmohatvam,","nirmohatve niścalatattvaṁ","niścalatattve jīvanmuktiḥ ॥9॥"]},{"id":"sh10","p":0,"s":"sh10","y":"shloka","n":"10","v":["वयसि गते कः कामविकारः","शुष्के नीरे कः कासारः ।","क्षीणे वित्ते कः परिवारः","ज्ञाते तत्त्वे कः संसारः ॥१०॥"],"t":["vayasi gate kaḥ kāmavikāraḥ","śuṣke nīre kaḥ kāsāraḥ,","kṣīṇe vitte kaḥ parivāraḥ","jñāte tattve kaḥ saṁsāraḥ ॥10॥"]},{"id":"sh11","p":0,"s":"sh11","y":"shloka","n":"11","v":["मा कुरु धनजनयौवनगर्वं","हरति निमेषात्कालः सर्वम् ।","मायामयमिदमखिलं हित्वा","ब्रह्मपदं त्वं प्रविश विदित्वा ॥११॥"],"t":["mā kuru dhanajanayauvanagarvaṁ","harati nimeṣātkālaḥ sarvam,","māyāmayamidamakhilaṁ hitvā","brahmapadaṁ tvaṁ praviśa viditvā ॥11॥"]},{"id":"sh12","p":0,"s":"sh12","y":"shloka","n":"12","v":["दिनयामिन्यौ सायं प्रातः","शिशिरवसन्तौ पुनरायातः ।","कालः क्रीडति गच्छत्यायुस्तदपि न मुञ्चत्याशावायुः ॥१२॥"],"t":["dinayāminyau sāyaṁ prātaḥ","śiśiravasantau punarāyātaḥ,","kālaḥ krīḍati gacchatyāyustadapi na muñcatyāśāvāyuḥ ॥12॥"]},{"id":"sh13","p":0,"s":"sh13","y":"shloka","n":"13","v":["का ते कान्ता धनगतचिन्ता","वातुल किं तव नास्ति नियन्ता ।","त्रिजगति सज्जनसङ्गतिरेका","भवति भवार्णवतरणे नौका ॥१३॥"],"t":["kā te kāntā dhanagatacintā","vātula kiṁ tava nāsti niyantā,","trijagati sajjanasaṅgatirekā","bhavati bhavārṇavataraṇe naukā ॥13॥"]},{"id":"sh13a","p":0,"s":"sh13a","y":"shloka","n":"13अ","v":["द्वादशमञ्जरिकाभिरशेषः","कथितो वैयाकरणस्यैषः ।","उपदेशोऽभूद्विद्यानिपुणैः","श्रीमच्छङ्करभगवच्छरणैः ॥१३अ ॥"],"t":["dvādaśamañjarikābhiraśeṣaḥ","kathito vaiyākaraṇasyaiṣaḥ,","upadeśo’bhūdvidyānipuṇaiḥ","śrīmacchaṅkarabhagavaccharaṇaiḥ ॥13a ॥"]},{"id":"sh14","p":0,"s":"sh14","y":"shloka","n":"14","v":["जटिलो मुण्डी लुञ्छितकेशः","काषायाम्बरबहुकृतवेषः ।","पश्यन्नपि च न पश्यति मूढो","ह्युदरनिमित्तं बहुकृतवेषः ॥१४॥"],"t":["jaṭilo muṇḍī luñchitakeśaḥ","kāṣāyāmbarabahukr̥taveṣaḥ,","paśyannapi ca na paśyati mūḍho","hyudaranimittaṁ bahukr̥taveṣaḥ ॥14॥"]},{"id":"sh15","p":0,"s":"sh15","y":"shloka","n":"15","v":["अङ्गं गलितं पलितं मुण्डं","दशनविहीनं जातं तुण्डम् ।","वृद्धो याति गृहीत्वा दण्डं","तदपि न मुञ्चत्याशापिण्डम् ॥१५॥"],"t":["aṅgaṁ galitaṁ palitaṁ muṇḍaṁ","daśanavihīnaṁ jātaṁ tuṇḍam,","vr̥ddho yāti gr̥hītvā daṇḍaṁ","tadapi na muñcatyāśāpiṇḍam ॥15॥"]},{"id":"sh16","p":0,"s":"sh16","y":"shloka","n":"16","v":["अग्रे वह्निः पृष्ठे भानुः","रात्रौ चुबुकसमर्पितजानुः ।","करतलभिक्षस्तरुतलवासस्तदपि न मुञ्चत्याशापाशः ॥१६॥"],"t":["agre vahniḥ pr̥ṣṭhe bhānuḥ","rātrau cubukasamarpitajānuḥ,","karatalabhikṣastarutalavāsastadapi na muñcatyāśāpāśaḥ ॥16॥"]},{"id":"sh17","p":0,"s":"sh17","y":"shloka","n":"17","v":["कुरुते गङ्गासागरगमनं","व्रतपरिपालनमथवा दानम् ।","ज्ञानविहीनः सर्वमतेन","मुक्तिं न भजति जन्मशतेन ॥१७॥"],"t":["kurute gaṅgāsāgaragamanaṁ","vrataparipālanamathavā dānam,","jñānavihīnaḥ sarvamatena","muktiṁ na bhajati janmaśatena ॥17॥"]},{"id":"sh18","p":0,"s":"sh18","y":"shloka","n":"18","v":["सुरमन्दिरतरुमूलनिवासः","शय्या भूतलमजिनं वासः ।","सर्वपरिग्रहभोगत्यागः","कस्य सुखं न करोति विरागः ॥१८॥"],"t":["suramandiratarumūlanivāsaḥ","śayyā bhūtalamajinaṁ vāsaḥ,","sarvaparigrahabhogatyāgaḥ","kasya sukhaṁ na karoti virāgaḥ ॥18॥"]},{"id":"sh19","p":0,"s":"sh19","y":"shloka","n":"19","v":["योगरतो वा भोगरतो वा","सङ्गरतो वा सङ्गविहीनः ।","यस्य ब्रह्मणि रमते चित्तं","नन्दति नन्दति नन्दत्येव ॥१९॥"],"t":["yogarato vā bhogarato vā","saṅgarato vā saṅgavihīnaḥ,","yasya brahmaṇi ramate cittaṁ","nandati nandati nandatyeva ॥19॥"]},{"id":"sh20","p":0,"s":"sh20","y":"shloka","n":"20","v":["भगवद्गीता किञ्चिदधीता","गङ्गाजललवकणिका पीता ।","सकृदपि येन मुरारिसमर्चा","क्रियते तस्य यमेन न चर्चा ॥२०॥"],"t":["bhagavadgītā kiñcidadhītā","gaṅgājalalavakaṇikā pītā,","sakr̥dapi yena murārisamarcā","kriyate tasya yamena na carcā ॥20॥"]},{"id":"sh21","p":0,"s":"sh21","y":"shloka","n":"21","v":["पुनरपि जननं पुनरपि मरणं","पुनरपि जननीजठरे शयनम् ।","इह संसारे बहुदुस्तारे","कृपयाऽपारे पाहि मुरारे ॥२१॥"],"t":["punarapi jananaṁ punarapi maraṇaṁ","punarapi jananījaṭhare śayanam,","iha saṁsāre bahudustāre","kr̥payā’pāre pāhi murāre ॥21॥"]},{"id":"sh22","p":0,"s":"sh22","y":"shloka","n":"22","v":["रथ्याचर्पटविरचितकन्थः","पुण्यापुण्यविवर्जितपन्थः ।","योगी योगनियोजितचित्तो","रमते बालोन्मत्तवदेव ॥२२॥"],"t":["rathyācarpaṭaviracitakanthaḥ","puṇyāpuṇyavivarjitapanthaḥ,","yogī yoganiyojitacitto","ramate bālonmattavadeva ॥22॥"]},{"id":"sh23","p":0,"s":"sh23","y":"shloka","n":"23","v":["कस्त्वं कोऽहं कुत आयातः","का मे जननी को मे तातः ।","इति परिभावय सर्वमसारम्","विश्वं त्यक्त्वा स्वप्नविचारम् ॥२३॥"],"t":["kastvaṁ ko’haṁ kuta āyātaḥ","kā me jananī ko me tātaḥ,","iti paribhāvaya sarvamasāram","viśvaṁ tyaktvā svapnavicāram ॥23॥"]},{"id":"sh24","p":0,"s":"sh24","y":"shloka","n":"24","v":["त्वयि मयि चान्यत्रैको विष्णुर्व्यर्थं कुप्यसि मय्यसहिष्णुः ।","भव समचित्तः सर्वत्र त्वं","वाञ्छस्यचिराद्यदि विष्णुत्वम् ॥२४॥"],"t":["tvayi mayi cānyatraiko viṣṇurvyarthaṁ kupyasi mayyasahiṣṇuḥ,","bhava samacittaḥ sarvatra tvaṁ","vāñchasyacirādyadi viṣṇutvam ॥24॥"]},{"id":"sh25","p":0,"s":"sh25","y":"shloka","n":"25","v":["शत्रौ मित्रे पुत्रे बन्धौ","मा कुरु यत्नं विग्रहसन्धौ ।","सर्वस्मिन्नपि पश्यात्मानं","सर्वत्रोत्सृज भेदाज्ञानम् ॥२५॥"],"t":["śatrau mitre putre bandhau","mā kuru yatnaṁ vigrahasandhau,","sarvasminnapi paśyātmānaṁ","sarvatrotsr̥ja bhedājñānam ॥25॥"]},{"id":"sh26","p":0,"s":"sh26","y":"shloka","n":"26","v":["कामं क्रोधं लोभं मोहं","त्यक्त्वाऽऽत्मानं भावय कोऽहम् ।","आत्मज्ञानविहीना मूढास्ते पच्यन्ते नरकनिगूढाः ॥२६॥"],"t":["kāmaṁ krodhaṁ lobhaṁ mohaṁ","tyaktvā’’tmānaṁ bhāvaya ko’ham,","ātmajñānavihīnā mūḍhāste pacyante narakanigūḍhāḥ ॥26॥"]},{"id":"sh27","p":0,"s":"sh27","y":"shloka","n":"27","v":["गेयं गीतानामसहस्रं","ध्येयं श्रीपतिरूपमजस्रम् ।","नेयं सज्जनसङ्गे चित्तं","देयं दीनजनाय च वित्तम् ॥२७॥"],"t":["geyaṁ gītānāmasahasraṁ","dhyeyaṁ śrīpatirūpamajasram,","neyaṁ sajjanasaṅge cittaṁ","deyaṁ dīnajanāya ca vittam ॥27॥"]},{"id":"sh28","p":0,"s":"sh28","y":"shloka","n":"28","v":["सुखतः क्रियते रामाभोगः","पश्चाद्धन्त शरीरे रोगः ।","यद्यपि लोके मरणं शरणं","तदपि न मुञ्चति पापाचरणम् ॥२८॥"],"t":["sukhataḥ kriyate rāmābhogaḥ","paścāddhanta śarīre rogaḥ,","yadyapi loke maraṇaṁ śaraṇaṁ","tadapi na muñcati pāpācaraṇam ॥28॥"]},{"id":"sh29","p":0,"s":"sh29","y":"shloka","n":"29","v":["अर्थमनर्थं भावय नित्यं","नास्ति ततः सुखलेशः सत्यम् ।","पुत्रादपि धनभाजां भीतिः","सर्वत्रैषा विहिता रीतिः ॥२९॥"],"t":["arthamanarthaṁ bhāvaya nityaṁ","nāsti tataḥ sukhaleśaḥ satyam,","putrādapi dhanabhājāṁ bhītiḥ","sarvatraiṣā vihitā rītiḥ ॥29॥"]},{"id":"sh30","p":0,"s":"sh30","y":"shloka","n":"30","v":["प्राणायामं प्रत्याहारं","नित्यानित्य विवेकविचारम् ।","जाप्यसमेतसमाधिविधानं","कुर्ववधानं महदवधानम् ॥३०॥"],"t":["prāṇāyāmaṁ pratyāhāraṁ","nityānitya vivekavicāram,","jāpyasametasamādhividhānaṁ","kurvavadhānaṁ mahadavadhānam ॥30॥"]},{"id":"sh31","p":0,"s":"sh31","y":"shloka","n":"31","v":["गुरुचरणाम्बुजनिर्भरभक्तः","संसारादचिराद्भव मुक्तः ।","सेन्द्रियमानसनियमादेवं","द्रक्ष्यसि निजहृदयस्थं देवम् ॥३१॥"],"t":["gurucaraṇāmbujanirbharabhaktaḥ","saṁsārādacirādbhava muktaḥ,","sendriyamānasaniyamādevaṁ","drakṣyasi nijahr̥dayasthaṁ devam ॥31॥"]}],"topics":[{"id":"sh1","hi":"ध्रुवपद","en":"The refrain"},{"id":"sh2","hi":"द्वादशमञ्जरिका","en":"The twelve verses (Dvādaśa-mañjarikā)"},{"id":"sh14","hi":"चतुर्दशमञ्जरिका","en":"The fourteen verses (Caturdaśa-mañjarikā)"},{"id":"sh28","hi":"समापनके श्लोक","en":"The closing verses"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}},{"id":"en-sanskritdocuments","file":"meanings/en-sanskritdocuments","title":{"hi":"sanskritdocuments.org — अंग्रेज़ी अर्थ","en":"sanskritdocuments.org — English meaning"}}],"au":[]}}