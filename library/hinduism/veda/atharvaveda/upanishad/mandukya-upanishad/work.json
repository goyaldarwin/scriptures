{"id":"mandukya-upanishad","lang":"sa","title":{"hi":"माण्डूक्योपनिषद्","en":"Māṇḍūkya Upaniṣad"},"by":{"hi":"अथर्ववेद","en":"Atharvaveda"},"edition":{"hi":"sanskritdocuments.org","en":"sanskritdocuments.org"},"parts":{"name":{"hi":"उपनिषद्","en":"Upaniṣad"},"list":[{"hi":"माण्डूक्योपनिषद्","en":"Māṇḍūkya Upaniṣad"}]},"types":{"shanti":{"name":{"hi":"शान्तिमन्त्र","en":"Śānti Mantra"},"short":{"hi":"शा॰","en":"Śā."}},"mantra":{"name":{"hi":"मन्त्र","en":"Mantra"},"short":{"hi":"मं॰","en":"Man."}},"iti":{"name":{"hi":"समापन (पुष्पिका)","en":"Closing words (iti)"},"short":{"hi":"इति","en":"Iti"}}},"items":[{"id":"shanti.1","p":0,"s":"shanti.1","y":"shanti","n":"","v":["ॐ भद्रं कर्णेभिः शृणुयाम देवा भद्रं पश्येमाक्षभिर्यजत्राः ।","स्थिरैरङ्गैस्तुष्टुवांसस्तनूभिर्व्यशेम देवहितं यदायुः ।","स्वस्ति न इन्द्रो वृद्धश्रवाः स्वस्ति नः पूषा विश्ववेदाः ।","स्वस्ति नस्तार्क्ष्यो अरिष्टनेमिः स्वस्ति नो बृहस्पतिर्दधातु ।।","ॐ शान्तिः शान्तिः शान्तिः ।।"],"t":["oṁ bhadraṁ karṇebhiḥ śṛṇuyāma devā bhadraṁ paśyemākṣabhiryajatrāḥ,","sthirairaṅgaistuṣṭuvāṁsastanūbhirvyaśema devahitaṁ yadāyuḥ,","svasti na indro vṛddhaśravāḥ svasti naḥ pūṣā viśvavedāḥ,","svasti nastārkṣyo ariṣṭanemiḥ svasti no bṛhaspatirdadhātu.","oṁ śāntiḥ śāntiḥ śāntiḥ."]},{"id":"m01","p":0,"s":"m01","y":"mantra","n":"1","v":["हरिः ॐ ।","ॐ इत्येतदक्षरमिदꣳ सर्वं तस्योपव्याख्यानं","भूतं भवद् भविष्यदिति सर्वमोङ्कार एव","यच्चान्यत् त्रिकालातीतं तदप्योङ्कार एव ।।१।।"],"t":["hariḥ oṁ,","oṁ ityetadakṣaramidaṁ sarvaṁ tasyopavyākhyānaṁ","bhūtaṁ bhavad bhaviṣyaditi sarvamoṅkāra eva","yaccānyat trikālātītaṁ tadapyoṅkāra eva ॥1॥"]},{"id":"m02","p":0,"s":"m02","y":"mantra","n":"2","v":["सर्वं ह्येतद् ब्रह्मायमात्मा ब्रह्म सोऽयमात्मा चतुष्पात् ।।२।।"],"t":["sarvaṁ hyetad brahmāyamātmā brahma so’yamātmā catuṣpāt ॥2॥"]},{"id":"m03","p":0,"s":"m03","y":"mantra","n":"3","v":["जागरितस्थानो बहिष्प्रज्ञः सप्ताङ्ग एकोनविंशतिमुखः","स्थूलभुग्वैश्वानरः प्रथमः पादः ।।३।।"],"t":["jāgaritasthāno bahiṣprajñaḥ saptāṅga ekonaviṁśatimukhaḥ","sthūlabhugvaiśvānaraḥ prathamaḥ pādaḥ ॥3॥"]},{"id":"m04","p":0,"s":"m04","y":"mantra","n":"4","v":["स्वप्नस्थानोऽन्तःप्रज्ञः सप्ताङ्ग एकोनविंशतिमुखः","प्रविविक्तभुक्तैजसो द्वितीयः पादः ।।४।।"],"t":["svapnasthāno’ntaḥprajñaḥ saptāṅga ekonaviṁśatimukhaḥ","praviviktabhuktaijaso dvitīyaḥ pādaḥ ॥4॥"]},{"id":"m05","p":0,"s":"m05","y":"mantra","n":"5","v":["यत्र सुप्तो न कञ्चन कामं कामयते न कञ्चन स्वप्नं","पश्यति तत् सुषुप्तम् । सुषुप्तस्थान एकीभूतः प्रज्ञानघन","एवानन्दमयो ह्यानन्दभुक् चेतोमुखः प्राज्ञस्तृतीयः पादः ।।५।।"],"t":["yatra supto na kañcana kāmaṁ kāmayate na kañcana svapnaṁ","paśyati tat suṣuptam, suṣuptasthāna ekībhūtaḥ prajñānaghana","evānandamayo hyānandabhuk cetomukhaḥ prājñastṛtīyaḥ pādaḥ ॥5॥"]},{"id":"m06","p":0,"s":"m06","y":"mantra","n":"6","v":["एष सर्वेश्वरः एष सर्वज्ञ एषोऽन्तर्याम्येष योनिः सर्वस्य","प्रभवाप्ययौ हि भूतानाम् ।।६।।"],"t":["eṣa sarveśvaraḥ eṣa sarvajña eṣo’ntaryāmyeṣa yoniḥ sarvasya","prabhavāpyayau hi bhūtānām ॥6॥"]},{"id":"m07","p":0,"s":"m07","y":"mantra","n":"7","v":["नान्तःप्रज्ञं न बहिष्प्रज्ञं नोभयतःप्रज्ञं न प्रज्ञानघनं","न प्रज्ञं नाप्रज्ञम् । अदृष्टमव्यवहार्यमग्राह्यमलक्षणं","अचिन्त्यमव्यपदेश्यमेकात्मप्रत्ययसारं प्रपञ्चोपशमं","शान्तं शिवमद्वैतं चतुर्थं मन्यन्ते स आत्मा स विज्ञेयः ।।७।।"],"t":["nāntaḥprajñaṁ na bahiṣprajñaṁ nobhayataḥprajñaṁ na prajñānaghanaṁ","na prajñaṁ nāprajñam, adṛṣṭamavyavahāryamagrāhyamalakṣaṇaṁ","acintyamavyapadeśyamekātmapratyayasāraṁ prapañcopaśamaṁ","śāntaṁ śivamadvaitaṁ caturthaṁ manyante sa ātmā sa vijñeyaḥ ॥7॥"]},{"id":"m08","p":0,"s":"m08","y":"mantra","n":"8","v":["सोऽयमात्माध्यक्षरमोङ्कारोऽधिमात्रं पादा मात्रा मात्राश्च पादा","अकार उकारो मकार इति ।।८।।"],"t":["so’yamātmādhyakṣaramoṅkāro’dhimātraṁ pādā mātrā mātrāśca pādā","akāra ukāro makāra iti ॥8॥"]},{"id":"m09","p":0,"s":"m09","y":"mantra","n":"9","v":["जागरितस्थानो वैश्वानरोऽकारः प्रथमा मात्राऽऽप्तेरादिमत्त्वाद्","वाऽऽप्नोति ह वै सर्वान् कामानादिश्च भवति य एवं वेद ।।९।।"],"t":["jāgaritasthāno vaiśvānaro’kāraḥ prathamā mātrā’’pterādimattvād","vā’’pnoti ha vai sarvān kāmānādiśca bhavati ya evaṁ veda ॥9॥"]},{"id":"m10","p":0,"s":"m10","y":"mantra","n":"10","v":["स्वप्नस्थानस्तैजस उकारो द्वितीया मात्रोत्कर्षात्","उभयत्वाद्वोत्कर्षति ह वै ज्ञानसन्ततिं समानश्च भवति","नास्याब्रह्मवित्कुले भवति य एवं वेद ।।१०।।"],"t":["svapnasthānastaijasa ukāro dvitīyā mātrotkarṣāt","ubhayatvādvotkarṣati ha vai jñānasantatiṁ samānaśca bhavati","nāsyābrahmavitkule bhavati ya evaṁ veda ॥10॥"]},{"id":"m11","p":0,"s":"m11","y":"mantra","n":"11","v":["सुषुप्तस्थानः प्राज्ञो मकारस्तृतीया मात्रा मितेरपीतेर्वा","मिनोति ह वा इदं सर्वमपीतिश्च भवति य एवं वेद ।।११।।"],"t":["suṣuptasthānaḥ prājño makārastṛtīyā mātrā miterapītervā","minoti ha vā idaṁ sarvamapītiśca bhavati ya evaṁ veda ॥11॥"]},{"id":"m12","p":0,"s":"m12","y":"mantra","n":"12","v":["अमात्रश्चतुर्थोऽव्यवहार्यः प्रपञ्चोपशमः शिवोऽद्वैत","एवमोङ्कार आत्मैव संविशत्यात्मनाऽऽत्मानं य एवं वेद ।।१२।।"],"t":["amātraścaturtho’vyavahāryaḥ prapañcopaśamaḥ śivo’dvaita","evamoṅkāra ātmaiva saṁviśatyātmanā’’tmānaṁ ya evaṁ veda ॥12॥"]},{"id":"iti","p":0,"s":"iti","y":"iti","n":"","v":["।। इति माण्डूक्योपनिषत् समाप्ता ।।"],"t":[", , iti māṇḍūkyopaniṣat samāptā."]}],"topics":[{"id":"shanti.1","hi":"शान्तिपाठ","en":"Śānti Pāṭha"},{"id":"m01","hi":"ओंकार ही सब कुछ; आत्मा ही ब्रह्म","en":"Om is all; the Self is Brahman"},{"id":"m03","hi":"आत्माके चार पाद","en":"The four quarters of the Self"},{"id":"m08","hi":"ओंकारकी मात्राएँ और पाद","en":"The sounds of Om and the quarters"},{"id":"m12","hi":"मात्रारहित चौथा (तुरीय)","en":"The soundless Fourth"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[{"id":"smvedroad","file":"audio/smvedroad","title":{"hi":"SMVedroad","en":"SMVedroad"}}]},"glossary":true}