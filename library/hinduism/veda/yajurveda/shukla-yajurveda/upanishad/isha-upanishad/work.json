{"id":"isha-upanishad","lang":"sa","title":{"hi":"ईशावास्योपनिषद्","en":"Īśāvāsya Upaniṣad"},"by":{"hi":"शुक्ल यजुर्वेद, काण्व संहिता — अध्याय ४०","en":"Śukla Yajurveda, Kāṇva Saṃhitā — chapter 40"},"edition":{"hi":"shlokam.org","en":"shlokam.org"},"parts":{"name":{"hi":"उपनिषद्","en":"Upaniṣad"},"list":[{"hi":"ईशावास्योपनिषद्","en":"Īśāvāsya Upaniṣad"}]},"types":{"shanti":{"name":{"hi":"शान्तिमन्त्र","en":"Śānti Mantra"},"short":{"hi":"शा॰","en":"Śā."}},"mantra":{"name":{"hi":"मन्त्र","en":"Mantra"},"short":{"hi":"मं॰","en":"Man."}}},"items":[{"id":"shanti.1","p":0,"s":"shanti.1","y":"shanti","n":"","v":["ओं । पूर्णमदः पूर्णमिदं पूर्णात्पूर्णमुदच्यते ।","पूर्णस्य पूर्णमादाय पूर्णमेवावशिष्यते ।।","ओं शान्तिः शान्तिः शान्तिः ।।"],"t":["oṁ, pūrṇamadaḥ pūrṇamidaṁ pūrṇātpūrṇamudacyate,","pūrṇasya pūrṇamādāya pūrṇamevāvaśiṣyate ॥","oṁ śāntiḥ śāntiḥ śāntiḥ ॥"]},{"id":"m01","p":0,"s":"m01","y":"mantra","n":"1","v":["ईशावास्यमिदं सर्वं यत्किञ्च जगत्यां जगत् ।","तेन त्यक्तेन भुञ्जीथा मा गृधः कस्य स्विद्धनम् ।।१।।"],"t":["īśāvāsyamidaṁ sarvaṁ yatkiñca jagatyāṁ jagat,","tena tyaktena bhuñjīthā mā gṛdhaḥ kasya sviddhanam ॥1॥"]},{"id":"m02","p":0,"s":"m02","y":"mantra","n":"2","v":["कुर्वन्नेवेह कर्माणि जिजीविषेच्छतं समाः ।","एवं त्वयि नान्यथेतोऽस्ति न कर्म लिप्यते नरे ।।२।।"],"t":["kurvanneveha karmāṇi jijīviṣecchataṁ samāḥ,","evaṁ tvayi nānyatheto’sti na karma lipyate nare ॥2॥"]},{"id":"m03","p":0,"s":"m03","y":"mantra","n":"3","v":["असुर्या नाम ते लोका अन्धेन तमसावृताः ।","तांस्ते प्रेत्याभिगच्छन्ति ये के चात्महनो जनाः ।।३।।"],"t":["asuryā nāma te lokā andhena tamasāvṛtāḥ,","tāṁste pretyābhigacchanti ye ke cātmahano janāḥ ॥3॥"]},{"id":"m04","p":0,"s":"m04","y":"mantra","n":"4","v":["अनेजदेकं मनसो जवीयो नैनद्देवा आप्नुवन्पूर्वमर्षत् ।","तद्धावतोऽन्यानत्येति तिष्ठत्तस्मिन्नपो मातरिश्वा दधाति ।।४।।"],"t":["anejadekaṁ manaso javīyo nainaddevā āpnuvanpūrvamarṣat,","taddhāvato’nyānatyeti tiṣṭhattasminnapo mātariśvā dadhāti ॥4॥"]},{"id":"m05","p":0,"s":"m05","y":"mantra","n":"5","v":["तदेजति तन्नैजति तद्दूरे तद्वन्तिके ।","तदन्तरस्य सर्वस्य तदु सर्वस्यास्य बाह्यतः ।।५।।"],"t":["tadejati tannaijati taddūre tadvantike,","tadantarasya sarvasya tadu sarvasyāsya bāhyataḥ ॥5॥"]},{"id":"m06","p":0,"s":"m06","y":"mantra","n":"6","v":["यस्तु सर्वाणि भूतान्यात्मन्येवानुपश्यति ।","सर्वभूतेषु चात्मानं ततो न विजुगुप्सते ।।६।।"],"t":["yastu sarvāṇi bhūtānyātmanyevānupaśyati,","sarvabhūteṣu cātmānaṁ tato na vijugupsate ॥6॥"]},{"id":"m07","p":0,"s":"m07","y":"mantra","n":"7","v":["यस्मिन्सर्वाणि भूतान्यात्मैवाभूद्विजानतः ।","तत्र को मोहः कः शोक एकत्वमनुपश्यतः ।।७।।"],"t":["yasminsarvāṇi bhūtānyātmaivābhūdvijānataḥ,","tatra ko mohaḥ kaḥ śoka ekatvamanupaśyataḥ ॥7॥"]},{"id":"m08","p":0,"s":"m08","y":"mantra","n":"8","v":["स पर्यगाच्छुक्रमकायमव्रणमस्नाविरं शुद्धमपापविद्धम् ।","कविर्मनीषी परिभूः स्वयम्भूर्याथातथ्यतोऽर्थान्व्यदधाच्छाश्वतीभ्यः समाभ्यः ।।८।।"],"t":["sa paryagācchukramakāyamavraṇamasnāviraṁ śuddhamapāpaviddham,","kavirmanīṣī paribhūḥ svayambhūryāthātathyato’rthānvyadadhācchāśvatībhyaḥ samābhyaḥ ॥8॥"]},{"id":"m09","p":0,"s":"m09","y":"mantra","n":"9","v":["अन्धन्तमः प्रविशन्ति येऽविद्यामुपासते ।","ततो भूय इव ते तमो य उ विद्यायां रताः ।।९।।"],"t":["andhantamaḥ praviśanti ye’vidyāmupāsate,","tato bhūya iva te tamo ya u vidyāyāṁ ratāḥ ॥9॥"]},{"id":"m10","p":0,"s":"m10","y":"mantra","n":"10","v":["अन्यदेवाहुर्विद्ययाऽन्यदाहुरविद्यया ।","इति शुश्रुम धीराणां ये नस्तद्विचचक्षिरे ।।१०।।"],"t":["anyadevāhurvidyayā’nyadāhuravidyayā,","iti śuśruma dhīrāṇāṁ ye nastadvicacakṣire ॥10॥"]},{"id":"m11","p":0,"s":"m11","y":"mantra","n":"11","v":["विद्यां चाविद्यां च यस्तद्वेदोभयं सह ।","अविद्यया मृत्युं तीर्त्वा विद्ययामृतमश्नुते ।।११।।"],"t":["vidyāṁ cāvidyāṁ ca yastadvedobhayaṁ saha,","avidyayā mṛtyuṁ tīrtvā vidyayāmṛtamaśnute ॥11॥"]},{"id":"m12","p":0,"s":"m12","y":"mantra","n":"12","v":["अन्धं तमः प्रविशन्ति येऽसम्भूतिमुपासते ।","ततो भूय इव ते तमो य उ संभूत्यां रताः ।।१२।।"],"t":["andhaṁ tamaḥ praviśanti ye’sambhūtimupāsate,","tato bhūya iva te tamo ya u saṁbhūtyāṁ ratāḥ ॥12॥"]},{"id":"m13","p":0,"s":"m13","y":"mantra","n":"13","v":["अन्यदेवाहुः संभवादन्यदाहुरसंभवात् ।","इति शुश्रुम धीराणां ये नस्तद्विचचक्षिरे ।।१३।।"],"t":["anyadevāhuḥ saṁbhavādanyadāhurasaṁbhavāt,","iti śuśruma dhīrāṇāṁ ye nastadvicacakṣire ॥13॥"]},{"id":"m14","p":0,"s":"m14","y":"mantra","n":"14","v":["संभूतिं च विनाशं च यस्तद्वेदोभयं सह ।","विनाशेन मृत्युं तीर्त्वा संभूत्यामृतमश्नुते ।।१४।।"],"t":["saṁbhūtiṁ ca vināśaṁ ca yastadvedobhayaṁ saha,","vināśena mṛtyuṁ tīrtvā saṁbhūtyāmṛtamaśnute ॥14॥"]},{"id":"m15","p":0,"s":"m15","y":"mantra","n":"15","v":["हिरण्मयेन पात्रेण सत्यस्यापिहितं मुखम् ।","तत्त्वं पूषन्नपावृणु सत्यधर्माय दृष्टये ।।१५।।"],"t":["hiraṇmayena pātreṇa satyasyāpihitaṁ mukham,","tattvaṁ pūṣannapāvṛṇu satyadharmāya dṛṣṭaye ॥15॥"]},{"id":"m16","p":0,"s":"m16","y":"mantra","n":"16","v":["पूषन्नेकर्षे यम सूर्य प्राजापत्य व्यूह रश्मीन्समूह तेजः ।","यत्ते रूपं कल्याणतमं तत्ते पश्यामि योऽसावसौ पुरुषः सोऽहमस्मि ।।१६।।"],"t":["pūṣannekarṣe yama sūrya prājāpatya vyūha raśmīnsamūha tejaḥ,","yatte rūpaṁ kalyāṇatamaṁ tatte paśyāmi yo’sāvasau puruṣaḥ so’hamasmi ॥16॥"]},{"id":"m17","p":0,"s":"m17","y":"mantra","n":"17","v":["वायुरनिलममृतमथेदं भस्मान्तं शरीरम् ।","ओं । क्रतो स्मर कृतं स्मर क्रतो स्मर कृतं स्मर ।।१७।।"],"t":["vāyuranilamamṛtamathedaṁ bhasmāntaṁ śarīram,","oṁ, krato smara kṛtaṁ smara krato smara kṛtaṁ smara ॥17॥"]},{"id":"m18","p":0,"s":"m18","y":"mantra","n":"18","v":["अग्ने नय सुपथा राये अस्मान्विश्वानि देव वयुनानि विद्वान् ।","युयोध्यस्मज्जुहुराणमेनो भूयिष्ठां ते नम उक्तिं विधेम ।।१८।।"],"t":["agne naya supathā rāye asmānviśvāni deva vayunāni vidvān,","yuyodhyasmajjuhurāṇameno bhūyiṣṭhāṁ te nama uktiṁ vidhema ॥18॥"]}],"topics":[{"id":"shanti.1","hi":"शान्तिपाठ","en":"Śānti Pāṭha"},{"id":"m01","hi":"ईश्वरसे व्याप्त जगत् और त्याग","en":"The Lord-pervaded world and renunciation"},{"id":"m03","hi":"आत्माका स्वरूप","en":"The nature of the Self"},{"id":"m09","hi":"विद्या और अविद्या, सम्भूति और असम्भूति","en":"Vidyā and avidyā, sambhūti and asambhūti"},{"id":"m15","hi":"अन्तकालकी प्रार्थनाएँ","en":"Prayers at life’s end"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"}}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"}}],"au":[]},"glossary":true}