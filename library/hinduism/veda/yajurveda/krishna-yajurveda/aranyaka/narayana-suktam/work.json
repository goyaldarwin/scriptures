{"id":"narayana-suktam","lang":"sa","title":{"hi":"नारायणसूक्तम्","en":"Narayana Suktam"},"by":{"hi":"कृष्ण यजुर्वेद, तैत्तिरीय आरण्यक, प्रपाठक १० (महानारायण)","en":"Krishna Yajurveda, Taittiriya Aranyaka, prapathaka 10 (Mahanarayana)"},"edition":{"hi":"श्लोकम् (shlokam.org)","en":"Shlokam (shlokam.org)"},"parts":{"name":{"hi":"सूक्त","en":"Sukta"},"list":[{"hi":"नारायणसूक्तम्","en":"Narayana Suktam"}]},"types":{"shanti":{"name":{"hi":"शान्तिमन्त्र","en":"Shanti Mantra"},"short":{"hi":"शा॰","en":"Shan."}},"mantra":{"name":{"hi":"मन्त्र","en":"Mantra"},"short":{"hi":"मं॰","en":"Man."}},"gayatri":{"name":{"hi":"गायत्री मन्त्र","en":"Gayatri mantra"},"short":{"hi":"गा॰","en":"Gay."}}},"items":[{"id":"shanti.1","p":0,"s":"shanti","y":"shanti","n":"","v":["ॐ स॒ह ना॑ववतु । स॒ह नौ॑ भुनक्तु । स॒ह वी॒र्य॑-ङ्करवावहै ।","ते॒ज॒स्विना॒वधी॑तमस्तु॒ मा वि॑द्विषा॒वहै᳚ ॥","ॐ शान्ति॒-श्शान्ति॒-श्शान्तिः॑ ॥"],"c":"","t":["oṁ sa̠ha nā̍vavatu, sa̠ha nau̍ bhunaktu, sa̠ha vī̠rya̍-ṅkaravāvahai,","te̠ja̠svinā̠vadhī̍tamastu̠ mā vi̍dviṣā̠vahai̎.","oṁ śānti̠-śśānti̠-śśānti̍ḥ."]},{"id":"m17","s":"sukta","y":"mantra","n":"17","v":["धा॒ता पु॒रस्ता॒द्यमु॑दाज॒हार॑ । श॒क्रः प्रवि॒द्वा-न्प्र॒दिश॒श्चत॑स्रः ।","तमे॒वं-विँ॒द्वान॒मृत॑ इ॒ह भ॑वति । नान्यः पन्था॒ अय॑नाय विद्यते ॥"],"c":"17","p":0,"t":["dhā̠tā pu̠rastā̠dyamu̍dāja̠hāra̍, śa̠kraḥ pravi̠dvā-npra̠diśa̠ścata̍sraḥ,","tame̠vaṁ-vi̠m̐dvāna̠mr̥ta̍ i̠ha bha̍vati, nānyaḥ panthā̠ aya̍nāya vidyate."]},{"id":"m01","p":0,"s":"sukta","y":"mantra","n":"1","v":["ॐ ॥ स॒ह॒स्र॒शीर्॑ष-न्दे॒वं॒ वि॒श्वाक्षं॑-विँ॒श्वश॑म्भुवम् ।","विश्व॑-न्ना॒राय॑ण-न्दे॒व॒म॒क्षर॑-म्पर॒म-म्प॒दम् ।"],"c":"1","t":["oṁ ॥ sa̠ha̠sra̠śī̍rṣa-nde̠va̠ṁ vi̠śvākṣa̍ṁ-vi̠m̐śvaśa̍mbhuvam,","viśva̍-nnā̠rāya̍ṇa-nde̠va̠ma̠kṣara̍-mpara̠ma-mpa̠dam,"]},{"id":"m02","p":0,"s":"sukta","y":"mantra","n":"2","v":["वि॒श्वतः॒ पर॑मान्नि॒त्यं॒-विँ॒श्व-न्ना॑राय॒णꣳ ह॑रिम् ।","विश्व॑मे॒वेद-म्पुरु॑ष॒-स्तद्विश्व॒-मुप॑जीवति ।"],"c":"2","t":["vi̠śvata̠ḥ para̍mānni̠tya̠ṁ-vi̠m̐śva-nnā̍rāya̠ṇagͫ ha̍rim,","viśva̍me̠veda-mpuru̍ṣa̠-stadviśva̠-mupa̍jīvati,"]},{"id":"m03","p":0,"s":"sukta","y":"mantra","n":"3","v":["पतिं॒-विँश्व॑स्या॒त्मेश्व॑र॒ꣳ॒ शाश्व॑तꣳ शि॒व-म॑च्युतम् ।","ना॒राय॒ण-म्म॑हाज्ञे॒यं॒-विँ॒श्वात्मा॑न-म्प॒राय॑णम् ।"],"c":"3","t":["pati̠ṁ-vim̐śva̍syā̠tme̠śva̍ra̠gͫ śāśva̍tagͫ śi̠va-ma̍cyutam,","nā̠rāya̠ṇa-mma̍hājñe̠ya̠ṁ-vi̠m̐śvātmā̍na-mpa̠rāya̍ṇam,"]},{"id":"m04","p":0,"s":"sukta","y":"mantra","n":"4","v":["ना॒राय॒णप॑रो ज्यो॒ति॒रा॒त्मा ना॑राय॒णः प॑रः ।","ना॒राय॒णपर॑-म्ब्र॒ह्म॒ तत्त्व-न्ना॑राय॒णः प॑रः ।"],"c":"4","t":["nā̠rāya̠ṇapa̍ro jyo̠ti̠rā̠tmā nā̍rāya̠ṇaḥ pa̍raḥ,","nā̠rāya̠ṇapara̍-mbra̠hma̠ tattva-nnā̍rāya̠ṇaḥ pa̍raḥ,"]},{"id":"m05","p":0,"s":"sukta","y":"mantra","n":"5","v":["ना॒राय॒णप॑रो ध्या॒ता॒ ध्या॒न-न्ना॑राय॒णः प॑रः ।","यच्च॑ कि॒ञ्चिज्ज॑गत्स॒र्व॒-न्दृ॒श्यते᳚ श्रूय॒ते-ऽपि॑ वा ॥"],"c":"5","t":["nā̠rāya̠ṇapa̍ro dhyā̠tā̠ dhyā̠na-nnā̍rāya̠ṇaḥ pa̍raḥ,","yacca̍ ki̠ñcijja̍gatsa̠rva̠-ndr̥̠śyate̎ śrūya̠te-’pi̍ vā."]},{"id":"m06","p":0,"s":"sukta","y":"mantra","n":"6","v":["अन्त॑र्ब॒हिश्च॑ तत्स॒र्वं॒-व्याँ॒प्य ना॑राय॒ण-स्स्थि॑तः ।","अनन्त॒मव्यय॑-ङ्क॒विꣳ स॑मु॒द्रे-ऽन्तं॑-विँ॒श्वश॑म्भुवम् ।"],"c":"6","t":["anta̍rba̠hiśca̍ tatsa̠rva̠ṁ-vyā̠m̐pya nā̍rāya̠ṇa-ssthi̍taḥ,","ananta̠mavyaya̍-ṅka̠vigͫ sa̍mu̠dre-’nta̍ṁ-vi̠m̐śvaśa̍mbhuvam,"]},{"id":"m07","p":0,"s":"sukta","y":"mantra","n":"7","v":["प॒द्म॒को॒श-प्र॑तीका॒श॒ꣳ॒ हृ॒दय॑-ञ्चाप्य॒धोमु॑खम् ।","अधो॑ नि॒ष्ट्या वि॑तस्त्या॒न्ते॒ ना॒भ्यामु॑परि॒ तिष्ठ॑ति ।"],"c":"7","t":["pa̠dma̠ko̠śa-pra̍tī̠kā̠śa̠gͫ hr̥̠daya̍-ñcāpya̠dhomu̍kham,","adho̍ ni̠ṣṭyā vi̍tastyā̠nte̠ nā̠bhyāmu̍pari̠ tiṣṭha̍ti,"]},{"id":"m08","p":0,"s":"sukta","y":"mantra","n":"8","v":["ज्वा॒ल॒मा॒लाकु॑ल-म्भा॒ती॒ वि॒श्वस्या॑यत॒न-म्म॑हत् ।","सन्त॑तꣳ सि॒राभि॑स्तु॒ लम्ब॑त्याकोश॒सन्नि॑भम् ।"],"c":"8","t":["jvā̠la̠mā̠lāku̍la-mbhā̠tī̠ vi̠śvasyā̍yata̠na-mma̍hat,","santa̍tagͫ si̠rābhi̍stu̠ lamba̍tyākośa̠sanni̍bham,"]},{"id":"m09","p":0,"s":"sukta","y":"mantra","n":"9","v":["तस्यान्ते॑ सुषि॒रꣳ सू॒क्ष्म-न्तस्मिन्᳚ स॒र्व-म्प्रति॑ष्ठितम् ।","तस्य॒ मध्ये॑ म॒हान॑ग्नि-र्वि॒श्वार्चि॑-र्वि॒श्वतो॑मुखः ।"],"c":"9","t":["tasyānte̍ suṣi̠ragͫ sū̠kṣma-ntasmi̎n sa̠rva-mprati̍ṣṭhitam,","tasya̠ madhye̍ ma̠hāna̍gni-rvi̠śvārci̍-rvi̠śvato̍mukhaḥ,"]},{"id":"m10","p":0,"s":"sukta","y":"mantra","n":"10","v":["सो-ऽग्र॑भु॒ग्विभ॑जन्ति॒ष्ठ॒-न्नाहा॑रमज॒रः क॒विः ।","ति॒र्य॒गू॒र्ध्वम॑धश्शा॒यी॒ र॒श्मय॑स्तस्य॒ सन्त॑ताः ।"],"c":"10","t":["so-’gra̍bhu̠gvibha̍janti̠ṣṭha̠-nnāhā̍ramaja̠raḥ ka̠viḥ,","ti̠rya̠gū̠rdhvama̍dhaśśā̠yī̠ ra̠śmaya̍stasya̠ santa̍tāḥ,"]},{"id":"m11","p":0,"s":"sukta","y":"mantra","n":"11","v":["स॒न्ता॒पय॑ति स्व-न्दे॒हमापा॑दतल॒मस्त॑कः ।","तस्य॒ मध्ये॒ वह्नि॑शिखा अ॒णीयो᳚र्ध्वा व्य॒वस्थि॑तः ।"],"c":"11","t":["sa̠ntā̠paya̍ti sva-nde̠hamāpā̍datala̠masta̍kaḥ,","tasya̠ madhye̠ vahni̍śikhā a̠ṇīyo̎rdhvā vya̠vasthi̍taḥ,"]},{"id":"m12","p":0,"s":"sukta","y":"mantra","n":"12","v":["नी॒लतो॑-यद॑मध्य॒स्था॒-द्वि॒द्युल्ले॑खेव॒ भास्व॑रा ।","नी॒वार॒शूक॑वत्त॒न्वी॒ पी॒ता भा᳚स्वत्य॒णूप॑मा ।"],"c":"12","t":["nī̠lato̍-yada̍madhya̠sthā̠-dvi̠dyulle̍kheva̠ bhāsva̍rā,","nī̠vāra̠śūka̍vatta̠nvī̠ pī̠tā bhā̎svatya̠ṇūpa̍mā,"]},{"id":"m13","p":0,"s":"sukta","y":"mantra","n":"13","v":["तस्या᳚-श्शिखा॒या म॑ध्ये प॒रमा᳚त्मा व्य॒वस्थि॑तः ।","स ब्रह्म॒ स शिव॒-स्स हरि॒-स्सेन्द्र॒-स्सो-ऽक्ष॑रः पर॒म-स्स्व॒राट् ॥"],"c":"13","t":["tasyā̎-śśikhā̠yā ma̍dhye pa̠ramā̎tmā vya̠vasthi̍taḥ,","sa brahma̠ sa śiva̠-ssa hari̠-ssendra̠-sso-’kṣa̍raḥ para̠ma-ssva̠rāṭ."]},{"id":"m14","p":0,"s":"sukta","y":"mantra","n":"14","v":["ऋ॒तꣳ स॒त्य-म्प॑र-म्ब्र॒ह्म॒ पु॒रुष॑-ङ्कृष्ण॒पिङ्ग॑लम् ।","ऊ॒र्ध्वरे॑तं-विँ॑रूपा॒क्षं॒-विँ॒श्वरू॑पाय॒ वै नमो॒ नमः॑ ॥"],"c":"14","t":["r̥̠tagͫ sa̠tya-mpa̍ra-mbra̠hma̠ pu̠ruṣa̍-ṅkr̥ṣṇa̠piṅga̍lam,","ū̠rdhvare̍taṁ-vi̍m̐rūpā̠kṣa̠ṁ-vi̠m̐śvarū̍pāya̠ vai namo̠ nama̍ḥ."]},{"id":"gayatri","p":0,"s":"end","y":"gayatri","n":"","v":["ओ-न्ना॒रा॒य॒णाय॑ वि॒द्महे॑ वासुदे॒वाय॑ धीमहि ।","तन्नो॑ विष्णुः प्रचो॒दया᳚त् ॥"],"c":"","t":["o-nnā̠rā̠ya̠ṇāya̍ vi̠dmahe̍ vāsude̠vāya̍ dhīmahi,","tanno̍ viṣṇuḥ praco̠dayā̎t."]},{"id":"shanti.end","p":0,"s":"end","y":"shanti","n":"","v":["ॐ शान्ति॒-श्शान्ति॒-श्शान्तिः॑ ॥"],"c":"","t":["oṁ śānti̠-śśānti̠-śśānti̍ḥ."]}],"topics":[{"id":"shanti.1","hi":"शान्तिपाठ","en":"Shanti Paath"},{"id":"m17","hi":"आरम्भ: धाता पुरस्तात्","en":"Opening: Dhata purastat"},{"id":"m01","hi":"नारायण ही सब कुछ, सबसे परे","en":"Narayana, all that is and beyond all"},{"id":"m07","hi":"हृदय-कमलमें अग्निशिखा और परमात्मा","en":"The flame in the lotus of the heart, and the Supreme within it"},{"id":"gayatri","hi":"नारायण गायत्री और शान्ति","en":"Narayana Gayatri and shanti"}],"sources":{"hi":[{"id":"hi-scriptures","file":"meanings/hi-scriptures","title":{"hi":"भावार्थ — शास्त्र","en":"Hindi meaning — Scriptures"},"notes":true,"lines":true}],"en":[{"id":"en-scriptures","file":"meanings/en-scriptures","title":{"hi":"अंग्रेज़ी अर्थ — शास्त्र","en":"English meaning — Scriptures"},"notes":true,"lines":true}],"au":[{"id":"sri-sathya-sai","file":"audio/sri-sathya-sai","title":{"hi":"श्री सत्य साई (आधिकारिक)","en":"Sri Sathya Sai Official"},"draft":true}]}}