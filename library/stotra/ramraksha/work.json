{"id":"ramraksha","lang":"sa","title":{"hi":"श्रीरामरक्षास्तोत्रम्","en":"Śrī Rāma Rakṣā Stotram"},"by":{"hi":"बुधकौशिक ऋषि","en":"Budha Kauśika Ṛṣi"},"edition":{"hi":"वन्दे गुरु परम्पराम्","en":"Vande Guru Paramparaam"},"parts":{"name":{"hi":"पाठ","en":"Pāṭha"},"list":[{"hi":"श्रीरामरक्षास्तोत्रम्","en":"Śrī Rāma Rakṣā Stotram"}]},"types":{"mantra":{"name":{"hi":"मन्त्र","en":"Mantra"},"short":{"hi":"मं॰","en":"Man."}},"viniyoga":{"name":{"hi":"विनियोग","en":"Viniyoga"},"short":{"hi":"विनि॰","en":"Vin."}},"dhyana":{"name":{"hi":"ध्यान","en":"Dhyāna"},"short":{"hi":"ध्या॰","en":"Dhy."}},"shloka":{"name":{"hi":"श्लोक","en":"Śloka"},"short":{"hi":"श्लो॰","en":"Śl."}},"iti":{"name":{"hi":"पुष्पिका","en":"Colophon"},"short":{"hi":"इति","en":"Iti"}}},"items":[{"id":"mangal","p":0,"s":"mangal","y":"mantra","n":"","v":["।। ॐ श्रीगणेशाय नमः ।।"],"t":["॥ oṁ śrīgaṇeśāya namaḥ ॥"]},{"id":"viniyoga","p":0,"s":"viniyoga","y":"viniyoga","n":"","v":["अस्य श्रीरामरक्षास्तोत्रमन्त्रस्य ।","बुधकौशिक ऋषिः ।","श्रीसीतारामचन्द्रो देवता ।","अनुष्टुप् छन्दः ।","सीता शक्तिः ।","श्रीमान् हनुमान् कीलकम् ।","श्रीरामचन्द्रप्रीत्यर्थे रामरक्षास्तोत्रजपे विनियोगः ।।"],"t":["asya śrīrāmarakṣāstotramantrasya,","budhakauśika ṛṣiḥ,","śrīsītārāmacandro devatā,","anuṣṭup chandaḥ,","sītā śaktiḥ,","śrīmān hanumān kīlakam,","śrīrāmacandraprītyarthe rāmarakṣāstotrajape viniyogaḥ ॥"]},{"id":"dhyana","p":0,"s":"dhyana","y":"dhyana","n":"","v":["ध्यायेदाजानुबाहुं धृतशरधनुषं बद्धपद्मासनस्थं","पीतं वासो वसानं नवकमलदलस्पर्धिनेत्रं प्रसन्नम् ।","वामाङ्कारूढसीतामुखकमलमिलल्लोचनं नीरदाभं","नानालङ्कारदीप्तं दधतमुरुजटामण्डलं रामचन्द्रम् ।।"],"t":["dhyāyedājānubāhuṁ dhṛtaśaradhanuṣaṁ baddhapadmāsanasthaṁ","pītaṁ vāso vasānaṁ navakamaladalaspardhinetraṁ prasannam,","vāmāṅkārūḍhasītāmukhakamalamilallocanaṁ nīradābhaṁ","nānālaṅkāradīptaṁ dadhatamurujaṭāmaṇḍalaṁ rāmacandram ॥"]},{"id":"sh1","p":0,"s":"sh1","y":"shloka","n":"1","v":["चरितं रघुनाथस्य शतकोटिप्रविस्तरम् ।","एकैकमक्षरं पुंसां महापातकनाशनम् ।।१।।"],"t":["caritaṁ raghunāthasya śatakoṭipravistaram,","ekaikamakṣaraṁ puṁsāṁ mahāpātakanāśanam ॥1॥"]},{"id":"sh2","p":0,"s":"sh2","y":"shloka","n":"2","v":["ध्यात्वा नीलोत्पलश्यामं रामं राजीवलोचनम् ।","जानकीलक्ष्मणोपेतं जटामुकुटमण्डितम् ।।२।।"],"t":["dhyātvā nīlotpalaśyāmaṁ rāmaṁ rājīvalocanam,","jānakīlakṣmaṇopetaṁ jaṭāmukuṭamaṇḍitam ॥2॥"]},{"id":"sh3","p":0,"s":"sh3","y":"shloka","n":"3","v":["सासितूणधनुर्बाणपाणिं नक्तंचरान्तकम् ।","स्वलीलया जगत्त्रातुमाविर्भूतमजं विभुम् ।।३।।"],"t":["sāsitūṇadhanurbāṇapāṇiṁ naktaṁcarāntakam,","svalīlayā jagattrātumāvirbhūtamajaṁ vibhum ॥3॥"]},{"id":"sh4","p":0,"s":"sh4","y":"shloka","n":"4","v":["रामरक्षां पठेत्प्राज्ञः पापघ्नीं सर्वकामदाम् ।","शिरो मे राघवः पातु भालं दशरथात्मजः ।।४।।"],"t":["rāmarakṣāṁ paṭhetprājñaḥ pāpaghnīṁ sarvakāmadām,","śiro me rāghavaḥ pātu bhālaṁ daśarathātmajaḥ ॥4॥"]},{"id":"sh5","p":0,"s":"sh5","y":"shloka","n":"5","v":["कौसल्येयो दृशौ पातु विश्वामित्रप्रियः श्रुती ।","घ्राणं पातु मखत्राता मुखं सौमित्रिवत्सलः ।।५।।"],"t":["kausalyeyo dṛśau pātu viśvāmitrapriyaḥ śrutī,","ghrāṇaṁ pātu makhatrātā mukhaṁ saumitrivatsalaḥ ॥5॥"]},{"id":"sh6","p":0,"s":"sh6","y":"shloka","n":"6","v":["जिह्वां विद्यानिधिः पातु कण्ठं भरतवन्दितः ।","स्कन्धौ दिव्यायुधः पातु भुजौ भग्नेशकार्मुकः ।।६।।"],"t":["jihvāṁ vidyānidhiḥ pātu kaṇṭhaṁ bharatavanditaḥ,","skandhau divyāyudhaḥ pātu bhujau bhagneśakārmukaḥ ॥6॥"]},{"id":"sh7","p":0,"s":"sh7","y":"shloka","n":"7","v":["करौ सीतापतिः पातु हृदयं जामदग्न्यजित् ।","मध्यं पातु खरध्वंसी नाभिं जाम्बवदाश्रयः ।।७।।"],"t":["karau sītāpatiḥ pātu hṛdayaṁ jāmadagnyajit,","madhyaṁ pātu kharadhvaṁsī nābhiṁ jāmbavadāśrayaḥ ॥7॥"]},{"id":"sh8","p":0,"s":"sh8","y":"shloka","n":"8","v":["सुग्रीवेशः कटी पातु सक्थिनी हनुमत्प्रभुः ।","ऊरू रघूत्तमः पातु रक्षःकुलविनाशकृत् ।।८।।"],"t":["sugrīveśaḥ kaṭī pātu sakthinī hanumatprabhuḥ,","ūrū raghūttamaḥ pātu rakṣaḥkulavināśakṛt ॥8॥"]},{"id":"sh9","p":0,"s":"sh9","y":"shloka","n":"9","v":["जानुनी सेतुकृत्पातु जङ्घे दशमुखान्तकः ।","पादौ विभीषणश्रीदः पातु रामोऽखिलं वपुः ।।९।।"],"t":["jānunī setukṛtpātu jaṅghe daśamukhāntakaḥ,","pādau vibhīṣaṇaśrīdaḥ pātu rāmo’khilaṁ vapuḥ ॥9॥"]},{"id":"sh10","p":0,"s":"sh10","y":"shloka","n":"10","v":["एतां रामबलोपेतां रक्षां यः सुकृती पठेत् ।","स चिरायुः सुखी पुत्री विजयी विनयी भवेत् ।।१०।।"],"t":["etāṁ rāmabalopetāṁ rakṣāṁ yaḥ sukṛtī paṭhet,","sa cirāyuḥ sukhī putrī vijayī vinayī bhavet ॥10॥"]},{"id":"sh11","p":0,"s":"sh11","y":"shloka","n":"11","v":["पातालभूतलव्योमचारिणश्छद्मचारिणः ।","न द्रष्टुमपि शक्तास्ते रक्षितं रामनामभिः ।।११।।"],"t":["pātālabhūtalavyomacāriṇaśchadmacāriṇaḥ,","na draṣṭumapi śaktāste rakṣitaṁ rāmanāmabhiḥ ॥11॥"]},{"id":"sh12","p":0,"s":"sh12","y":"shloka","n":"12","v":["रामेति रामभद्रेति रामचन्द्रेति वा स्मरन् ।","नरो न लिप्यते पापैः भुक्तिं मुक्तिं च विन्दति ।।१२।।"],"t":["rāmeti rāmabhadreti rāmacandreti vā smaran,","naro na lipyate pāpaiḥ bhuktiṁ muktiṁ ca vindati ॥12॥"]},{"id":"sh13","p":0,"s":"sh13","y":"shloka","n":"13","v":["जगज्जैत्रैकमन्त्रेण रामनाम्नाभिरक्षितम् ।","यः कण्ठे धारयेत्तस्य करस्थाः सर्वसिद्धयः ।।१३।।"],"t":["jagajjaitraikamantreṇa rāmanāmnābhirakṣitam,","yaḥ kaṇṭhe dhārayettasya karasthāḥ sarvasiddhayaḥ ॥13॥"]},{"id":"sh14","p":0,"s":"sh14","y":"shloka","n":"14","v":["वज्रपञ्जरनामेदं यो रामकवचं स्मरेत् ।","अव्याहताज्ञः सर्वत्र लभते जयमङ्गलम् ।।१४।।"],"t":["vajrapañjaranāmedaṁ yo rāmakavacaṁ smaret,","avyāhatājñaḥ sarvatra labhate jayamaṅgalam ॥14॥"]},{"id":"sh15","p":0,"s":"sh15","y":"shloka","n":"15","v":["आदिष्टवान् यथा स्वप्ने रामरक्षामिमां हरः ।","तथा लिखितवान् प्रातः प्रबुद्धो बुधकौशिकः ।।१५।।"],"t":["ādiṣṭavān yathā svapne rāmarakṣāmimāṁ haraḥ,","tathā likhitavān prātaḥ prabuddho budhakauśikaḥ ॥15॥"]},{"id":"sh16","p":0,"s":"sh16","y":"shloka","n":"16","v":["आरामः कल्पवृक्षाणां विरामः सकलापदाम् ।","अभिरामस्त्रिलोकानां रामः श्रीमान् स नः प्रभुः ।।१६।।"],"t":["ārāmaḥ kalpavṛkṣāṇāṁ virāmaḥ sakalāpadām,","abhirāmastrilokānāṁ rāmaḥ śrīmān sa naḥ prabhuḥ ॥16॥"]},{"id":"sh17","p":0,"s":"sh17","y":"shloka","n":"17","v":["तरुणौ रूपसम्पन्नौ सुकुमारौ महाबलौ ।","पुण्डरीकविशालाक्षौ चीरकृष्णाजिनाम्बरौ ।।१७।।"],"t":["taruṇau rūpasampannau sukumārau mahābalau,","puṇḍarīkaviśālākṣau cīrakṛṣṇājināmbarau ॥17॥"]},{"id":"sh18","p":0,"s":"sh18","y":"shloka","n":"18","v":["फलमूलाशिनौ दान्तौ तापसौ ब्रह्मचारिणौ ।","पुत्रौ दशरथस्यैतौ भ्रातरौ रामलक्ष्मणौ ।।१८।।"],"t":["phalamūlāśinau dāntau tāpasau brahmacāriṇau,","putrau daśarathasyaitau bhrātarau rāmalakṣmaṇau ॥18॥"]},{"id":"sh19","p":0,"s":"sh19","y":"shloka","n":"19","v":["शरण्यौ सर्वसत्त्वानां श्रेष्ठौ सर्वधनुष्मताम् ।","रक्षःकुलनिहन्तारौ त्रायेतां नो रघूत्तमौ ।।१९।।"],"t":["śaraṇyau sarvasattvānāṁ śreṣṭhau sarvadhanuṣmatām,","rakṣaḥkulanihantārau trāyetāṁ no raghūttamau ॥19॥"]},{"id":"sh20","p":0,"s":"sh20","y":"shloka","n":"20","v":["आत्तसज्जधनुषाविषुस्पृशावक्षयाशुगनिषङ्गसङ्गिनौ ।","रक्षणाय मम रामलक्ष्मणावग्रतः पथि सदैव गच्छताम् ।।२०।।"],"t":["āttasajjadhanuṣāviṣuspṛśāvakṣayāśuganiṣaṅgasaṅginau,","rakṣaṇāya mama rāmalakṣmaṇāvagrataḥ pathi sadaiva gacchatām ॥20॥"]},{"id":"sh21","p":0,"s":"sh21","y":"shloka","n":"21","v":["सन्नद्धः कवची खड्गी चापबाणधरो युवा ।","गच्छन्मनोरथान्नश्च रामः पातु सलक्ष्मणः ।।२१।।"],"t":["sannaddhaḥ kavacī khaḍgī cāpabāṇadharo yuvā,","gacchanmanorathānnaśca rāmaḥ pātu salakṣmaṇaḥ ॥21॥"]},{"id":"sh22","p":0,"s":"sh22","y":"shloka","n":"22","v":["रामो दाशरथिः शूरो लक्ष्मणानुचरो बली ।","काकुत्स्थः पुरुषः पूर्णः कौसल्येयो रघूत्तमः ।।२२।।"],"t":["rāmo dāśarathiḥ śūro lakṣmaṇānucaro balī,","kākutsthaḥ puruṣaḥ pūrṇaḥ kausalyeyo raghūttamaḥ ॥22॥"]},{"id":"sh23","p":0,"s":"sh23","y":"shloka","n":"23","v":["वेदान्तवेद्यो यज्ञेशः पुराणपुरुषोत्तमः ।","जानकीवल्लभः श्रीमान् अप्रमेयपराक्रमः ।।२३।।"],"t":["vedāntavedyo yajñeśaḥ purāṇapuruṣottamaḥ,","jānakīvallabhaḥ śrīmān aprameyaparākramaḥ ॥23॥"]},{"id":"sh24","p":0,"s":"sh24","y":"shloka","n":"24","v":["इत्येतानि जपन्नित्यं मद्भक्तः श्रद्धयान्वितः ।","अश्वमेधाधिकं पुण्यं सम्प्राप्नोति न संशयः ।।२४।।"],"t":["ityetāni japannityaṁ madbhaktaḥ śraddhayānvitaḥ,","aśvamedhādhikaṁ puṇyaṁ samprāpnoti na saṁśayaḥ ॥24॥"]},{"id":"sh25","p":0,"s":"sh25","y":"shloka","n":"25","v":["रामं दूर्वादलश्यामं पद्माक्षं पीतवाससम् ।","स्तुवन्ति नामभिर्दिव्यैः न ते संसारिणो नराः ।।२५।।"],"t":["rāmaṁ dūrvādalaśyāmaṁ padmākṣaṁ pītavāsasam,","stuvanti nāmabhirdivyaiḥ na te saṁsāriṇo narāḥ ॥25॥"]},{"id":"sh26","p":0,"s":"sh26","y":"shloka","n":"26","v":["रामं लक्ष्मणपूर्वजं रघुवरं सीतापतिं सुन्दरम् ।","काकुत्स्थं करुणार्णवं गुणनिधिं विप्रप्रियं धार्मिकम् ।","राजेन्द्रं सत्यसन्धं दशरथतनयं श्यामलं शान्तमूर्तिम् ।","वन्दे लोकाभिरामं रघुकुलतिलकं राघवं रावणारिम् ।।२६।।"],"t":["rāmaṁ lakṣmaṇapūrvajaṁ raghuvaraṁ sītāpatiṁ sundaram,","kākutsthaṁ karuṇārṇavaṁ guṇanidhiṁ viprapriyaṁ dhārmikam,","rājendraṁ satyasandhaṁ daśarathatanayaṁ śyāmalaṁ śāntamūrtim,","vande lokābhirāmaṁ raghukulatilakaṁ rāghavaṁ rāvaṇārim ॥26॥"]},{"id":"sh27","p":0,"s":"sh27","y":"shloka","n":"27","v":["रामाय रामभद्राय रामचन्द्राय वेधसे ।","रघुनाथाय नाथाय सीतायाः पतये नमः ।।२७।।"],"t":["rāmāya rāmabhadrāya rāmacandrāya vedhase,","raghunāthāya nāthāya sītāyāḥ pataye namaḥ ॥27॥"]},{"id":"sh28","p":0,"s":"sh28","y":"shloka","n":"28","v":["श्रीराम राम रघुनन्दन राम राम","श्रीराम राम भरताग्रज राम राम ।","श्रीराम राम रणकर्कश राम राम","श्रीराम राम शरणं भव राम राम ।।२८।।"],"t":["śrīrāma rāma raghunandana rāma rāma","śrīrāma rāma bharatāgraja rāma rāma,","śrīrāma rāma raṇakarkaśa rāma rāma","śrīrāma rāma śaraṇaṁ bhava rāma rāma ॥28॥"]},{"id":"sh29","p":0,"s":"sh29","y":"shloka","n":"29","v":["श्रीरामचन्द्रचरणौ मनसा स्मरामि","श्रीरामचन्द्रचरणौ वचसा गृणामि ।","श्रीरामचन्द्रचरणौ शिरसा नमामि","श्रीरामचन्द्रचरणौ शरणं प्रपद्ये ।।२९।।"],"t":["śrīrāmacandracaraṇau manasā smarāmi","śrīrāmacandracaraṇau vacasā gṛṇāmi,","śrīrāmacandracaraṇau śirasā namāmi","śrīrāmacandracaraṇau śaraṇaṁ prapadye ॥29॥"]},{"id":"sh30","p":0,"s":"sh30","y":"shloka","n":"30","v":["माता रामो मत्पिता रामचन्द्रः","स्वामी रामो मत्सखा रामचन्द्रः ।","सर्वस्वं मे रामचन्द्रो दयालुः","नान्यं जाने नैव जाने न जाने ।।३०।।"],"t":["mātā rāmo matpitā rāmacandraḥ","svāmī rāmo matsakhā rāmacandraḥ,","sarvasvaṁ me rāmacandro dayāluḥ","nānyaṁ jāne naiva jāne na jāne ॥30॥"]},{"id":"sh31","p":0,"s":"sh31","y":"shloka","n":"31","v":["दक्षिणे लक्ष्मणो यस्य वामे च जनकात्मजा ।","पुरतो मारुतिर्यस्य तं वन्दे रघुनन्दनम् ।।३१।।"],"t":["dakṣiṇe lakṣmaṇo yasya vāme ca janakātmajā,","purato mārutiryasya taṁ vande raghunandanam ॥31॥"]},{"id":"sh32","p":0,"s":"sh32","y":"shloka","n":"32","v":["लोकाभिरामं रणरङ्गधीरं","राजीवनेत्रं रघुवंशनाथम् ।","कारुण्यरूपं करुणाकरं तं","श्रीरामचन्द्रं शरणं प्रपद्ये ।।३२।।"],"t":["lokābhirāmaṁ raṇaraṅgadhīraṁ","rājīvanetraṁ raghuvaṁśanātham,","kāruṇyarūpaṁ karuṇākaraṁ taṁ","śrīrāmacandraṁ śaraṇaṁ prapadye ॥32॥"]},{"id":"sh33","p":0,"s":"sh33","y":"shloka","n":"33","v":["मनोजवं मारुततुल्यवेगं","जितेन्द्रियं बुद्धिमतां वरिष्ठम् ।","वातात्मजं वानरयूथमुख्यं","श्रीरामदूतं शरणं प्रपद्ये ।।३३।।"],"t":["manojavaṁ mārutatulyavegaṁ","jitendriyaṁ buddhimatāṁ variṣṭham,","vātātmajaṁ vānarayūthamukhyaṁ","śrīrāmadūtaṁ śaraṇaṁ prapadye ॥33॥"]},{"id":"sh34","p":0,"s":"sh34","y":"shloka","n":"34","v":["कूजन्तं रामरामेति मधुरं मधुराक्षरम् ।","आरुह्य कविताशाखां वन्दे वाल्मीकिकोकिलम् ।।३४।।"],"t":["kūjantaṁ rāmarāmeti madhuraṁ madhurākṣaram,","āruhya kavitāśākhāṁ vande vālmīkikokilam ॥34॥"]},{"id":"sh35","p":0,"s":"sh35","y":"shloka","n":"35","v":["आपदामपहर्तारं दातारं सर्वसम्पदाम् ।","लोकाभिरामं श्रीरामं भूयो भूयो नमाम्यहम् ।।३५।।"],"t":["āpadāmapahartāraṁ dātāraṁ sarvasampadām,","lokābhirāmaṁ śrīrāmaṁ bhūyo bhūyo namāmyaham ॥35॥"]},{"id":"sh36","p":0,"s":"sh36","y":"shloka","n":"36","v":["भर्जनं भवबीजानाम् अर्जनं सुखसम्पदाम् ।","तर्जनं यमदूतानां रामरामेति गर्जनम् ।।३६।।"],"t":["bharjanaṁ bhavabījānām arjanaṁ sukhasampadām,","tarjanaṁ yamadūtānāṁ rāmarāmeti garjanam ॥36॥"]},{"id":"sh37","p":0,"s":"sh37","y":"shloka","n":"37","v":["रामो राजमणिः सदा विजयते रामं रमेशं भजे","रामेणाभिहता निशाचरचमू रामाय तस्मै नमः ।","रामान्नास्ति परायणं परतरं रामस्य दासोऽस्म्यहं","रामे चित्तलयः सदा भवतु मे भो राम मामुद्धर ।।३७।।"],"t":["rāmo rājamaṇiḥ sadā vijayate rāmaṁ rameśaṁ bhaje","rāmeṇābhihatā niśācaracamū rāmāya tasmai namaḥ,","rāmānnāsti parāyaṇaṁ parataraṁ rāmasya dāso’smyahaṁ","rāme cittalayaḥ sadā bhavatu me bho rāma māmuddhara ॥37॥"]},{"id":"sh38","p":0,"s":"sh38","y":"shloka","n":"38","v":["राम रामेति रामेति रमे रामे मनोरमे ।","सहस्रनामतत्तुल्यं रामनाम वरानने ।।३८।।"],"t":["rāma rāmeti rāmeti rame rāme manorame,","sahasranāmatattulyaṁ rāmanāma varānane ॥38॥"]},{"id":"iti","p":0,"s":"iti","y":"iti","n":"","v":["इति श्रीबुधकौशिकमुनिविरचितं श्रीरामरक्षास्तोत्रं सम्पूर्णम् ।।","श्रीसीतारामचन्द्रार्पणमस्तु ।।"],"t":["iti śrībudhakauśikamuniviracitaṁ śrīrāmarakṣāstotraṁ sampūrṇam ॥","śrīsītārāmacandrārpaṇamastu ॥"]}],"topics":[{"id":"viniyoga","hi":"विनियोग","en":"Viniyoga"},{"id":"dhyana","hi":"ध्यानम्","en":"Dhyānam"},{"id":"sh1","hi":"स्तोत्र","en":"Stotra"}],"sources":{"hi":[{"id":"hi-stuti-chalisa-sangrah","file":"meanings/hi-stuti-chalisa-sangrah","title":{"hi":"स्तुति चालीसा संग्रह — हिंदी अर्थ","en":"Stuti Chalisa Sangrah — Hindi meaning"}}],"en":[{"id":"en-vande-guru-paramparaam","file":"meanings/en-vande-guru-paramparaam","title":{"hi":"वन्दे गुरु परम्पराम् — अंग्रेज़ी अर्थ","en":"Vande Guru Paramparaam — English meaning"}}],"au":[{"id":"vande-guru-paramparaam","file":"audio/vande-guru-paramparaam","title":{"hi":"वन्दे गुरु परम्पराम्","en":"Vande Guru Paramparaam"}}]}}