{"chunk": 1, "s": 907.1, "e": 914.18, "t": " अप्रमत्ते नवेद्धव्यम शरवत्तन मयोभई", "w": []}
{"chunk": 1, "s": 914.18, "e": 923.94, "t": " यस्मिंद्योप्रुत्वीचान्तरिक्शमो तम्मनस्स्धब्रानेश्च सर्वेई", "w": []}
{"chunk": 1, "s": 923.94, "e": 934.5, "t": " तमेवेगम जानत्द, आत्मान मन्यावाचोवि मुन्चत, आम्रुतस्येशा से तूई", "w": []}
{"chunk": 1, "s": 934.5, "e": 940.5, "t": " आरा इवरत नाभो सम्हता यक्रनार्ध्याः", "w": []}
{"chunk": 1, "s": 940.5, "e": 946.5, "t": " सए शों तश्चरते भहुदाजाय मानहा", "w": []}
{"chunk": 1, "s": 946.5, "e": 951.5, "t": " हु मित्ये वंध्यायतात मानम", "w": []}
{"chunk": 1, "s": 951.5, "e": 957.5, "t": " स्वस्तिवपारायतम सफ्परस्तात", "w": []}
{"chunk": 1, "s": 957.5, "e": 963.5, "t": " यस सर्वग्यस सर्ववित्यस्ये शमही माभुभी", "w": []}
{"chunk": 1, "s": 963.5, "e": 971.5, "t": " दिव्ये ब्रम्म्म पुरेष्येश़ व्योंन्यात्मा प्रतिष्थितः", "w": []}
{"chunk": 1, "s": 971.5, "e": 981.5, "t": " मनो मायण्प्रान शरीर नेता प्रतिष्थितों नेह्रदयम सन्निदाया", "w": []}
{"chunk": 1, "s": 981.5, "e": 991.5, "t": " तद्विग्याने नपरिपश्यंति दिरा आनंदरूपम औम्रुतम्यत्विभाति", "w": []}
{"chunk": 1, "s": 991.5, "e": 998.58, "t": " बिध्यते हरदययगरंदिष्छिद्यंते सर्वसम्शया", "w": []}
{"chunk": 1, "s": 998.58, "e": 1006.92, "t": " शीयंते चास्यắcरमाणी तस्मिन्ध्रष्ते परावरे", "w": []}
{"chunk": 1, "s": 1006.92, "e": 1013.66, "t": " फिरन्मये प्रे खोशे विरजम्बरम्हनिष्कलम", "w": []}
{"chunk": 1, "s": 1013.66, "e": 1021.12, "t": " तच्ष्ब्रम्, जोतिषाम्, जोतिस्तिद्यदात्म्, वि� do, vivu", "w": []}
{"chunk": 1, "s": 1021.12, "e": 1027.84, "t": " नतत्र सुर्यो भातिन चंद्र तार कमने मा विद्य।", "w": []}
{"chunk": 1, "s": 1027.84, "e": 1031.78, "t": " तो भान्ति कुतो यम अगनि ही", "w": []}
{"chunk": 1, "s": 1031.78, "e": 1035.94, "t": " तमेव भाण्त, तमन भाति सर्वं,", "w": []}
{"chunk": 1, "s": 1035.94, "e": 1040.82, "t": " तस्यभाशा सर्वम दंविभाति", "w": []}
{"chunk": 1, "s": 1040.82, "e": 1044.78, "t": " ब्रम्मे वेद, वम्रु तम्पुरस्तात,", "w": []}
{"chunk": 1, "s": 1074.78, "e": 1079.78, "t": " समानम व्रुख्षम पर्षस्वाजाते", "w": []}
{"chunk": 1, "s": 1079.78, "e": 1084.78, "t": " तव्योरन्यण्यण्प्प्लम स्वाध्वत्ति", "w": []}
{"chunk": 1, "s": 1084.78, "e": 1089.78, "t": " अनश्ननन्यो भिचा कषीति", "w": []}
{"chunk": 1, "s": 1089.78, "e": 1094.78, "t": " समाने व्रुख्षे पुर्शोनि मगनो", "w": []}
{"chunk": 1, "s": 1094.78, "e": 1098.78, "t": " नीशया शोचति मुईह्यमानहा", "w": []}
{"chunk": 1, "s": 1098.78, "e": 1103.78, "t": " जुष्तम यदा पश्यत्यन्यमीशमस्य", "w": []}
{"chunk": 1, "s": 1103.78, "e": 1114.78, "t": " वाज़ा पश्यव पश्यते रुख्मवर्नम, कर्तारमीशम पूरुशम्ब्रम्म्योनिम,", "w": []}
{"chunk": 1, "s": 1114.78, "e": 1124.78, "t": " तदा विद्वान पुन्यपापे विधुय, निरंजनव परमम्साम्यमुपेती,", "w": []}
{"chunk": 1, "s": 1124.78, "e": 1128.78, "t": " नजनण परमजँम साम्यमु पेटी", "w": []}
{"chunk": 1, "s": 1128.78, "e": 1134.78, "t": " प्रानो ख्येषयस्शर्वब हु तेर्विभाटी", "w": []}
{"chunk": 1, "s": 1134.78, "e": 1139.78, "t": " विजानन विद्वाशं भवते नातिवादी", "w": []}
{"chunk": 1, "s": 1139.78, "e": 1144.78, "t": " आत्मक्रीड आत्मरतिख्क्रीआवान", "w": []}
{"chunk": 1, "s": 1144.78, "e": 1149.78, "t": " ईशब्रम्म विदान्वरिष्त्हा", "w": []}
{"chunk": 1, "s": 1149.78, "e": 1154.78, "t": " सत्येन लब्यस्तप साख्ये साथ्मा", "w": []}
{"chunk": 1, "s": 1154.78, "e": 1160.78, "t": " सम्यग्याने नप्रम्म चर्येन निट्यम", "w": []}
{"chunk": 1, "s": 1160.78, "e": 1165.78, "t": " अंतश्षरीरे जो तिर्मा यो हिशुब्रो", "w": []}
{"chunk": 1, "s": 1165.78, "e": 1171.78, "t": " यम पश्यत्यत्य अख्षीन दूशा", "w": []}
{"chunk": 1, "s": 1171.78, "e": 1175.78, "t": " सत्यमे वजयती नान्र्दम", "w": []}
{"chunk": 1, "s": 1175.78, "e": 1180.78, "t": " येन पन्तावित तो देवयानध", "w": []}
{"chunk": 1, "s": 1180.78, "e": 1185.78, "t": " येना क्रमन्ति रुशयो ल्याप्त कामा", "w": []}
{"chunk": 1, "s": 1185.78, "e": 1190.78, "t": " यद्रतत सत्यस्य परमंनि दानं", "w": []}
{"chunk": 1, "s": 1190.78, "e": 1195.78, "t": " ब्रहत्यत दिव्यम अचिन्तिरूपं", "w": []}
{"chunk": 1, "s": 1195.78, "e": 1200.0, "t": " सुख्श्माच्यत सुख्श्मतरम विभाति", "w": []}
{"chunk": 2, "s": 1200.0, "e": 1210.0, "t": " दूराज सु दूरे तदिहांति केच, पश्यत स्विहेइ वनि ही तंगूहया,", "w": []}
{"chunk": 2, "s": 1210.0, "e": 1220.0, "t": " न चक्षूशा ग्रुछ्यते न पिवाचा, न न नेर देवेस तपसा कर मनावा,", "w": []}
{"chunk": 2, "s": 1220.0, "e": 1231.0, "t": " यान प्रसादेन विशुध सत्वस्त तस्तूतं पश्यती निश्कलम्ध्या यमानध,", "w": []}
{"chunk": 2, "s": 1231.0, "e": 1237.0, "t": " एशोन रात्मा चेत सावेदि तव्यो,", "w": []}
{"chunk": 2, "s": 1237.0, "e": 1242.0, "t": " यस्मिन प्रानप पंच्धासम विवेशा,", "w": []}
{"chunk": 2, "s": 1242.0, "e": 1247.0, "t": " प्रानेश्चित्तम सर्वमो तंप्रजानाम,", "w": []}
{"chunk": 2, "s": 1247.0, "e": 1251.8, "t": " याछ मिन विषष्थ, देविभम अत येश आत्मान,", "w": []}
