{"chunk": 2, "s": 1256.8, "e": 1263.1, "t": " विष्थस अत्वख, खाम எते यंस्च कामान,", "w": []}
{"chunk": 2, "s": 1263.1, "e": 1268.1, "t": " तं, तम, लोकम जयते तंस्च कामान,", "w": []}
{"chunk": 2, "s": 1268.1, "e": 1274.6, "t": " स्तस्माद अत्म आद्म, यंक्यर्चय दूति कामान,", "w": []}
{"chunk": 2, "s": 1274.6, "e": 1281.08, "t": " अतिट्स्ट्रूतीः मुन्ड के प्रफमखण्द्ठा", "w": []}
{"chunk": 2, "s": 1281.08, "e": 1287.28, "t": " अत्ट्स्ट्रूतीः मुन्ड के ज्विद्यख्ण्दठा", "w": []}
{"chunk": 2, "s": 1287.28, "e": 1292.6, "t": " न्वेदेई तत्परमं ब्रम्म धामं", "w": []}
{"chunk": 2, "s": 1292.6, "e": 1297.4, "t": " यत्रविष्वम्नि तंभाति सुभ्भ्रम्", "w": []}
{"chunk": 2, "s": 1297.4, "e": 1303.92, "t": " उपासते पुरुशम येख्य akaमा च्ते सुक्रमे", "w": []}
{"chunk": 2, "s": 1303.92, "e": 1306.92, "t": " तदतिवर्तन्ति दिरा", "w": []}
{"chunk": 2, "s": 1307.92, "e": 1312.92, "t": " कामान्यख कामयते मन्यमानहु", "w": []}
{"chunk": 2, "s": 1312.92, "e": 1317.92, "t": " सकाम फिर्जायते तत्रतत्र", "w": []}
{"chunk": 2, "s": 1317.92, "e": 1322.92, "t": " पर्याख कामस्श्यक्रुतात्मनस्तु", "w": []}
{"chunk": 2, "s": 1322.92, "e": 1327.92, "t": " इहेव सर्वे प्रविली यंति कामा", "w": []}
{"chunk": 2, "s": 1327.92, "e": 1332.92, "t": " नायमात्मा प्रवचने नलग्व्यो", "w": []}
{"chunk": 2, "s": 1332.92, "e": 1337.12, "t": " नमेदयान भहुनाश्वृतेन", "w": []}
{"chunk": 2, "s": 1337.12, "e": 1341.92, "t": " यमेवेशव्रुनु तेनलब्योस", "w": []}
{"chunk": 2, "s": 1341.92, "e": 1346.92, "t": " तस्येश आत्मा विव्रुनु तेतनुम्स्वां", "w": []}
{"chunk": 2, "s": 1346.92, "e": 1351.92, "t": " नायमात्मा बलहीनेनलब्यो", "w": []}
{"chunk": 2, "s": 1351.92, "e": 1357.92, "t": " नजप्रमादात्ता पसोवाप्या लिंगात", "w": []}
{"chunk": 2, "s": 1357.92, "e": 1368.64, "t": " ये ते रुपायर यत ते यस्तू विद्वांस दस्येश आत्मा विषते ब्रम्दामा", "w": []}
{"chunk": 2, "s": 1368.64, "e": 1373.66, "t": " सम्प्राप्ये नम्रुशयो थ्यानत्रूएक्ता", "w": []}
{"chunk": 2, "s": 1373.66, "e": 1379.78, "t": " गुतात्मानो वीत रागाफ प्रशान्ता", "w": []}
