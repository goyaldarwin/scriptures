{"chunk": 0, "s": 30.0, "e": 34.66, "t": " अदित्यवि कर्तन मार्तन्द हरी रूप विरोचन", "w": []}
{"chunk": 0, "s": 34.66, "e": 37.6, "t": " आम्बर मनिखग रवि कहलाते", "w": []}
{"chunk": 0, "s": 37.6, "e": 40.3, "t": " वेद ही रन्य गर्भ कहगाते", "w": []}
{"chunk": 0, "s": 40.3, "e": 43.14, "t": " सहस्ट्रान्श्प्रद्योटन कही कही", "w": []}
{"chunk": 0, "s": 43.14, "e": 45.84, "t": " मूनिगन होत प्रसन मोदले ही", "w": []}
{"chunk": 0, "s": 45.84, "e": 48.34, "t": " औरुन सद्रिष सारती मनोध", "w": []}
{"chunk": 0, "s": 48.34, "e": 51.44, "t": " हर हांकत है साता चडी रथ पर", "w": []}
{"chunk": 0, "s": 51.44, "e": 54.1, "t": " वद्यार मन्डल की मही मातिनारी", "w": []}
{"chunk": 0, "s": 54.1, "e": 56.76, "t": " तेज रूप केरी बलिहारी", "w": []}
{"chunk": 0, "s": 56.76, "e": 59.6, "t": " उच्छर वास ध्रश्याय जोते", "w": []}
{"chunk": 0, "s": 59.6, "e": 62.4, "t": " देखि पुरंदर लज्जित होते", "w": []}
{"chunk": 0, "s": 62.4, "e": 64.6, "t": " मित्र मरी चीभानु", "w": []}
{"chunk": 0, "s": 64.6, "e": 67.04, "t": " अरुन भास कर सविता", "w": []}
{"chunk": 0, "s": 67.04, "e": 70.44, "t": " सूर्या अर्कखग कल कर पूशारवी", "w": []}
{"chunk": 0, "s": 70.44, "e": 72.24, "t": " अदित्य नामलें", "w": []}
{"chunk": 0, "s": 72.24, "e": 75.24, "t": " रिज़न्य गर भाय नमह कही के", "w": []}
{"chunk": 0, "s": 75.24, "e": 78.24, "t": " दुआद सिनाम प्रेम सोंगावे", "w": []}
{"chunk": 0, "s": 78.24, "e": 80.24, "t": " मस्तक बार भार नवावे", "w": []}
{"chunk": 0, "s": 80.24, "e": 83.24, "t": " चार पदारत सोजन पावे", "w": []}
{"chunk": 0, "s": 83.24, "e": 86.24, "t": " दुखदर द्राद पुंजन सावे", "w": []}
{"chunk": 0, "s": 86.24, "e": 88.24, "t": " नमसकार को चमत कार", "w": []}
{"chunk": 0, "s": 88.24, "e": 91.24, "t": " यह विदि हर रिज़ को ख्रपासार", "w": []}
{"chunk": 0, "s": 91.24, "e": 94.24, "t": " यह सेवे बानु तुम ही मन लाई", "w": []}
{"chunk": 0, "s": 94.24, "e": 97.24, "t": " आश्ट से दिनवनि दिते ही पाई", "w": []}
{"chunk": 0, "s": 97.24, "e": 100.24, "t": " बार अनामु चारन करते", "w": []}
{"chunk": 0, "s": 100.24, "e": 102.24, "t": " सहस जनम के पातक तरते", "w": []}
{"chunk": 0, "s": 102.24, "e": 105.24, "t": " उपा क्यान जो करते", "w": []}
{"chunk": 0, "s": 105.24, "e": 107.24, "t": " तवजन रिपसु जमल हते", "w": []}
{"chunk": 0, "s": 107.24, "e": 109.24, "t": " सोते ही चन चन", "w": []}
{"chunk": 0, "s": 109.24, "e": 111.24, "t": " सुत जुत परिवार बडतू है", "w": []}
{"chunk": 0, "s": 111.24, "e": 114.24, "t": " प्रभल मोह को फन्द कतू है", "w": []}
{"chunk": 0, "s": 114.24, "e": 116.24, "t": " अरक शीष को रक्षा करते", "w": []}
{"chunk": 0, "s": 116.24, "e": 119.24, "t": " रविल लाट पर नित्त भिहरते", "w": []}
{"chunk": 0, "s": 119.24, "e": 122.24, "t": " सूर्या नेप्र नित्त विराजत", "w": []}
{"chunk": 0, "s": 122.24, "e": 125.24, "t": " करन देस पर दिन कर चाजत", "w": []}
{"chunk": 0, "s": 125.24, "e": 127.24, "t": " भानु नासि का वास रहु नित", "w": []}
{"chunk": 0, "s": 127.24, "e": 130.24, "t": " भास कर करत सदा मुख का उईत", "w": []}
{"chunk": 0, "s": 130.24, "e": 133.24, "t": " अण्त रहे पर जन रहा मारे", "w": []}
{"chunk": 0, "s": 133.24, "e": 136.24, "t": " रसना भीच तिख्षन बस प्यारे", "w": []}
{"chunk": 0, "s": 136.24, "e": 139.24, "t": " कंथ सुवरन रेत की शोभा", "w": []}
{"chunk": 0, "s": 139.24, "e": 144.24, "t": " तेजस कान दे लोब हाँ उशा बाहु मित्र पीथ ही पर", "w": []}
{"chunk": 0, "s": 144.24, "e": 147.24, "t": " बश्ता वरुन रहम सुश ना कर", "w": []}
{"chunk": 0, "s": 147.24, "e": 150.24, "t": " युगल हाथ पर रक्षा कारन", "w": []}
{"chunk": 0, "s": 150.24, "e": 155.24, "t": " भानु मानुर सर्म सुदर चंबसत ना भी आदित्यमनोधर", "w": []}
{"chunk": 0, "s": 155.24, "e": 158.24, "t": " कतिमम रहत्मन मुदभर", "w": []}
{"chunk": 0, "s": 158.24, "e": 161.24, "t": " जंगा गो पति सविता बासा", "w": []}
{"chunk": 0, "s": 161.24, "e": 166.2, "t": " दिवाकर करत हुलासा विवस्वान पद की रक्वारी", "w": []}
{"chunk": 0, "s": 166.2, "e": 171.84, "t": " बाहर वसते नित्तमहारी सहस्त्राशु सर्वांग समारे", "w": []}
{"chunk": 0, "s": 171.84, "e": 177.24, "t": " रक्षा कवच विच्ट्र विचारे आस जो जन आपने मनमाही", "w": []}
{"chunk": 0, "s": 177.24, "e": 180.24, "t": " वे जग भीज कर हुते ही नाही", "w": []}
{"chunk": 0, "s": 180.24, "e": 183.24, "t": " दरिद्र कुष्ट तेहिं कब हुन व्यापे", "w": []}
{"chunk": 0, "s": 183.24, "e": 185.56, "t": " जन्या को मन में हजापे", "w": []}
{"chunk": 0, "s": 185.56, "e": 188.36, "t": " पन्द्कार जग काजो हरता", "w": []}
{"chunk": 0, "s": 188.36, "e": 191.04, "t": " नव प्रकाश से आन्द भरता", "w": []}
{"chunk": 0, "s": 191.04, "e": 193.84, "t": " गरह गन गरीस नमी तावत जाही", "w": []}
{"chunk": 0, "s": 193.84, "e": 196.56, "t": " कोड्टि बार में प्रनवाउताही", "w": []}
{"chunk": 0, "s": 196.56, "e": 199.36, "t": " मन्द सद्रिष सुत जग में जाखे", "w": []}
{"chunk": 0, "s": 199.36, "e": 202.08, "t": " दर मराज सम अद्बुत बाखे", "w": []}
{"chunk": 0, "s": 202.08, "e": 204.84, "t": " दन दन तुम दिन मनी देवा", "w": []}
{"chunk": 0, "s": 204.84, "e": 207.5, "t": " क्या करत सुर मुनिनर सेवा", "w": []}
{"chunk": 0, "s": 207.5, "e": 210.3, "t": " बब्ति भाद थुत पून न्यम सों", "w": []}
{"chunk": 0, "s": 210.3, "e": 213.1, "t": " दूर रखत सो भब के ब्रम सों", "w": []}
{"chunk": 0, "s": 213.1, "e": 215.8, "t": " परम माग महे सुर्य फाल गुन", "w": []}
{"chunk": 0, "s": 215.8, "e": 218.64, "t": " मद्वे दांग नाम रविगावे", "w": []}
{"chunk": 0, "s": 218.64, "e": 221.3, "t": " भानू देवे साख गिनावे", "w": []}
{"chunk": 0, "s": 221.3, "e": 224.08, "t": " जेश्ट इंद्र आश़ रविगावे", "w": []}
{"chunk": 0, "s": 224.08, "e": 226.98, "t": " यह भादो आश्ट इन ही मरेता", "w": []}
{"chunk": 0, "s": 226.98, "e": 229.68, "t": " कातिक होत दिवा करनेता", "w": []}
{"chunk": 0, "s": 229.68, "e": 232.48, "t": " पगशन भिन विशनु है पूसे ही", "w": []}
{"chunk": 0, "s": 232.48, "e": 235.18, "t": " पूशनाम रवि है मलमासे ही", "w": []}
{"chunk": 0, "s": 235.18, "e": 238.08, "t": " भानु चालिसा प्रेम युत", "w": []}
{"chunk": 0, "s": 238.08, "e": 240.78, "t": " गाभही जे नरनित्या", "w": []}
{"chunk": 0, "s": 240.78, "e": 244.38, "t": " सुख साम पत्तिला है विदिद", "w": []}
{"chunk": 0, "s": 244.38, "e": 248.78, "t": " हो ही सदा क्रित क्रित्या", "w": []}
