{"chunk": 0, "s": 0.0, "e": 13.0, "t": " तेगिरी तानया दाखष जै शमबू प्रिये गुने कानी गन्पती जननी पार्वती हम बेशकती भावानी", "w": []}
{"chunk": 0, "s": 14.0, "e": 23.0, "t": " ब्रम्हा भेद ना तुम्रो पावे पंच्बदन नित तुम को द्यावे शद मुख कही नसकत यष तेरो", "w": []}
{"chunk": 0, "s": 23.0, "e": 27.2, "t": " यश तेरो सहस बदन श्रम करत गनेरो", "w": []}
{"chunk": 0, "s": 27.2, "e": 30.16, "t": " तेरो पार ना पावत माता", "w": []}
{"chunk": 0, "s": 30.16, "e": 33.2, "t": " सित रक्शा लेही एशजाता", "w": []}
{"chunk": 0, "s": 33.2, "e": 36.3, "t": " अदर प्रवाल सदिश अरु नारे", "w": []}
{"chunk": 0, "s": 36.3, "e": 39.46, "t": " अतिकम निये नैन कजरारे", "w": []}
{"chunk": 0, "s": 39.46, "e": 42.46, "t": " ललित ललाथ विले पित के सरे", "w": []}
{"chunk": 0, "s": 42.46, "e": 45.46, "t": " कुम कुम अख्षत शोभा मनोहर", "w": []}
{"chunk": 0, "s": 45.46, "e": 48.56, "t": " कनक बसन कन चुकी सजाय", "w": []}
{"chunk": 0, "s": 48.56, "e": 51.8, "t": " खति में खला दिव ये लेहे राए", "w": []}
{"chunk": 0, "s": 51.8, "e": 54.68, "t": " बन्त्मदार हार की शोभा", "w": []}
{"chunk": 0, "s": 54.68, "e": 57.8, "t": " जाही देखी सहजे हमने लोभा", "w": []}
{"chunk": 0, "s": 57.8, "e": 60.88, "t": " पाला रुन अनन्त चविदारी", "w": []}
{"chunk": 0, "s": 60.88, "e": 64.08, "t": " भाभूशन की शोभा प्यारी", "w": []}
{"chunk": 0, "s": 64.08, "e": 68.6, "t": " तानारतन जतित सिंगा सनता पर राजती", "w": []}
{"chunk": 0, "s": 68.6, "e": 72.48, "t": " हरी चकुरनन विंद्रा दिक परिवार", "w": []}
{"chunk": 0, "s": 72.48, "e": 76.42, "t": " वेर पूजित जगम्रिग नाग, यक्ष्रव पूजित", "w": []}
{"chunk": 0, "s": 76.42, "e": 82.44, "t": " विर के लाऊश निवासनी जैजे, को टिक प्रभाविखासनी जैजे", "w": []}
{"chunk": 0, "s": 82.44, "e": 88.58, "t": " त्रिवूवन सकल कुदुम्ब तेहारी, आनु आनु मह्दुमरी उज्यारी", "w": []}
{"chunk": 0, "s": 88.58, "e": 94.58, "t": " आई महेश पानेश तुमहारे तिबवन के जोनिज रक्वारे", "w": []}
{"chunk": 0, "s": 94.58, "e": 100.58, "t": " उन्श्वपती तुम प्राब्त किन जब सुक्त पुर तन उदित भाई", "w": []}
{"chunk": 0, "s": 100.58, "e": 105.58, "t": " तब भुडहा भेल सवारी जिन की महिमा का गागा", "w": []}
{"chunk": 0, "s": 105.58, "e": 110.58, "t": " वे को तिन की सदाशम शान वेहारी शंकर", "w": []}
{"chunk": 0, "s": 110.58, "e": 113.58, "t": " भाबूशन आब जंक भाएंकर", "w": []}
{"chunk": 0, "s": 113.58, "e": 115.58, "t": " निल कंछ की पदवी पाई", "w": []}
{"chunk": 0, "s": 115.58, "e": 118.58, "t": " देव मगन के प्यज अस्कीन हो", "w": []}
{"chunk": 0, "s": 118.58, "e": 121.58, "t": " विश्ले आपुत नहीं आमिदीन हो", "w": []}
{"chunk": 0, "s": 121.58, "e": 124.58, "t": " ताकी तुम पतनी चविदारनी", "w": []}
{"chunk": 0, "s": 124.58, "e": 126.58, "t": " दूरित विदारनी", "w": []}
{"chunk": 0, "s": 126.58, "e": 128.58, "t": " मंगल कारिन", "w": []}
{"chunk": 0, "s": 128.58, "e": 130.58, "t": " देखि परम सोंदरे तेहारो", "w": []}
{"chunk": 0, "s": 130.58, "e": 133.58, "t": " त्रिव वन चकित बना वन फारो", "w": []}
{"chunk": 0, "s": 133.58, "e": 135.58, "t": " देव थासो माता गंगा", "w": []}
{"chunk": 0, "s": 135.58, "e": 137.88, "t": " तजगित बना वन भारो", "w": []}
{"chunk": 0, "s": 137.88, "e": 140.84, "t": " थे भी ता सो माता गंगा", "w": []}
{"chunk": 0, "s": 140.84, "e": 143.88, "t": " लज्जा मैं है सलिल तरंगा", "w": []}
{"chunk": 0, "s": 143.88, "e": 146.98, "t": " सोथ समाने शम्बू पहे आई", "w": []}
{"chunk": 0, "s": 146.98, "e": 150.18, "t": " विशनु पदाज चुडि सोथाई", "w": []}
{"chunk": 0, "s": 150.18, "e": 153.18, "t": " तेही को कमल बदन मुर्जायो", "w": []}
{"chunk": 0, "s": 153.18, "e": 156.18, "t": " लखि सत्वर शिव शीष चडायो", "w": []}
{"chunk": 0, "s": 156.18, "e": 159.38, "t": " नित्या नंद करी वर्दायनी", "w": []}
{"chunk": 0, "s": 159.38, "e": 162.62, "t": " अभे बख्त करनित अनपायनी", "w": []}
{"chunk": 0, "s": 162.62, "e": 165.62, "t": " पक्जिल पापत्रय तापनी कंदनी", "w": []}
{"chunk": 0, "s": 165.62, "e": 168.62, "t": " माहेश्वरी ही माले नन्दनी", "w": []}
{"chunk": 0, "s": 168.62, "e": 171.62, "t": " काशी पूरी सदा मनबाई", "w": []}
{"chunk": 0, "s": 171.62, "e": 174.62, "t": " सिथ पीट तेही आपु बनाई", "w": []}
{"chunk": 0, "s": 174.62, "e": 177.62, "t": " बगवति पति दिन विख्षादात्री", "w": []}
{"chunk": 0, "s": 177.62, "e": 180.62, "t": " कि पाप्र मोद सनेज विदात्री", "w": []}
{"chunk": 0, "s": 180.62, "e": 183.94, "t": " रिपुख्शे कारनी जै जै आमभे", "w": []}
{"chunk": 0, "s": 183.94, "e": 186.94, "t": " वाचा सिथ करी आवलमबे", "w": []}
{"chunk": 0, "s": 186.94, "e": 189.94, "t": " तोरी उमा शंकरी काली", "w": []}
{"chunk": 0, "s": 189.94, "e": 192.94, "t": " अन पूरना जगप्रती पाली", "w": []}
{"chunk": 0, "s": 192.94, "e": 195.44, "t": " सब जन की इश्वरी", "w": []}
{"chunk": 0, "s": 195.44, "e": 198.84, "t": " भग्वती प्रती प्लाना पर मेश्वरी", "w": []}
{"chunk": 0, "s": 198.84, "e": 202.22, "t": " सती उमने कच्नत पस्या कीनी", "w": []}
{"chunk": 0, "s": 202.22, "e": 205.34, "t": " नारद सोजब शिक्षा लीनी", "w": []}
{"chunk": 0, "s": 205.34, "e": 211.34, "t": " अन्ननेर नवाय। आजारा अस्तिमाज्धन भायो तुमारा", "w": []}
{"chunk": 0, "s": 211.34, "e": 217.34, "t": " पत्र खास को खाद नवायो वुमानाम तब तुमने पायो", "w": []}
{"chunk": 0, "s": 217.34, "e": 223.34, "t": " तब भी लोकिरी शिसाथ पदारे लगे दिगावन दिकी नाहारे", "w": []}
{"chunk": 0, "s": 223.34, "e": 229.34, "t": " तब तब जय जय जय उचारे हु सब तरिषी निज के हसिदारे", "w": []}
{"chunk": 0, "s": 229.34, "e": 234.34, "t": " वर देने के वचन सुनाये आंगे उमावर पति तुम तीनसो", "w": []}
{"chunk": 0, "s": 234.34, "e": 237.34, "t": " चाहत जगत्रिव वन नी दी जीनसो", "w": []}
{"chunk": 0, "s": 237.34, "e": 240.34, "t": " एब मस्तु कही ते दोगाये", "w": []}
{"chunk": 0, "s": 240.34, "e": 243.34, "t": " सुफल मनुरत तुम ने लाये", "w": []}
{"chunk": 0, "s": 243.34, "e": 246.34, "t": " करविवा हषिव सो से बामा", "w": []}
{"chunk": 0, "s": 246.34, "e": 249.34, "t": " उने काहाई हर की बामा", "w": []}
{"chunk": 0, "s": 249.34, "e": 252.34, "t": " जो पडि है जन यह जाली सा", "w": []}
{"chunk": 0, "s": 252.34, "e": 256.34, "t": " तो बद़चन्द्र का सुबखष्र जैति जैति सुखखानि", "w": []}
{"chunk": 0, "s": 256.34, "e": 260.34, "t": " पार्वतिनि जबाद्त हित रहु सदावर दानि", "w": []}
