"बाहुवोस्तव": {"hi": "आपकी भुजाओंमें", "en": "in your arms", "p": [["बाह्वोः", "भुजाओंमें"], ["तव", "आपकी"]]},
"हेतयः": {"hi": "शस्त्र", "en": "weapons", "r": "हेति"},
"तासामीशानो": {"hi": "उनके स्वामी", "en": "master of them", "p": [["तासाम्", "उनके"], ["ईशानः", "स्वामी"]]},
