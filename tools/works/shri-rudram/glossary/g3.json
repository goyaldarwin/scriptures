"जीवसे": {"hi": "जीनेके लिए", "en": "that we may live", "r": "जीव्", "g": "तुमर्थक"},
"इमाग्ं": {"hi": "इस (स्तुति) को", "en": "this (prayer)", "r": "इदम्", "g": "द्वितीया स्त्रीलिंग"},
"तवसे": {"hi": "बलवान्‌को", "en": "to the mighty one", "r": "तवस्"},
"क्षयद्वीराय": {"hi": "वीरोंके स्वामी (या वीरोंका नाश करनेवाले) को", "en": "to the lord of heroes", "r": "क्षयद्वीर"},
"प्रभरामहे": {"hi": "हम अर्पित करते हैं", "en": "we offer", "r": "प्र + भृ", "g": "लट्, उत्तम पुरुष बहुवचन"},
"मतिम्": {"hi": "स्तुति, बुद्धि", "en": "the prayer, thought", "r": "मति"},
"नश्शमसद्द्विपदे": {"hi": "हमारे दो पैरवालों (मनुष्यों) का कल्याण हो", "en": "may it be well with our two-footed ones", "p": [["नः", "हमारे"], ["शम्", "कल्याण"], ["असत्", "हो"], ["द्विपदे", "दो पैरवालोंको"]]},
"चतुष्पदे": {"hi": "चार पैरवालों (पशुओं) को", "en": "to the four-footed ones", "r": "चतुष्पद्"},
"विश्वम्पुष्टङ्ग्रामे": {"hi": "सब, पुष्ट, गाँवमें", "en": "all, nourished, in the village", "p": [["विश्वम्", "सब"], ["पुष्टम्", "पुष्ट"], ["ग्रामे", "गाँवमें"]]},
"अस्मिन्ननातुरम्": {"hi": "इसमें, नीरोग", "en": "in this, free from illness", "p": [["अस्मिन्", "इसमें"], ["अनातुरम्", "नीरोग"]]},
"मृडा": {"hi": "सुखी करो", "en": "be gracious", "r": "मृड्", "g": "लोट् (मृड)"},
"रुद्रोत": {"hi": "हे रुद्र, और", "en": "O Rudra, and", "p": [["रुद्र", "हे रुद्र"], ["उत", "और"]]},
"मयस्कृधि": {"hi": "सुख दो", "en": "give joy", "p": [["मयः", "सुख"], ["कृधि", "करो"]]},
"नमसा": {"hi": "नमस्कारसे", "en": "with salutation", "r": "नमस्", "g": "तृतीया एकवचन"},
"विधेम": {"hi": "हम सेवा (पूजा) करें", "en": "we serve, we worship", "r": "विध्", "g": "विधिलिङ्"},
"यच्छञ्च": {"hi": "जो सुख और", "en": "the welfare that", "p": [["यत्", "जो"], ["शम्", "सुख"], ["च", "और"]]},
"योश्च": {"hi": "और भयका निवारण", "en": "and freedom from fear", "p": [["योः", "भयका दूर होना"], ["च", "और"]]},
"मनुरायजे": {"hi": "मनुने यज्ञ करके पाया", "en": "Manu won by worship", "p": [["मनुः", "मनु"], ["आयजे", "यज्ञसे प्राप्त किया"]]},
"तदश्याम": {"hi": "वह हम पाएँ", "en": "may we attain that", "p": [["तत्", "वह"], ["अश्याम", "पाएँ"]]},
"प्रणीतौ": {"hi": "मार्गदर्शनमें", "en": "under (your) guidance", "r": "प्रणीति", "g": "सप्तमी एकवचन"},
"महान्तमुत": {"hi": "बड़े (वृद्ध) को और", "en": "the elder, and", "p": [["महान्तम्", "बड़ेको"], ["उत", "और"]]},
"अर्भकम्मा": {"hi": "बालकको मत", "en": "the child, do not", "p": [["अर्भकम्", "बालकको"], ["मा", "मत"]]},
"उक्षन्तमुत": {"hi": "युवा (बढ़ते हुए) को और", "en": "the young man, and", "p": [["उक्षन्तम्", "बढ़ते हुएको"], ["उत", "और"]]},
