"अश्वेषु": {"hi": "घोड़ोंमें", "en": "among the horses", "r": "अश्व"},
"वीरान्मा": {"hi": "वीरोंको मत", "en": "the heroes, do not", "p": [["वीरान्", "वीरोंको"], ["मा", "मत"]]},
"भामितोऽवधीर्हविष्मंतो": {"hi": "क्रोधित होकर मारो; हवि लिए हुए (हम)", "en": "in anger slay; (we) bearing offerings", "p": [["भामितः", "क्रोधित होकर"], ["अवधीः", "मारो"], ["हविष्मन्तः", "हवि लिए हुए"]]},
"आरात्ते": {"hi": "दूर (रहे) आपका", "en": "far (be) your", "p": [["आरात्", "दूर"], ["ते", "आपका"]]},
