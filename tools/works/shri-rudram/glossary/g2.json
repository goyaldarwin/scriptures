"नमश्शीघ्रियाय": {"hi": "नमस्कार, तीव्र धाराओंमें रहनेवालेको", "en": "salutation to him in the swift currents", "p": [["नमः", "नमस्कार"], ["शीघ्रियाय", "तीव्र प्रवाहमें स्थितको"]]},
"शीभ्याय": {"hi": "बहते जलमें रहनेवालेको", "en": "to him in the flowing waters", "r": "शीभ्य"},
"ऊर्म्याय": {"hi": "लहरोंमें रहनेवालेको", "en": "to him in the waves", "r": "ऊर्म्य"},
"चावस्वन्याय": {"hi": "और शान्त (शब्दहीन) जलमें रहनेवालेको", "en": "and to him in the still waters", "p": [["च", "और"], ["अवस्वन्याय", "शान्त जलमें स्थितको"]]},
"स्रोतस्याय": {"hi": "प्रवाहों (नदियों) में रहनेवालेको", "en": "to him in the streams", "r": "स्रोतस्य"},
"द्वीप्याय": {"hi": "द्वीपोंमें रहनेवालेको", "en": "to him on the islands", "r": "द्वीप्य"},
"ज्येष्ठाय": {"hi": "सबसे बड़ेको", "en": "to the eldest", "r": "ज्येष्ठ"},
"कनिष्ठाय": {"hi": "सबसे छोटेको", "en": "to the youngest", "r": "कनिष्ठ"},
"पूर्वजाय": {"hi": "पहले जन्मेको", "en": "to the first-born", "r": "पूर्वज"},
"चापरजाय": {"hi": "और बादमें जन्मेको", "en": "and to the later-born", "p": [["च", "और"], ["अपरजाय", "बादमें जन्मेको"]]},
"मध्यमाय": {"hi": "बीचवालेको", "en": "to the middle one", "r": "मध्यम"},
"चापगल्भाय": {"hi": "और अपरिपक्व (बाल) को", "en": "and to the one not yet grown", "p": [["च", "और"], ["अपगल्भाय", "अप्रौढको"]]},
"जघन्याय": {"hi": "निम्नतममें स्थितको", "en": "to him in the lowest", "r": "जघन्य"},
"बुध्नियाय": {"hi": "मूल (जड़ों) में स्थितको", "en": "to him in the roots", "r": "बुध्निय"},
"सोभ्याय": {"hi": "पुण्य-पाप मिश्रित (मनुष्य-) लोकमें स्थितको", "en": "to him in the world of mixed deeds", "r": "सोभ्य"},
"प्रतिसर्याय": {"hi": "रक्षासूत्र (अभिचार-निवारण) में स्थितको", "en": "to him in the protective charm", "r": "प्रतिसर्य"},
"याम्याय": {"hi": "यमलोकमें स्थितको", "en": "to him in Yama’s realm", "r": "याम्य"},
"क्षेम्याय": {"hi": "क्षेम (कल्याण, स्वर्ग) में स्थितको", "en": "to him in well-being", "r": "क्षेम्य"},
"उर्वर्याय": {"hi": "उपजाऊ खेतोंमें स्थितको", "en": "to him in the fertile fields", "r": "उर्वर्य"},
"खल्याय": {"hi": "खलिहानोंमें स्थितको", "en": "to him in the threshing-floors", "r": "खल्य"},
"नमश्श्लोक्याय": {"hi": "नमस्कार, वेदमन्त्रोंमें स्थितको", "en": "salutation to him in the Vedic hymns", "p": [["नमः", "नमस्कार"], ["श्लोक्याय", "मन्त्रोंमें स्थितको"]]},
"चाऽवसान्याय": {"hi": "और (वेदके) अन्त (उपनिषद्) में स्थितको", "en": "and to him at the end (of the Veda)", "p": [["च", "और"], ["अवसान्याय", "अन्तमें स्थितको"]]},
"वन्याय": {"hi": "वनमें स्थितको", "en": "to him in the forests", "r": "वन्य"},
"कक्ष्याय": {"hi": "झाड़ियोंमें स्थितको", "en": "to him in the thickets", "r": "कक्ष्य"},
"श्रवाय": {"hi": "शब्दरूपको", "en": "to him who is sound", "r": "श्रव"},
"प्रतिश्रवाय": {"hi": "प्रतिध्वनिरूपको", "en": "to him who is the echo", "r": "प्रतिश्रव"},
"आशुषेणाय": {"hi": "शीघ्रगामी सेनावालेको", "en": "to him of swift armies", "r": "आशुषेण"},
"चाशुरथाय": {"hi": "और शीघ्रगामी रथवालेको", "en": "and to him of swift chariots", "p": [["च", "और"], ["आशुरथाय", "तेज रथवालेको"]]},
"नमश्शूराय": {"hi": "नमस्कार, शूरवीरको", "en": "salutation to the hero", "p": [["नमः", "नमस्कार"], ["शूराय", "शूरको"]]},
"चावभिन्दते": {"hi": "और (शत्रुओंको) चीरनेवालेको", "en": "and to him who breaks (foes) apart", "p": [["च", "और"], ["अवभिन्दते", "चीर डालनेवालेको"]]},
"वर्मिणे": {"hi": "कवचधारीको", "en": "to the armoured one", "r": "वर्मिन्"},
"वरूथिने": {"hi": "रथके रक्षा-आवरणवालेको", "en": "to him with a sheltering chariot", "r": "वरूथिन्"},
"बिल्मिने": {"hi": "शिरस्त्राणधारीको", "en": "to the helmeted one", "r": "बिल्मिन्"},
"कवचिने": {"hi": "कवचवालेको", "en": "to the one with a breastplate", "r": "कवचिन्"},
"श्रुताय": {"hi": "प्रसिद्धको", "en": "to the renowned one", "r": "श्रुत"},
"श्रुतसेनाय": {"hi": "प्रसिद्ध सेनावालेको", "en": "to him whose army is renowned", "r": "श्रुतसेन"},
"नमोऽस्यद्भ्यो": {"hi": "नमस्कार, (बाण) छोड़नेवालोंको", "en": "salutation to those who shoot", "r": "अस् (फेंकना)", "g": "नमः + चतुर्थी बहुवचन (अस्यत्)", "p": [["नमः", "नमस्कार"], ["अस्यद्भ्यः", "(बाण) फेंकनेवालोंको"]]},
"विध्यद्भ्यश्च": {"hi": "और (लक्ष्य) बेधनेवालोंको", "en": "and to those who pierce", "r": "व्यध् (बेधना)", "g": "चतुर्थी बहुवचन (विध्यत्) + च", "p": [["विध्यद्भ्यः", "बेधनेवालोंको"], ["च", "और"]]}
}
