"ए॒षा-म्पुरु॑षाणामे॒षा-म्प॑शू॒ना-म्मा भेमा-ऽरो॒ मो ए॑षा॒-ङ्किञ्च॒नाम॑मत् ।"
],
"t": [
"drāpē̠ andha̍saspatē̠ dari̍dra̠nnīla̍lōhita ।",
"ē̠ṣā-mpuru̍ṣāṇāmē̠ṣā-mpa̍śū̠nā-mmā bhērmā-'rō̠ mō ē̍ṣā̠-ṅkiñcha̠nāma̍mat ।"
]
},
{
"head": "10th Anuvaka",
"pg": 64,
"v": [
"या ते॑ रुद्र शि॒॒वा त॒नू-श्शि॒॒वा वि॒॒श्वाह॑भेषजी ।",
"शि॒॒वा रु॒द्रस्य॑ भेष॒जी तया॑ नो मृड जी॒वसे᳚ ॥"
],
"t": [
"yā tē̍ rudra śi̠vā ta̠nū-śśi̠vā vi̠śvāha̍bhēṣajī ।",
"śi̠vā ru̠drasya̍ bhēṣa̠jī tayā̍ nō mṛḍa jī̠vasē̎ ॥"
]
},
{
"head": "10th Anuvaka",
"pg": 65,
"v": [
"इ॒माग्ं रु॒द्राय॑ त॒वसे॑ कप॒र्दिने᳚ क्ष॒यद्वी॑ी॑राय॒ प्रभ॑रामहे म॒तिम् ।",
"यथा॑ न॒श्शमस॑द्द्वि॒॒पदे॒ चतु॑ष्पदे॒ विश्व॑-म्पु॒ष्ट-ङ्ग्रामे॑ अ॒स",
"न्नना॑तुरम् ।"
],
"t": [
"i̠māgṃ ru̠drāya̍ ta̠vasē̍ kapa̠rdinē̎ kṣa̠yadvī̍rāya̠ prabha̍rāmahē ma̠tim ।",
"yathā̍ na̠śśamasa̍ddvi̠padē̠ chatu̍ṣpadē̠ viśva̍-mpu̠ṣṭa-ṅgrāmē̍ a̠sminnanā̍turam ।"
]
},
{
"head": "10th Anuvaka",
"pg": 66,
"v": [
"मृ॒डा नो॑ रुद्रो॒त नो॒ मय॑स्कृधि क्ष॒यद्वी॑ी॑राय॒ नम॑सा विधेम ते ।",
"यच्छ-ञ्च॒ योश्च॒ मनु॑राय॒जे पि॒॒ता तद॑श्याम॒ तव॑ रुद्र॒ प्रणी॑तौ ।"
],
"t": [
"mṛ̠ḍā nō̍ rudrō̠ta nō̠ maya̍skṛdhi kṣa̠yadvī̍rāya̠ nama̍sā vidhēma tē ।",
"yachCha-ñcha̠ yōścha̠ manu̍rāya̠jē pi̠tā tada̍śyāma̠ tava̍ rudra̠ praṇī̍tau ।"
]
},
{
"head": "10th Anuvaka",
"pg": 67,
"v": [
"मा नो॑ म॒हान्त॑मु॒त मा नो॑ अर्भ॒॒क-म्मा न॒ उक्ष॑न्तमु॒त मा न॑ उक्षि॒॒तम् ।",
"मा नो॑-ऽवधीः पि॒॒तर॒-म्मोत मा॒तर॑-म्प्रि",
"या मा न॑स्त॒नुवो॑ रुद्र रीरिषः ।"
],
"t": [
"mā nō̍ ma̠hānta̍mu̠ta mā nō̍ arbha̠ka-mmā na̠ ukṣa̍ntamu̠ta mā na̍ ukṣi̠tam ।",
"mā nō̍-'vadhīḥ pi̠tara̠-mmōta mā̠tara̍-mpri̠yā mā na̍sta̠nuvō̍ rudra rīriṣaḥ ।"
]
},
{
"head": "10th Anuvaka",
"pg": 68,
"v": [
"मा न॑स्तो॒के तन॑ये॒ मा न॒ आयु॑षि॒॒ मा नो॒ गोषु॒ मा नो॒ अश्वे॑षु रीरिषः ।",
"वी॒रान्मा नो॑ रुद्र भामि॒॒तो-ऽव॑धीर्​ह॒विष्मं॑तो॒ नम॑सा विधेम ते ।"
],
"t": [
"māna̍stō̠kē tana̍yē̠ mā na̠ āyu̍ṣi̠ mā nō̠ gōṣu̠ mā nō̠ aśvē̍ṣu rīriṣaḥ ।",
"vī̠rānmā nō̍ rudra bhāmi̠tō-'va̍dhīr​ha̠viṣmaṃ̍tō̠ nama̍sā vidhēma tē ।"
]
},
{
"head": "10th Anuvaka",
"pg": 69,
"v": [
"आ॒रात्ते॑ गो॒घ्न उ॒त पू॑रुष॒घ्ने क्ष॒यद्वी॑ी॑राय सु॒म्नम॒स्मे ते॑ अस्तु ।",
"रक्षा॑ च नो॒ अधि॑ च देव ब्रू॒ह्यथा॑ च न॒-श्शर्म॑॑ यच्छ द्वि॒॒बर्​हाः᳚ ।"
],
"t": [
"ā̠rāttē̍ gō̠ghna u̠ta pū̍ruṣa̠ghnē kṣa̠yadvī̍rāya su̠mnama̠smē tē̍ astu ।",
"rakṣā̍ cha nō̠ adhi̍ cha dēva brū̠hyathā̍ cha na̠-śśarma̍ yachcha dvi̠bar​hā̎ḥ ।"
]
},
{
"head": "10th Anuvaka",
"pg": 70,
"v": [
"स्तु॒हि श्रु॒त-ङ्ग॑र्त॒॒सदं॒-युँवा॑न-म्मृ॒गन्न भी॒ममु॑पह॒न्तुमु॒ग्रम् ।",
"मृ॒डा ज॑रि॒॒त्रेे रु॑द्र॒ स्तवा॑नो अ॒न्यन्ते॑ अ॒स्मन्निव॑पन्तु॒ सेनाः᳚ ।"
],
"t": [
"stu̠hi śru̠ta-ṅga̍rta̠sada̠ṃ yuvā̍na-mmṛ̠ganna bhī̠mamu̍paha̠ntumu̠gram ।",
"mṛ̠ḍā ja̍ri̠trē ru̍dra̠ stavā̍nō a̠nyantē̍ a̠smanniva̍pantu̠ sēnā̎ḥ ।"
]
},
{
"head": "10th Anuvaka",
"pg": 71,
"v": [
"परि॑णो रु॒द्रस्य॑ हे॒तिर्वृ॑॑णक्तु॒ परि॑ त्वे॒षस्य॑ दुर्म॒॒ति र॑घा॒योः ।",
"अव॑ स्थि॒॒रा म॒घव॑द्भ्य-स्तनुष्व॒ मीढ्व॑स्तो॒काय॒ तन॑याय मृडय ।"
],
"t": [
"pari̍ṇō ru̠drasya̍ hē̠tirvṛ̍ṇaktu̠ pari̍ tvē̠ṣasya̍ durma̠ti ra̍ghā̠yōḥ ।",
"ava̍ sthi̠rā ma̠ghava̍dbhya-stanuṣva̠ mīḍhva̍stō̠kāya̠ tana̍yāya mṛḍaya ।"
]
},
{
"head": "10th Anuvaka",
"pg": 72,
"v": [
"मीढु॑ष्टम॒ शिव॑तम शि॒॒वो नः॑ सु॒मना॑ भव ।",
"प॒र॒मे वृ॒क्ष आयु॑धन्नि॒धाय॒ कृत्तिं॒-वँसा॑न॒ आच॑र॒ पिना॑क॒-म्बिभ्र॒॒दाग॑हि ।"
],
"t": [
"mīḍhu̍ṣṭama̠ śiva̍tama śi̠vō na̍-ssu̠manā̍ bhava ।",
"pa̠ra̠mē vṛ̠kṣa āyu̍dhanni̠dhāya̠ kṛtti̠ṃ vasā̍na̠ ācha̍ra̠ pinā̍ka̠-mbibhra̠dāga̍hi ।"
]
},
{
"head": "10th Anuvaka",
"pg": 73,
"v": [
"विकि॑रिद॒ विलो॑हित॒ नम॑स्ते अस्तु भगवः ।",
"यास्ते॑ स॒हस्रग्ं॑ हे॒तयो॒न्यम॒स्मन्निव॑पन्तु॒ ताः ।"
],
"t": [
"viki̍rida̠ vilō̍hita̠ nama̍stē astu bhagavaḥ ।",
"yāstē̍ sa̠hasragṃ̍ hē̠tayō̠nyama̠smanniva̍pantu̠ tāḥ ।"
]
},
{
"head": "10th Anuvaka",
"pg": 74,
"v": [
"स॒हस्रा॑णि सहस्र॒धा बा॑हु॒वोस्तव॑ हे॒तयः॑ ।",
"तासा॒मीशा॑नो भगवः परा॒चीना॒ मुखा॑ कृधि ॥ १०॥"
],
"t": [
"sa̠hasrā̍ṇi sahasra̠dhā bā̍hu̠vōstava̍ hē̠taya̍ḥ ।",
"tāsā̠mīśā̍nō bhagavaḥ parā̠chīnā̠ mukhā̍ kṛdhi ॥ 10 ॥"
]
},
{
"head": "11th Anuvaka",
"pg": 75,
"v": [
"स॒हस्रा॑णि सहस्र॒शो ये रु॒द्रा अधि॒॒ भूम्या᳚म् ।",
"तेषाग्ं॑ सहस्रयोज॒ने-ऽव॒धन्वा॑नि तन्मसि ।"
],
"t": [
"sa̠hasrā̍ṇi sahasra̠śō yē ru̠drā adhi̠ bhūmyā̎m ।",
"tēṣāg̍ṃ sahasrayōja̠nē-'va̠dhanvā̍ni tanmasi ।"
]
},
{
"head": "11th Anuvaka",
"pg": 76,
"v": [
"अ॒स",
"न्म॑ह॒त्य॑र्ण॒॒वें᳚᳚-ऽतरि॑क्षे भ॒वा अधि॑ ।",
"नील॑ग्रीवा-श्शिति॒॒कण्ठा᳚-श्श॒वा अ॒धः, क्ष॑माच॒राः ।"
],
"t": [
"a̠sminma̍ha̠tya̍rṇa̠vē̎m-'tari̍kṣē bha̠vā adhi̍ ।",
"nīla̍grīvā-śśiti̠kaṇṭhā̎-śśa̠rvā a̠dhaḥ, kṣa̍mācha̠rāḥ ।"
]
},
{
"head": "11th Anuvaka",
"pg": 77,
"v": [
"नील॑ग्रीवा-श्शिति॒॒कण्ठा॒ दिवग्ं॑ रु॒द्रा उप॑श्रिताः ।",
"ये वृ॒क्षेषु॑ स॒स्पिञ्ज॑रा॒ नील॑ग्रीवा॒ विलो॑हिताः ।"
],
"t": [
"nīla̍grīvā-śśiti̠kaṇṭhā̠ divag̍ṃ ru̠drā upa̍śritāḥ ।",
"yē vṛ̠kṣēṣu̍ sa̠spiñja̍rā̠ nīla̍grīvā̠ vilō̍hitāḥ ।"
]
},
{
"head": "11th Anuvaka",
"pg": 78,
"v": [
"ये भू॒ताना॒मधि॑पतयो विशि॒॒खासः॑ कप॒र्दि॑नः ।",
"ये अन्ने॑षु वि॒॒विध्य॑न्ति॒॒ पात्रे॑े॑षु॒ पिब॑तो॒ जनान्॑ ।",
"ये प॒था-म्प॑थि॒॒रक्ष॑य ऐलबृ॒दा॑ य॒व्युुधः॑ ।",
"ये ती॒थानि॑ प्र॒चर॑न्ति सृ॒काव॑न्तो निष॒ङ्गिणः॑ ।",
"य ए॒ताव॑न्तश्च॒ भूयाग्ं॑सश्च॒ दिशो॑ रु॒द्रा वि॑तस्थि॒॒रे ।",
"तेषाग्ं॑ सहस्रयोज॒ने-ऽव॒धन्वा॑नि तन्मसि ।",
"नमो॑ रु॒द्रेभ्यो॒ ये पृ॑थि॒॒व्यांां-येँ᳚᳚-ऽन्तरि॑क्षे॒ ये दि॒॒वि येषा॒मन्नं॒-वाँतो॑ व॒र्​",
"ष॒मिष॑व॒स्तेभ्यो॒ दश॒ प्राची॒दश॑ दक्षि॒॒णा दश॑ प्र॒तीची॒-दशो-दी॑ची॒-",
"दशो॒ध्वास्तेभ्यो॒ नम॒स्ते नो॑ मृडयन्तु॒ ते य-न्द्वि॒॒ष्मो यश्च॑ नो॒ द्वेेष्टि॒ तं-वोँ॒ जम्भे॑",
"दधामि॥ ११॥"
],
"t": [
"yē bhū̠tānā̠madhi̍patayō viśi̠khāsa̍ḥ kapa̠rdi̍naḥ ।",
"yē annē̍ṣu vi̠vidhya̍nti̠ pātrē̍ṣu̠ piba̍tō̠ janān̍ ।",
"yē pa̠thā-mpa̍thi̠rakṣa̍ya ailabṛ̠dā̍ ya̠vyudha̍ḥ ।",
"yē tī̠rthāni̍ pra̠chara̍nti sṛ̠kāva̍ntō niṣa̠ṅgiṇa̍ḥ ।",
"ya ē̠tāva̍ntaścha̠ bhūyāg̍ṃsaścha̠ diśō̍ ru̠drā vi̍tasthi̠rē ।",
"tēṣāg̍ṃ sahasrayōja̠nē-'va̠dhanvā̍ni tanmasi ।",
"namō̍ ru̠drēbhyō̠ yē pṛ̍thi̠vyāṃ yē̎-'ntari̍kṣē̠ yē di̠vi yēṣā̠manna̠ṃ vātō̍ va̠r​",
"ṣa̠miṣa̍va̠stēbhyō̠ daśa̠ prāchī̠rdaśa̍ dakṣi̠ṇā daśa̍ pra̠tīchī̠-rdaśō-dī̍chī̠-",
"rdaśō̠rdhvāstēbhyō̠ nama̠stē nō̍ mṛḍayantu̠ tē ya-ndvi̠ṣmō yaścha̍ nō̠ dvēṣṭi̠ taṃ vō",
"jambhē̍ dadhāmi ॥ 11 ॥"
]
},
{
"head": "11th Anuvaka",
"pg": 81,
"v": [
"त्र्य॑म्बकं-यँजामहे सुग॒न्धि-म्पु॑ष्टि॒वर्ध॑॑नम् ।",
"उ॒र्वा॒॒रु॒कमि॑व॒ बन्ध॑नान्मृत्यो॑मुक्षीय॒ मा-ऽमृता᳚त् ।"
],
"t": [
"trya̍mbakaṃ yajāmahē suga̠ndhi-mpu̍ṣṭi̠vardha̍nam ।",
"u̠rvā̠ru̠kami̍va̠ bandha̍nānmṛtyō̍rmukṣīya̠ mā-'mṛtā̎t ।"
]
},
{
"head": "11th Anuvaka",
"pg": 83,
"v": [
"यो रु॒द्रो अ॒ग्नौ यो अ॒प्सु य ओष॑धीषु॒ यो रु॒द्रो विश्वा॒ भुव॑ना वि॒॒वेश॒ तस्म",
"रु॒द्राय॒ नमो॑ अस्तु ।",
"तमु॑ ष्टु॒हि॒॒ य-स्स्वि॒॒षुस्सु॒धन्वा॒ यो विश्व॑स्य॒ क्षय॑ति भेष॒जस्य॑ ।",
"यक्ष्वा᳚म॒हे सौ᳚मन॒साय॑ रु॒द्र-न्नमो᳚भिर्दे॒॒वमसु॑र-न्दुवस्य ।",
"अ॒य-म्मे॒ हस्तो॒ भग॑वान॒य-म्मे॒ भग॑वत्तरः ।",
"अ॒य-म्मे᳚ वि॒॒श्वभे᳚षजो॒-ऽयग्ं शि॒॒वाभि॑मर्​शनः ।",
"ये ते॑ स॒हस्र॑म॒युत॒-म्पाशा॒ मृत्यो॒ मर्त्या॑॑य॒ हन्त॑वे ।",
"तान् य॒ज्ञस्य॑ मा॒यया॒ सर्वा॒॒नव॑ यजामहे ।",
"मृ॒त्यवे॒ स्वाहा॑ मृ॒त्यवे॒ स्वाहा᳚ ॥ ११॥",
"ओ-न्नमो भगवते रुद्राय विष्णवे मृत्यु॑र्मे पा॒हि ॥",
"प्राणाना-ङ्ग्रन्थिरसि रुद्रो मा॑ विशा॒न्तकः ।",
"तेनान्नेना᳚प्याय॒स्व ॥",
"नमो रुद्राय विष्णवे मृत्यु॑र्मे पा॒हि ॥"
],
"t": [
"yō ru̠drō a̠gnau yō a̠psu ya ōṣa̍dhīṣu̠ yō ru̠drō viśvā̠ bhuva̍nā vi̠vēśa̠ tasmai̍ ru̠drāya",
"namō̍ astu ।",
"tamu̍ ṣṭu̠hi̠ ya-ssvi̠ṣussu̠dhanvā̠ yō viśva̍sya̠ kṣaya̍ti bhēṣa̠jasya̍ ।",
"yakṣvā̎ma̠hē sau̎mana̠sāya̍ ru̠dra-nnamō̎bhirdē̠vamasu̍ra-nduvasya ।",
"a̠ya-mmē̠ hastō̠ bhaga̍vāna̠ya-mmē̠ bhaga̍vattaraḥ ।",
"a̠ya-mmē̎ vi̠śvabhē̎ṣajō̠-'yagṃ śi̠vābhi̍mar​śanaḥ ।",
