{"chunk": 0, "s": 255.12, "e": 260.62, "t": " आनु में एताम भगवो देवतागम शादि,", "w": []}
{"chunk": 0, "s": 260.62, "e": 264.26, "t": " याम देवताम उपास्सटि,", "w": []}
{"chunk": 0, "s": 264.26, "e": 268.96, "t": " तमूहा परह प्रत्युवाच आहा,", "w": []}
{"chunk": 0, "s": 268.96, "e": 275.68, "t": " तारे वा श्वुद्र पवैव सहँ गोविहि आस्तू इती", "w": []}
{"chunk": 0, "s": 275.68, "e": 279.68, "t": " तदूध पूनहा एवजानश्तू पूद्रायना", "w": []}
{"chunk": 0, "s": 279.68, "e": 285.42, "t": " सहस्रम गवाम निष्कम अश्वतरी रतम दूहितरम", "w": []}
{"chunk": 0, "s": 285.42, "e": 289.3, "t": " तदा आदा यप पतिचक्रमें", "w": []}
{"chunk": 0, "s": 289.3, "e": 295.0, "t": " तगमभ अभ्युवादा राइक्कुव इदगम सहस्रम गवाम", "w": []}
{"chunk": 0, "s": 295.0, "e": 300.72, "t": " आव निशकह आव आश्वतरी रतह येम जाया,", "w": []}
{"chunk": 0, "s": 300.72, "e": 308.0, "t": " आव ग्रामो यस्मिन आसे अन्वेवमा भगभः शाजि इती,", "w": []}
{"chunk": 0, "s": 308.0, "e": 312.52, "t": " खस्याह मुकम उपोद भूखनन उवाचा,", "w": []}
{"chunk": 0, "s": 312.52, "e": 318.24, "t": " आजहार इमाह सुद्राह अनेन एव मुखेना,", "w": []}
{"chunk": 0, "s": 318.24, "e": 333.24, "t": " आलापःष्यता इति तेह एते रैएक्वपर स्नाम महाडूसे शू यत्र उस्मिवूवास्व, शहतस्मिवूवाच्य,", "w": []}
{"chunk": 0, "s": 333.24, "e": 340.24, "t": " इति चतुद्तो द्यायस्य भिधियकळनदाद,", "w": []}
{"chunk": 0, "s": 340.24, "e": 346.24, "t": " आता चतूद्यायस्य भिधियकळनदाद,", "w": []}
{"chunk": 0, "s": 376.24, "e": 384.16, "t": " अजीदई वतं आचा अद्यात्न प्रानोवाव समवर्गज़", "w": []}
{"chunk": 0, "s": 384.16, "e": 389.08, "t": " सहयदास्वपिति प्रानम येववाख अप्यति", "w": []}
{"chunk": 0, "s": 389.08, "e": 394.48, "t": " प्रानम चक्ष्वु प्रानगम श्रोट्रम प्रानम वनधध", "w": []}
{"chunk": 0, "s": 394.48, "e": 399.32, "t": " प्रानोवि येवयेटान सर्वान सम्रुप्ठे इते", "w": []}
{"chunk": 0, "s": 399.32, "e": 409.32, "t": " तो वा ए तो धूउ सम्वर गूू वाजू हु ए वदे वेशू प्रानहः प्रानिशू", "w": []}
{"chunk": 0, "s": 409.32, "e": 419.32, "t": " आत्ठा शूनकम्चका प्यम आभिप्रतारिनम्चक ताख्षसे निं परिविश्यमानू", "w": []}
{"chunk": 0, "s": 419.32, "e": 426.32, "t": " प्रम्हचारी भिभिख्षे तस्मा उहाना ददतू", "w": []}
{"chunk": 0, "s": 426.32, "e": 432.32, "t": " शवो वाचा महात्वनश्च्च्च्च्रो देवाह ए कहा", "w": []}
{"chunk": 0, "s": 432.32, "e": 437.32, "t": " कहा सजगारा बूवनस्यगोपाः", "w": []}
{"chunk": 0, "s": 437.32, "e": 443.32, "t": " तम कापे यना भिपश्यंति मत्या अभिप्रतारिन", "w": []}
{"chunk": 0, "s": 443.32, "e": 449.32, "t": " बहुदा वसंतम यस्मेवा एतद अन्नम", "w": []}
{"chunk": 0, "s": 449.32, "e": 453.32, "t": " तस्मा एतद नगत्त्म इति", "w": []}
{"chunk": 0, "s": 453.32, "e": 474.32, "t": " तदुवाशवून कह का पेया प्रति मन्वाना प्रत्ये याया आत्मा देवानाम जनिता प्रजानागम फिरन्या दम्स्ट्रो भभसो आनसुरिर महान तमस्या महिवानम आहुजु", "w": []}
{"chunk": 0, "s": 474.32, "e": 500.32, "t": " अनद्यमानो यद अनन्नम अट्ती ती वैवयम्रम्हचारिने दम उपास्महे दध्तास्मे भिख्षाम इते पस्मा उहा दधुहु तेवा ये ते पंचाने पंचाने दश सन्त तत्क्रुतम", "w": []}
{"chunk": 0, "s": 500.32, "e": 514.32, "t": " तस्मात सर्वासुदिख्शू अन्नम एवदशक्र दगम सअशा विरात अन्नादी तयेदगम सर्वं द्रिष्टगम", "w": []}
{"chunk": 0, "s": 514.32, "e": 524.3, "t": " Sarmasya Yidam Drishtam Bhavati Anadho Bhavati Yayevam Veda Yayevam Veda", "w": []}
{"chunk": 0, "s": 524.3, "e": 530.0, "t": " Kithi Chaturthodhyayasyat Triti Ya Khandah", "w": []}
