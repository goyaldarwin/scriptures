{"chunk": 0, "s": 588.46, "e": 592.46, "t": " सध्यकाम हा येबजा भालाहा", "w": []}
{"chunk": 0, "s": 592.46, "e": 595.46, "t": " ब्रुवी था इती", "w": []}
{"chunk": 0, "s": 595.46, "e": 597.46, "t": " साहा एखारिद्द्रुमतम", "w": []}
{"chunk": 1, "s": 600.0, "e": 608.0, "t": " वाचा ब्रम्हचर्यम भगवति वद्स्यामि उप्याम भगवन्तम इति", "w": []}
{"chunk": 1, "s": 608.0, "e": 614.0, "t": " तगम्हो वाचा भिम्गो त्रोनु तोम्या अशि इति", "w": []}
{"chunk": 1, "s": 614.0, "e": 622.0, "t": " सहो वाचा ना आध्म एत दवेदा भो यत्गो त्रो आध्म आस्मि", "w": []}
{"chunk": 1, "s": 622.0, "e": 638.0, "t": " आप्रुच्च्मातरगम सामा प्रत्यब्रवेत बवोज्वाज्वं चरन्ती परिचारिनी यववने त्वाम अलभे साहम एतन्वेदा", "w": []}
{"chunk": 1, "s": 638.0, "e": 655.0, "t": " यद्गो त्रोस्त्रुम असी जबलातु नाम आहम अस्मी, सत्यकामो नामत्वम असी, इती सोबगम सत्यकामो जाबालो अस्मी, गो इती,", "w": []}
{"chunk": 1, "s": 655.0, "e": 661.0, "t": " तगम हो वाचा नये तद्राम्बनो विवक्त्म अरहती", "w": []}
{"chunk": 1, "s": 661.0, "e": 670.0, "t": " समिदखम सोम्य आहरा उपत्वाने श्या ना सत्या दगा", "w": []}
{"chunk": 1, "s": 670.0, "e": 677.0, "t": " इती तम्वुपनी यक्वुशाना अबलानाम चतुष्यता गाज्", "w": []}
{"chunk": 1, "s": 677.0, "e": 684.0, "t": " दिराख्रुत्या उवाचा इमा सोम्य अनुसम्ब्रजेती", "w": []}
{"chunk": 1, "s": 684.0, "e": 702.0, "t": " आविप्रस्ता पयंपूचा ना सहस्रेनवर्ते येती साहवर्षगनम् प्रोवासा तायदा सहस्रगम् सम्पेदूः इती चतुर्टो द्यायस्या चतुर्दध्खन्डधाः", "w": []}
{"chunk": 1, "s": 702.0, "e": 724.84, "t": " आथा चतुद्द्द्यायस्या पन्चमज्खन्दधा आथा हैनम रुशभो अभ्भिवादा सत्यकामा इति भगवाध इति ठा प्रतिषुश्रावः प्राप्ताः सोम्या", "w": []}
{"chunk": 1, "s": 814.84, "e": 819.84, "t": " अज्च्चात अद्ड्ने प्रांगुपो पविवेशा", "w": []}
{"chunk": 1, "s": 819.84, "e": 826.84, "t": " सम अद्ड्ने अभ्विवादा सत्यकामा", "w": []}
{"chunk": 1, "s": 826.84, "e": 831.84, "t": " इति भगवाह इति था प्रतिषुश्रावा", "w": []}
{"chunk": 1, "s": 831.84, "e": 836.84, "t": " ब्रम्हना सोम्या के पादंप्रुवान इति", "w": []}
{"chunk": 1, "s": 836.84, "e": 839.84, "t": " ब्रवी तुमे भगवान इति", "w": []}
{"chunk": 1, "s": 839.84, "e": 851.84, "t": " तस्मै हो वाचा पुधिवी कला, अन्तरिक्शम कला, जयोग कला, तमुध्द्रह कला, येशवैसो म्यच्टृष्कला हा,", "w": []}
{"chunk": 1, "s": 851.84, "e": 859.84, "t": " पादो ब्रम्हनो अन्न्तवान नामा, चायाये तम्ये वम विद्वाव्श्च्टृष्कलम,", "w": []}
{"chunk": 1, "s": 889.84, "e": 902.84, "t": " अगम सस्ते पादम वक्ता इति साहा शोभूते गाह अवि प्रस्ता पयान चकारा", "w": []}
{"chunk": 1, "s": 902.84, "e": 908.84, "t": " ता यत्रा विसायम भबूभूभूँ तत्र अग्निम पसमाधाया", "w": []}
{"chunk": 1, "s": 908.84, "e": 915.84, "t": " गाह उपरुद्या समिधम आदाया पस्चात अग्ने हे", "w": []}
{"chunk": 1, "s": 915.84, "e": 922.22, "t": " वंओ पो पो विछ वेशव खगं वखं सा उपननि पभ्या भ्युद वादः", "w": []}
{"chunk": 1, "s": 922.22, "e": 931.18, "t": " सत्यखामा इते भगवह इते टा प्रतिश श्ड्रावा", "w": []}
{"chunk": 1, "s": 931.18, "e": 942.18, "t": " प्रस्ट्रश्रावा ब्रम्हनषोम्यग, दे पाद्व् ब्रुवाणि तिए, ब्रवी तुमे भ्यगभाणि तित्जस्मे हो भाचा.", "w": []}
{"chunk": 1, "s": 942.18, "e": 948.18, "t": " अगन हि क्ला, सुर्याब कलद, चंद्राब कला, विज्योट कलग,", "w": []}
{"chunk": 1, "s": 948.18, "e": 957.18, "t": " येशवेशो मे चतूष्कलग, पाधो ब्रम्हनो, जो टिष्स्ना, जो टिष्वान नामा,", "w": []}
{"chunk": 1, "s": 957.18, "e": 965.18, "t": " ॐयह एतम्यवं विद्वागं, चतूष्कलम पाद नम्हनो,", "w": []}
{"chunk": 1, "s": 965.18, "e": 972.18, "t": " जो टिष्मान अतिव पास्ते, जो टिष्मान अस्मिन लोके भ्वति,", "w": []}
