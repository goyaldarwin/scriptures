{"chunk": 0, "s": 0.0, "e": 18.0, "t": " जेजे जे मगला मुक्कि माता आरे ती उतारे मैंया तुमारी", "w": []}
{"chunk": 0, "s": 18.0, "e": 29.0, "t": " पीत वसल तन पर तव सो हे पुंडल की चवी है यतिनारी", "w": []}
{"chunk": 0, "s": 29.0, "e": 39.92, "t": " ये कर कमलो में मौडगर इदार", "w": []}
{"chunk": 0, "s": 39.92, "e": 44.82, "t": " आसुटी करे ही सकल नरे नारी", "w": []}
{"chunk": 0, "s": 44.82, "e": 50.26, "t": " जेजे, जे, बगल आमुक्के मादा", "w": []}
{"chunk": 0, "s": 50.26, "e": 55.44, "t": " आरति अतारे मइ आतमारी", "w": []}
{"chunk": 0, "s": 55.44, "e": 60.56, "t": " चम्पत माल गले लेहे लामे", "w": []}
{"chunk": 0, "s": 60.56, "e": 65.76, "t": " सुरे नर मुनी जैए जैयती उचारी", "w": []}
{"chunk": 0, "s": 65.76, "e": 71.28, "t": " त्रिवद ताप मिटते सब जन के", "w": []}
{"chunk": 0, "s": 71.28, "e": 76.48, "t": " बाती तव रती है सुख्कारी", "w": []}
{"chunk": 0, "s": 76.48, "e": 81.48, "t": " आपागानी तुब्यागे अभा़ी", "w": []}
{"chunk": 0, "s": 82.48, "e": 86.48, "t": " जए-जए-जए बगला भूखे माता", "w": []}
{"chunk": 0, "s": 87.48, "e": 91.48, "t": " तार्ते उतारे मं्या तुमार", "w": []}
{"chunk": 0, "s": 92.48, "e": 96.48, "t": " पालत रद स्रीजट तुवजग को", "w": []}
{"chunk": 0, "s": 97.48, "e": 101.48, "t": " सब जिवने की होफ्रत्वारी", "w": []}
{"chunk": 0, "s": 101.48, "e": 113.48, "t": " भी भी बाद्वारी ब्रमत सकल जन खर उर देमे तुम उज्यारी", "w": []}
{"chunk": 0, "s": 113.48, "e": 124.48, "t": " जे जे वगला मुख्य माता आरती उतारे मैंया तुमारी", "w": []}
{"chunk": 0, "s": 124.48, "e": 150.48, "t": " तिमिरन शावग, ज्यान वडावग, हम भे तुम ही हो असुरारी, सन्तन को सुख देत सजाही, सब जन की तुम प्राणन प्यारी,", "w": []}
{"chunk": 0, "s": 150.48, "e": 155.48, "t": " जे जे वगला मुक्कि माता", "w": []}
{"chunk": 0, "s": 155.48, "e": 160.48, "t": " एर ती उतारे मैंया तुमारी", "w": []}
{"chunk": 0, "s": 160.48, "e": 165.48, "t": " तब चर्णन जो द्यान लगावे", "w": []}
{"chunk": 0, "s": 165.48, "e": 171.48, "t": " ताखो तुम भव भायारी", "w": []}
{"chunk": 0, "s": 171.48, "e": 186.48, "t": " प्रेम सहित जो करियारटी, तेनर मोखश के हो अधिकारी, जैजैजैवगला वो खीमाता एर्टी उतारे मैं अतुआरी,", "w": []}
{"chunk": 0, "s": 186.48, "e": 196.48, "t": " एर्टी अतारे मैं अगरी, एर्टी अतारे मैं अगरी,", "w": []}
