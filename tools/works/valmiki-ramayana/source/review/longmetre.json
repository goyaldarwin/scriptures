[
 {
  "id": "kishkindha.6.27",
  "counts": [
   11,
   12,
   11,
   13
  ],
  "lines": [
   "मम दयिततमा हृता वनाद्",
   "रजनिचरेण विमथ्य येन सा।",
   "कथय मम रिपुं तमद्य वै",
   "प्लवगपते यमसंनिधिं नयामि॥ २७॥"
  ]
 },
 {
  "id": "kishkindha.56.17",
  "counts": [
   11,
   12,
   11,
   13
  ],
  "lines": [
   "तदसुखमनुकीर्तितं वचो",
   "भुवि पतितांश्च निरीक्ष्य वानरान्।",
   "भृशचकितमतिर्महामतिः",
   "कृपणमुदाहृतवान् स गृध्रराजः॥ १७॥"
  ]
 },
 {
  "id": "uttara.29.41",
  "counts": [
   11,
   13,
   11,
   12
  ],
  "lines": [
   "नय रथमधिरोप्य वासवं",
   "नगरमितो व्रज सेनया वृतस्त्वम्।",
   "अहमपि तव पृष्ठतो द्रुतं",
   "सह सचिवैरनुयामि हृष्टवत्॥ ४१॥"
  ]
 },
 {
  "id": "uttara.57.21",
  "counts": [
   10,
   12,
   11,
   12
  ],
  "lines": [
   "इति सर्वमशेषतो मया",
   "कथितं सम्भवकारणं तु सौम्य।",
   "नृपपुङ्गवशापजं द्विजस्य",
   "द्विजशापाच्च यदद्भुतं नृपस्य॥ २१॥"
  ]
 },
 {
  "id": "uttara.63.24",
  "counts": [
   10,
   11,
   10,
   11
  ],
  "lines": [
   "इति राम निवेदितं तु ते",
   "भयजं कारणमुत्थितं च यत्।",
   "विनिवारयितुं भवान् क्षमः",
   "कुरु तं काममहीनविक्रम॥ २४॥"
  ]
 },
 {
  "id": "uttara.88.21",
  "counts": [
   10,
   13,
   11,
   12
  ],
  "lines": [
   "इति लक्ष्मणवाक्यमुत्तमं",
   "नृपतिरतीव मनोहरं महात्मा।",
   "परितोषमवाप हृष्टचेताः",
   "स निशम्येन्द्रसमानविक्रमौजाः॥ २१॥"
  ]
 },
 {
  "id": "uttara.97.17",
  "counts": [
   11,
   10,
   11,
   12
  ],
  "lines": [
   "इति सम्प्रविचार्य राजसिंहः",
   "श्वोभूते शपथस्य निश्चयम्।",
   "विससर्ज मुनीन् नृपांश्च सर्वान्",
   "स महात्मा महतो महानुभावः॥ १७॥"
  ]
 }
]