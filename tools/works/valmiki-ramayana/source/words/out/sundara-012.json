{"कादम्बा": {"en": "kādamba birds (grey-winged geese)", "hi": "कादम्ब पक्षी (धूसर पंखोंवाले हंस)", "r": "कादम्ब", "g": "प्रथमा, बहुवचन (कादम्बाः; इवसे पहले विसर्ग-लोप)"}, "पक्षिणः": {"en": "birds", "hi": "पक्षी", "r": "पक्षिन्", "g": "प्रथमा, बहुवचन"}, "हेमसूत्राणि": {"en": "golden chains", "hi": "सोनेकी लड़ियाँ (हार)", "r": "हेमन् + सूत्र", "g": "समास (षष्ठी तत्पुरुष), प्रथमा, बहुवचन", "p": [["हेम", "सोनेकी"], ["सूत्राणि", "लड़ियाँ"]]}, "चान्यासां": {"en": "and of others (other women)", "hi": "और दूसरी (स्त्रियों)के", "r": "च + अन्य", "g": "संधि: च + अन्यासाम्", "p": [["च", "और"], ["अन्यासाम्", "दूसरी (स्त्रियों)के"]]}, "चक्रवाका": {"en": "cakravāka birds (ruddy geese)", "hi": "चकवे पक्षी", "r": "चक्रवाक", "g": "प्रथमा, बहुवचन (चक्रवाकाः; इवसे पहले विसर्ग-लोप)"}, "इवाभवन्": {"en": "were like", "hi": "की भाँति हो गये, समान लगे", "r": "इव + भू", "g": "संधि: इव + अभवन् (लङ्, प्रथम पुरुष, बहुवचन)", "p": [["इव", "की भाँति"], ["अभवन्", "हो गये"]]}, "हंसकारण्डवोपेताश्चक्रवाकोपशोभिताः": {"en": "(the women, like rivers) filled with swans and kāraṇḍava ducks and adorned with cakravāka birds", "hi": "हंसों और कारण्डवों (जलपक्षियों)से युक्त तथा चकवोंसे सुशोभित", "r": "हंस + कारण्डव + उपेत + चक्रवाक + उपशोभित", "g": "संधि: हंसकारण्डवोपेताः + च + चक्रवाकोपशोभिताः (समास), प्रथमा, बहुवचन", "p": [["हंस", "हंसों"], ["कारण्डव", "और कारण्डव पक्षियोंसे"], ["उपेताः", "युक्त"], ["च", "तथा"], ["चक्रवाक", "चकवोंसे"], ["उपशोभिताः", "सुशोभित"]]}, "आपगा": {"en": "rivers", "hi": "नदियाँ", "r": "आपगा", "g": "प्रथमा, बहुवचन (आपगाः; इवसे पहले विसर्ग-लोप)"}, "रेजुर्जघनैः": {"en": "shone, with their hips", "hi": "शोभित हुईं, जघनों (नितम्बों)से", "r": "राज् + जघन", "g": "संधि: रेजुः + जघनैः", "p": [["रेजुः", "शोभित हुईं (लिट्, प्रथम पुरुष, बहुवचन)"], ["जघनैः", "जघनोंसे (तृतीया, बहुवचन)"]]}, "पुलिनैरिव": {"en": "as with sandbanks", "hi": "मानो रेतीले तटोंसे", "r": "पुलिन + इव", "g": "संधि: पुलिनैः + इव", "p": [["पुलिनैः", "रेतीले तटोंसे"], ["इव", "मानो"]]}, "किङ्किणीजालसङ्काशास्ता": {"en": "they, with their strings of little bells looking like (lotus) buds", "hi": "वे, जिनकी करधनीकी छोटी घण्टियोंकी लड़ियाँ (कमलकी कलियों)-जैसी दिखती थीं", "r": "किङ्किणी + जाल + सङ्काश + तद्", "g": "संधि: किङ्किणीजालसङ्काशाः + ताः; समास (बहुव्रीहि), प्रथमा, बहुवचन", "p": [["किङ्किणी", "छोटी घण्टियोंकी"], ["जाल", "लड़ियाँ"], ["सङ्काशाः", "जैसी दिखनेवाली"], ["ताः", "वे"]]}, "हेमविपुलाम्बुजाः": {"en": "with golden ornaments for large lotuses", "hi": "सोनेके आभूषणरूपी बड़े कमलोंवाली", "r": "हेमन् + विपुल + अम्बुज", "g": "समास (बहुव्रीहि), प्रथमा, बहुवचन", "p": [["हेम", "सोनेके (गहने)"], ["विपुल", "बड़े"], ["अम्बुजाः", "कमलोंवाली"]]}, "भावग्राहा": {"en": "with their amorous gestures for crocodiles", "hi": "हाव-भावरूपी ग्राहों (मगरों)वाली", "r": "भाव + ग्राह", "g": "समास (बहुव्रीहि), प्रथमा, बहुवचन (भावग्राहाः; विसर्ग-लोप)", "p": [["भाव", "हाव-भावरूपी"], ["ग्राहाः", "मगरोंवाली"]]}, "यशस्तीराः": {"en": "with their splendour (beauty) for banks", "hi": "कान्तिरूपी तटोंवाली", "r": "यशस् + तीर", "g": "समास (बहुव्रीहि), प्रथमा, बहुवचन", "p": [["यशः", "कान्ति, शोभा"], ["तीराः", "तटोंवाली"]]}, "सुप्ता": {"en": "asleep, sleeping", "hi": "सोयी हुई", "r": "स्वप्", "g": "क्त (भूतकृदन्त), प्रथमा, स्त्रीलिङ्ग, एकवचन / बहुवचन (सुप्ताः)"}, "नद्य": {"en": "rivers", "hi": "नदियाँ", "r": "नदी", "g": "प्रथमा, बहुवचन (नद्यः; इवसे पहले विसर्ग-लोप)"}, "इवाबभुः": {"en": "shone like", "hi": "की भाँति शोभित हुईं", "r": "इव + आ-भा", "g": "संधि: इव + आबभुः (लिट्, प्रथम पुरुष, बहुवचन)", "p": [["इव", "की भाँति"], ["आबभुः", "शोभित हुईं"]]}, "मृदुष्वङ्गेषु": {"en": "on the soft limbs", "hi": "कोमल अङ्गोंपर", "r": "मृदु + अङ्ग", "g": "संधि: मृदुषु + अङ्गेषु (सप्तमी, बहुवचन)", "p": [["मृदुषु", "कोमल"], ["अङ्गेषु", "अङ्गोंपर"]]}, "कासाञ्चित्": {"en": "of some (women)", "hi": "किन्हीं (स्त्रियों)के", "r": "किम् + चित्", "g": "षष्ठी, बहुवचन, स्त्रीलिङ्ग"}, "कुचाग्रेषु": {"en": "on the tips of the breasts", "hi": "स्तनोंके अग्रभागोंपर", "r": "कुच + अग्र", "g": "समास (षष्ठी तत्पुरुष), सप्तमी, बहुवचन", "p": [["कुच", "स्तनोंके"], ["अग्रेषु", "अग्रभागोंपर"]]}, "संस्थिताः": {"en": "set, placed / stationed, resting", "hi": "स्थित, टिके हुए / ठहरी हुई", "r": "सम् + स्था", "g": "क्त (भूतकृदन्त), प्रथमा, बहुवचन"}, "बभूवुर्भूषणानीव": {"en": "were like ornaments", "hi": "आभूषणोंके समान हो गयीं", "r": "भू + भूषण + इव", "g": "संधि: बभूवुः + भूषणानि + इव", "p": [["बभूवुः", "हो गयीं (लिट्, प्रथम पुरुष, बहुवचन)"], ["भूषणानि", "आभूषण"], ["इव", "के समान"]]}, "शुभा": {"en": "beautiful, auspicious", "hi": "सुन्दर, मङ्गलमयी", "r": "शुभ", "g": "प्रथमा, स्त्रीलिङ्ग, एकवचन / बहुवचन (शुभाः)"}, "भूषणराजयः": {"en": "the lines (marks) left by the ornaments", "hi": "आभूषणोंके (दबनेसे बने) चिह्नोंकी रेखाएँ", "r": "भूषण + राजि", "g": "समास (षष्ठी तत्पुरुष), प्रथमा, बहुवचन", "p": [["भूषण", "आभूषणोंकी"], ["राजयः", "रेखाएँ"]]}, "अंशुकान्ताश्च": {"en": "and the ends (borders) of garments", "hi": "और वस्त्रोंके छोर", "r": "अंशुक + अन्त + च", "g": "संधि: अंशुकान्ताः + च", "p": [["अंशुक", "वस्त्रोंके"], ["अन्ताः", "छोर"], ["च", "और"]]}, "कासाञ्चिन्मुखमारुतकम्पिताः": {"en": "of some (women), stirred by the breath of the mouth", "hi": "किन्हीं (स्त्रियों)के, मुखकी साँससे हिलते हुए", "r": "किम् + चित् + मुख + मारुत + कम्प्", "g": "संधि: कासाञ्चित् + मुखमारुतकम्पिताः", "p": [["कासाञ्चित्", "किन्हींके"], ["मुख", "मुखकी"], ["मारुत", "वायु (साँस)से"], ["कम्पिताः", "हिलाये हुए"]]}, "उपर्युपरि": {"en": "over, above (again and again)", "hi": "ऊपर-ऊपर", "r": "उपरि", "g": "अव्यय (द्विरुक्ति)", "p": [["उपरि", "ऊपर"], ["उपरि", "ऊपर"]]}, "वक्त्राणां": {"en": "of the faces", "hi": "मुखोंके", "r": "वक्त्र", "g": "षष्ठी, बहुवचन"}, "व्याधूयन्ते": {"en": "are tossed about, flutter", "hi": "हिलाये जाते हैं, फहराते हैं", "r": "वि + आ + धू", "g": "कर्मवाच्य, लट्, प्रथम पुरुष, बहुवचन"}, "पताका": {"en": "flags, banners", "hi": "पताकाएँ, झण्डियाँ", "r": "पताका", "g": "प्रथमा, बहुवचन (पताकाः; इवसे पहले विसर्ग-लोप)"}, "इवोद्धूताः": {"en": "like (flags) raised and fluttering", "hi": "ऊपर उठकर फहराती हुई (पताकाओं)की भाँति", "r": "इव + उद् + धू", "g":