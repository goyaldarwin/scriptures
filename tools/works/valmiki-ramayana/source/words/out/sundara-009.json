: {"en": "of the mighty one (Rāvaṇa)", "hi": "महामना (रावण)के", "r": "महत् + आत्मन्", "g": "समास (बहुव्रीहि), षष्ठी, एकवचन (महात्मनः)"}, "वेश्म": {"en": "the house, mansion", "hi": "भवन", "r": "वेश्मन्", "g": "प्रथमा / द्वितीया, एकवचन"}, "महारत्नपरिच्छदम्": {"en": "furnished with great jewels", "hi": "बहुमूल्य रत्नमय सामग्रियोंसे युक्त", "r": "महत् + रत्न + परिच्छद", "g": "समास (बहुव्रीहि), द्वितीया, एकवचन", "p": [["महारत्न", "बहुमूल्य रत्नोंकी"], ["परिच्छदम्", "सामग्रीवाला"]]}, "महारत्नसमाकीर्णं": {"en": "studded with great gems", "hi": "बड़े-बड़े रत्नोंसे भरा", "r": "महत् + रत्न + सम् + आ + कॄ", "g": "समास (तृतीया तत्पुरुष), द्वितीया, एकवचन", "p": [["महारत्न", "बड़े रत्नोंसे"], ["समाकीर्णम्", "भरा"]]}, "विराजमानं": {"en": "shining", "hi": "शोभायमान", "r": "वि + राज्", "g": "शानच् (वर्तमान कृदन्त), द्वितीया, एकवचन"}, "वपुषा": {"en": "by (its) form, by (its) beauty", "hi": "रूपसे, शरीरसे", "r": "वपुस्", "g": "तृतीया, एकवचन"}, "गजाश्वरथसङ्कुलम्": {"en": "crowded with elephants, horses and chariots", "hi": "हाथियों, घोड़ों और रथोंसे भरा", "r": "गज + अश्व + रथ + सङ्कुल", "g": "समास (तृतीया तत्पुरुष), द्वितीया, एकवचन", "p": [["गजाश्वरथ", "हाथियों, घोड़ों और रथोंसे"], ["सङ्कुलम्", "भरा"]]}, "लङ्काभरणमित्येव": {"en": "as the very ornament of Laṅkā", "hi": "लङ्काका आभूषण ही", "r": "लङ्का + आभरण + इति + एव", "g": "संधि: लङ्काभरणम् + इति + एव", "p": [["लङ्काभरणम्", "लङ्काका आभूषण"], ["इति", "ऐसा"], ["एव", "ही"]]}, "चचार": {"en": "moved about", "hi": "विचरण किया", "r": "चर्", "g": "लिट्, प्रथम पुरुष, एकवचन"}, "हनुमांस्तत्र": {"en": "Hanumān (son of the wind-god) there", "hi": "हनुमान्जी वहाँ", "r": "हनुमत् + तत्र", "g": "संधि: हनुमान् + तत्र", "p": [["हनुमान्", "हनुमान्जी"], ["तत्र", "वहाँ"]]}, "समीपतः": {"en": "near", "hi": "समीप", "r": "समीप", "g": "अव्यय (तसिल्)"}, "गृहाद्": {"en": "from house", "hi": "घरसे", "r": "गृह", "g": "पञ्चमी, एकवचन"}, "राक्षसानामुद्यानानि": {"en": "the gardens of the rākṣasas", "hi": "राक्षसोंके उद्यानोंको", "r": "राक्षस + उद्यान", "g": "संधि: राक