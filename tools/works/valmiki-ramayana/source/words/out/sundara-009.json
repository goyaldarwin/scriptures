{"चापानि": {"en": "bows", "hi": "धनुषोंको", "r": "चाप", "g": "द्वितीया, बहुवचन"}, "कान्ताश्च": {"en": "and the beloved women", "hi": "और प्रियतमा स्त्रियोंको", "r": "कान्ता + च", "g": "संधि: कान्ताः + च", "p": [["कान्ताः", "प्रियतमा स्त्रियोंको"], ["च", "और"]]}, "समालभन्त्य": {"en": "(women) anointing themselves (with sandal paste)", "hi": "(चन्दन आदिका) अनुलेप लगाती हुई", "r": "सम् + आ + लभ्", "g": "शतृ (वर्तमान कृदन्त), स्त्रीलिङ्ग, द्वितीया, बहुवचन (समालभन्त्यः)"}, "स्तथापरास्तत्र": {"en": "and likewise other (women) there", "hi": "तथा वहाँ दूसरी (स्त्रियोंको)", "r": "तथा + अपर + तत्र", "g": "संधि: (समालभन्त्यः) + तथा + अपराः + तत्र; आरम्भका स् पिछले पदका है", "p": [["तथा", "वैसे ही"], ["अपराः", "दूसरी (स्त्रियोंको)"], ["तत्र", "वहाँ"]]}, "स्वपन्त्यः": {"en": "sleeping", "hi": "सोती हुई", "r": "स्वप्", "g": "शतृ (वर्तमान कृदन्त), स्त्रीलिङ्ग, द्वितीया, बहुवचन"}, "सुरूपवक्त्राश्च": {"en": "and (women) with beautiful faces", "hi": "और सुन्दर मुखवाली (स्त्रियोंको)", "r": "सुरूप + वक्त्र + च", "g": "संधि: सुरूपवक्त्राः + च; समास (बहुव्रीहि), द्वितीया, बहुवचन", "p": [["सुरूप", "सुन्दर"], ["वक्त्राः", "मुखवाली"], ["च", "और"]]}, "हसन्त्यः": {"en": "laughing", "hi": "हँसती हुई", "r": "हस्", "g": "शतृ (वर्तमान कृदन्त), स्त्रीलिङ्ग, द्वितीया, बहुवचन"}, "क्रुद्धाः": {"en": "angry", "hi": "कुपित", "r": "क्रुध्", "g": "क्त (भूतकालिक कृदन्त), स्त्रीलिङ्ग, द्वितीया, बहुवचन"}, "पराश्चापि": {"en": "and others too", "hi": "और दूसरी (स्त्रियोंको) भी", "r": "पर + च + अपि", "g": "संधि: पराः + च + अपि", "p": [["पराः", "दूसरी (स्त्रियोंको)"], ["च", "और"], ["अपि", "भी"]]}, "विनिःश्वसन्त्यः": {"en": "sighing deeply", "hi": "लंबी साँसें लेती हुई", "r": "वि + निस् + श्वस्", "g": "शतृ (वर्तमान कृदन्त), स्त्रीलिङ्ग, द्वितीया, बहुवचन"}, "महागजैश्चापि": {"en": "and also with great elephants", "hi": "और बड़े-बड़े हाथियोंसे भी", "r": "महत् + गज + च + अपि", "g": "संधि: महागजैः + च + अपि; समास (कर्मधारय), तृतीया, बहुवचन", "p": [["महागजैः", "बड़े हाथियोंसे"], ["च", "और"], ["अपि", "भी"]]}, "नदद्भिः"