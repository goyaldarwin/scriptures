: "लट्, उत्तम पुरुष, एकवचन (आत्मनेपद)"}, "विशालाक्षि": {"en": "O large-eyed one", "hi": "हे विशाललोचने!", "r": "विशाल + अक्षि", "g": "सम्बोधन, एकवचन; बहुव्रीहि समास", "p": [["विशाल", "बड़ी"], ["अक्षि", "आँख"]]}, "मन्यस्व": {"en": "think, consider (with बहु: hold in high regard)", "hi": "मानो, समझो (बहु मन्यस्व: आदर करो)", "r": "मन्", "g": "लोट्, मध्यम पुरुष, एकवचन"}, "प्रिये": {"en": "O beloved", "hi": "हे प्रिये!", "r": "प्रिया", "g": "सम्बोधन, एकवचन"}, "सर्वाङ्गगुणसम्पन्ने": {"en": "O you endowed with every grace of limb", "hi": "हे सर्वाङ्गसुन्दरी!", "r": "सर्व + अङ्ग + गुण + सम्पन्न", "g": "सम्बोधन, एकवचन; तत्पुरुष समास", "p": [["सर्वाङ्ग", "सब अङ्ग"], ["गुण", "सौन्दर्य-गुण"], ["सम्पन्न", "युक्त"]]}, "सर्वलोकमनोहरे": {"en": "O charmer of all the worlds", "hi": "हे सब लोगोंका मन हरनेवाली!", "r": "सर्व + लोक + मनोहर", "g": "सम्बोधन, एकवचन; तत्पुरुष समास", "p": [["सर्वलोक", "सब लोग"], ["मनोहर", "मन हरनेवाली"]]}, "किञ्चिन्मनुष्या": {"en": "anyone, (no) humans", "hi": "कोई, मनुष्य", "r": "किञ्चित् + मनुष्य", "g": "संधि: किञ्चित् + मनुष्याः (प्रथमा, बहुवचन, विसर्गलोप)", "p": [["किञ्चित्", "कोई"], ["मनुष्याः", "मनुष्य"]]}, "कामरूपिणः": {"en": "able to take any form at will", "hi": "इच्छानुसार रूप धारण करनेवाले", "r": "काम + रूपिन्", "g": "प्रथमा, बहुवचन; उपपद समास", "p": [["काम", "इच्छा"], ["रूपिन्", "रूप धारण करनेवाला"]]}, "व्यपसर्पतु": {"en": "let it go away", "hi": "दूर हो जाय", "r": "वि-अप-सृप्", "g": "लोट्, प्रथम पुरुष, एकवचन"}, "सीते": {"en": "O Sītā", "hi": "हे सीते!", "r": "सीता", "g": "सम्बोधन, एकवचन"}, "मत्तः": {"en": "from me / than me", "hi": "मुझसे", "r": "अस्मद्", "g": "पञ्चमी, एकवचन"}, "समुत्थितम्": {"en": "arisen", "hi": "उत्पन्न", "r": "सम्-उद्-स्था", "g": "क्त, प्रथमा, एकवचन"}, "स्वधर्मो": {"en": "(their) own dharma, proper way", "hi": "अपना धर्म", "r": "स्व + धर्म", "g": "प्रथमा, एकवचन; तत्पुरुष समास", "p": [["स्व", "अपना"], ["धर्म", "धर्म"]]}, "भीरु": {"en": "O timid one", "hi": "हे भीरु!", "r": "भीरु", "g": "सम्बोधन, एकवचन"}, "सर्वदैव": {"en": "always indeed", "hi": "सदा ही", "r": "सर्वदा + एव", "g": "संधि: सर्वदा + एव", "p": [["सर्वदा", "सदा"], ["एव", "ही"]]}, "गमनं": {"en": "going (to), approaching / departure", "hi": "जाना, गमन / प्रस्थान", "r": "गमन", "g": "प्रथमा, एकवचन"}, "परस्त्रीणां": {"en": "of others' wives", "hi": "परायी स्त्रियोंका", "r": "पर + स्त्री", "g": "षष्ठी, बहुवचन; कर्मधारय समास", "p": [["पर", "पराया"], ["स्त्री", "स्त्री"]]}, "हरणं": {"en": "carrying off", "hi": "हरण करना", "r": "हरण", "g": "प्रथमा, एकवचन"}, "सम्प्रमथ्य": {"en": "by force", "hi": "बलपूर्वक", "r": "सम्-प्र-मथ्", "g": "ल्यप् (पूर्वकालिक)"}, "चैवमकामां": {"en": "and (you) thus unwilling", "hi": "और इस प्रकार न चाहनेवाली (तुमको)", "r": "च + एवम् + अकाम", "g": "संधि: च + एवम् + अकामाम् (द्वितीया, एकवचन)", "p": [["च", "और"], ["एवम्", "इस प्रकार"], ["अकामाम्", "न चाहनेवालीको"]]}, "स्प्रक्ष्यामि": {"en": "I will touch", "hi": "छूऊँगा", "r": "स्पृश्", "g": "लृट्, उत्तम पुरुष, एकवचन"}, "मैथिलि": {"en": "O Maithilī (Sītā, princess of Mithilā)", "hi": "हे मिथिलेशकुमारी!", "r": "मैथिली", "g": "सम्बोधन, एकवचन"}, "यथाकामं": {"en": "as it pleases, at will", "hi": "इच्छानुसार", "r": "यथा + काम", "g": "अव्ययीभाव समास", "p": [["यथा", "अनुसार"], ["कामम्", "इच्छा"]]}, "प्रवर्तताम्": {"en": "let it have its way", "hi": "चले, प्रवृत्त हो", "r": "प्र-वृत्", "g": "लोट्, प्रथम पुरुष, एकवचन"}, "देवि": {"en": "O queen, O lady", "hi": "हे देवि!", "r": "देवी", "g": "सम्बोधन, एकवचन"}, "विश्वसिहि": {"en": "trust", "hi": "विश्वास करो", "r": "वि-श्वस्", "g": "लोट्, मध्यम पुरुष, एकवचन"}, "प्रणयस्व": {"en": "show love (to me)", "hi": "प्रेम करो", "r": "प्र-नी", "g": "लोट्, मध्यम पुरुष, एकवचन (आत्मनेपद)"}, "तत्त्वेन": {"en": "truly, in truth", "hi": "सचमुच, यथार्थरूपसे", "r": "तत्त्व", "g": "तृतीया, एकवचन"}, "मैवं": {"en": "not so", "hi": "ऐसी नहीं", "r": "मा + एवम्", "g": "संधि: मा + एवम्", "p": [["मा", "मत"], ["एवम्", "ऐसी"]]}, "भूः": {"en": "be (with मा: do not be)", "hi": "हो (मा भूः: मत हो)", "r": "भू", "g": "लुङ्, मध्यम पुरुष, एकवचन (मा-योगमें अट्-रहित)"}, "शोकलालसा": {"en": "given over to grief", "hi": "शोकमें डूबी हुई", "r": "शोक + लालसा", "g": "प्रथमा, एकवचन; बहुव्रीहि समास", "p": [["शोक", "शोक"], ["लालसा", "लगन"]]}, "एकवेणी": {"en": "a single braid", "hi": "एक ही वेणी", "r": "एक + वेणी", "g": "प्रथमा, एकवचन; समास", "p": [["एक", "एक"], ["वेणी", "चोटी"]]}, "अधःशय्या": {"en": "sleeping on the ground / lying on the ground", "hi": "भूमिपर सोना / भूमिपर सोनेवाली", "r": "अधस् + शय्या", "g": "प्रथमा, एकवचन; समास", "p": [["अधः", "नीचे"], ["शय्या", "शयन"]]}, "ध्यानं": {"en": "brooding", "hi": "चिन्ता", "r": "ध्यान", "g": "प्रथमा, एकवचन"}, "मलिनमम्बरम्": {"en": "a soiled garment", "hi": "मैला वस्त्र", "r": "मलिन + अम्बर", "g": "संधि: मलिनम् + अम्बरम्", "p": [["मलिनम्", "मैला"], ["अम्बरम्", "वस्त्र"]]}, "अस्थानेऽप्युपवासश्च": {"en": "and fasting even out of season", "hi": "और बिना अवसरके भी उपवास", "r": "अस्थान + अपि + उपवास + च", "g": "संधि: अस्थाने + अपि + उपवासः + च", "p": [["अस्थाने", "बिना अवसर"], ["अपि", "भी"], ["उपवासः", "उपवास"], ["च", "और"]]}, "नैतान्यौपयिकानि": {"en": "these are not fitting", "hi": "ये उचित नहीं हैं", "r": "न + एतद् + औपयिक", "g": "संधि: न + एतानि + औपयिकानि", "p": [["न", "नहीं"], ["एतानि", "ये"], ["औपयिकानि", "उचित"]]}, "माल्यानि": {"en": "garlands", "hi": "मालाएँ", "r": "माल्य", "g": "प्रथमा/द्वितीया, बहुवचन"}, "चन्दनान्यगुरूणि": {"en": "sandal-pastes and aloe-woods", "hi": "चन्दन और अगुरु", "r": "चन्दन + अगुरु", "g": "संधि: चन्दनानि + अगुरूणि", "p": [["चन्दनानि", "चन्दन"], ["अगुरूणि", "अगुरु"]]}, "वासांसि": {"en": "garments / clothes", "hi": "वस्त्र", "r": "वासस्", "g": "प्रथमा/द्वितीया, बहुवचन"}, "दिव्यान्याभरणानि": {"en": "divine ornaments", "hi": "दिव्य आभूषण", "r": "दिव्य + आभरण", "g": "संधि: दिव्यानि + आभरणानि", "p": [["दिव्यानि", "दिव्य"], ["आभरणानि", "आभूषण"]]}, "नृत्यं": {"en": "dance", "hi": "नृत्य", "r": "नृत्य", "g": "द्वितीया, एकवचन"}, "वाद्यं": {"en": "instrumental music", "hi": "वाद्य", "r": "वाद्य", "g": "द्वितीया, एकवचन"}, "लभ": {"en": "obtain", "hi": "प्राप्त करो", "r": "लभ्", "g": "लोट्, मध्यम पुरुष, एकवचन"}, "स्त्रीरत्नमसि": {"en": "you are a jewel among women", "hi": "तुम स्त्रियोंमें रत्न हो", "r": "स्त्री + रत्न + अस्", "g": "संधि: स्त्रीरत्नम् + असि", "p": [["स्त्रीरत्नम्", "स्त्रियोंमें रत्न"], ["असि", "हो"]]}, "गात्रेषु": {"en": "on the limbs", "hi": "अङ्गोंमें", "r": "गात्र", "g": "सप्तमी, बहुवचन"}, "भूषणम्": {"en": "ornament", "hi": "आभूषण, शोभा", "r": "भूषण", "g": "द्वितीया/प्रथमा, एकवचन"}, "स्यास्त्वमनर्हा": {"en": "could you be unworthy", "hi": "तुम (भोगोंके) अयोग्य होओगी", "r": "अस् + युष्मद् + अनर्ह", "g": "संधि: स्याः + त्वम् + अनर्हा (स्याः: विधिलिङ्, मध्यम पुरुष, एकवचन)", "p": [["स्याः", "होओ"], ["त्वम्", "तुम"], ["अनर्हा", "अयोग्य"]]}, "सुविग्रहे": {"en": "O you of lovely form", "hi": "हे सुन्दर शरीरवाली!", "r": "सु + विग्रह", "g": "सम्बोधन, एकवचन; बहुव्रीहि समास", "p": [["सु", "सुन्दर"], ["विग्रह", "शरीर"]]}, "सञ्जातं": {"en": "come about, arisen", "hi": "प्राप्त हुआ", "r": "सम्-जन्", "g": "क्त, प्रथमा, एकवचन"}, "यौवनं": {"en": "youth", "hi": "यौवन", "r": "यौवन", "g": "प्रथमा, एकवचन"}, "ह्यतिवर्तते": {"en": "is indeed passing away", "hi": "बीता जा रहा है", "r": "हि + अति-वृत्", "g": "संधि: हि + अतिवर्तते (लट्, प्रथम पुरुष, एकवचन)", "p": [["हि", "क्योंकि, निश्चय ही"], ["अतिवर्तते", "बीता जा रहा है"]]}, "यदतीतं": {"en": "what has passed", "hi": "जो बीत गया", "r": "यद् + अतीत", "g": "संधि: यत् + अतीतम्", "p": [["यत्", "जो"], ["अतीतम्", "बीता हुआ"]]}, "पुनर्नैति": {"en": "does not come again", "hi": "फिर नहीं लौटता", "r": "पुनर् + न + इ", "g": "संधि: पुनः + न + एति", "p": [["पुनः", "फिर"], ["न", "नहीं"], ["एति", "आता"]]}, "स्रोतः": {"en": "the current", "hi": "धारा", "r": "स्रोतस्", "g": "प्रथमा, एकवचन"}, "स्रोतस्विनामिव": {"en": "as (that) of rivers", "hi": "मानो नदियोंकी", "r": "स्रोतस्विनी + इव", "g": "संधि: स्रोतस्विनाम् + इव (षष्ठी, बहुवचन)", "p": [["स्रोतस्विनाम्", "नदियोंकी"], ["इव", "जैसे"]]}, "कृत्वोपरतो": {"en": "having made (you), ceased", "hi": "(तुम्हें) बनाकर रुक गया", "r": "कृ + उपरत", "g": "संधि: कृत्वा + उपरतः", "p": [["कृत्वा", "बनाकर"], ["उपरतः", "रुक गया, निवृत्त हो गया"]]}, "रूपकर्ता": {"en": "the maker of forms", "hi": "रूपोंका निर्माता", "r": "रूप + कर्तृ", "g": "प्रथमा, एकवचन; तत्पुरुष समास", "p": [["रूप", "रूप"], ["कर्तृ", "बनानेवाला"]]}, "विश्वकृत्": {"en": "the creator of the universe", "hi": "विश्वके रचयिता (ब्रह्माजी)", "r": "विश्व + कृत्", "g": "प्रथमा, एकवचन; उपपद समास", "p": [["विश्व", "जगत्"], ["कृत्", "बनानेवाला"]]}}