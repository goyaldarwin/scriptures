ind fixed on Sītā", "hi": "जिसका मन सीतामें आसक्त था", "r": "सीता + आसक्त + मनस्", "g": "प्रथमा, एकवचन (विसर्गलोप); बहुव्रीहि समास", "p": [["सीता", "सीताजी"], ["आसक्त", "लगा हुआ"], ["मनस्", "मन"]]}, "मन्दाञ्चितगतिर्बभौ": {"en": "appeared with a slow, graceful gait", "hi": "मन्द और सुन्दर चालसे शोभित हुआ", "r": "मन्द + अञ्चित + गति + भा", "g": "संधि: मन्दाञ्चितगतिः + बभौ (बभौ: लिट्, प्रथम पुरुष, एकवचन)", "p": [["मन्द", "धीमी"], ["अञ्चित", "सुन्दर, लचीली"], ["गतिः", "चालवाला"], ["बभौ", "शोभित हुआ"]]}, "काञ्चीनिनादं": {"en": "the jingling of the girdles", "hi": "करधनियोंकी झनकारको", "r": "काञ्ची + निनाद", "g": "द्वितीया, एकवचन; तत्पुरुष समास", "p": [["काञ्ची", "करधनी"], ["निनाद", "शब्द"]]}, "परमस्त्रीणां": {"en": "of the finest women", "hi": "उत्तम स्त्रियोंके", "r": "परम + स्त्री", "g": "षष्ठी, बहुवचन; कर्मधारय समास", "p": [["परम", "उत्तम"], ["स्त्री", "स्त्री"]]}, "कपिर्मारुतनन्दनः": {"en": "the monkey, son of the Wind-god (Hanumān)", "hi": "पवनपुत्र कपि (हनुमान्जी)", "r": "कपि + मारुत + नन्दन", "g": "संधि: कपिः + मारुतनन्दनः (प्रथमा, एकवचन)", "p": [["कपिः", "वानर"], ["मारुतनन्दनः", "पवनपुत्र"]]}, "चाप्रतिमकर्माणमचिन्त्यबलपौरुषम्": {"en": "and him of matchless deeds, of unimaginable strength and valour", "hi": "और अनुपम कर्म करनेवाले तथा अचिन्त्य बल-पौरुषवाले (उसको)", "r": "च + अप्रतिम + कर्मन् + अचिन्त्य + बल + पौरुष", "g": "संधि: च + अप्रतिमकर्माणम् + अचिन्त्यबलपौरुषम् (द्वितीया, एकवचन; बहुव्रीहि)", "p": [["च", "और"], ["अप्रतिमकर्माणम्", "अनुपम कर्म करनेवालेको"], ["अचिन्त्यबलपौरुषम्", "अचिन्त्य बल और पौरुषवालेको"]]}, "द्वारदेशमनुप्राप्तं": {"en": "arrived at the entrance", "hi": "द्वारपर आ पहुँचे हुए", "r": "द्वार + देश + अनु-प्र-आप्", "g": "संधि: द्वारदेशम् + अनुप्राप्तम् (द्वितीया, एकवचन)", "p": [["द्वारदेशम्", "द्वारपर"], ["अनुप्राप्तम्", "पहुँचे हुएको"]]}, "दीपिकाभिरनेकाभिः": {"en": "by many torches", "hi": "अनेक मशालोंसे", "r": "दीपिका + अनेक", "g": "संधि: दीपिकाभिः + अनेकाभिः (तृतीया, बहुवचन)", "p": [["दीपिकाभिः", "मशालोंसे"], ["अनेकाभिः", "अनेक"]]}, "समन्ताद