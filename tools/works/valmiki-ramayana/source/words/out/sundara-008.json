so the sounds (of footsteps) on the stairs", "hi": "और सीढ़ियोंपर (चढ़ने-उतरनेके) शब्दोंको भी", "r": "सोपान + निनद + च + अपि", "g": "संधि: सोपाननिनदान् + च + अपि", "p": [["सोपाननिनदान्", "सीढ़ियोंके शब्दोंको"], ["च", "और"], ["अपि", "भी"]]}, "भवनेषु": {"en": "in the mansions", "hi": "भवनोंमें", "r": "भवन", "g": "सप्तमी, बहुवचन"}, "महात्मनाम्": {"en": "of the great (high-minded) ones", "hi": "महात्माओं (बड़े लोगों)के", "r": "महात्मन्", "g": "षष्ठी, बहुवचन"}, "आस्फोटितनिनादांश्च": {"en": "and the sounds of slapping the arms (as wrestlers do)", "hi": "और भुजाओंपर ताल ठोंकनेके शब्दोंको", "r": "आ-स्फुट् + निनाद + च", "g": "संधि: आस्फोटितनिनादान् + च", "p": [["आस्फोटित", "ताल ठोंकनेके"], ["निनादान्", "शब्दोंको"], ["च", "और"]]}, "क्ष्वेडितांश्च": {"en": "and roars (shouts)", "hi": "और सिंहनादों (गर्जनाओं)को", "r": "क्ष्वेडित + च", "g": "संधि: क्ष्वेडितान् + च (द्वितीया, बहुवचन)", "p": [["क्ष्वेडितान्", "गर्जनाओंको"], ["च", "और"]]}, "जपतां": {"en": "of (those) reciting in prayer", "hi": "जप करनेवालोंके", "r": "जप्", "g": "शतृ (वर्तमान कृदन्त), षष्ठी, बहुवचन"}, "मन्त्रान्": {"en": "sacred hymns, mantras", "hi": "मन्त्रोंको", "r": "मन्त्र", "g": "द्वितीया, बहुवचन"}, "रक्षोगृहेषु": {"en": "in the houses of the rākṣasas", "hi": "राक्षसोंके घरोंमें", "r": "रक्षस् + गृह", "g": "समास (षष्ठी तत्पुरुष), सप्तमी, बहुवचन", "p": [["रक्षः", "राक्षसोंके"], ["गृहेषु", "घरोंमें"]]}, "स्वाध्यायनिरतांश्चैव": {"en": "and also (those) devoted to study of the Vedas", "hi": "और वेदपाठमें लगे हुओंको भी", "r": "स्वाध्याय + नि-रम् + च + एव", "g": "संधि: स्वाध्यायनिरतान् + च + एव", "p": [["स्वाध्यायनिरतान्", "वेदपाठमें लगे हुओंको"], ["च", "और"], ["एव", "भी"]]}, "यातुधानान्": {"en": "rākṣasas, demons", "hi": "राक्षसोंको", "r": "यातुधान", "g": "द्वितीया, बहुवचन"}, "रावणस्तवसंयुक्तान्": {"en": "engaged in praising Rāvaṇa", "hi": "रावणकी स्तुतिमें लगे हुए", "r": "रावण + स्तव + सम्-युज्", "g": "समास (तृतीया तत्पुरुष), द्वितीया, बहुवचन", "p": [["रावणस्तव", "रावणकी स्तुतिसे"], ["संयुक्तान्", "युक्त"]]}, "गर्जतो": {"en": "roaring", "hi": "गरजते हुए", "r": "गर्ज्", "g": "शतृ (वर्तमान कृदन्त), द्वितीया, बहुवचन"}, "राक्षसानपि": {"en": "rākṣasas also", "hi": "राक्षसोंको भी", "r": "राक्षस + अपि", "g": "संधि: राक्षसान् + अपि", "p": [["राक्षसान्", "राक्षसोंको"], ["अपि", "भी"]]}, "राजमार्गं": {"en": "the royal road", "hi": "राजमार्गको", "r": "राजन् + मार्ग", "g": "समास (षष्ठी तत्पुरुष), द्वितीया, एकवचन", "p": [["राज", "राजाका"], ["मार्गम्", "मार्ग"]]}, "समावृत्य": {"en": "covering, filling (completely)", "hi": "घेरकर, छाकर", "r": "सम् + आ + वृ", "g": "ल्यप् (पूर्वकालिक)"}, "रक्षोगणं": {"en": "a host of rākṣasas", "hi": "राक्षसोंके समूहको", "r": "रक्षस् + गण", "g": "समास (षष्ठी तत्पुरुष), द्वितीया, एकवचन", "p": [["रक्षः", "राक्षसोंके"], ["गणम्", "समूहको"]]}, "मध्यमे": {"en": "in the central", "hi": "बीचवाले", "r": "मध्यम", "g": "सप्तमी, एकवचन"}, "गुल्मे": {"en": "in the (central) guard-post, troop of guards", "hi": "सैनिक चौकी (रक्षकदल)में", "r": "गुल्म", "g": "सप्तमी, एकवचन"}, "राक्षसस्य": {"en": "of the rākṣasa (Rāvaṇa)", "hi": "राक्षस (रावण)के", "r": "राक्षस", "g": "षष्ठी, एकवचन"}, "चरान्": {"en": "spies", "hi": "गुप्तचरोंको", "r": "चर", "g": "द्वितीया, बहुवचन"}, "बहून्": {"en": "many", "hi": "बहुतोंको", "r": "बहु", "g": "द्वितीया, बहुवचन"}, "दीक्षिताञ्जटिलान्": {"en": "(some) consecrated for rites, (some) with matted hair", "hi": "(कुछ) दीक्षा लिये हुए, (कुछ) जटाधारी", "r": "दीक्षित + जटिल", "g": "संधि: दीक्षितान् + जटिलान् (द्वितीया, बहुवचन)", "p": [["दीक्षितान्", "दीक्षा लिये हुओंको"], ["जटिलान्", "जटाधारियोंको"]]}, "मुण्डान्": {"en": "with shaven heads", "hi": "सिर मुँड़ाये हुओंको", "r": "मुण्ड", "g": "द्वितीया, बहुवचन"}, "गोजिनाम्बरवाससः": {"en": "clothed in garments of cowhide", "hi": "गोचर्मके वस्त्र पहने हुओंको", "r": "गो + अजिन + अम्बर + वासस्", "g": "समास (बहुव्रीहि), द्वितीया, बहुवचन", "p": [["गो", "गौके"], ["अजिन", "चर्मके"], ["अम्बर", "वस्त्ररूप"], ["वाससः", "पहनावेवालोंको"]]}, "दर्भमुष्टिप्रहरणानग्निकुण्डायुधांस्तथा": {"en": "having fistfuls of darbha grass as weapons, and likewise having fire-pots as weapons", "hi": "मुट्ठीभर कुशोंको ही अस्त्र बनाये हुए तथा अग्निकुण्डोंको ही आयुध बनाये हुए", "r": "दर्भ + मुष्टि + प्रहरण + अग्नि + कुण्ड + आयुध + तथा", "g": "संधि: दर्भमुष्टिप्रहरणान् + अग्निकुण्डायुधान् + तथा (समास, बहुव्रीहि, द्वितीया, बहुवचन)", "p": [["दर्भमुष्टिप्रहरणान्", "मुट्ठीभर कुश ही जिनके अस्त्र हैं, उन्हें"], ["अग्निकुण्डायुधान्", "अग्निकुण्ड ही जिनके आयुध हैं, उन्हें"], ["तथा", "तथा"]]}, "कूटमुद्गरपाणींश्च": {"en": "and with hammers and maces in their hands", "hi": "और हाथोंमें हथौड़े और मुद्गर लिये हुओंको", "r": "कूट + मुद्गर + पाणि + च", "g": "संधि: कूटमुद्गरपाणीन् + च (समास, बहुव्रीहि, द्वितीया, बहुवचन)", "p": [["कूट", "हथौड़े"], ["मुद्गर", "मुद्गर"], ["पाणीन्", "हाथोंमें लिये हुओंको"], ["च", "और"]]}, "दण्डायुधधरानपि": {"en": "and also bearing staffs as weapons", "hi": "और डंडेको आयुधरूपमें धारण करनेवालोंको भी", "r": "दण्ड + आयुध + धर + अपि", "g": "संधि: दण्डायुधधरान् + अपि", "p": [["दण्डायुधधरान्", "डंडेरूपी आयुध धारण करनेवालोंको"], ["अपि", "भी"]]}, "एकाक्षानेकवर्णांश्च": {"en": "one-eyed ones, and ones of many colours", "hi": "एक आँखवालोंको और अनेक रंगोंवालोंको", "r": "एक + अक्षि + अनेक + वर्ण + च", "g": "संधि: एकाक्षान् + अनेकवर्णान् + च", "p": [["एकाक्षान्", "एक आँखवालोंको"], ["अनेकवर्णान्", "अनेक रंगोंवालोंको"], ["च", "और"]]}, "लम्बोदरपयोधरान्": {"en": "with pendulous bellies and breasts", "hi": "लटकते पेट और स्तनोंवालोंको", "r": "लम्ब + उदर + पयोधर", "g": "समास (बहुव्रीहि), द्वितीया, बहुवचन", "p": [["लम्ब", "लटकते हुए"], ["उदर", "पेट"], ["पयोधरान्", "और स्तनोंवालोंको"]]}, "करालान्": {"en": "frightful", "hi": "भयंकर (विकराल) रूपवालोंको", "r": "कराल", "g": "द्वितीया, बहुवचन"}, "भुग्नवक्त्रांश्च": {"en": "and with crooked faces", "hi": "और टेढ़े मुखवालोंको", "r": "भुग्न + वक्त्र + च", "g": "संधि: भुग्नवक्त्रान् + च (समास, बहुव्रीहि)", "p": [["भुग्न", "टेढ़े"], ["वक्त्रान्", "मुखवालोंको"], ["च", "और"]]}, "विकटान्": {"en": "hideous, monstrous", "hi": "विकट (बेडौल)", "r": "विकट", "g": "द्वितीया, बहुवचन"}, "वामनांस्तथा": {"en": "and likewise dwarfs", "hi": "तथा बौनोंको", "r": "वामन + तथा", "g": "संधि: वामनान् + तथा", "p": [["वामनान्", "बौनोंको"], ["तथा", "तथा"]]}, "धन्विनः": {"en": "archers, bearing bows", "hi": "धनुर्धारियोंको", "r": "धन्विन्", "g": "द्वितीया, बहुवचन"}, "खड्गिनश्चैव": {"en": "and also swordsmen", "hi": "और तलवारधारियोंको भी", "r": "खड्गिन् + च + एव", "g": "संधि: खड्गिनः + च + एव", "p": [["खड्गिनः", "तलवारधारियोंको"], ["च", "और"], ["एव", "भी"]]}, "शतघ्नीमुसलायुधान्": {"en": "armed with śataghnīs (spiked missiles) and pestle-clubs", "hi": "शतघ्नी और मूसल जिनके आयुध हैं, उन्हें", "r": "शतघ्नी + मुसल + आयुध", "g": "समास (बहुव्रीहि), द्वितीया, बहुवचन", "p": [["शतघ्नी", "शतघ्नी (काँटेदार अस्त्र)"], ["मुसल", "मूसल"], ["आयुधान्", "आयुधवालोंको"]]}, "परिघोत्तमहस्तांश्च": {"en": "and holding excellent iron bars in their hands", "hi": "और हाथोंमें उत्तम परिघ (लोहदण्ड) लिये हुओंको", "r": "परिघ + उत्तम + हस्त + च", "g": "संधि: परिघोत्तमहस्तान् + च (समास, बहुव्रीहि)", "p": [["परिघोत्तम", "उत्तम परिघ"], ["हस्तान्", "हाथमें लिये हुओंको"], ["च", "और"]]}, "विचित्रकवचोज्ज्वलान्": {"en": "gleaming in many-coloured armour", "hi": "विचित्र कवचोंसे चमकते हुओंको", "r": "विचित्र + कवच + उत्-ज्वल्", "g": "समास (तृतीया तत्पुरुष), द्वितीया, बहुवचन", "p": [["विचित्रकवच", "विचित्र कवचोंसे"], ["उज्ज्वलान्", "चमकते हुओंको"]]}, "नातिस्थूलान्": {"en": "not too stout", "hi": "जो न अधिक मोटे थे, उन्हें", "r": "न + अति + स्थूल", "g": "समास, द्वितीया, बहुवचन", "p": [["न", "नहीं"], ["अतिस्थूलान्", "अधिक मोटोंको"]]}, "नातिकृशान्": {"en": "not too thin", "hi": "जो न अधिक दुबले थे, उन्हें", "r": "न + अति + कृश", "g": "समास, द्वितीया, बहुवचन", "p": [["न", "नहीं"], ["अतिकृशान्", "अधिक दुबलोंको"]]}, "नातिदीर्घातिह्रस्वकान्": {"en": "neither too tall nor too short", "hi": "न अधिक लंबे, न अधिक नाटे", "r": "न + अति + दीर्घ + अति + ह्रस्वक", "g": "समास, द्वितीया, बहुवचन", "p": [["न", "नहीं"], ["अतिदीर्घ", "अधिक लंबे"], ["अतिह्रस्वकान्", "अधिक नाटोंको"]]}, "नातिगौरान्": {"en": "not too fair", "hi": "जो न अधिक गोरे थे, उन्हें", "r": "न + अति + गौर", "g": "समास, द्वितीया, बहुवचन", "p": [["न", "नहीं"], ["अतिगौरान्", "अधिक गोरोंको"]]}, "नातिकृष्णान्नातिकुब्जान्न": {"en": "not too dark, not too hunchbacked, nor (dwarfish)", "hi": "न अधिक काले, न अधिक कुबड़े, न (बौने)", "r": "न + अति + कृष्ण + न + अति + कुब्ज + न", "g": "संधि: नातिकृष्णान् + नातिकुब्जान् + न", "p": [["नातिकृष्णान्", "न अधिक कालोंको"], ["नातिकुब्जान्", "न अधिक कुबड़ोंको"], ["न", "न (बौनोंको)"]]}, "वामनान्": {"en": "dwarfs (here with 'na': not dwarfish)", "hi": "बौनोंको (यहाँ 'न' के साथ: जो बौने नहीं थे)", "r": "वामन", "g": "द्वितीया, बहुवचन"}, "विरूपान्": {"en": "misshapen, ugly ones", "hi": "कुरूपोंको", "r": "विरूप", "g": "द्वितीया, बहुवचन"}, "बहुरूपांश्च": {"en": "and ones of many forms", "hi": "और अनेक रूप धारण करनेवालोंको", "r": "बहु + रूप + च", "g": "संधि: बहुरूपान् + च (समास, बहुव्रीहि)", "p": [["बहुरूपान्", "अनेक रूपोंवालोंको"], ["च", "और"]]}, "सुरूपांश्च": {"en": "and handsome ones", "hi": "और सुन्दर रूपवालोंको", "r": "सु + रूप + च", "g": "संधि: सुरूपान् + च (समास, बहुव्रीहि)", "p": [["सुरूपान्", "सुन्दर रूपवालोंको"], ["च", "और"]]}, "सुवर्चसः": {"en": "full of splendour, radiant", "hi": "बड़े तेजस्वी", "r": "सुवर्चस्", "g": "द्वितीया, बहुवचन"}, "ध्वजिनः": {"en": "bearing banners", "hi": "ध्वजा धारण करनेवालोंको", "r": "ध्वजिन्", "g": "द्वितीया, बहुवचन"}, "पताकिनश्चैव": {"en": "and also bearing pennants", "hi": "और पताका धारण करनेवालोंको भी", "r": "पताकिन् + च + एव", "g": "संधि: पताकिनः + च + एव", "p": [["पताकिनः", "पताकाधारियोंको"], ["च", "और"], ["एव", "भी"]]}, "विविधायुधान्": {"en": "bearing various weapons", "hi": "अनेक प्रकारके आयुध धारण करनेवालोंको", "r": "विविध + आयुध", "g": "समास (बहुव्रीहि), द्वितीया, बहुवचन", "p": [["विविध", "अनेक प्रकारके"], ["आयुधान्", "आयुधोंवालोंको"]]}, "शक्तिवृक्षायुधांश्चैव": {"en": "and also those with spears (śakti) and trees as weapons", "hi": "और शक्ति तथा वृक्षोंको आयुध बनाये हुओंको भी", "r": "शक्ति + वृक्ष + आयुध + च + एव", "g": "संधि: शक्तिवृक्षायुधान् + च + ए