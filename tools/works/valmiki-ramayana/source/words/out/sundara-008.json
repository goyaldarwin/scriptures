{"व्यतिक्रमः": {"en": "transgression, a departure (from what is set) / such a lapse (in conduct)", "hi": "उल्लङ्घन, टलना / ऐसा व्यतिक्रम (मर्यादाका उल्लङ्घन)", "r": "वि + अति + क्रम्", "g": "प्रथमा, एकवचन"}, "सीतानिमित्तं": {"en": "because of Sītā / about Sītā", "hi": "सीताके कारण / सीताके विषयमें", "r": "सीता + निमित्त", "g": "समास (षष्ठी तत्पुरुष), अव्ययवत् (द्वितीया, एकवचन)", "p": [["सीता", "सीताके"], ["निमित्तम्", "कारण, विषयमें"]]}, "राज्ञस्तु": {"en": "but of the king", "hi": "परंतु राजाके", "r": "राजन् + तु", "g": "संधि: राज्ञः + तु", "p": [["राज्ञः", "राजाके"], ["तु", "परंतु, तो"]]}, "दुरात्मनः": {"en": "of the evil-minded one", "hi": "दुष्टात्माके", "r": "दुरात्मन्", "g": "षष्ठी, एकवचन"}, "सर्वेषां": {"en": "of all", "hi": "सबके", "r": "सर्व", "g": "षष्ठी, बहुवचन"}, "विनाशः": {"en": "destruction, ruin", "hi": "विनाश", "r": "विनाश", "g": "प्रथमा, एकवचन"}, "समुपागतः": {"en": "has come, has drawn near / has entered into (friendship)", "hi": "आ पहुँचा है / (मित्रता)को प्राप्त हुआ", "r": "सम् + उप + आ + गम्", "g": "क्त (भूतकालिक कृदन्त), प्रथमा, एकवचन"}, "विधत्स्व": {"en": "carry out, accomplish", "hi": "सम्पन्न करो", "r": "वि + धा", "g": "लोट्, मध्यम पुरुष, एकवचन (आत्मनेपद)"}, "सर्वकार्याणि": {"en": "all the tasks", "hi": "सब कार्य", "r": "सर्व + कार्य", "g": "समास (कर्मधारय), द्वितीया, बहुवचन", "p": [["सर्व", "सब"], ["कार्याणि", "कार्य"]]}, "यानीह": {"en": "which (ones) here", "hi": "जो-जो यहाँ", "r": "यद् + इह", "g": "संधि: यानि + इह", "p": [["यानि", "जो (कार्य)"], ["इह", "यहाँ"]]}, "वाञ्छसि": {"en": "you wish", "hi": "तुम चाहते हो", "r": "वाञ्छ्", "g": "लट्, मध्यम पुरुष, एकवचन"}, "शापोपहतां": {"en": "struck by a curse", "hi": "शापसे मारी हुई (शापग्रस्त)", "r": "शाप + उप + हन्", "g": "समास (तृतीया तत्पुरुष), द्वितीया, एकवचन, स्त्रीलिङ्ग", "p": [["शाप", "शापसे"], ["उपहताम्", "आहत, ग्रस्त"]]}, "राक्षसमुख्यपालिताम्": {"en": "ruled (guarded) by the chief of the rākṣasas (Rāvaṇa)", "hi": "राक्षसराज (रावण)द्वारा पालित", "r": "राक्षस + मुख्य + पालि", "g": "समास (तृतीया तत्पुरुष), द्वितीया, एकवचन, स्त्रीलिङ्ग", "p": [["राक्षसमुख्य", "राक्षसोंके प्रधान (रावण)द्वारा"], ["पालिताम्", "पालित, रक्षित"]]}, "यदृच्छया": {"en": "freely, at will / at random", "hi": "स्वेच्छासे, बेरोक-टोक / अनायास, इधर-उधर", "r": "यदृच्छा", "g": "तृतीया, एकवचन (अव्ययवत्)"}, "सतीं": {"en": "the virtuous (chaste) lady", "hi": "सती (पतिव्रता)को", "r": "सती", "g": "द्वितीया, एकवचन, स्त्रीलिङ्ग"}, "विमार्ग": {"en": "search for (her)", "hi": "खोजो", "r": "मार्ग्", "g": "लोट्, मध्यम पुरुष, एकवचन"}, "गतो": {"en": "gone, having gone (to)", "hi": "गया हुआ, जाकर", "r": "गम्", "g": "क्त (भूतकालिक कृदन्त), प्रथमा, एकवचन"}, "निर्जित्य": {"en": "having conquered", "hi": "जीतकर", "r": "निर् + जि", "g": "ल्यप् (पूर्वकालिक)"}, "श्रेष्ठां": {"en": "the excellent, foremost (city)", "hi": "श्रेष्ठ (नगरी)को", "r": "श्रेष्ठ", "g": "द्वितीया, एकवचन, स्त्रीलिङ्ग"}, "कामरूपिणीम्": {"en": "able to take any form at will", "hi": "इच्छानुसार रूप धारण करनेवाली", "r": "काम + रूपिन्", "g": "समास (उपपद), द्वितीया, एकवचन, स्त्रीलिङ्ग", "p": [["काम", "इच्छानुसार"], ["रूपिणीम्", "रूप धारण करनेवालीको"]]}, "कपिसत्तमः": {"en": "the best of monkeys (Hanumān)", "hi": "कपिश्रेष्ठ (हनुमान्जी)", "r": "कपि + सत्तम", "g": "समास (षष्ठी तत्पुरुष), प्रथमा, एकवचन", "p": [["कपि", "वानरोंमें"], ["सत्तमः", "श्रेष्ठ"]]}, "अद्वारेण": {"en": "not by the gate", "hi": "द्वारसे नहीं (बिना द्वारके)", "r": "अ + द्वार", "g": "समास (नञ् तत्पुरुष), तृतीया, एकवचन", "p": [["अ", "नहीं"], ["द्वारेण", "द्वारसे"]]}, "महावीर्यः": {"en": "of great valour", "hi": "महापराक्रमी", "r": "महत् + वीर्य", "g": "समास (बहुव्रीहि), प्रथमा, एकवचन", "p": [["महा", "महान्"], ["वीर्यः", "पराक्रमवाला"]]}, "प्राकारमवपुप्लुवे": {"en": "leapt over (down from) the rampart", "hi": "परकोटेको लाँघकर (उसपरसे) नीचे कूद पड़ा", "r": "प्राकार + अव-प्लु", "g": "संधि: प्राकारम् + अवपुप्लुवे (लिट्, प्रथम पुरुष, एकवचन, आत्मनेपद)", "p": [["प्राकारम्", "परकोटेको"], ["अवपुप्लुवे", "कूदकर उतरा"]]}, "कपिराजहितङ्करः": {"en": "doing good to the king of monkeys (Sugrīva), i.e. Hanumān", "hi": "वानरराज (सुग्रीव)का हित करनेवाले (हनुमान्जी)", "r": "कपि + राज + हित + कर", "g": "समास (उपपद), प्रथमा, एकवचन", "p": [["कपिराज", "वानरराज (सुग्रीव)का"], ["हितङ्करः", "हित करनेवाले"]]}, "चक्रेऽथ": {"en": "then placed", "hi": "फिर रखा", "r": "कृ + अथ", "g": "संधि: चक्रे + अथ (लिट्, प्रथम पुरुष, एकवचन)", "p": [["चक्रे", "रखा, किया"], ["अथ", "फिर"]]}, "पादं": {"en": "the foot", "hi": "पैर", "r": "पाद", "g": "द्वितीया, एकवचन"}, "सव्यं": {"en": "the left (foot)", "hi": "बायाँ (पैर)", "r": "सव्य", "g": "द्वितीया, एकवचन"}, "शत्रूणां": {"en": "of the enemies", "hi": "शत्रुओंके", "r": "शत्रु", "g": "षष्ठी, बहुवचन"}, "मूर्धनि": {"en": "on the head / on the top", "hi": "सिरपर / ऊपर (पीठपर)", "r": "मूर्धन्", "g": "सप्तमी, एकवचन"}, "प्रविष्टः": {"en": "entered", "hi": "प्रविष्ट हुआ", "r": "प्र + विश्", "g": "क्त (भूतकालिक कृदन्त), प्रथमा, एकवचन"}, "सत्त्वसम्पन्नो": {"en": "full of strength and courage", "hi": "बल और धैर्यसे सम्पन्न", "r": "सत्त्व + सम्-पद्", "g": "समास (तृतीया तत्पुरुष), प्रथमा, एकवचन", "p": [["सत्त्व", "बल, धैर्यसे"], ["सम्पन्नः", "युक्त"]]}, "निशायां": {"en": "at night", "hi": "रातमें", "r": "निशा", "g": "सप्तमी, एकवचन"}, "महापथमास्थाय": {"en": "taking the great road (highway)", "hi": "राजमार्ग (बड़ी सड़क)का आश्रय लेकर", "r": "महत् + पथिन् + आ-स्था", "g": "संधि: महापथम् + आस्थाय", "p": [["महापथम्", "बड़ी सड़कको"], ["आस्थाय", "पकड़कर, आश्रय लेकर"]]}, "मुक्तपुष्पविराजितम्": {"en": "bright with strewn flowers", "hi": "बिखेरे हुए फूलोंसे सुशोभित", "r": "मुक्त + पुष्प + वि-राज्", "g": "समास (तृतीया तत्पुरुष), द्वितीया, एकवचन", "p": [["मुक्त", "बिखेरे हुए"], ["पुष्प", "फूलोंसे"], ["विराजितम्", "सुशोभित"]]}, "रम्यामभिययौ": {"en": "went towards the lovely (city)", "hi": "रमणीय (नगरी)की ओर चला", "r": "रम्य + अभि-या", "g": "संधि: रम्याम् + अभिययौ (लिट्, प्रथम पुरुष, एकवचन)", "p": [["रम्याम्", "रमणीय (नगरी)की"], ["अभिययौ", "ओर गया"]]}, "हसितोत्कृष्टनिनदैस्तूर्यघोषपुरस्कृतैः": {"en": "with sounds of laughter and loud shouts, accompanied by the sound of musical instruments", "hi": "हँसी और ऊँचे स्वरोंके शब्दोंसे, जिनके साथ बाजोंकी ध्वनि भी थी", "r": "हसित + उत्कृष्ट + निनद + तूर्य + घोष + पुरस्कृत", "g": "संधि: हसितोत्कृष्टनिनदैः + तूर्यघोषपुरस्कृतैः (समास, तृतीया, बहुवचन)", "p": [["हसितोत्कृष्टनिनदैः", "हँसी और ऊँचे शब्दोंसे"], ["तूर्यघोषपुरस्कृतैः", "बाजोंकी ध्वनिसे युक्त"]]}, "वज्राङ्कुशनिकाशैश्च": {"en": "and (with houses) shaped like the thunderbolt and the elephant-goad", "hi": "और वज्र तथा अंकुशके आकारवाले (भवनों)से", "r": "वज्र + अङ्कुश + निकाश + च", "g": "संधि: वज्राङ्कुशनिकाशैः + च (समास, तृतीया, बहुवचन)", "p": [["वज्र", "वज्र"], ["अङ्कुश", "अंकुश"], ["निकाशैः", "जैसे आकारवाले"], ["च", "और"]]}, "वज्रजालविभूषितैः": {"en": "adorned with diamond lattices", "hi": "हीरोंकी जालियों (झरोखों)से सजे हुए", "r": "वज्र + जाल + वि-भूष्", "g": "समास (तृतीया तत्पुरुष), तृतीया, बहुवचन", "p": [["वज्रजाल", "हीरोंकी जालियोंसे"], ["विभूषितैः", "सजे हुए"]]}, "गृहमेघैः": {"en": "with cloud-like houses", "hi": "मेघोंके समान भवनोंसे", "r": "गृह + मेघ", "g": "समास (रूपक कर्मधारय), तृतीया, बहुवचन", "p": [["गृह", "भवनरूपी"], ["मेघैः", "मेघोंसे"]]}, "रम्या": {"en": "lovely, delightful", "hi": "रमणीय, सुन्दर", "r": "रम्य", "g": "प्रथमा, एकवचन, स्त्रीलिङ्ग"}, "बभासे": {"en": "shone", "hi": "शोभित हुई, चमकी", "r": "भास्", "g": "लिट्, प्रथम पुरुष, एकवचन (आत्मनेपद)"}, "द्यौरिवाम्बुदैः": {"en": "like the sky with clouds", "hi": "मेघोंसे युक्त आकाशकी भाँति", "r": "दिव् + इव + अम्बुद", "g": "संधि: द्यौः + इव + अम्बुदैः", "p": [["द्यौः", "आकाश"], ["इव", "की भाँति"], ["अम्बुदैः", "मेघोंसे"]]}, "प्रजज्वाल": {"en": "blazed, shone brightly", "hi": "जगमगा उठी", "r": "प्र + ज्वल्", "g": "लिट्, प्रथम पुरुष, एकवचन"}, "रक्षोगणगृहैः": {"en": "with the houses of the hosts of rākṣasas", "hi": "राक्षसगणोंके घरोंसे", "r": "रक्षस् + गण + गृह", "g": "समास (षष्ठी तत्पुरुष), तृतीया, बहुवचन", "p": [["रक्षोगण", "राक्षसोंके समूहोंके"], ["गृहैः", "घरोंसे"]]}, "सिताभ्रसदृशैश्चित्रैः": {"en": "like white clouds, and many-coloured (wonderful)", "hi": "श्वेत बादलोंके समान और रंग-बिरंगे (विचित्र)", "r": "सित + अभ्र + सदृश + चित्र", "g": "संधि: सिताभ्रसदृशैः + चित्रैः (तृतीया, बहुवचन)", "p": [["सिताभ्रसदृशैः", "श्वेत बादलोंके समान"], ["चित्रैः", "विचित्र, रंग-बिरंगे"]]}, "पद्मस्वस्तिकसंस्थितैः": {"en": "built in the shapes of the lotus and the svastika", "hi": "कमल और स्वस्तिकके आकारमें बने", "r": "पद्म + स्वस्तिक + सम्-स्था", "g": "समास, तृतीया, बहुवचन", "p": [["पद्म", "कमल"], ["स्वस्तिक", "स्वस्तिक (के आकारमें)"], ["संस्थितैः", "स्थित, बने हुए"]]}, "वर्धमानगृहैश्चापि": {"en": "and also with flourishing houses (of the Vardhamāna style)", "hi": "और वर्धमान नामक (समृद्ध) भवनोंसे भी", "r": "वर्धमान + गृह + च + अपि", "g": "संधि: वर्धमानगृहैः + च + अपि (समास, तृतीया, बहुवचन)", "p": [["वर्धमान", "वर्धमान (समृद्ध)"], ["गृहैः", "भवनोंसे"], ["च", "और"], ["अपि", "भी"]]}, "सुविभूषितैः": {"en": "well adorned", "hi": "भली भाँति सजे हुए", "r": "सु + वि + भूष्", "g": "क्त (भूतकालिक कृदन्त), तृतीया, बहुवचन"}, "चित्रमाल्याभरणां": {"en": "having colourful garlands for her ornaments", "hi": "रंग-बिरंगी मालाओंको आभूषणरूपमें धारण करनेवाली", "r": "चित्र + माल्य + आभरण", "g": "समास (बहुव्रीहि), द्वितीया, एकवचन, स्त्रीलिङ्ग", "p": [["चित्र", "रंग-बिरंगी"], ["माल्य", "मालाएँ"], ["आभरणाम्", "आभूषण हैं जिसके, उसको"]]}, "राघवार्थे": {"en": "for the sake of Rāma (descendant of Raghu)", "hi": "श्रीरामके लिये", "r": "राघव + अर्थ", "g": "समास (षष्ठी तत्पुरुष), सप्तमी, एकवचन", "p": [["राघव", "श्रीरामके"], ["अर्थे", "लिये"]]}, "चरन्": {"en": "moving about", "hi": "घूमते हुए", "r": "चर्", "g": "शतृ (वर्तमान कृदन्त), प्रथमा, एकवचन"}, "ननन्द": {"en": "rejoiced", "hi": "आनन्दित हुआ", "r": "नन्द्", "g": "लिट्, प्रथम पुरुष, एकवचन"}, "भवनाद्": {"en": "from (one) mansion", "hi": "एक भवनसे", "r": "भवन", "g": "पञ्चमी, एकवचन"}, "गच्छन्": {"en": "going", "hi": "जाते हुए", "r": "गम्", "g": "शतृ (वर्तमान कृदन्त), प्रथमा, एकवचन"}, "विविधाकृतिरूपाणि": {"en": "of various shapes and forms", "hi": "अनेक प्रकारकी आकृतियों और रूपोंवाले", "r": "विविध + आकृति + रूप", "g": "समास 