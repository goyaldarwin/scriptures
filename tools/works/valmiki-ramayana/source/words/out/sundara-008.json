"वज्रिणश्च": {"en": "and bearing thunderbolt-weapons", "hi": "और वज्र धारण करनेवालोंको", "r": "वज्रिन् + च", "g": "संधि: वज्रिणः + च", "p": [["वज्रिणः", "वज्रधारियोंको"], ["च", "और"]]}, "महाबलान्": {"en": "very mighty", "hi": "महाबलवानोंको", "r": "महत् + बल", "g": "समास (बहुव्रीहि), द्वितीया, बहुवचन", "p": [["महा", "महान्"], ["बलान्", "बलवालोंको"]]}, "शतसाहस्रमव्यग्रमारक्षं": {"en": "a guard of a hundred thousand, alert and steady", "hi": "एक लाख (सैनिकोंका) सावधान रक्षकदल", "r": "शतसाहस्र + अव्यग्र + आरक्ष", "g": "संधि: शतसाहस्रम् + अव्यग्रम् + आरक्षम्", "p": [["शतसाहस्रम्", "एक लाखका"], ["अव्यग्रम्", "स्थिर, सावधान"], ["आरक्षम्", "रक्षकदलको"]]}, "मध्यमं": {"en": "the central (guard)", "hi": "बीचवाले (रक्षकदल)को", "r": "मध्यम", "g": "द्वितीया, एकवचन"}, "रक्षोऽधिपतिनिर्दिष्टं": {"en": "posted (ordered there) by the lord of the rākṣasas", "hi": "राक्षसराज (रावण)द्वारा नियुक्त", "r": "रक्षस् + अधिपति + निर्-दिश्", "g": "समास (तृतीया तत्पुरुष), द्वितीया, एकवचन", "p": [["रक्षोऽधिपति", "राक्षसराजद्वारा"], ["निर्दिष्टम्", "नियुक्त किये हुएको"]]}, "ददर्शान्तःपुराग्रतः": {"en": "saw in front of the inner palace", "hi": "अन्तःपुरके सामने देखा", "r": "दृश् + अन्तःपुर + अग्रतस्", "g": "संधि: ददर्श + अन्तःपुराग्रतः", "p": [["ददर्श", "देखा"], ["अन्तःपुराग्रतः", "अन्तःपुरके सामने"]]}, "गृहं": {"en": "the house, palace", "hi": "भवन, महल", "r": "गृह", "g": "द्वितीया, एकवचन"}, "महाहाटकतोरणम्": {"en": "having great golden archways", "hi": "सोनेके विशाल फाटकोंवाले", "r": "महत् + हाटक + तोरण", "g": "समास (बहुव्रीहि), द्वितीया, एकवचन", "p": [["महा", "विशाल"], ["हाटक", "सोनेके"], ["तोरणम्", "फाटकवालेको"]]}, "विख्यातमद्रिमूर्ध्नि": {"en": "renowned, on the summit of the mountain", "hi": "विख्यात, पर्वतके शिखरपर", "r": "वि-ख्या + अद्रि + मूर्धन्", "g": "संधि: विख्यातम् + अद्रिमूर्ध्नि", "p": [["विख्यातम्", "प्रसिद्ध"], ["अद्रिमूर्ध्नि", "पर्वतके शिखरपर"]]}, "प्रतिष्ठितम्": {"en": "standing, set (on)", "hi": "स्थित", "r": "प्रति + स्था", "g": "क्त (भूतकालिक कृदन्त), द्वितीया/प्रथमा, एकवचन"}, "पुण्डरीकावतंसाभिः": {"en": "crowned with white lotuses", "hi": "श्वेत कमलोंसे अलंकृत (जिनके आभूषण श्वेत कमल हैं)", "r": "पुण्डरीक + अवतंस", "g": "समास (बहुव्रीहि), तृतीया, बहुवचन, स्त्रीलिङ्ग", "p": [["पुण्डरीक", "श्वेत कमल"], ["अवतंसाभिः", "जिनके आभूषण हैं, उनसे"]]}, "समावृतम्": {"en": "surrounded", "hi": "घिरा हुआ", "r": "सम् + आ + वृ", "g": "क्त (भूतकालिक कृदन्त), द्वितीया, एकवचन"}, "प्राकारावृतमत्यन्तं": {"en": "entirely enclosed by ramparts", "hi": "चारों ओरसे परकोटेसे भली भाँति घिरा हुआ", "r": "प्राकार + आ-वृ + अत्यन्त", "g": "संधि: प्राकारावृतम् + अत्यन्तम्", "p": [["प्राकारावृतम्", "परकोटेसे घिरे हुएको"], ["अत्यन्तम्", "पूर्णतः"]]}, "त्रिविष्टपनिभं": {"en": "like heaven", "hi": "स्वर्गके समान", "r": "त्रिविष्टप + निभ", "g": "समास, द्वितीया, एकवचन", "p": [["त्रिविष्टप", "स्वर्गके"], ["निभम्", "समान"]]}, "दिव्यं": {"en": "divine, wonderful", "hi": "दिव्य", "r": "दिव्य", "g": "द्वितीया/प्रथमा, एकवचन"}, "दिव्यनादविनादितम्": {"en": "resounding with heavenly sounds", "hi": "दिव्य ध्वनियोंसे गूँजते हुए", "r": "दिव्य + नाद + वि-नद्", "g": "समास (तृतीया तत्पुरुष), द्वितीया, एकवचन", "p": [["दिव्यनाद", "दिव्य ध्वनियोंसे"], ["विनादितम्", "गूँजते हुएको"]]}, "वाजिह्रेषितसङ्घुष्टं": {"en": "resounding with the neighing of horses", "hi": "घोड़ोंकी हिनहिनाहटसे गूँजते हुए", "r": "वाजिन् + ह्रेषित + सम्-घुष्", "g": "समास (तृतीया तत्पुरुष), द्वितीया, एकवचन", "p": [["वाजि", "घोड़ोंकी"], ["ह्रेषित", "हिनहिनाहटसे"], ["सङ्घुष्टम्", "गूँजते हुएको"]]}, "नादितं": {"en": "made to resound", "hi": "शब्दायमान, गुंजित", "r": "नद्", "g": "क्त (णिजन्त, भूतकालिक कृदन्त), द्वितीया, एकवचन"}, "भूषणैस्तथा": {"en": "and (the jingling) of ornaments too", "hi": "तथा आभूषणों (की झनकार)से", "r": "भूषण + तथा", "g": "संधि: भूषणैः + तथा", "p": [["भूषणैः", "आभूषणोंसे"], ["तथा", "तथा"]]}, "रथैर्यानैर्विमानैश्च": {"en": "with chariots, carriages and aerial cars", "hi": "रथों, सवारियों और विमानोंसे", "r": "रथ + यान + विमान + च", "g": "संधि: रथैः + यानैः + विमानैः + च", "p": [["रथैः", "रथोंसे"], ["यानैः", 