, "मनका दोष जिसमें"]]}, "स्वर्गप्रकाशो": {"en": "bright as heaven", "hi": "स्वर्गके समान प्रकाशमान", "r": "स्वर्ग + प्रकाश", "g": "समास (बहुव्रीहि), प्रथमा, एकवचन", "p": [["स्वर्ग", "स्वर्गके समान"], ["प्रकाशः", "प्रकाशवाला"]]}, "प्रदोषः": {"en": "the evening (first part of the night)", "hi": "प्रदोषकाल (रातका आरम्भ)", "r": "प्रदोष", "g": "प्रथमा, एकवचन"}, "तन्त्रीस्वराः": {"en": "the notes of stringed instruments", "hi": "वीणा आदिके तारोंके स्वर", "r": "तन्त्री + स्वर", "g": "समास (षष्ठी तत्पुरुष), प्रथमा, बहुवचन", "p": [["तन्त्री", "तारोंके"], ["स्वराः", "स्वर"]]}, "कर्णसुखाः": {"en": "pleasing to the ear", "hi": "कानोंको सुख देनेवाले", "r": "कर्ण + सुख", "g": "समास (बहुव्रीहि), प्रथमा, बहुवचन", "p": [["कर्ण", "कानोंको"], ["सुखाः", "सुख देनेवाले"]]}, "प्रवृत्ताः": {"en": "began, arose", "hi": "आरम्भ हुए, छिड़ गये", "r": "प्र + वृत्", "g": "क्त (भूतकालिक कृदन्त), प्रथमा, बहुवचन"}, "स्वपन्ति": {"en": "sleep", "hi": "सोती हैं", "r": "स्वप्", "g": "लट्, प्रथम पुरुष, बहुवचन"}, "नार्यः": {"en": "women", "hi": "स्त्रियाँ", "r": "नारी", "g": "प्रथमा, बहुवचन"}, "पतिभिः": {"en": "with their husbands", "hi": "पतियोंके साथ", "r": "पति", "g": "तृतीया, बहुवचन"}, "सुवृत्ताः": {"en": "of good conduct, virtuous", "hi": "सदाचारिणी", "r": "सु + वृत्त", "g": "समास (बहुव्रीहि), प्रथमा, बहुवचन, स्त्रीलिङ्ग", "p": [["सु", "उत्तम"], ["वृत्ताः", "आचरणवाली"]]}, "नक्तञ्चराश्चापि": {"en": "and the night-roamers (rākṣasas) too", "hi": "और निशाचर (राक्षस) भी", "r": "नक्तम् + चर + च + अपि", "g": "संधि: नक्तञ्चराः + च + अपि", "p": [["नक्तञ्चराः", "रातमें विचरनेवाले"], ["च", "और"], ["अपि", "भी"]]}, "प्रवृत्ता": {"en": "set out", "hi": "प्रवृत्त हुए, निकल पड़े", "r": "प्र + वृत्", "g": "क्त (भूतकालिक कृदन्त), प्रथमा, बहुवचन (प्रवृत्ताः, संधिसे विसर्गलोप)"}, "विहर्तुमत्यद्भुतरौद्रवृत्ताः": {"en": "to roam about, (they) whose ways were most strange and fierce", "hi": "विहार करनेके लिये, अत्यन्त विचित्र और भयंकर आचरणवाले", "r": "वि-हृ + अति + अद्भुत + रौद्र + वृत्त", "g": "संधि: विहर्तुम् + अत्यद्भुत