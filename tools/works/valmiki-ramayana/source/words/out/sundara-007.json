 "O mighty one", "hi": "हे महाबली!", "r": "महत् + बल", "g": "समास (बहुव्रीहि), संबोधन, एकवचन"}, "तथ्यं": {"en": "truth / true", "hi": "सत्य बात / सच", "r": "तथ्य", "g": "प्रथमा/द्वितीया, एकवचन"}, "ब्रुवन्त्या": {"en": "of (me) speaking", "hi": "कहती हुई (मुझ)से", "r": "ब्रू", "g": "शतृ, षष्ठी, एकवचन, स्त्रीलिङ्ग (ब्रुवन्त्याः; संधिमें विसर्ग लुप्त)"}, "हरीश्वर": {"en": "O lord of monkeys", "hi": "हे वानरराज!", "r": "हरि + ईश्वर", "g": "समास (षष्ठी तत्पुरुष), संबोधन, एकवचन", "p": [["हरि", "वानरोंके"], ["ईश्वर", "स्वामी"]]}, "स्वयम्भुवा": {"en": "by the Self-born (Brahmā)", "hi": "स्वयम्भू (ब्रह्माजी)द्वारा", "r": "स्वयम्भू", "g": "तृतीया, एकवचन"}, "दत्तं": {"en": "given", "hi": "दिया गया", "r": "दा", "g": "क्त, प्रथमा/द्वितीया, एकवचन, नपुंसकलिङ्ग"}, "वरदानं": {"en": "a boon (granted)", "hi": "वरदान", "r": "वर + दान", "g": "समास (षष्ठी तत्पुरुष), प्रथमा/द्वितीया, एकवचन", "p": [["वर", "वरका"], ["दानम्", "दान"]]}, "कश्चिद्": {"en": "some, any (one)", "hi": "कोई", "r": "किम् + चित्", "g": "प्रथमा, एकवचन (कश्चित्)"}, "विक्रमाद्": {"en": "by (his) prowess", "hi": "पराक्रमसे", "r": "वि + क्रम्", "g": "पञ्चमी, एकवचन (विक्रमात्)"}, "वशमानयेत्": {"en": "should bring under control", "hi": "वशमें कर ले", "r": "वश + आ + नी", "g": "संधि: वशम् + आनयेत् (विधिलिङ्, प्रथम पुरुष, एकवचन)", "p": [["वशम्", "वशमें"], ["आनयेत्", "ले आये"]]}, "विज्ञेयं": {"en": "to be known", "hi": "जान लेना चाहिये", "r": "वि + ज्ञा", "g": "कृत्य (यत्), प्रथमा, एकवचन, नपुंसकलिङ्ग"}, "भयमागतम्": {"en": "danger has come", "hi": "भय आ पहुँचा है", "r": "भय + आ + गम्", "g": "संधि: भयम् + आगतम् (क्त)", "p": [["भयम्", "भय"], ["आगतम्", "आ पहुँचा है"]]}, "समयः": {"en": "the (appointed) time", "hi": "(नियत) समय", "r": "समय", "g": "प्रथमा, एकवचन"}, "प्राप्तोऽद्य": {"en": "has come today", "hi": "आज आ पहुँचा है", "r": "प्र + आप् + अद्य", "g": "संधि: प्राप्तः (क्त, प्रथमा, एकवचन) + अद्य", "p": [["प्राप्तः", "आ पहुँचा है"], ["अद्य", "आज"]]}, "स्वयम्भूविहितः": {"en": "ordained by the Self-born (Brahmā)", "hi": "स्वयम्भू (ब्रह्माजी)द्वारा विहित", "r": "स्वयम्भू + वि + धा", "g": "समास (तृतीया तत्पुरुष), क्त, प्रथमा, एकवचन", "p": [["स्वयम्भू", "ब्रह्माजीद्वारा"], ["विहितः", "निश्चित किया हुआ"]]}, "सत्यो": {"en": "true", "hi": "सत्य", "r": "सत्य", "g": "प्रथमा, एकवचन (सत्यः; संधिमें ओ)"}, "तस्यास्ति": {"en": "of it there is", "hi": "उसका है", "r": "तद् + अस्", "g": "संधि: तस्य + अस्ति (लट्, प्रथम पुरुष, एकवचन)", "p": [["तस्य", "उसका"], ["अस्ति", "है"]]}}