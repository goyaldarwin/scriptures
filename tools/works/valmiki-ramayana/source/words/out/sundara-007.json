{"लङ्कामुद्योतयामासुः": {"en": "lit up Laṅkā", "hi": "लंकाको प्रकाशित कर दिया", "r": "लङ्का + उद्द्युत् (णिच्)", "g": "संधि: लङ्काम् + उद्योतयामासुः (लिट्, प्रथम पुरुष, बहुवचन)", "p": [["लङ्काम्", "लंकाको"], ["उद्योतयामासुः", "प्रकाशित कर दिया"]]}, "समलङ्कृताम्": {"en": "well adorned, decorated all over", "hi": "भली-भाँति सजी हुई(को)", "r": "सम् + अलम् + कृ", "g": "क्त, द्वितीया, एकवचन, स्त्रीलिङ्ग"}, "अचिन्त्यामद्भुताकारां": {"en": "(Laṅkā) beyond imagining, of wondrous form", "hi": "अचिन्त्य और अद्भुत आकारवाली(को)", "r": "अचिन्त्य + अद्भुत + आकार", "g": "संधि: अचिन्त्याम् + अद्भुताकाराम्; द्वितीया, एकवचन, स्त्रीलिङ्ग", "p": [["अचिन्त्याम्", "जिसकी कल्पना न हो सके"], ["अद्भुताकाराम्", "अद्भुत आकारवाली"]]}, "आसीद्": {"en": "was, became", "hi": "था, हो गया", "r": "अस्", "g": "लङ्, प्रथम पुरुष, एकवचन (आसीत्)"}, "विषण्णो": {"en": "dejected, sad", "hi": "विषादमें पड़ा हुआ, दुःखी", "r": "वि + सद्", "g": "क्त, प्रथमा, एकवचन"}, "हृष्टश्च": {"en": "and delighted", "hi": "और हर्षित", "r": "हृष्ट + च", "g": "संधि: हृष्टः + च", "p": [["हृष्टः", "हर्षित"], ["च", "और"]]}, "पाण्डुराविद्धविमानमालिनीं": {"en": "(Laṅkā) garlanded with rows of white, closely set mansions", "hi": "श्वेत और सटे हुए भवनोंकी पंक्तियोंसे मालाकी भाँति सुशोभित(को)", "r": "पाण्डुर + आविद्ध + विमान + मालिन्", "g": "समास, द्वितीया, एकवचन, स्त्रीलिङ्ग", "p": [["पाण्डुर", "श्वेत"], ["आविद्ध", "सटे हुए"], ["विमान", "सतमहले भवन"], ["मालिनीम्", "मालावाली(को)"]]}, "महार्हजाम्बूनदजालतोरणाम्": {"en": "having very costly golden lattices and archways", "hi": "बहुमूल्य सोनेकी जालियों और तोरणोंवाली(को)", "r": "महार्ह + जाम्बूनद + जाल + तोरण", "g": "समास (बहुव्रीहि), द्वितीया, एकवचन, स्त्रीलिङ्ग", "p": [["महार्ह", "बहुमूल्य"], ["जाम्बूनद", "सोनेकी"], ["जाल", "जालियाँ"], ["तोरणाम्", "तोरणोंवाली(को)"]]}, "यशस्विनीं": {"en": "famed, glorious (she)", "hi": "यशस्विनी(को)", "r": "यशस्विन्", "g": "द्वितीया, एकवचन, स्त्रीलिङ्ग"}, "रावणबाहुपालितां": {"en": "guarded by the arms of Rāvaṇa", "hi": "रावणकी भुजाओंसे रक्षित(को)", "r": "रावण + बाहु + पाल्", "g": "समास (तृतीया तत्पुरुष), क्त, द्वितीया, एकवचन, स्त्रीलिङ्ग", "p": [["रावण", "रावणकी"], ["बाहु", "भुजाओंसे"], ["पालिताम्", "रक्षित(को)"]]}, "क्षपाचरैर्भीमबलैः": {"en": "by night-rangers (rākṣasas) of fearsome strength", "hi": "भयंकर बलवाले निशाचरोंद्वारा", "r": "क्षपाचर + भीम + बल", "g": "संधि: क्षपाचरैः + भीमबलैः; तृतीया, बहुवचन", "p": [["क्षपाचरैः", "निशाचरों (राक्षसों)द्वारा"], ["भीमबलैः", "भयंकर बलवाले"]]}, "सुपालिताम्": {"en": "well guarded", "hi": "भली-भाँति रक्षित(को)", "r": "सु + पाल्", "g": "क्त, द्वितीया, एकवचन, स्त्रीलिङ्ग"}, "चन्द्रोऽपि": {"en": "the moon too", "hi": "चन्द्रमा भी", "r": "चन्द्र + अपि", "g": "संधि: चन्द्रः + अपि", "p": [["चन्द्रः", "चन्द्रमा"], ["अपि", "भी"]]}, "साचिव्यमिवास्य": {"en": "as if (doing) him a helper's service", "hi": "मानो उनकी सहायता (करते हुए)", "r": "साचिव्य + इव + इदम्", "g": "संधि: साचिव्यम् + इव + अस्य", "p": [["साचिव्यम्", "सहायता, मन्त्रीका-सा कार्य"], ["इव", "मानो"], ["अस्य", "इनकी (हनुमान्जीकी)"]]}, "कुर्वं": {"en": "doing, rendering", "hi": "करता हुआ", "r": "कृ", "g": "शतृ, प्रथमा, एकवचन (कुर्वन्; अगले पदसे संधिमें 'कुर्वंस्')"}, "स्तारागणैर्मध्यगतो": {"en": "in the middle of the hosts of stars", "hi": "तारोंके समूहके बीचमें स्थित", "r": "तारा + गण + मध्य + गम्", "g": "संधि: (कुर्वन्का) स् + तारागणैः + मध्यगतः", "p": [["तारागणैः", "तारोंके समूहोंके साथ"], ["मध्यगतः", "बीचमें स्थित"]]}, "विराजन्": {"en": "shining", "hi": "शोभा पाता हुआ, चमकता हुआ", "r": "वि + राज्", "g": "शतृ, प्रथमा, एकवचन"}, "ज्योत्स्नावितानेन": {"en": "with a canopy of moonlight", "hi": "चाँदनीके चँदोवेसे", "r": "ज्योत्स्ना + वितान", "g": "समास (षष्ठी तत्पुरुष), तृतीया, एकवचन", "p": [["ज्योत्स्ना", "चाँदनीके"], ["वितानेन", "चँदोवेसे"]]}, "वितत्य": {"en": "having spread over, having covered", "hi": "फैलाकर, ढककर", "r": "वि + तन्", "g": "ल्यप् (पूर्वकालिक)"}, "नुत्तिष्ठतेऽनेकसहस्ररश्मिः": {"en": "rises, (the moon) with many thousands of rays", "hi": "अनेक सहस्र किरणोंवाला (चन्द्रमा) उदित होता है", "r": "उद् + स्था; अनेक + स