": "संधि: महानूपुरकेयूरैः + अपविद्धैः + महाधनैः (तृतीया, बहुवचन)", "p": [["महानूपुरकेयूरैः", "बड़े नूपुरों और बाजूबंदोंसे"], ["अपविद्धैः", "इधर-उधर पड़े"], ["महाधनैः", "बहुमूल्य"]]}, "पानभाजनविक्षिप्तैः": {"en": "with drinking-vessels scattered about", "hi": "बिखरे हुए पान-पात्रोंसे", "r": "पान + भाजन + विक्षिप्त", "g": "समास, तृतीया, बहुवचन", "p": [["पानभाजन", "पीनेके पात्र"], ["विक्षिप्तैः", "बिखरे हुए"]]}, "फलैश्च": {"en": "and with fruits", "hi": "और फलोंसे", "r": "फल; च", "g": "संधि: फलैः + च", "p": [["फलैः", "फलोंसे"], ["च", "और"]]}, "विविधैरपि": {"en": "of many kinds too", "hi": "अनेक प्रकारके भी", "r": "विविध; अपि", "g": "संधि: विविधैः + अपि", "p": [["विविधैः", "अनेक प्रकारके"], ["अपि", "भी"]]}, "कृतपुष्पोपहारा": {"en": "decked with offerings of flowers", "hi": "फूलोंकी भेंटसे सजायी हुई", "r": "कृत + पुष्प + उपहार", "g": "समास (बहुव्रीहि), प्रथमा, एकवचन", "p": [["कृत", "किया हुआ"], ["पुष्पोपहारा", "फूलोंकी भेंटवाली"]]}, "भूरधिकां": {"en": "the floor, greater", "hi": "भूमि (फर्श), अधिक", "r": "भू; अधिक", "g": "संधि: भूः + अधिकाम्", "p": [["भूः", "भूमि, फर्श"], ["अधिकाम्", "अधिक (को)"]]}, "पुष्यति": {"en": "increases, displays", "hi": "बढ़ाती है", "r": "पुष्", "g": "लट्, प्रथम पुरुष, एकवचन"}, "श्रियम्": {"en": "beauty, splendour / Lakṣmī (goddess of fortune)", "hi": "शोभा / लक्ष्मीजी", "r": "श्री", "g": "द्वितीया, एकवचन"}, "विन्यस्तैः": {"en": "placed, arranged", "hi": "रखे हुए", "r": "वि + नि + अस्", "g": "क्त, तृतीया, बहुवचन"}, "सुश्लिष्टशयनासनैः": {"en": "with well-made beds and seats", "hi": "भलीभाँति बने पलंगों और आसनोंसे", "r": "सुश्लिष्ट + शयन + आसन", "g": "समास, तृतीया, बहुवचन", "p": [["सुश्लिष्ट", "अच्छी तरह जुड़े, सुगठित"], ["शयन", "पलंग"], ["आसनैः", "आसनोंसे"]]}}