{"मन्दरः": {"en": "Mount Mandara (the mountain used to churn the ocean)", "hi": "मन्दराचल", "r": "मन्दर", "g": "प्रथमा, एकवचन"}, "चूतपुंनागसुरभिर्बकुलोत्तमसंयुतः": {"en": "fragrant with mango and punnāga (blossoms) and joined with (the scent of) the finest bakula", "hi": "आम और पुंनागके फूलोंकी सुगन्धवाला तथा उत्तम मौलसिरीकी गन्धसे युक्त", "r": "चूत + पुंनाग + सुरभि; बकुल + उत्तम + संयुत", "g": "संधि: चूतपुंनागसुरभिः + बकुलोत्तमसंयुतः (दोनों समास, प्रथमा, एकवचन)", "p": [["चूतपुंनागसुरभिः", "आम और पुंनागके फूलोंसे सुगन्धित"], ["बकुलोत्तमसंयुतः", "उत्तम मौलसिरी (बकुल)-की गन्धसे युक्त"]]}, "मृष्टान्नरससंयुक्तः": {"en": "mixed with the flavour of rich, well-dressed food", "hi": "स्वादिष्ट अन्नके रससे मिला हुआ", "r": "मृष्ट + अन्न + रस + संयुक्त", "g": "समास, प्रथमा, एकवचन", "p": [["मृष्ट", "सुस्वादु, अच्छी तरह बनाया"], ["अन्न", "अन्न, भोजन"], ["रस", "रस, स्वाद"], ["संयुक्तः", "मिला हुआ"]]}, "पानगन्धपुरःसरः": {"en": "carrying the smell of liquor before it", "hi": "मदिराकी गन्धको आगे लिये हुए", "r": "पान + गन्ध + पुरःसर", "g": "समास, प्रथमा, एकवचन", "p": [["पान", "मदिरा, पेय"], ["गन्ध", "गन्ध"], ["पुरःसरः", "आगे-आगे चलनेवाला"]]}, "निश्चक्राम": {"en": "came out, issued forth", "hi": "निकला", "r": "निस् + क्रम्", "g": "लिट्, प्रथम पुरुष, एकवचन"}, "महामुखात्": {"en": "from the huge mouth", "hi": "विशाल मुखसे", "r": "महत् + मुख", "g": "पञ्चमी, एकवचन (समास)"}, "शयानस्य": {"en": "of (him) lying asleep, while he slept", "hi": "सोते हुए (उस)-के", "r": "शी", "g": "शानच्, षष्ठी, एकवचन"}, "विनिःश्वासः": {"en": "breath, exhalation", "hi": "साँस, निःश्वास", "r": "वि + निस् + श्वस्", "g": "प्रथमा, एकवचन"}, "पूरयन्निव": {"en": "as if filling", "hi": "मानो भरता हुआ", "r": "पूरय (पॄ, णिच्) + इव", "g": "संधि: पूरयन् + इव (शतृ, प्रथमा, एकवचन)", "p": [["पूरयन्", "भरता हुआ"], ["इव", "मानो"]]}, "मुक्तामणिविचित्रेण": {"en": "made colourful with pearls and gems", "hi": "मोतियों और मणियोंसे चित्र-विचित्र", "r": "मुक्ता + मणि + विचित्र", "g": "समास, तृतीया, एकवचन", "p": [["मुक्ता", "मोती"], ["मणि", "मणि, रत्न"], ["विचित्रेण", "रंग-बिरंगे"]]}, "काञ्चनेन": {"en": "golden, made of gold", "hi": "सोनेके", "r": "काञ्चन", "g": "तृतीया, एकवचन"}, "विराजिता": {"en": "shining, made splendid", "hi": "सुशोभित", "r": "वि + राज्", "g": "क्त, प्रथमा, एकवचन (स्त्रीलिङ्ग)"}, "मुकुटेनापवृत्तेन": {"en": "with the crown slipped aside", "hi": "एक ओर खिसके हुए मुकुटसे", "r": "मुकुट + अपवृत्त", "g": "संधि: मुकुटेन + अपवृत्तेन (तृतीया, एकवचन)", "p": [["मुकुटेन", "मुकुटसे"], ["अपवृत्तेन", "खिसके हुए, टेढ़े हुए"]]}, "कुण्डलोज्ज्वलिताननम्": {"en": "with face lit up by earrings", "hi": "कुण्डलोंसे चमकते मुखवाले (को)", "r": "कुण्डल + उज्ज्वलित + आनन", "g": "समास (बहुव्रीहि), द्वितीया, एकवचन", "p": [["कुण्डल", "कुण्डल, कानका गहना"], ["उज्ज्वलित", "चमकाया हुआ"], ["आननम्", "मुख"]]}, "रक्तचन्दनदिग्धेन": {"en": "smeared with red sandal-paste", "hi": "लाल चन्दनसे लिपे हुए", "r": "रक्त + चन्दन + दिग्ध", "g": "समास, तृतीया, एकवचन", "p": [["रक्तचन्दन", "लाल चन्दन"], ["दिग्धेन", "लिपे हुए"]]}, "हारेण": {"en": "with a necklace", "hi": "हारसे", "r": "हार", "g": "तृतीया, एकवचन"}, "शोभिना": {"en": "shining, beautiful", "hi": "शोभायमान", "r": "शोभिन्", "g": "तृतीया, एकवचन"}, "पीनायतविशालेन": {"en": "full, long and broad", "hi": "मांसल, लम्बे और चौड़े", "r": "पीन + आयत + विशाल", "g": "समास, तृतीया, एकवचन", "p": [["पीन", "मांसल, भरा हुआ"], ["आयत", "लम्बा"], ["विशालेन", "चौड़े"]]}, "वक्षसाभिविराजिता": {"en": "made splendid by the chest", "hi": "वक्षःस्थलसे सुशोभित", "r": "वक्षस् + अभि + वि + राज्", "g": "संधि: वक्षसा + अभिविराजिता", "p": [["वक्षसा", "छातीसे"], ["अभिविराजिता", "अत्यन्त सुशोभित"]]}, "पाण्डुरेणापविद्धेन": {"en": "with a white (silk cloth) lying loosely thrown", "hi": "अस्त-व्यस्त पड़े श्वेत (रेशमी वस्त्र)-से", "r": "पाण्डुर + अप + व्यध्", "g": "संधि: पाण्डुरेण + अपविद्धेन (तृतीया, एकवचन)", "p": [["पाण्डुरेण", "श्वेत"], ["अपविद्धेन", "इधर-उधर पड़े, अस्त-व्यस्त"]]}, "क्षौमेण": {"en": "with a silken cloth", "hi": "रेशमी वस्त्रसे", "r": "क्षौम", "g": "तृतीया, एकवचन"}, "क्षतजेक्षणम्": {"en": "having blood-red eyes", "hi": "रक्त-जैसे लाल नेत्रोंवाले (को)", "r": "क्षतज + ईक्षण", "g": "समास (बहुव्रीहि), द्वितीया, एकवचन", "p": [["क्षतज", "रक्त"], ["ईक्षणम्", "नेत्र"]]}, "महार्हेण": {"en": "very costly, precious", "hi": "बहुमूल्य", "r": "महत् + अर्ह", "g": "तृतीया, एकवचन (समास)"}, "सुसंवीतं": {"en": "well covered, well clad", "hi": "भलीभाँति ढके हुए (को)", "r": "सु + सम् + व्ये", "g": "क्त, द्वितीया, एकवचन"}, "पीतेनोत्तरवाससा": {"en": "with a yellow upper garment", "hi": "पीले उत्तरीय (ओढ़नेके वस्त्र)-से", "r": "पीत + उत्तरवासस्", "g": "संधि: पीतेन + उत्तरवाससा (तृतीया, एकवचन)", "p": [["पीतेन", "पीले"], ["उत्तरवाससा", "ऊपरके वस्त्र, उत्तरीयसे"]]}, "माषराशिप्रतीकाशं": {"en": "looking like a heap of black gram", "hi": "उड़दके ढेर-जैसे (को)", "r": "माष + राशि + प्रतीकाश", "g": "समास, द्वितीया, एकवचन", "p": [["माष", "उड़द"], ["राशि", "ढेर"], ["प्रतीकाशम्", "समान दीखनेवाले"]]}, "भुजङ्गवत्": {"en": "like a snake", "hi": "सर्पकी भाँति", "r": "भुजङ्ग", "g": "वत् (अव्यय)"}, "गाङ्गे": {"en": "of the Gaṅgā", "hi": "गङ्गाके", "r": "गाङ्ग", "g": "सप्तमी, एकवचन"}, "तोयान्ते": {"en": "in the water", "hi": "जलमें", "r": "तोय + अन्त", "g": "समास, सप्तमी, एकवचन", "p": [["तोय", "जल"], ["अन्ते", "भीतर, किनारे"]]}, "कुञ्जरम्": {"en": "an elephant", "hi": "हाथी (को)", "r": "कुञ्जर", "g": "द्वितीया, एकवचन"}, "चतुर्भिः": {"en": "by four, with four", "hi": "चारसे, चारोंके साथ", "r": "चतुर्", "g": "तृतीया, बहुवचन"}, "काञ्चनैर्दीपैर्दीप्यमानं": {"en": "lit up by golden lamps", "hi": "सोनेके दीपकोंसे प्रकाशित होते हुए (को)", "r": "काञ्चन; दीप; दीप्", "g": "संधि: काञ्चनैः + दीपैः + दीप्यमानम्", "p": [["काञ्चनैः", "सोनेके"], ["दीपैः", "दीपकोंसे"], ["दीप्यमानम्", "प्रकाशित होते हुए (शानच्)"]]}, "चतुर्दिशम्": {"en": "on all four sides", "hi": "चारों ओर", "r": "चतुर् + दिश्", "g": "अव्ययीभाव समास"}, "प्रकाशीकृतसर्वाङ्गं": {"en": "with all his limbs lit up", "hi": "जिसके सब अङ्ग प्रकाशित थे, उस (को)", "r": "प्रकाशीकृत + सर्व + अङ्ग", "g": "समास (बहुव्रीहि), द्वितीया, एकवचन", "p": [["प्रकाशीकृत", "प्रकाशित किये हुए"], ["सर्वाङ्गम्", "सब अङ्ग"]]}, "मेघं": {"en": "a cloud", "hi": "मेघ (को)", "r": "मेघ", "g": "द्वितीया, एकवचन"}, "विद्युद्गणैरिव": {"en": "as (a cloud) by flashes of lightning", "hi": "मानो बिजलियोंके समूहसे", "r": "विद्युत् + गण + इव", "g": "संधि: विद्युद्गणैः + इव", "p": [["विद्युद्गणैः", "बिजलियोंके समूहोंसे"], ["इव", "मानो, जैसे"]]}, "पादमूलगताश्चापि": {"en": "and also (those) seated at the feet", "hi": "और चरणोंके पास बैठी हुई (को) भी", "r": "पादमूल + गत; च; अपि", "g": "संधि: पादमूलगताः + च + अपि", "p": [["पादमूलगताः", "चरणोंके पास बैठी हुई"], ["च", "और"], ["अपि", "भी"]]}, "सुमहात्मनः": {"en": "of the very mighty one", "hi": "अत्यन्त महाकाय (उस)-के", "r": "सु + महत् + आत्मन्", "g": "षष्ठी, एकवचन (समास)"}, "पत्नीः": {"en": "wives", "hi": "पत्नियोंको", "r": "पत्नी", "g": "द्वितीया, बहुवचन"}, "प्रियभार्यस्य": {"en": "of him who holds his wife (wives) dear", "hi": "जिसे पत्नी प्यारी है, उसके", "r": "प्रिय + भार्या", "g": "समास (बहुव्रीहि), षष्ठी, एकवचन", "p": [["प्रिय", "प्यारी"], ["भार्या", "पत्नी"]]}, "शशिप्रकाशवदना": {"en": "with faces bright as the moon", "hi": "चन्द्रमाके समान उज्ज्वल मुखवाली (स्त्रियोंको)", "r": "शशिन् + प्रकाश + वदन", "g": "समास (बहुव्रीहि), द्वितीया, बहुवचन", "p": [["शशि", "चन्द्रमा"], ["प्रकाश", "प्रकाश, कान्ति"], ["वदनाः", "मुख"]]}, "वरकुण्डलभूषणाः": {"en": "adorned with fine earrings", "hi": "सुन्दर कुण्डलोंसे विभूषित (स्त्रियोंको)", "r": "वर + कुण्डल + भूषण", "g": "समास (बहुव्रीहि), द्वितीया, बहुवचन", "p": [["वर", "श्रेष्ठ, सुन्दर"], ["कुण्डल", "कुण्डल"], ["भूषणाः", "आभूषण"]]}, "अम्लानमाल्याभरणा": {"en": "wearing unwithered garlands and ornaments", "hi": "बिना मुरझायी मालाएँ और आभूषण पहने हुई (स्त्रियोंको)", "r": "अम्लान + माल्य + आभरण", "g": "समास (बहुव्रीहि), द्वितीया, बहुवचन", "p": [["अम्लान", "न मुरझाये"], ["माल्य", "माला"], ["आभरणाः", "आभूषण"]]}, "नृत्यवादित्रकुशला": {"en": "skilled in dancing and playing instruments", "hi": "नाचने और बाजा बजानेमें कुशल", "r": "नृत्य + वादित्र + कुशल", "g": "समास, द्वितीया, बहुव