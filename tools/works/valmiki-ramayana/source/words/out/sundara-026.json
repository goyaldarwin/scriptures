किम्-चित् + उप + लक्ष्", "g": "संधि: किञ्चित् + उपलक्षये", "p": [["किञ्चित्", "कुछ"], ["उपलक्षये", "देखती हूँ (लट्, उत्तम पुरुष, एकवचन)"]]}, "विरूपमपि": {"en": "even a deformity", "hi": "विकृत (अशुभ) भी", "r": "विरूप + अपि", "g": "संधि: विरूपम् + अपि", "p": [["विरूपम्", "विकृत, अशुभ"], ["अपि", "भी"]]}, "सुसूक्ष्ममपि": {"en": "even very slight", "hi": "अत्यन्त सूक्ष्म भी", "r": "सु + सूक्ष्म + अपि", "g": "संधि: सुसूक्ष्मम् + अपि", "p": [["सुसूक्ष्मम्", "बहुत छोटा"], ["अपि", "भी"]]}, "लक्षणम्": {"en": "sign, mark", "hi": "लक्षण, चिह्न", "r": "लक्षण", "g": "द्वितीया, एकवचन"}, "छायावैगुण्यमात्रं": {"en": "merely a dimming of (her) lustre", "hi": "केवल कान्तिकी मलिनता", "r": "छाया + वैगुण्य + मात्र", "g": "द्वितीया, एकवचन; समास", "p": [["छाया", "कान्ति"], ["वैगुण्य", "दोष, मलिनता"], ["मात्रम्", "केवल"]]}, "दुःखमुपस्थितम्": {"en": "sorrow that has come", "hi": "आया हुआ दुःख", "r": "दुःख + उप + स्था", "g": "संधि: दुःखम् + उपस्थितम्", "p": [["दुःखम्", "दुःख"], ["उपस्थितम्", "आया हुआ"]]}, "अदुःखार्हामिमां": {"en": "this one not deserving sorrow", "hi": "दुःख भोगनेके अयोग्य इस(को)", "r": "अ + दुःख + अर्ह + इदम्", "g": "संधि: अदुःखार्हाम् + इमाम्", "p": [["अदुःखार्हाम्", "दुःखके अयोग्य"], ["इमाम्", "इस(को)"]]}, "वैहायसमुपस्थिताम्": {"en": "risen into the sky (as seen in the dream)", "hi": "आकाशमें स्थित (स्वप्नमें देखी गयी)", "r": "वैहायस + उप + स्था", "g": "संधि: वैहायसम् + उपस्थिताम्", "p": [["वैहायसम्", "आकाशमें"], ["उपस्थिताम्", "स्थित(को)"]]}, "अर्थसिद्धिं": {"en": "the fulfilment of (her) purpose", "hi": "मनोरथकी सिद्धि", "r": "अर्थ + सिद्धि", "g": "द्वितीया, एकवचन; समास", "p": [["अर्थ", "प्रयोजन"], ["सिद्धिम्", "सिद्धि"]]}, "वैदेह्याः": {"en": "of Vaidehī (Sītā)", "hi": "वैदेही (सीता) की", "r": "वैदेही", "g": "षष्ठी, एकवचन"}, "पश्याम्यहमुपस्थिताम्": {"en": "I see (it) at hand", "hi": "मैं निकट आयी हुई देखती हूँ", "r": "दृश् (पश्य) + अस्मद् + उप + स्था", "g": "संधि: पश्यामि + अहम् + उपस्थिताम्", "p": [["पश्यामि", "देखती हूँ"], ["अहम्", "मैं"], ["उपस्थिताम्", "निकट आयी हु