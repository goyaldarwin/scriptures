r": "भर्त्स्", "g": "क्त, द्वितीया, एकवचन, स्त्रीलिङ्ग"}, "तर्जितां": {"en": "threatened", "hi": "धमकायी गयी(को)", "r": "तर्ज्", "g": "क्त, द्वितीया, एकवचन, स्त्रीलिङ्ग"}, "नानुमंस्यति": {"en": "will not tolerate", "hi": "सहन नहीं करेंगे", "r": "न + अनु + मन्", "g": "संधि: न + अनुमंस्यति (लृट्, प्रथम पुरुष, एकवचन)", "p": [["न", "नहीं"], ["अनुमंस्यति", "अनुमति देगा, सहन करेगा"]]}, "तदलं": {"en": "so, enough (of)", "hi": "अतः बस (… की आवश्यकता नहीं)", "r": "तद् + अलम्", "g": "संधि: तत् + अलम्", "p": [["तत्", "इसलिये"], ["अलम्", "बस, व्यर्थ"]]}, "क्रूरवाक्यैश्च": {"en": "and with cruel words", "hi": "और कठोर वचनोंसे", "r": "क्रूर + वाक्य + च", "g": "संधि: क्रूरवाक्यैः + च", "p": [["क्रूरवाक्यैः", "कठोर वचनोंसे"], ["च", "और"]]}, "सान्त्वमेवाभिधीयताम्": {"en": "let only gentle words be spoken", "hi": "सान्त्वनापूर्ण (मीठे) वचन ही बोले जायँ", "r": "सान्त्व + एव + अभि + धा", "g": "संधि: सान्त्वम् + एव + अभिधीयताम्", "p": [["सान्त्वम्", "मीठे वचन"], ["एव", "ही"], ["अभिधीयताम्", "कहे जायँ (लोट्, कर्मवाच्य)"]]}, "अभियाचाम": {"en": "let us beg (her)", "hi": "(आओ) हम प्रार्थना करें", "r": "अभि + याच्", "g": "लोट्, उत्तम पुरुष, बहुवचन"}, "वैदेहीमेतद्धि": {"en": "Vaidehī (Sītā); this indeed", "hi": "वैदेही (सीता) से; यही", "r": "वैदेही + एतद् + हि", "g": "संधि: वैदेहीम् + एतत् + हि", "p": [["वैदेहीम्", "सीतासे"], ["एतत्", "यह"], ["हि", "ही"]]}, "यस्या": {"en": "of whom (which woman)", "hi": "जिस (स्त्री) के", "r": "यद्", "g": "षष्ठी, एकवचन, स्त्रीलिङ्ग (यस्याः)"}, "ह्येवंविधः": {"en": "indeed, of such a kind", "hi": "ऐसा ही", "r": "हि + एवंविध", "g": "संधि: हि + एवंविधः", "p": [["हि", "ही, निश्चय"], ["एवंविधः", "ऐसा"]]}, "दुःखितायाः": {"en": "of (a woman) in sorrow", "hi": "दुःखी (स्त्री) के", "r": "दुःखित", "g": "षष्ठी, एकवचन, स्त्रीलिङ्ग"}, "प्रदृश्यते": {"en": "is seen", "hi": "दिखायी देता है", "r": "प्र + दृश्", "g": "लट्, प्रथम पुरुष, एकवचन (कर्मवाच्य)"}, "दुःखैर्बहुभिर्मुक्ता": {"en": "freed from many sorrows", "hi": "बहुत-से दुःखोंसे छूटी हुई", "r": "दुःख + बहु + मुच्", "g