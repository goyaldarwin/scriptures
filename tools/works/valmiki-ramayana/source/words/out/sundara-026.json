याम्यहमल्पभाग्या": {"en": "I, unfortunate, am perishing", "hi": "मैं अभागिन नष्ट हो रही हूँ", "r": "वि + पद् + अस्मद् + अल्प + भाग्य", "g": "संधि: विपद्यामि + अहम् + अल्पभाग्या", "p": [["विपद्यामि", "नष्ट हो रही हूँ"], ["अहम्", "मैं"], ["अल्पभाग्या", "अभागिन"]]}, "महार्णवे": {"en": "in the great ocean", "hi": "महासागरमें", "r": "महत् + अर्णव", "g": "सप्तमी, एकवचन; समास"}, "नौरिव": {"en": "like a boat", "hi": "नौकाकी भाँति", "r": "नौ + इव", "g": "संधि: नौः + इव", "p": [["नौः", "नौका"], ["इव", "भाँति"]]}, "मूढवाता": {"en": "driven off course by the wind", "hi": "हवासे भटकी हुई", "r": "मूढ + वात", "g": "प्रथमा, एकवचन, स्त्रीलिङ्ग; समास (बहुव्रीहि)", "p": [["मूढ", "भटका हुआ"], ["वाता", "वायुवाली"]]}, "तरस्विनौ": {"en": "the two mighty ones", "hi": "दोनों वेगशाली (वीर)", "r": "तरस्विन्", "g": "प्रथमा, द्विवचन"}, "धारयता": {"en": "bearing (the form)", "hi": "धारण करनेवाले(द्वारा)", "r": "धृ (णिच्: धारय)", "g": "शतृ, तृतीया, एकवचन"}, "मृगस्य": {"en": "of a deer", "hi": "मृगका", "r": "मृग", "g": "षष्ठी, एकवचन"}, "सत्त्वेन": {"en": "by a being, creature", "hi": "एक प्राणीद्वारा", "r": "सत्त्व", "g": "तृतीया, एकवचन"}, "मनुजेन्द्रपुत्रौ": {"en": "the two sons of the lord of men (Daśaratha)", "hi": "राजा (दशरथ) के दोनों पुत्र", "r": "मनुज + इन्द्र + पुत्र", "g": "प्रथमा, द्विवचन; समास", "p": [["मनुजेन्द्र", "नरेश"], ["पुत्रौ", "दोनों पुत्र"]]}, "विशस्तौ": {"en": "slain", "hi": "मारे गये", "r": "वि + शस्", "g": "क्त, प्रथमा, द्विवचन"}, "कारणात्": {"en": "on account of", "hi": "कारणसे", "r": "कारण", "g": "पञ्चमी, एकवचन"}, "सिंहर्षभौ": {"en": "two lordly lions", "hi": "दो श्रेष्ठ सिंह", "r": "सिंह + ऋषभ", "g": "प्रथमा, द्विवचन; समास", "p": [["सिंह", "सिंह"], ["ऋषभौ", "दो श्रेष्ठ"]]}, "द्वाविव": {"en": "like two", "hi": "दोकी भाँति", "r": "द्वि + इव", "g": "संधि: द्वौ + इव", "p": [["द्वौ", "दो"], ["इव", "भाँति"]]}, "वैद्युतेन": {"en": "by lightning", "hi": "बिजलीसे", "r": "वैद्युत", "g": "तृतीया, एकवचन"}, "मृगरूपधारी": {"en": "taking the form of a deer", "hi": "मृगका रूप धारण करनेवाला", "r": "मृग + रूप + धारिन्", "g": "प्रथमा, एकवचन; समास", "p": [["मृगरूप", "मृगका रूप"], ["धारी", "धारण करनेवाला"]]}, "मामल्पभाग्यां": {"en": "me, the unfortunate", "hi": "मुझ अभागिनको", "r": "अस्मद् + अल्प + भाग्य", "g": "संधि: माम् + अल्पभाग्याम्", "p": [["माम्", "मुझको"], ["अल्पभाग्याम्", "अभागिनको"]]}, "लुलुभे": {"en": "lured", "hi": "लुभा लिया", "r": "लुभ्", "g": "लिट्, प्रथम पुरुष, एकवचन"}, "तदानीम्": {"en": "then, at that time", "hi": "उस समय", "r": "तदानीम्", "g": "अव्यय"}, "यत्रार्यपुत्रौ": {"en": "when the two noble sons", "hi": "जब दोनों आर्यपुत्रोंको", "r": "यत्र + आर्य + पुत्र", "g": "संधि: यत्र + आर्यपुत्रौ", "p": [["यत्र", "जब"], ["आर्यपुत्रौ", "दोनों आर्यपुत्रोंको"]]}, "विससर्ज": {"en": "sent away", "hi": "भेज दिया", "r": "वि + सृज्", "g": "लिट्, प्रथम पुरुष, एकवचन"}, "रामानुजं": {"en": "Rāma's younger brother (Lakṣmaṇa)", "hi": "श्रीरामके छोटे भाई (लक्ष्मण) को", "r": "राम + अनुज", "g": "द्वितीया, एकवचन; समास", "p": [["राम", "श्रीरामके"], ["अनुजम्", "छोटे भाईको"]]}, "सत्यव्रत": {"en": "O true to your vow", "hi": "हे सत्यव्रती", "r": "सत्य + व्रत", "g": "सम्बोधन, एकवचन; समास (बहुव्रीहि)"}, "दीर्घबाहो": {"en": "O long-armed one", "hi": "हे महाबाहो", "r": "दीर्घ + बाहु", "g": "सम्बोधन, एकवचन; समास (बहुव्रीहि)"}, "पूर्णचन्द्रप्रतिमानवक्त्र": {"en": "O you whose face is like the full moon", "hi": "हे पूर्ण चन्द्रमाके समान मुखवाले", "r": "पूर्ण + चन्द्र + प्रतिमान + वक्त्र", "g": "सम्बोधन, एकवचन; समास (बहुव्रीहि)", "p": [["पूर्णचन्द्र", "पूर्ण चन्द्रमा"], ["प्रतिमान", "समान"], ["वक्त्र", "मुखवाले"]]}, "हितः": {"en": "well-wisher, benefactor", "hi": "हितैषी", "r": "हित", "g": "प्रथमा, एकवचन"}, "प्रियश्च": {"en": "and dear", "hi": "और प्रिय", "r": "प्रिय + च", "g": "संधि: प्रियः + च", "p": [["प्रियः", "प्रिय"], ["च", "और"]]}, "वध्यां": {"en": "(me) condemned to be killed", "hi": "वधके योग्य (मुझको)", "r": "वध्य", "g": "द्वितीया, एकवचन, स्त्रीलिङ्ग"}, "वेत्सि": {"en": "you know", "hi": "जानते हो", "r": "विद्", "g": "लट्, मध्यम पुरुष, एकवचन"}, "अनन्यदेवत्वमियं": {"en": "having no other god (but my husband), this", "hi": "(पतिके सिवा) दूसरे देवताको न मानना, यह", "r": "अनन्य + देवत्व + इदम्", "g": "संधि: अनन्यदेवत्वम् + इयम्", "p": [["अनन्यदेवत्वम्", "दूसरे देवताको न मानना"], ["इयम्", "यह"]]}, "क्षमा": {"en": "forbearance", "hi": "क्षमा", "r": "क्षमा", "g": "प्रथमा, एकवचन"}, "नियमश्च": {"en": "and restraint, discipline", "hi": "और नियम (संयम)", "r": "नियम + च", "g": "संधि: नियमः + च", "p": [["नियमः", "नियम"], ["च", "और"]]}, "धर्मे": {"en": "in dharma (righteousness)", "hi": "धर्मके विषयमें", "r": "धर्म", "g": "सप्तमी, एकवचन"}, "पतिव्रतात्वं": {"en": "devotion to the husband", "hi": "पातिव्रत्य", "r": "पतिव्रता + त्व", "g": "प्रथमा, एकवचन; समास", "p": [["पतिव्रता", "पतिव्रता"], ["त्वम्", "भाव"]]}, "विफलं": {"en": "fruitless", "hi": "निष्फल", "r": "विफल", "g": "प्रथमा, एकवचन, नपुंसकलिङ्ग"}, "कृतघ्नेष्विव": {"en": "as among ungrateful (men)", "hi": "कृतघ्नोंके प्रति (किये उपकारकी) भाँति", "r": "कृतघ्न + इव", "g": "संधि: कृतघ्नेषु + इव", "p": [["कृतघ्नेषु", "कृतघ्नोंके प्रति"], ["इव", "भाँति"]]}, "मानुषाणाम्": {"en": "of human beings", "hi": "मनुष्योंके", "r": "मानुष", "g": "षष्ठी, बहुवचन"}, "मोघो": {"en": "vain, futile", "hi": "व्यर्थ", "r": "मोघ", "g": "प्रथमा, एकवचन"}, "धर्मश्चरितो": {"en": "dharma practised", "hi": "आचरण किया हुआ धर्म", "r": "धर्म + चर्", "g": "संधि: धर्मः + चरितः", "p": [["धर्मः", "धर्म"], ["चरितः", "आचरण किया हुआ"]]}, "ममायं": {"en": "this of mine", "hi": "मेरा यह", "r": "अस्मद् + इदम्", "g": "संधि: मम + अयम्", "p": [["मम", "मेरा"], ["अयम्", "यह"]]}, "तथैकपत्नीत्वमिदं": {"en": "likewise this faithfulness to one husband", "hi": "उसी प्रकार यह एकपत्नीव्रत", "r": "तथा + एक + पत्नी + त्व + इदम्", "g": "संधि: तथा + एकपत्नीत्वम् + इदम्", "p": [["तथा", "उसी प्रकार"], ["एकपत्नीत्वम्", "एक ही पतिकी पत्नी होनेका व्रत"], ["इदम्", "यह"]]}, "निरर्थकम्": {"en": "meaningless, useless", "hi": "निरर्थक", "r": "निरर्थक", "g": "प्रथमा, एकवचन, नपुंसकलिङ्ग"}, "कृशा": {"en": "emaciated", "hi": "दुबली", "r": "कृश", "g": "प्रथमा, एकवचन, स्त्रीलिङ्ग"}, "विवर्णा": {"en": "pale", "hi": "फीके रंगवाली", "r": "विवर्ण", "g": "प्रथमा, एकवचन, स्त्रीलिङ्ग"}, "सङ्गमने": {"en": "of reunion", "hi": "मिलनकी", "r": "सङ्गमन", "g": "सप्तमी, एकवचन"}, "निराशा": {"en": "hopeless", "hi": "निराश", "r": "निर् + आशा", "g": "प्रथमा, एकवचन, स्त्रीलिङ्ग"}, "पितुर्निदेशं": {"en": "the father's command", "hi": "पिताकी आज्ञा", "r": "पितृ + निदेश", "g": "संधि: पितुः + निदेशम्", "p": [["पितुः", "पिताकी"], ["निदेशम्", "आज्ञाको"]]}, "नियमेन": {"en": "strictly, as enjoined", "hi": "नियमपूर्वक", "r": "नियम", "g": "तृतीया, एकवचन"}, "वनान्निवृत्तश्चरितव्रतश्च": {"en": "returned from the forest, and with the vow completed", "hi": "वनसे लौटे हुए और व्रत पूरा किये हुए", "r": "वन + नि + वृत् + चरित + व्रत", "g": "संधि: वनात् + निवृत्तः + च + चरितव्रतः + च", "p": [["वनात्", "वनसे"], ["निवृत्तः", "लौटे हुए"], ["च", "और"], ["चरितव्रतः", "व्रत पूरा किये हुए"], ["च", "और"]]}, "स्त्रीभिस्तु": {"en": "but with women", "hi": "परंतु स्त्रियोंके साथ", "r": "स्त्री + तु", "g": "संधि: स्त्रीभिः + तु", "p": [["स्त्रीभिः", "स्त्रियोंके साथ"], ["तु", "परंतु"]]}, "विपुलेक्षणाभिः": {"en": "large-eyed", "hi": "बड़े-बड़े नेत्रोंवाली", "r": "विपुल + ईक्षण", "g": "तृतीया, बहुवचन, स्त्रीलिङ्ग; समास (बहुव्रीहि)"}, "संरंस्यसे": {"en": "you will enjoy yourself", "hi": "रमण करोगे", "r": "सम् + रम्", "g": "लृट्, मध्यम पुरुष, एकवचन"}, "वीतभयः": {"en": "free from fear", "hi": "निर्भय", "r": "वीत + भय", "g": "प्रथमा, एकवचन; समास (बहुव्रीहि)"}, "कृतार्थः": {"en": "having achieved (your) purpose", "hi": "कृतार्थ", "r": "कृत + अर्थ", "g": "प्रथमा, एकवचन; समास (बहुव्रीहि)"}, "जातकामा": {"en": "in whom love has arisen", "hi": "प्रेम उत्पन्न हुई", "r": "जात + काम", "g": "प्रथमा, एकवचन, स्त्रीलिङ्ग; समास (बहुव्रीहि)"}, "चिरं": {"en": "for a long time", "hi": "दीर्घकालतक", "r": "चिर", "g": "अव्यय (द्वितीया)"}, "विनाशाय": {"en": "for (my) destruction", "hi": "विनाशके लिये", "r": "वि + नश्", "g": "चतुर्थी, एकवचन"}, "निबद्धभावा": {"en": "with heart fastened (on you)", "hi": "(तुममें) बँधे हुए भाववाली", "r": "नि + बन्ध् + भाव", "g": "प्रथमा, एकवचन, स्त्रीलिङ्ग; समास (बहुव्रीहि)"}, "मोघं": {"en": "in vain", "hi": "व्यर्थ ही", "r": "मोघ", "g": "द्वितीया, एकवचन (क्रियाविशेषण)"}, "चरित्वाथ": {"en": "having practised, then", "hi": "आचरण करके, अब", "r": "चर् + अथ", "g": "संधि: चरित्वा + अथ", "p": [["चरित्वा", "आचरण करके"], ["अथ", "अब"]]}, "तपो": {"en": "austerity", "hi": "तप", "r": "तपस्", "g": "द्वितीया, एकवचन"}, "व्रतं": {"en": "vow", "hi": "व्रत", "r": "व्रत", "g": "द्वितीया, एकवचन"}, "त्यक्ष्यामि": {"en": "I will give up", "hi": "त्याग दूँगी", "r": "त्यज्", "g": "लृट्, उत्तम पुरुष, एकवचन"}, "धिग्जीवितमल्पभाग्याम्": {"en": "fie! life; (me) the unfortunate", "hi": "धिक्कार है! जीवन; (मुझ) अभागिनको", "r": "धिक् + जीवित + अल्प + भाग्य", "g": "संधि: धिक् + जीवितम् + अल्पभाग्याम्", "p": [["धिक्", "धिक्कार है"], ["जीवितम्", "जीवनको"], ["अल्पभाग्याम्", "अभागिनको"]]}, "सञ्जीवितं": {"en": "(my) life", "hi": "जीवन (को)", "r": "सम् + जीव्", "g": "क्त (भावमें), द्वितीया, एकवचन"}, "क्षिप्रमहं": {"en": "quickly I", "hi": "मैं शीघ्र", "r": "क्षिप्र + अस्मद्", "g": "संधि: क्षिप्रम् + अहम्", "p": [["क्षिप्रम्", "शीघ्र"], ["अहम्", "मैं"]]}, "त्यजेयं": {"en": "I would give up", "hi": "त्याग दूँ", "r": "त्यज्", "g": "विधिलिङ्, उत्तम पुरुष, एकवचन"}, "विषेण": {"en": "by poison", "hi": "विषसे", "r": "विष", "g": "तृतीया, एकवचन"}, "शस्त्रेण": {"en": "by a weapon", "hi": "शस्त्रसे", "r": "शस्त्र", "g": "तृतीया, एकवचन"}, "शितेन": {"en": "sharp", "hi": "तीखे", "r": "शित", "g": "तृतीया, एकवचन"}, "विषस्य": {"en": "of poison", "hi": "विषका", "r": "विष", "g": "षष्ठी, एकवचन"}, "दाता": {"en": "giver", "hi": "देनेवाला", "r": "दातृ", "g": "प्रथमा, एकवचन"}}