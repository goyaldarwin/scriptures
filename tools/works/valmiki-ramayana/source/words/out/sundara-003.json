{"प्लवमानं": {"en": "leaping, flying (through the air)", "hi": "छलाँग लगाते, उड़ते हुए (को)", "r": "प्लु", "g": "शानच् (वर्तमान कृदन्त), द्वितीया, एकवचन"}, "प्लवगं": {"en": "the monkey (one who moves by leaps)", "hi": "वानरको", "r": "प्लवग", "g": "द्वितीया, एकवचन"}, "त्वरितं": {"en": "quickly, swiftly", "hi": "शीघ्रतासे, तेजीसे", "r": "त्वर्", "g": "क्त (भूत कृदन्त), क्रियाविशेषण"}, "ववृषुस्तत्र": {"en": "rained down (showered) there", "hi": "वहाँ बरसाये", "r": "वृष् + तत्र", "g": "संधि: ववृषुः + तत्र", "p": [["ववृषुः", "बरसाये (लिट्, प्रथम पुरुष, बहुवचन)"], ["तत्र", "वहाँ"]]}, "देवगन्धर्वचारणाः": {"en": "the gods, Gandharvas (celestial musicians) and Cāraṇas (celestial bards)", "hi": "देवता, गन्धर्व और चारण", "r": "देव + गन्धर्व + चारण", "g": "समास (द्वन्द्व), प्रथमा, बहुवचन", "p": [["देव", "देवता"], ["गन्धर्व", "गन्धर्व (देवलोकके गायक)"], ["चारणाः", "चारण (देवताओंके स्तुतिगायक)"]]}, "तताप": {"en": "scorched, burned with heat / blazed", "hi": "तपाया, ताप दिया / तपा", "r": "तप्", "g": "लिट्, प्रथम पुरुष, एकवचन"}, "प्लवन्तं": {"en": "leaping, flying", "hi": "छलाँग लगाते, उड़ते हुए (को)", "r": "प्लु", "g": "शतृ (वर्तमान कृदन्त), द्वितीया, एकवचन"}, "वानरेश्वरम्": {"en": "the lord of monkeys (Hanumān)", "hi": "वानरोंके स्वामी (हनुमान्जी)को", "r": "वानर + ईश्वर", "g": "समास (षष्ठी तत्पुरुष), द्वितीया, एकवचन", "p": [["वानर", "वानरोंके"], ["ईश्वरम्", "स्वामीको"]]}, "सिषेवे": {"en": "served, attended on", "hi": "सेवा की", "r": "सेव्", "g": "लिट्, प्रथम पुरुष, एकवचन"}, "वायू": {"en": "the wind (-god)", "hi": "वायु (देवता)", "r": "वायु", "g": "प्रथमा, एकवचन (वायुः, संधिमें वायू)"}, "रामकार्यार्थसिद्धये": {"en": "for the accomplishment of Rāma's task", "hi": "श्रीरामके कार्यकी सिद्धिके लिये", "r": "राम + कार्य + अर्थ + सिद्धि", "g": "समास (षष्ठी तत्पुरुष), चतुर्थी, एकवचन", "p": [["राम", "श्रीरामके"], ["कार्यार्थ", "कार्यके प्रयोजनकी"], ["सिद्धये", "सिद्धिके लिये"]]}, "ऋषयस्तुष्टुवुश्चैनं": {"en": "and the sages praised him", "hi": "और ऋषियोंने इनकी स्तुति की", "r": "ऋषि + स्तु + च + एनद्", "g": "संधि: ऋषयः + तुष्टुवुः + च + एनम्", "p": [["ऋषयः", "ऋषियोंने"], ["तुष्टुवुः", "स्तुति की"], ["च", "और"], ["एनम्", "इनकी"]]}, "विहायसा": {"en": "through the sky", "hi": "आकाशमार्गसे", "r": "विहायस्", "g": "तृतीया, एकवचन"}, "जगुश्च": {"en": "and sang", "hi": "और गान किया", "r": "गै + च", "g": "संधि: जगुः + च", "p": [["जगुः", "गान किया (लिट्, प्रथम पुरुष, बहुवचन)"], ["च", "और"]]}, "देवगन्धर्वाः": {"en": "the gods and Gandharvas", "hi": "देवता और गन्धर्व", "r": "देव + गन्धर्व", "g": "समास (द्वन्द्व), प्रथमा, बहुवचन", "p": [["देव", "देवता"], ["गन्धर्वाः", "गन्धर्व"]]}, "प्रशंसन्तो": {"en": "praising", "hi": "प्रशंसा करते हुए", "r": "प्र + शंस्", "g": "शतृ (वर्तमान कृदन्त), प्रथमा, बहुवचन"}, "वनौकसम्": {"en": "the forest-dweller (the monkey)", "hi": "वनवासी (वानर)को", "r": "वन + ओकस्", "g": "समास (बहुव्रीहि), द्वितीया, एकवचन", "p": [["वन", "वन"], ["ओकसम्", "घर है जिसका, उसको"]]}, "नागाश्च": {"en": "and the Nāgas (serpent beings)", "hi": "और नाग", "r": "नाग + च", "g": "संधि: नागाः + च", "p": [["नागाः", "नाग"], ["च", "और"]]}, "तुष्टुवुर्यक्षा": {"en": "the Yakṣas praised", "hi": "यक्षोंने स्तुति की", "r": "स्तु + यक्ष", "g": "संधि: तुष्टुवुः + यक्षाः", "p": [["तुष्टुवुः", "स्तुति की"], ["यक्षाः", "यक्षोंने"]]}, "रक्षांसि": {"en": "the Rākṣasas (demons)", "hi": "राक्षस", "r": "रक्षस्", "g": "प्रथमा/द्वितीया, बहुवचन (नपुंसक)"}, "प्रेक्ष्य": {"en": "having seen, on seeing", "hi": "देखकर", "r": "प्र + ईक्ष्", "g": "ल्यप् (पूर्वकालिक)"}, "कपिवरं": {"en": "the best of monkeys", "hi": "कपिश्रेष्ठ (हनुमान्जी)को", "r": "कपि + वर", "g": "समास (षष्ठी तत्पुरुष), द्वितीया, एकवचन", "p": [["कपि", "वानरोंमें"], ["वरम्", "श्रेष्ठको"]]}, "विगतक्लमम्": {"en": "free of weariness, unwearied", "hi": "थकावटसे रहित (को)", "r": "वि + गम् + क्लम", "g": "समास (बहुव्रीहि), द्वितीया, एकवचन", "p": [["विगत", "दूर हो गयी है"], ["क्लमम्", "थकावट जिसकी, उसको"]]}, "तस्मिन्": {"en": "in that, on that / when he (was …)", "hi": "उसमें, उसपर / उसके (… रहते)", "r": "तद्", "g": "सप्तमी, एकवचन"}, "प्लवगशार्दूले": {"en": "(while) the tiger among monkeys (Hanumān was …)", "hi": "वानरोंमें सिंहके समान (हनुमान्जी)के (… रहते)", "r": "प्लवग + शार्दूल", "g": "समास, सप्तमी, एकवचन", "p": [["प्लवग", "वानरोंमें"], ["शार्दूले", "सिंह (श्रेष्ठ)के"]]}, "प्लवमाने": {"en": "(while) leaping, flying", "hi": "छलाँग लगाते (उड़ते) समय", "r": "प्लु", "g": "शानच् (वर्तमान कृदन्त), सप्तमी, एकवचन"}, "हनूमति": {"en": "(while) Hanumān (was …)", "hi": "हनुमान्जीके (… रहते)", "r": "हनुमत्", "g": "सप्तमी, एकवचन"}, "इक्ष्वाकुकुलमानार्थी": {"en": "wishing to honour the Ikṣvāku line", "hi": "इक्ष्वाकुकुलका सम्मान चाहनेवाला", "r": "इक्ष्वाकु + कुल + मान + अर्थिन्", "g": "समास, प्रथमा, एकवचन", "p": [["इक्ष्वाकुकुल", "इक्ष्वाकुवंशके"], ["मान", "सम्मानका"], ["अर्थी", "इच्छुक"]]}, "चिन्तयामास": {"en": "thought, reflected", "hi": "सोचा, विचार किया", "r": "चिन्त्", "g": "लिट् (आम्), प्रथम पुरुष, एकवचन"}, "सागरः": {"en": "the ocean (the ocean-god)", "hi": "समुद्र (समुद्रदेवता)", "r": "सागर", "g": "प्रथमा, एकवचन"}, "साहाय्यं": {"en": "help, assistance", "hi": "सहायता", "r": "साहाय्य", "g": "द्वितीया, एकवचन"}, "वानरेन्द्रस्य": {"en": "of the chief of monkeys (Hanumān / Sugrīva)", "hi": "वानरराज (हनुमान्जी / सुग्रीव)का", "r": "वानर + इन्द्र", "g": "समास (षष्ठी तत्पुरुष), षष्ठी, एकवचन", "p": [["वानर", "वानरोंके"], ["इन्द्रस्य", "स्वामीका"]]}, "नाहं": {"en": "not I, I do not", "hi": "मैं नहीं", "r": "न + अस्मद्", "g": "संधि: न + अहम्", "p": [["न", "नहीं"], ["अहम्", "मैं"]]}, "हनूमतः": {"en": "of Hanumān / to Hanumān", "hi": "हनुमान्जीका / हनुमान्जीको", "r": "हनुमत्", "g": "षष्ठी, एकवचन"}, "भविष्यामि": {"en": "I shall be, I shall become", "hi": "होऊँगा, बन जाऊँगा", "r": "भू", "g": "लृट्, उत्तम पुरुष, एकवचन"}, "सर्ववाच्यो": {"en": "open to blame by all", "hi": "सबकी निन्दाका पात्र", "r": "सर्व + वच्", "g": "समास, प्रथमा, एकवचन", "p": [["सर्व", "सबके द्वारा"], ["वाच्यः", "निन्दनीय"]]}, "विवक्षताम्": {"en": "of those who would speak (of it)", "hi": "कहनेकी इच्छावालोंका (बोलनेवालोंका)", "r": "वच्", "g": "सन्नन्त, शतृ (वर्तमान कृदन्त), षष्ठी, बहुवचन"}, "अहमिक्ष्वाकुनाथेन": {"en": "I, by the Ikṣvāku king (Sagara)", "hi": "मैं, इक्ष्वाकुवंशी राजा (सगर)द्वारा", "r": "अस्मद् + इक्ष्वाकु + नाथ", "g": "संधि: अहम् + इक्ष्वाकुनाथेन", "p": [["अहम्", "मैं"], ["इक्ष्वाकुनाथेन", "इक्ष्वाकुवंशी राजाद्वारा"]]}, "सगरेण": {"en": "by Sagara (an Ikṣvāku king)", "hi": "राजा सगरद्वारा", "r": "सगर", "g": "तृतीया, एकवचन"}, "विवर्धितः": {"en": "made to grow, enlarged", "hi": "बढ़ाया गया", "r": "वि + वृध्", "g": "णिजन्त, क्त (भूत कृदन्त), प्रथमा, एकवचन"}, "इक्ष्वाकुसचिवश्चायं": {"en": "and this helper (minister) of the Ikṣvāku prince (Rāma)", "hi": "और यह इक्ष्वाकुवंशी (श्रीराम)का सहायक (मन्त्री)", "r": "इक्ष्वाकु + सचिव + च + इदम्", "g": "संधि: इक्ष्वाकुसचिवः + च + अयम्", "p": [["इक्ष्वाकुसचिवः", "इक्ष्वाकुवंशीका सहायक"], ["च", "और"], ["अयम्", "यह"]]}, "तन्नार्हत्यवसादितुम्": {"en": "therefore he ought not to be let down (left to flag)", "hi": "इसलिये इन्हें शिथिल (दुःखी) होने देना उचित नहीं", "r": "तद् + न + अर्ह् + अव-सद्", "g": "संधि: तत् + न + अर्हति + अवसादितुम्", "p": [["तत्", "इसलिये"], ["न", "नहीं"], ["अर्हति", "योग्य है"], ["अवसादितुम्", "शिथिल (दुःखी) किये जानेके"]]}, "विधातव्यं": {"en": "is to be arranged, should be done", "hi": "प्रबन्ध करना चाहिये, करना चाहिये", "r": "वि + धा", "g": "तव्यत्, प्रथमा, एकवचन (नपुंसक)"}, "विश्रमेत": {"en": "may rest", "hi": "विश्राम कर सके", "r": "वि + श्रम्", "g": "विधिलिङ्, प्रथम पुरुष, एकवचन"}, "शेषं": {"en": "the rest, the remaining (distance)", "hi": "शेष (बचा हुआ मार्ग)", "r": "शेष", "g": "द्वितीया, एकवचन"}, "विश्रान्तः": {"en": "rested, having rested", "hi": "विश्राम करके", "r": "वि + श्रम्", "g": "क्त (भूत कृदन्त), प्रथमा, एकवचन"}, "सोऽतितरिष्यति": {"en": "he will cross over", "hi": "वह पार कर जायगा", "r": "तद् + अति + तॄ", "g": "संधि: सः + अतितरिष्यति", "p": [["सः", "वह"], ["अतितरिष्यति", "पार कर जायगा (लृट्, प्रथम पुरुष, एकवचन)"]]}, "साध्वीं": {"en": "good, right (resolve) / virtuous (woman)", "hi": "उत्तम (विचार)को / सती (स्त्री)को", "r": "साधु", "g": "स्त्रीलिङ्ग, द्वितीया, एकवचन"}, "समुद्रश्छन्नमम्भसि": {"en": "the ocean, (to the one) hidden in the water", "hi": "समुद्रने, जलमें छिपे हुए (मैनाक)से", "r": "समुद्र + छद् + अम्भस्", "g": "संधि: समुद्रः + छन्नम् + अम्भसि", "p": [["समुद्रः", "समुद्रने"], ["छन्नम्", "छिपे हुएसे"], ["अम्भसि", "जलमें"]]}, "हिरण्यनाभं": {"en": "with gold at its centre", "hi": "जिसके मध्यमें सोना है, उसको", "r": "हिरण्य + नाभ", "g": "समास (बहुव्रीहि), द्वितीया, एकवचन", "p": [["हिरण्य", "सोना"], ["नाभम्", "मध्यमें है जिसके, उसको"]]}, "मैनाकमुवाच": {"en": "said to Maināka (a golden mountain within the ocean)", "hi": "मैनाक पर्वतसे बोला", "r": "मैनाक + वच्", "g": "संधि: मैनाकम् + उवाच", "p": [["मैनाकम्", "मैनाकसे"], ["उवाच", "बोला (लिट्, प्रथम पुरुष, एकवचन)"]]}, "गिरिसत्तमम्": {"en": "the best of mountains", "hi": "पर्वतश्रेष्ठको", "r": "गिरि + सत्तम", "g": "समास (षष्ठी तत्पुरुष), द्वितीया, एकवचन", "p": [["गिरि", "पर्वतोंमें"], ["सत्तमम्", "श्रेष्ठको"]]}, "त्वमिहासुरसङ्घानां": {"en": "you, here, (against) the hosts of Asuras", "hi": "तुम, यहाँ, असुरसमूहोंके", "r": "युष्मद् + इह + असुर + सङ्घ", "g": "संधि: त्वम् + इह + असुरसङ्घानाम्", "p": [["त्वम्", "तुम"], ["इह", "यहाँ"], ["असुरसङ्घानाम्", "असुरोंके समूहोंके (षष्ठी, बहुवचन)"]]}, "देवराज्ञा": {"en": "by the king of the gods (Indra)", "hi": "देवराज (इन्द्र)द्वारा", "r": "देव + राजन्", "g": "समास (षष्ठी तत्पुरुष), तृतीया, एकवचन", "p": [["देव", "देवताओंके"], ["राज्ञा", "राजाद्वारा"]]}, "महात्मना": {"en": "by (with) the great-souled one", "hi": "महात्माद्वारा, महात्माके साथ", "r": "महत् + आत्मन्", "g": "समास (बहुव्रीहि), तृतीया, एकवचन"}, "पातालनिलयानां": {"en": "of those dwelling in Pātāla (the nether world)", "hi": "पातालमें रहनेवालोंके", "r": "पाताल + निलय", "g": "समास (बहुव्रीहि), षष्ठी, बहुवचन", "p": [["पाताल", "पातालमें"], ["निलयानाम्", "निवास है जिनका, उनके"]]}, "परिघः": {"en": "a bar (like the iron bar of a gate), a barrier", "hi": "अर्गला (रोकनेवाली आड़)", "r": "परिघ", "g": "प्रथमा, एकवचन"}, "संनिवेशितः": {"en": "placed, set (there)", "hi": "स्थापित किये गये", "r": "सम् + नि + विश्", "g": "णिजन्त, क्त (भूत कृदन्त), प्रथमा, एकवचन"}, "त्वमेषां": {"en": "you, of these", "hi": "तुम, इनके", "r": "युष्मद् + इदम्", "g": "संधि: त्वम् + एषाम्", "p": [["त्वम्", "तुम"], ["एषाम्", "इनके"]]}, "ज्ञातवीर्याणां": {"en": "whose might is well known", "hi": "जिनका पराक्रम जाना हुआ है, उनके", "r": "ज्ञा + वीर्य", "g": "समास (बहुव्रीहि), षष्ठी, बहुवचन", "p": [["ज्ञात", "जाना हुआ"], ["वीर्याणाम्", "पराक्रम है जिनका, उनके"]]}, "पुनरेवोत्पतिष्यताम्": {"en": "of those who would rise up again", "hi": "फिरसे ऊपर उठ आनेवालोंके", "r": "पुनर् + एव + उत् + पत्", "g": "संधि: पुनः + एव + उत्पतिष्यताम्", "p": [["पुनः", "फिर"], ["एव", "ही"], ["उत्पतिष्यताम्", "ऊपर उठ आनेवालोंके (भविष्यत् कृदन्त, षष्ठी, बहुवचन)"]]}, "पातालस्याप्रमेयस्य": {"en": "of the immeasurable Pātāla (nether world)", "hi": "अपार पाताललोकके", "r": "पाताल + अप्रमेय", "g": "संधि: पातालस्य + अप्रमेयस्य", "p": [["पातालस्य", "पातालके"], ["अप्रमेयस्य", "अपार (जिसका माप न हो सके)"]]}, "द्वारमावृत्य": {"en": "covering (blocking) the entrance", "hi": "द्वारको ढककर (रोककर)", "r": "द्वार + आ-वृ", "g": "संधि: द्वारम् + आवृत्य", "p": [["द्वारम्", "द्वारको"], ["आवृत्य", "ढककर, रोककर (ल्यप्)"]]}, "तिष्ठसि": {"en": "you stand, you stay", "hi": "खड़े हो, स्थित हो", "r": "स्था", "g": "लट्, मध्यम पुरुष, एकवचन"}, "तिर्यगूर्ध्वमधश्चैव": {"en": "sideways, upward and downward too", "hi": "तिरछे, ऊपर और नीचे भी", "r": "तिर्यच् + ऊर्ध्व + अधस् + च + एव", "g": "संधि: तिर्यक् + ऊर्ध्वम् + अधः + च + एव", "p": [["तिर्यक्", "तिरछे (चौड़ाईमें)"], ["ऊर्ध्वम्", "ऊपर"], ["अधः", "नीचे"], ["च", "और"], ["एव", "भी"]]}, "शक्तिस्ते": {"en": "your power", "hi": "तुम्हारी शक्ति", "r": "शक्ति + युष्मद्", "g": "संधि: शक्तिः + ते", "p": [["शक्तिः", "शक्ति"], ["ते", "तुम्हारी"]]}, "शैल": {"en": "O mountain / (like) a mountain", "hi": "हे पर्वत! / पर्वत", "r": "शैल", "g": "सम्बोधन, एकवचन / प्रथमा, एकवचन (शैलः, संधिमें शैल)"}, "वर्धितुम्": {"en": "to grow", "hi": "बढ़नेकी, बढ़नेके लिये", "r": "वृध्", "g": "तुमुन्"}, "तस्मात्": {"en": "therefore", "hi": "इसलिये", "r": "तद्", "g": "पञ्चमी, एकवचन (अव्ययके अर्थमें)"}, "सञ्चोदयामि": {"en": "I urge, I bid", "hi": "प्रेरित करता हूँ", "r": "सम् + चुद्", "g": "णिजन्त, लट्, उत्तम पुरुष, एकवचन"}, "त्वामुत्तिष्ठ": {"en": "you; rise up!", "hi": "तुम्हें; उठो", "r": "युष्मद् + उत् + स्था", "g": "संधि: त्वाम् + उत्तिष्ठ", "p": [["त्वाम्", "तुम्हें"], ["उत्तिष्ठ", "उठो (लोट्, मध्यम पुरुष, एकवचन)"]]}, "गिरिसत्तम": {"en": "O best of mountains", "hi": "हे पर्वतश्रेष्ठ!", "r": "गिरि + सत्तम", "g": "समास, सम्बोधन, एकवचन", "p": [["गिरि", "पर्वतोंमें"], ["सत्तम", "हे श्रेष्ठ"]]}, "कपिशार्दूलस्त्वामुपर्येति": {"en": "the tiger among monkeys passes over you", "hi": "वानरश्रेष्ठ तुम्हारे ऊपरसे जा रहा है", "r": "कपि + शार्दूल + युष्मद् + उपरि + इ", "g": "संधि: कपिशार्दूलः + त्वाम् + उपरि + एति", "p": [["कपिशार्दूलः", "वानरोंमें सिंह (श्रेष्ठ)"], ["त्वाम्", "तुम्हारे"], ["उपरि", "ऊपरसे"], ["एति", "जा रहा है"]]}, "रामकार्यार्थी": {"en": "seeking (to do) Rāma's work", "hi": "श्रीरामका कार्य सिद्ध करना चाहनेवाला", "r": "राम + कार्य + अर्थिन्", "g": "समास, प्रथमा, एकवचन", "p": [["रामकार्य", "श्रीरामके कार्यका"], ["अर्थी", "इच्छुक"]]}, "भीमकर्मा": {"en": "doer of mighty, fearsome deeds", "hi": "भयंकर (अद्भुत) कर्म करनेवाला", "r": "भीम + कर्मन्", "g": "समास (बहुव्रीहि), प्रथमा, एकवचन", "p": [["भीम", "भयंकर"], ["कर्मा", "कर्म हैं जिसके, वह"]]}, "खमाप्लुतः": {"en": "leapt into the sky", "hi": "आकाशमें उछला हुआ", "r": "ख + आ-प्लु", "g": "संधि: खम् + आप्लुतः", "p": [["खम्", "आकाशमें"], ["आप्लुतः", "उछला हुआ (क्त, प्रथमा, एकवचन)"]]}, "साह्यं": {"en": "help, assistance", "hi": "सहायता", "r": "साह्य", "g": "प्रथमा/द्वितीया, एकवचन"}, "कार्यमिक्ष्वाकुकुलवर्तिनः": {"en": "is to be done for him who serves the Ikṣvāku line", "hi": "इक्ष्वाकुवंशकी सेवामें लगे (हनुमान्जी)की … करनी चाहिये", "r": "कृ + इक्ष्वाकु + कुल + वर्तिन्", "g": "संधि: कार्यम् + इक्ष्वाकुकुलवर्तिनः", "p": [["कार्यम्", "करनी चाहिये"], ["इक्ष्वाकुकुलवर्तिनः", "इक्ष्वाकुवंशकी सेवामें लगे हुएकी (षष्ठी, एकवचन)"]]}, "इक्ष्वाकवः": {"en": "the Ikṣvākus (kings of Ikṣvāku's line)", "hi": "इक्ष्वाकुवंशी राजा", "r": "इक्ष्वाकु", "g": "प्रथमा, बहुवचन"}, "पूज्याः": {"en": "worthy of honour", "hi": "पूजनीय", "r": "पूज्", "g": "यत्, प्रथमा, बहुवचन"}, "पूज्यतमास्तव": {"en": "most worthy of honour, for you", "hi": "तुम्हारे लिये परम पूजनीय", "r": "पूज्य + तम + युष्मद्", "g": "संधि: पूज्यतमाः + तव", "p": [["पूज्यतमाः", "सबसे अधिक पूजनीय"], ["तव", "तुम्हारे लिये"]]}, "साचिव्यमस्माकं": {"en": "help, for us (a minister's service)", "hi": "हमारी सहायता", "r": "साचिव्य + अस्मद्", "g": "संधि: साचिव्यम् + अस्माकम्", "p": [["साचिव्यम्", "सहायता (मन्त्रीका कर्तव्य)"], ["अस्माकम्", "हमारी"]]}, "कार्यमतिक्रमेत्": {"en": "the task would slip by (be missed)", "hi": "कार्य छूट जाय, टल जाय", "r": "कृ + अति + क्रम्", "g": "संधि: कार्यम् + अतिक्रमेत्", "p": [["कार्यम्", "कार्य"], ["अतिक्रमेत्", "छूट जाय (विधिलिङ्, प्रथम पुरुष, एकवचन)"]]}, "कर्तव्यमकृतं": {"en": "a duty that is left undone", "hi": "करनेयोग्य कार्य, जो न किया गया हो", "r": "कृ + अ + कृ", "g": "संधि: कर्तव्यम् + अकृतम्", "p": [["कर्तव्यम्", "करनेयोग्य"], ["अकृतम्", "न किया हुआ"]]}, "कार्यं": {"en": "the task, the work / to be done", "hi": "कार्य / करनेयोग्य", "r": "कृ", "g": "ण्यत्, प्रथमा/द्वितीया, एकवचन"}, "मन्युमुदीरयेत्": {"en": "would rouse anger", "hi": "क्रोध जगा देता है", "r": "मन्यु + उत् + ईर्", "g": "संधि: मन्युम् + उदीरयेत्", "p": [["मन्युम्", "क्रोधको"], ["उदीरयेत्", "जगा देता है (णिजन्त, विधिलिङ्, प्रथम पुरुष, एकवचन)"]]}, "सलिलादूर्ध्वमुत्तिष्ठ": {"en": "rise up out of the water", "hi": "जलसे ऊपर उठो", "r": "सलिल + ऊर्ध्व + उत् + स्था", "g": "संधि: सलिलात् + ऊर्ध्वम् + उत्तिष्ठ", "p": [["सलिलात्", "जलसे"], ["ऊर्ध्वम्", "ऊपर"], ["उत्तिष्ठ", "उठो"]]}, "तिष्ठत्वेष": {"en": "let this one stay (rest)", "hi": "यह (वानर) ठहरे", "r": "स्था + एतद्", "g": "संधि: तिष्ठतु + एषः", "p": [["तिष्ठतु", "ठहरे"], ["एषः", "यह"]]}, "कपिस्त्वयि": {"en": "the monkey, on you", "hi": "वानर, तुमपर", "r": "कपि + युष्मद्", "g": 