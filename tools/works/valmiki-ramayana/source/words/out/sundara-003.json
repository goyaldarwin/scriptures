ents (on them)", "hi": "किन्नरों और बड़े-बड़े नागोंसे युक्त", "r": "स + किंनर + महत् + उरग", "g": "समास (बहुव्रीहि), तृतीया, बहुवचन", "p": [["स", "सहित"], ["किंनर", "किन्नरों (देवलोकके गायकों)"], ["महोरगैः", "और बड़े नागोंके"]]}, "आदित्योदयसङ्काशैरुल्लिखद्भिरिवाम्बरम्": {"en": "like the rising sun, as if scratching the sky", "hi": "उगते सूर्यके समान, मानो आकाशको खरोंच रहे हों", "r": "आदित्य + उदय + सङ्काश + उत्-लिख् + इव + अम्बर", "g": "संधि: आदित्योदयसङ्काशैः + उल्लिखद्भिः + इव + अम्बरम्", "p": [["आदित्योदयसङ्काशैः", "उगते सूर्यके समान"], ["उल्लिखद्भिः", "खरोंचते हुए"], ["इव", "मानो"], ["अम्बरम्", "आकाशको"]]}, "जाम्बूनदैः": {"en": "golden (of Jāmbūnada gold)", "hi": "जाम्बूनद नामक सुवर्णके", "r": "जाम्बूनद", "g": "तृतीया, बहुवचन"}, "पर्वतस्य": {"en": "of the mountain", "hi": "पर्वतके", "r": "पर्वत", "g": "षष्ठी, एकवचन"}, "समुत्थितैः": {"en": "risen up", "hi": "ऊपर उठे हुए", "r": "सम् + उत् + स्था", "g": "क्त (भूत कृदन्त), तृतीया, बहुवचन"}, "आकाशं": {"en": "the sky", "hi": "आकाश", "r": "आकाश", "g": "प्रथमा, एकवचन"}, "शस्त्रसङ्काशमभवत्": {"en": "(the sky,) blue as a sword-blade, became", "hi": "तलवारके समान नीला (आकाश) … हो गया", "r": "शस्त्र + सङ्काश + भू", "g": "संधि: शस्त्रसङ्काशम् + अभवत्", "p": [["शस्त्रसङ्काशम्", "शस्त्र (तलवार)के समान (नीला)"], ["अभवत्", "हो गया"]]}, "काञ्चनप्रभम्": {"en": "golden-hued", "hi": "सुनहरी आभावाला", "r": "काञ्चन + प्रभा", "g": "समास (बहुव्रीहि), प्रथमा, एकवचन", "p": [["काञ्चन", "सोनेकी"], ["प्रभम्", "आभावाला"]]}, "जातरूपमयैः": {"en": "golden", "hi": "सुवर्णमय", "r": "जातरूप + मय", "g": "तृतीया, बहुवचन"}, "शृङ्गैर्भ्राजमानैर्महाप्रभैः": {"en": "with shining, greatly radiant peaks", "hi": "चमकते हुए, अत्यन्त प्रभावाले शिखरोंसे", "r": "शृङ्ग + भ्राज् + महत् + प्रभा", "g": "संधि: शृङ्गैः + भ्राजमानैः + महाप्रभैः", "p": [["शृङ्गैः", "शिखरोंसे"], ["भ्राजमानैः", "चमकते हुए"], ["महाप्रभैः", "अत्यन्त प्रभावाले"]]}, "आदित्यशतसङ्काशः": {"en": "like a hundred suns", "hi": "सौ सूर्योंके समान", "r": "आदित्य + शत + सङ्काश", "g": "समास, प्रथमा, एक