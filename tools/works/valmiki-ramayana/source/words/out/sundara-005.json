{"अन्तरिक्षे": {"en": "in the sky (mid-air)", "hi": "आकाशमें", "r": "अन्तरिक्ष", "g": "सप्तमी, एकवचन"}, "श्रीमानिदं": {"en": "the glorious one ... this", "hi": "श्रीमान् (तेजस्वी) ... यह", "r": "श्रीमत् + इदम्", "g": "संधि: श्रीमान् + इदम्", "p": [["श्रीमान्", "शोभासम्पन्न, तेजस्वी"], ["इदम्", "यह"]]}, "प्रविष्टोऽस्मि": {"en": "I have entered", "hi": "मैं प्रवेश कर चुका हूँ", "r": "प्र + विश् + अस्", "g": "संधि: प्रविष्टः + अस्मि", "p": [["प्रविष्टः", "प्रवेश किया हुआ"], ["अस्मि", "(मैं) हूँ"]]}, "दाक्षायणि": {"en": "O daughter of Dakṣa (Surasā)", "hi": "हे दक्षकुमारी!", "r": "दाक्षायणी", "g": "सम्बोधन, एकवचन"}, "नमोऽस्तु": {"en": "salutation be (to)", "hi": "नमस्कार हो", "r": "नमस् + अस्", "g": "संधि: नमः + अस्तु (अस्तु: लोट्, प्रथम पुरुष, एकवचन)", "p": [["नमः", "नमस्कार"], ["अस्तु", "हो"]]}, "वैदेही": {"en": "Vaidehī (Sītā, princess of Videha)", "hi": "विदेहकुमारी सीता", "r": "वैदेही", "g": "प्रथमा, एकवचन"}, "सत्यश्चासीद्": {"en": "and (it) has come true", "hi": "और सत्य हो गया", "r": "सत्य + च + अस्", "g": "संधि: सत्यः + च + आसीत्", "p": [["सत्यः", "सत्य"], ["च", "और"], ["आसीत्", "हुआ, था"]]}, "वरस्तव": {"en": "your boon", "hi": "तुम्हारा वर", "r": "वर + युष्मद्", "g": "संधि: वरः + तव", "p": [["वरः", "वरदान"], ["तव", "तुम्हारा"]]}, "वदनान्मुक्तं": {"en": "released from the mouth", "hi": "मुखसे छूटे हुए", "r": "वदन + मुच्", "g": "संधि: वदनात् + मुक्तम्", "p": [["वदनात्", "मुखसे"], ["मुक्तम्", "छूटे हुए"]]}, "चन्द्रं": {"en": "the moon", "hi": "चन्द्रमाको", "r": "चन्द्र", "g": "द्वितीया, एकवचन"}, "राहुमुखादिव": {"en": "as if from the mouth of Rāhu (the demon who swallows the moon at an eclipse)", "hi": "जैसे राहुके मुखसे", "r": "राहु + मुख + इव", "g": "संधि: राहुमुखात् + इव", "p": [["राहुमुखात्", "राहुके मुखसे"], ["इव", "जैसे"]]}, "स्वेन": {"en": "with (her / my) own", "hi": "अपने", "r": "स्व", "g": "तृतीया, एकवचन"}, "रूपेण": {"en": "in (the) form", "hi": "रूपसे, रूपमें", "r": "रूप", "g": "तृतीया, एकवचन"}, "वानरम्": {"en": "the monkey (Vānara)", "hi": "वानरको", "r": "वानर", "g": "द्वितीया, एकवचन"}, "अर्थसिद्ध्यै": {"en": "for the success of (your) purpose", "hi": "कार्यकी सिद्धिके लिये", "r": "अर्थ + सिद्धि", "g": "समास (षष्ठी तत्पुरुष), चतुर्थी, एकवचन", "p": [["अर्थ", "कार्य, प्रयोजन"], ["सिद्ध्यै", "सिद्धिके लिये"]]}, "समानय": {"en": "unite (bring together)", "hi": "मिलाओ", "r": "सम् + आ + नी", "g": "लोट्, मध्यम पुरुष, एकवचन"}, "वैदेहीं": {"en": "Vaidehī (Sītā)", "hi": "विदेहकुमारी सीताको", "r": "वैदेही", "g": "द्वितीया, एकवचन"}, "राघवेण": {"en": "with / by Rāghava (Rāma, descendant of Raghu)", "hi": "श्रीरामसे / श्रीरामने", "r": "राघव", "g": "तृतीया, एकवचन"}, "साधुसाध्विति": {"en": "(saying) “well done, well done!”", "hi": "‘बहुत अच्छा, बहुत अच्छा’ (कहकर)", "r": "साधु + साधु + इति", "g": "संधि: साधु + साधु + इति", "p": [["साधु", "अच्छा"], ["साधु", "अच्छा"], ["इति", "ऐसा (कहकर)"]]}, "प्रशशंसुस्तदा": {"en": "then (they) praised", "hi": "तब प्रशंसा की", "r": "प्र + शंस् + तदा", "g": "संधि: प्रशशंसुः + तदा (प्रशशंसुः: लिट्, प्रथम पुरुष, बहुवचन)", "p": [["प्रशशंसुः", "प्रशंसा की"], ["तदा", "तब"]]}, "सागरमनाधृष्यमभ्येत्य": {"en": "having come to the unassailable ocean", "hi": "अजेय समुद्रके पास पहुँचकर", "r": "सागर + अनाधृष्य + अभि + इ", "g": "संधि: सागरम् + अनाधृष्यम् + अभ्येत्य", "p": [["सागरम्", "समुद्रको"], ["अनाधृष्यम्", "अजेय, जिसे कोई दबा न सके"], ["अभ्येत्य", "पास पहुँचकर"]]}, "गरुडोपमः": {"en": "like Garuḍa (king of birds)", "hi": "गरुड़के समान", "r": "गरुड + उपमा", "g": "समास (बहुव्रीहि), प्रथमा, एकवचन", "p": [["गरुड", "गरुड़"], ["उपमः", "के समान"]]}, "सेविते": {"en": "frequented (by)", "hi": "सेवित (आकाश)में", "r": "सेव्", "g": "क्त (भूतकृदन्त), सप्तमी, एकवचन"}, "वारिधाराभिः": {"en": "by streams of rain-water", "hi": "जलकी धाराओंसे", "r": "वारि + धारा", "g": "समास (षष्ठी तत्पुरुष), तृतीया, बहुवचन", "p": [["वारि", "जल"], ["धाराभिः", "धाराओंसे"]]}, "पतगैश्च": {"en": "and by birds", "hi": "और पक्षियोंसे", "r": "पतग + च", "g": "संधि: पतगैः + च", "p": [["पतगैः", "पक्षियोंसे"], ["च", "और"]]}, "निषेविते": {"en": "frequented, inhabited (by)", "hi": "सेवित (आकाश)में", "r": "नि + सेव्", "g": "क्त (भूतकृदन्त), सप्तमी, एकवचन"}, "चरिते": {"en": "travelled (by)", "hi": "विचरण किये गये (आकाश)में", "r": "चर्", "g": "क्त (भूतकृदन्त), सप्तमी, एकवचन"}, "कैशिकाचार्यैरैरावतनिषेविते": {"en": "by masters of music and dance (of the kaiśika style); frequented by Airāvata (Indra's elephant)", "hi": "संगीत-नृत्यके आचार्योंद्वारा; ऐरावतसे सेवित (आकाश)में", "r": "कैशिक + आचार्य + ऐरावत + नि + सेव्", "g": "संधि: कैशिकाचार्यैः + ऐरावतनिषेविते", "p": [["कैशिकाचार्यैः", "कैशिकी (संगीत-नृत्य-शैली)के आचार्योंद्वारा"], ["ऐरावतनिषेविते", "ऐरावत (इन्द्रके हाथी)से सेवित (आकाश)में"]]}, "सिंहकुञ्जरशार्दूलपतगोरगवाहनैः": {"en": "drawn by lions, elephants, tigers, birds and serpents", "hi": "सिंह, हाथी, बाघ, पक्षी और सर्प जिनके वाहन हैं, उन (विमानों)से", "r": "सिंह + कुञ्जर + शार्दूल + पतग + उरग + वाहन", "g": "समास (बहुव्रीहि), तृतीया, बहुवचन", "p": [["सिंह", "सिंह"], ["कुञ्जर", "हाथी"], ["शार्दूल", "बाघ"], ["पतग", "पक्षी"], ["उरग", "सर्प"], ["वाहनैः", "वाहनवाले"]]}, "विमानैः": {"en": "by aerial chariots", "hi": "विमानोंसे", "r": "विमान", "g": "तृतीया, बहुवचन"}, "सम्पतद्भिश्च": {"en": "and flying (swiftly)", "hi": "और (वेगसे) उड़ते हुए", "r": "सम् + पत् + च", "g": "संधि: सम्पतद्भिः + च (शतृ, तृतीया, बहुवचन)", "p": [["सम्पतद्भिः", "उड़ते हुए"], ["च", "और"]]}, "विमलैः": {"en": "spotless, bright", "hi": "निर्मल", "r": "विमल", "g": "तृतीया, बहुवचन"}, "समलङ्कृते": {"en": "well adorned", "hi": "सुशोभित (आकाश)में", "r": "सम् + अलम् + कृ", "g": "क्त (भूतकृदन्त), सप्तमी, एकवचन"}, "वज्राशनिसमस्पर्शैः": {"en": "whose touch is like the thunderbolt and lightning", "hi": "वज्र और बिजलीके समान स्पर्शवाले", "r": "वज्र + अशनि + सम + स्पर्श", "g": "समास (बहुव्रीहि), तृतीया, बहुवचन", "p": [["वज्र", "वज्र"], ["अशनि", "बिजली"], ["सम", "समान"], ["स्पर्शैः", "स्पर्शवाले"]]}, "पावकैरिव": {"en": "as if by fires", "hi": "मानो अग्नियोंसे", "r": "पावक + इव", "g": "संधि: पावकैः + इव", "p": [["पावकैः", "अग्नियोंसे"], ["इव", "मानो"]]}, "शोभिते": {"en": "made beautiful, adorned", "hi": "शोभित (आकाश)में", "r": "शुभ्", "g": "णिजन्त, क्त (भूतकृदन्त), सप्तमी, एकवचन"}, "कृतपुण्यैर्महाभागैः": {"en": "by the highly blessed who had done meritorious deeds", "hi": "पुण्यकर्म करनेवाले महाभाग्यशालियोंसे", "r": "कृत + पुण्य + महत् + भाग", "g": "संधि: कृतपुण्यैः + महाभागैः", "p": [["कृतपुण्यैः", "पुण्य कर चुकनेवालोंसे"], ["महाभागैः", "महाभाग्यशालियोंसे"]]}, "स्वर्गजिद्भिरधिष्ठिते": {"en": "occupied by those who have won heaven", "hi": "स्वर्गको जीतनेवालोंसे अधिष्ठित (आकाश)में", "r": "स्वर्ग + जि + अधि + स्था", "g": "संधि: स्वर्गजिद्भिः + अधिष्ठिते", "p": [["स्वर्गजिद्भिः", "स्वर्ग जीतनेवालोंसे"], ["अधिष्ठिते", "बसे हुए (आकाश)में"]]}, "वहता": {"en": "(by him) carrying", "hi": "वहन करते हुए (अग्नि)से", "r": "वह्", "g": "शतृ (वर्तमान कृदन्त), तृतीया, एकवचन"}, "हव्यमत्यन्तं": {"en": "the oblations, unceasingly", "hi": "हविष्यको, निरन्तर (अत्यधिक)", "r": "हव्य + अत्यन्त", "g": "संधि: हव्यम् + अत्यन्तम्", "p": [["हव्यम्", "हविष्य, आहुति"], ["अत्यन्तम्", "अत्यधिक, निरन्तर"]]}, "चित्रभानुना": {"en": "by Fire (the god Agni)", "hi": "अग्निदेवसे", "r": "चित्रभानु", "g": "तृतीया, एकवचन"}, "ग्रहनक्षत्रचन्द्रार्कतारागणविभूषिते": {"en": "adorned with the planets, constellations, moon, sun and hosts of stars", "hi": "ग्रह, नक्षत्र, चन्द्रमा, सूर्य और तारागणोंसे विभूषित (आकाश)में", "r": "ग्रह + नक्षत्र + चन्द्र + अर्क + तारा + गण + वि + भूष्", "g": "समास (तृतीया तत्पुरुष), सप्तमी, एकवचन", "p": [["ग्रह", "ग्रह"], ["नक्षत्र", "नक्षत्र"], ["चन्द्र", "चन्द्रमा"], ["अर्क", "सूर्य"], ["तारागण", "तारोंके समूह"], ["विभूषिते", "सुशोभित (आकाश)में"]]}, "महर्षिगणगन्धर्वनागयक्षसमाकुले": {"en": "thronged with hosts of great sages, Gandharvas, Nāgas and Yakṣas", "hi": "महर्षियोंके समूह, गन्धर्व, नाग और यक्षोंसे भरे (आकाश)में", "r": "महर्षि + गण + गन्धर्व + नाग + यक्ष + समाकुल", "g": "समास (तृतीया तत्पुरुष), सप्तमी, एकवचन", "p": [["महर्षिगण", "महर्षियोंके समूह"], ["गन्धर्व", "गन्धर्व (देवगायक)"], ["नाग", "नाग"], ["यक्ष", "यक्ष"], ["समाकुले", "भरे हुए (आकाश)में"]]}, "विविक्ते": {"en": "secluded, clear", "hi": "एकान्त (आकाश)में", "r": "विविक्त", "g": "सप्तमी, एकवचन"}, "विमले": {"en": "spotless, clear", "hi": "निर्मल (आकाश)में", "r": "विमल", "g": "सप्तमी, एकवचन"}, "विश्वावसुनिषेविते": {"en": "frequented by Viśvāvasu (king of the Gandharvas)", "hi": "गन्धर्वराज विश्वावसुसे सेवित (आकाश)में", "r": "विश्वावसु + नि + सेव्", "g": "समास (तृतीया तत्पुरुष), सप्तमी, एकवचन", "p": [["विश्वावसु", "विश्वावसु (गन्धर्वराज)से"], ["निषेविते", "सेवित (आकाश)में"]]}, "देवराजगजाक्रान्ते": {"en": "trodden by the elephant of the king of gods (Indra's Airāvata)", "hi": "देवराज इन्द्रके हाथी (ऐरावत)से विचरित (आकाश)में", "r": "देवराज + गज + आ + क्रम्", "g": "समास (तृतीया तत्पुरुष), सप्तमी, एकवचन", "p": [["देवराज", "देवराज इन्द्र"], ["गज", "हाथी"], ["आक्रान्ते", "विचरित, जहाँ चला गया हो, उस (आकाश)में"]]}, "चन्द्रसूर्यपथे": {"en": "on the path of the moon and the sun", "hi": "चन्द्रमा और सूर्यके मार्गमें", "r": "चन्द्र + सूर्य + पथ", "g": "समास (द्वन्द्वगर्भ षष्ठी तत्पुरुष), सप्तमी, एकवचन", "p": [["चन्द्र", "चन्द्रमा"], ["सूर्य", "सूर्य"], ["पथे", "मार्गमें"]]}, "शिवे": {"en": "auspicious", "hi": "मंगलमय (आकाश)में", "r": "शिव", "g": "सप्तमी, एकवचन"}, "विताने": {"en": "on the canopy", "hi": "चँदोवे (वितान)में", "r": "वितान", "g": "सप्तमी, एकवचन"}, "जीवलोकस्य": {"en": "of the world of living beings", "hi": "प्राणिजगत्‌के", "r": "जीव + लोक", "g": "समास (षष्ठी तत्पुरुष), षष्ठी, एकवचन", "p": [["जीव", "प्राणी"], ["लोकस्य", "लोकके"]]}, "वितते": {"en": "spread wide", "hi": "विस्तृत (आकाश)में", "r": "वि + तन्", "g": "क्त (भूतकृदन्त), सप्तमी, एकवचन"}, "ब्रह्मनिर्मिते": {"en": "made by Brahmā", "hi": "ब्रह्माजीके बनाये हुए (आकाश)में", "r": "ब्रह्मन् + निर् + मा", "g": "समास (तृतीया तत्पुरुष), सप्तमी, एकवचन", "p": [["ब्रह्म", "ब्रह्माजीद्वारा"], ["निर्मिते", "बनाये हुए (आकाश)में"]]}, "बहुशः": {"en": "in many ways, much", "hi": "बहुत प्रकारसे, बहुधा", "r": "बहु", "g": "अव्यय (शस् प्रत्यय)"}, "वीरैर्विद्याधरगणैर्वृते": {"en": "surrounded by heroic hosts of Vidyādharas (celestial beings)", "hi": "वीर विद्याधरगणोंसे घिरे (आकाश)में", "r": "वीर + विद्याधर + गण + वृ", "g": "संधि: वीरैः + विद्याधरगणैः + वृते", "p": [["वीरैः", "वीरोंसे"], ["विद्याधरगणैः", "विद्याधरोंके समूहोंसे"], ["वृते", "घिरे हुए (आकाश)में"]]}, "गरुत्मानिव": {"en": "like Garuḍa", "hi": "गरुड़की भाँति", "r": "गरुत्मत् + इव", "g": "संधि: गरुत्मान् + इव", "p": [["गरुत्मान्", "गरुड़"], ["इव", "की भाँति"]]}, "प्राकर्षन्": {"en": "drawing (dragging) along", "hi": "खींचते हुए", "r": "प्र + आ + कृष्", "g": "शतृ (वर्तमान कृदन्त), प्रथमा, एकवचन"}, "कालागुरुसवर्णानि": {"en": "of the colour of black aloe-wood", "hi": "काले अगुरुके समान रंगवाले", "r": "कालागुरु + सवर्ण", "g": "समास (बहुव्रीहि), द्वितीया, बहुवचन, नपुंसक", "p": [["कालागुरु", "काला अगुरु (सुगन्धित काष्ठ)"], ["सवर्णानि", "समान रंगवाले"]]}, "रक्तपीतसितानि": {"en": "red, yellow and white", "hi": "लाल, पीले और सफेद", "r": "रक्त + पीत + सित", "g": "समास (द्वन्द्व), द्वितीया, बहुवचन, नपुंसक", "p": [["रक्त", "लाल"], ["पीत", "पीले"], ["सितानि", "सफेद"]]}, "कृष्यमाणानि": {"en": "being drawn along", "hi": "खींचे जाते हुए", "r": "कृष्", "g": "कर्मणि शानच्, प्रथमा, बहुवचन, नपुंसक"}, "प्रावृषीन्दुरिवाभाति": {"en": "shines like the moon in the rainy season", "hi": "वर्षा-ऋतुमें चन्द्रमाकी भाँति शोभा पाता है", "r": "प्रावृष् + इन्दु + इव + आ + भा", "g": "संधि: प्रावृषि + इन्दुः + इव + आभाति", "p": [["प्रावृषि", "वर्षा-ऋतुमें"], ["इन्दुः", "चन्द्रमा"], ["इव", "की भाँति"], ["आभाति", "प्रकाशित होता है"]]}, "निष्पतन्": {"en": "coming out", "hi": "निकलते हुए", "r": "निस् + पत्", "g": "शतृ (वर्तमान कृदन्त), प्रथमा, एकवचन"}, "प्रविशंस्तदा": {"en": "entering, then", "hi": "तब प्रवेश करते हुए", "r": "प्र + विश् + तदा", "g": "संधि: प्रविशन् + तदा", "p": [["प्रविशन्", "प्रवेश करते हुए"], ["तदा", "तब"]]}, "प्रदृश्यमानः": {"en": "being seen, appearing", "hi": "दिखायी देते हुए", "r": "प्र + दृश्", "g": "कर्मणि शानच्, प्रथमा, एकवचन"}, "भेजेऽम्बरं": {"en": "kept to (moved through) the sky", "hi": "आकाशका आश्रय लिया (आकाशमें चलते रहे)", "r": "भ