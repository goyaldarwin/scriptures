कवचन"}, "नखैस्तीक्ष्णैर्मर्माण्युत्कृत्य": {"en": "having torn out the vital parts with sharp nails", "hi": "तीखे नखोंसे मर्मस्थानोंको फाड़कर", "r": "नख + तीक्ष्ण + मर्मन् + उद् + कृत्", "g": "संधि: नखैः + तीक्ष्णैः + मर्माणि + उत्कृत्य", "p": [["नखैः", "नखोंसे"], ["तीक्ष्णैः", "तीखे"], ["मर्माणि", "मर्मस्थानोंको"], ["उत्कृत्य", "फाड़कर"]]}, "मनःसम्पातविक्रमः": {"en": "with the speed of the rush of thought", "hi": "मनके वेगके समान वेगवाले", "r": "मनस् + सम्पात + विक्रम", "g": "समास (बहुव्रीहि), प्रथमा, एकवचन", "p": [["मनः", "मन"], ["सम्पात", "वेगसे दौड़ना"], ["विक्रमः", "गति, पराक्रमवाले"]]}, "दिष्ट्या": {"en": "by good fortune", "hi": "सौभाग्यसे", "r": "दिष्टि", "g": "तृतीया, एकवचन (अव्ययवत्)"}, "दाक्षिण्येन": {"en": "with skill (dexterity)", "hi": "कुशलतासे", "r": "दाक्षिण्य", "g": "तृतीया, एकवचन"}, "निपात्य": {"en": "having struck down", "hi": "मार गिराकर", "r": "नि + पत्", "g": "णिजन्त, ल्यप् (पूर्वकालिक)"}, "कपिप्रवीरो": {"en": "the foremost hero among monkeys", "hi": "वानरवीरोंमें श्रेष्ठ", "r": "कपि + प्रवीर", "g": "समास (षष्ठी तत्पुरुष), प्रथमा, एकवचन (कपिप्रवीरः)", "p": [["कपि", "वानरोंमें"], ["प्रवीरः", "श्रेष्ठ वीर"]]}, "पुनरात्मवान्": {"en": "again ... the self-possessed one", "hi": "फिर ... धीर (आत्मवान्)", "r": "पुनर् + आत्मवत्", "g": "संधि: पुनः + आत्मवान्", "p": [["पुनः", "फिर"], ["आत्मवान्", "धीर, मनस्वी"]]}, "हृतहृत्सा": {"en": "she, whose heart was torn out", "hi": "जिसका हृदय निकाल लिया गया था, वह", "r": "हृ + हृद् + तद्", "g": "संधि: हृतहृत् + सा", "p": [["हृतहृत्", "जिसका हृदय निकाल लिया गया"], ["सा", "वह"]]}, "पपात": {"en": "fell", "hi": "गिर पड़ा / गिर पड़ी", "r": "पत्", "g": "लिट्, प्रथम पुरुष, एकवचन"}, "विधुराम्भसि": {"en": "(she,) stricken, into the water", "hi": "व्याकुल (होकर) जलमें", "r": "विधुर + अम्भस्", "g": "संधि: विधुरा + अम्भसि", "p": [["विधुरा", "व्याकुल, विपन्न"], ["अम्भसि", "जलमें"]]}, "स्वयम्भुवैव": {"en": "by the Self-born (Brahmā) himself", "hi": "स्वयम्भू ब्रह्माजीद्वारा ही", "r": "स्वयम्भू + एव", "g": "संधि: स्वयम्भुवा + ए