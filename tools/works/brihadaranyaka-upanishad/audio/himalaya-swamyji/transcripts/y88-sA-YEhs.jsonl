{"chunk": 0, "s": 0.0, "e": 7.34, "t": " भद़ारिन्यखो पनिषडि मदूकानदे वित्यो दियायाजा", "w": []}
{"chunk": 0, "s": 7.34, "e": 15.32, "t": " आतध वित्या दियायस्या एजातशित्रुनाम प्रथम ब्राम्हनम", "w": []}
{"chunk": 0, "s": 15.32, "e": 25.46, "t": " वो म्द्रिप्तबाला किया अनुचानोगार कियासा साहु वाचा", "w": []}
{"chunk": 0, "s": 25.46, "e": 30.58, "t": " आजातशत्रम, काश्यम, ब्रम्हते ब्रवानि इती", "w": []}
{"chunk": 0, "s": 30.58, "e": 38.3, "t": " सहो वाच, आजातशत्रू, सहस्रम ये तस्या, वाचि दद्मो,", "w": []}
{"chunk": 0, "s": 38.3, "e": 43.3, "t": " जन को जन कह इती वेई, जन अधावन ती ती", "w": []}
{"chunk": 0, "s": 43.3, "e": 49.9, "t": " सहो वाच, गार यो यह एव, असव आदिते पुभ्शध,", "w": []}
{"chunk": 0, "s": 79.9, "e": 86.98, "t": " वूश्या ब्हुबति सबूवाचा दार क्यो यजेव असवुच्चन्ध्रे", "w": []}
{"chunk": 0, "s": 86.98, "e": 91.9, "t": " वूश्या एतम एव आहम ब्रम्हाव पासे इते", "w": []}
{"chunk": 0, "s": 91.9, "e": 98.9, "t": " सबूवाचा अजात शत्रू मा मा एतस्मिन सम्वदिष्टा", "w": []}
{"chunk": 0, "s": 98.9, "e": 107.9, "t": " प्रुहन पांदर वासा शोमो राजा इतिव आहम एतम पासे इते", "w": []}
{"chunk": 0, "s": 107.9, "e": 124.9, "t": " ये तम ये वंब पास्ते आहा आहा आहा आहा सुता, प्रास्तो भवते, नास्य अन्नम्ख्षीयते, सहो वाचा गार्ग्यो, ये ये व असव विद्युति पुरुश़,", "w": []}
{"chunk": 0, "s": 124.9, "e": 129.02, "t": " ए्दं येव आहं प्रमहु पास सेती", "w": []}
{"chunk": 0, "s": 129.02, "e": 131.98, "t": " सहो वाझ अजात सित्र हु", "w": []}
{"chunk": 0, "s": 131.98, "e": 136.3, "t": " मा आहेट अस्मिन संव भथिष्टा लग", "w": []}
{"chunk": 0, "s": 136.3, "e": 140.5, "t": " देजस्वी तिव आहं एदं भृास सेती", "w": []}
{"chunk": 0, "s": 140.5, "e": 144.14, "t": " सायाह एदं येव वं बु वास्ते", "w": []}
{"chunk": 0, "s": 144.14, "e": 146.5, "t": " तेजस्षी हभवती", "w": []}
{"chunk": 0, "s": 146.5, "e": 150.22, "t": " तेजस्भनी हऊस्य प्रजअ भवती", "w": []}
{"chunk": 0, "s": 150.22, "e": 156.22, "t": " श़ोवाच अगार ग्यो, यहा एव आयम आखाशे पूरुश़,", "w": []}
{"chunk": 0, "s": 156.22, "e": 160.22, "t": " एपम येव आहम ब्रम्ह उपासते,", "w": []}
{"chunk": 0, "s": 160.22, "e": 163.22, "t": " श़ोवाच आजात शेट्रू,", "w": []}
{"chunk": 0, "s": 163.22, "e": 168.22, "t": " मा आएपस्मिन सम्भदिष्टा,", "w": []}
{"chunk": 0, "s": 168.22, "e": 171.22, "t": " पूर्नम अप्रवर्त्ति दिवा,", "w": []}
{"chunk": 0, "s": 171.22, "e": 174.22, "t": " आहम एपम उपासते,", "w": []}
{"chunk": 0, "s": 174.22, "e": 178.22, "t": " सायाह एपम एवम उपासते,", "w": []}
{"chunk": 0, "s": 178.22, "e": 187.22, "t": " वूर्यते प्रजया पशुभिधि नास्य अस्मात लोकात प्रजोद वर्ध्तें", "w": []}
{"chunk": 0, "s": 187.22, "e": 193.22, "t": " सहोवाच गर्ज्यो या एव आयम भायो पुरुशा", "w": []}
{"chunk": 0, "s": 193.22, "e": 197.22, "t": " एतम एव आहम ब्रम हुपास अइतें", "w": []}
{"chunk": 0, "s": 197.22, "e": 204.22, "t": " सहोवाच अजात शत्रू मा आए तस्मिन समभदिष्टा", "w": []}
{"chunk": 0, "s": 204.22, "e": 210.22, "t": " इंद्रो वाईखुंतो अपराजिता साना इतिव वा", "w": []}
{"chunk": 0, "s": 210.22, "e": 217.22, "t": " आहम एतं बूपासश एति सा यह एतं ये वंबूपास्ते", "w": []}
{"chunk": 0, "s": 217.22, "e": 222.22, "t": " जिष्न हू अपरा जिष्न हू भवते अन्यता हा", "w": []}
{"chunk": 0, "s": 222.22, "e": 229.22, "t": " टिए जाया जाया टिजाया टिजायी साहो वाचा डार्व्यो", "w": []}
{"chunk": 0, "s": 229.22, "e": 236.02, "t": " यह एवम आयम अग्नोव पूरुश़, येटम येव, आहम ब्रम्ह, उपास इति,", "w": []}
{"chunk": 0, "s": 236.02, "e": 243.82, "t": " सहो भाजः, आजात श्ट्रू, मा, मा, एटस्मिन समभदिष्टा,", "w": []}
{"chunk": 0, "s": 243.82, "e": 249.42, "t": " विश्या सहीथि, वा, आहम येटम उपास इति,", "w": []}
{"chunk": 0, "s": 249.42, "e": 253.62, "t": " साया एटम येवम उपास दे,", "w": []}
{"chunk": 0, "s": 253.62, "e": 257.22, "t": " विशा सहिर लिए भवते", "w": []}
{"chunk": 0, "s": 257.22, "e": 260.72, "t": " विशा सहिर लिए श्यप पजा भवते", "w": []}
{"chunk": 0, "s": 260.72, "e": 263.02, "t": " सहोवाच़ आर्जो", "w": []}
{"chunk": 0, "s": 263.02, "e": 266.14, "t": " यह एव आयम अप्सु पुरुश़", "w": []}
{"chunk": 0, "s": 266.14, "e": 269.62, "t": " एपम एव आहम ब्रम्हुपास इति", "w": []}
{"chunk": 0, "s": 269.62, "e": 272.62, "t": " सहोवाच़ अजातशे त्रूू", "w": []}
{"chunk": 0, "s": 272.62, "e": 276.62, "t": " मा मा एपस्मिन सम्बदिष्ता", "w": []}
{"chunk": 0, "s": 276.62, "e": 278.92, "t": " प्रति रूपा इतिवा", "w": []}
{"chunk": 0, "s": 278.92, "e": 281.92, "t": " आजम एपम वूपास इती", "w": []}
{"chunk": 0, "s": 281.92, "e": 284.92, "t": " सै एपम एव वूपास दे", "w": []}
{"chunk": 0, "s": 284.92, "e": 288.92, "t": " प्रतिरूपगम हैव एनम वूपगच्च्टी", "w": []}
{"chunk": 0, "s": 288.92, "e": 291.92, "t": " न अप प्रतिरूपम अथो प्रतिरूपगम", "w": []}
{"chunk": 0, "s": 291.92, "e": 294.92, "t": " अस्मात जायते", "w": []}
{"chunk": 0, "s": 294.92, "e": 296.92, "t": " सहोवाच गर्जो", "w": []}
{"chunk": 0, "s": 296.92, "e": 299.92, "t": " यहा एव आयम आदर्षे", "w": []}
{"chunk": 0, "s": 329.92, "e": 351.92, "t": " वत्टान देडे थ्टे, सववा जगरद्यो, यधयेव आयम यंतं पच्चात श्व्दो अनुगती येधम य वाहम ब्रमो पास यती, सववाज अजात शित्रु, मा मा एध स्मिं सम भो दिष्ता,", "w": []}
{"chunk": 0, "s": 351.92, "e": 356.12, "t": " आशु हु इतिवा आहम एदम वुपास अगिति", "w": []}
{"chunk": 0, "s": 356.12, "e": 359.92, "t": " साया हेदम एवम वुपास दे", "w": []}
{"chunk": 0, "s": 359.92, "e": 364.92, "t": " सर्वगम हैवा अस्मिन लोख कह आयु लेति", "w": []}
{"chunk": 0, "s": 364.92, "e": 369.92, "t": " नये नम पूरा खालात प्रानो जहाति", "w": []}
{"chunk": 0, "s": 369.92, "e": 375.92, "t": " साहा अवाच गर्गय एवा आयम दिख्षु पूरुषध", "w": []}
{"chunk": 0, "s": 375.92, "e": 379.64, "t": " एटम येवा आँब्रम्हवाँ सथिते", "w": []}
{"chunk": 0, "s": 379.64, "e": 382.64, "t": " सहोवाज आजात शेट्रू", "w": []}
{"chunk": 0, "s": 382.64, "e": 387.44, "t": " मा मा एटस्मिन सम्भदिष्टा दितिया", "w": []}
{"chunk": 0, "s": 387.44, "e": 391.92, "t": " आनपगा इतिवा आँम एटम वुपासथिते", "w": []}
{"chunk": 0, "s": 391.92, "e": 395.64, "t": " साया हे टम येवाम वुपास्ते", "w": []}
{"chunk": 0, "s": 395.64, "e": 398.44, "t": " वीतिया वान भवते", "w": []}
{"chunk": 0, "s": 398.44, "e": 401.52, "t": " ना आस्मद गनश्चित्यते", "w": []}
{"chunk": 0, "s": 401.52, "e": 407.52, "t": " सहोवाजगार्यो, यए येव आयम चाया मयव पूरुशा,", "w": []}
{"chunk": 0, "s": 407.52, "e": 411.52, "t": " येटम येव आहम ब्रम्हो पासएते,", "w": []}
{"chunk": 0, "s": 411.52, "e": 414.52, "t": " सहोवाजआयात शिट्रू,", "w": []}
{"chunk": 0, "s": 414.52, "e": 418.52, "t": " मा, मा एटस्मिन समबरिष्टा,", "w": []}
{"chunk": 0, "s": 418.52, "e": 420.52, "t": " मुथ्यो हुई तिवा,", "w": []}
{"chunk": 0, "s": 420.52, "e": 423.52, "t": " आहम येटम बासएते,", "w": []}
{"chunk": 0, "s": 423.52, "e": 426.52, "t": " साया एटम येव बुपास्ते,", "w": []}
{"chunk": 0, "s": 426.52, "e": 431.52, "t": " सर्वगम हैव आस्मिन लोग कह आयू हेती", "w": []}
{"chunk": 0, "s": 431.52, "e": 436.52, "t": " नैनं पुरा कालान बुत्यो आगच्चती", "w": []}
{"chunk": 0, "s": 436.52, "e": 441.52, "t": " सहोवा चगार्जो यहा एव आयम आत्मनी पुरुशा", "w": []}
{"chunk": 0, "s": 441.52, "e": 444.52, "t": " एतम एव आहम ब्रम हुपासइती", "w": []}
{"chunk": 0, "s": 444.52, "e": 448.52, "t": " सहोवा जाजात शित्रू हु", "w": []}
{"chunk": 0, "s": 448.52, "e": 452.52, "t": " मा मा एतस्मिन सम्भदिष्टा", "w": []}
{"chunk": 0, "s": 452.52, "e": 456.78, "t": " आत्मन वी इदिवा आहम ये तम्बूपास दिं", "w": []}
{"chunk": 0, "s": 456.78, "e": 460.34, "t": " सायगये तम्ये वंभूपासते", "w": []}
{"chunk": 0, "s": 460.34, "e": 462.64, "t": " आत्मन वी भभवदि", "w": []}
{"chunk": 0, "s": 462.64, "e": 466.46, "t": " आत्मन विनियास्यप्रजा भवदी", "w": []}
{"chunk": 0, "s": 466.46, "e": 470.36, "t": " साहातुष्नीम आसा गार्ख्यायम", "w": []}
{"chunk": 0, "s": 470.36, "e": 473.32, "t": " सहोवाज आजात्शित्रू", "w": []}
{"chunk": 0, "s": 473.32, "e": 478.62, "t": " ये ता वन्नूइ दि", "w": []}
{"chunk": 0, "s": 478.62, "e": 481.16, "t": " ये ता वतिई दिए दि", "w": []}
{"chunk": 0, "s": 481.16, "e": 484.82, "t": " नएता वता विदितं भवति इति", "w": []}
{"chunk": 0, "s": 484.82, "e": 487.48, "t": " सहोवाच जगार क्या है", "w": []}
{"chunk": 0, "s": 487.48, "e": 490.38, "t": " वुपः त्रायानि इति", "w": []}
{"chunk": 0, "s": 490.38, "e": 493.46, "t": " सहोवाच अजात चेट्रू", "w": []}
{"chunk": 0, "s": 493.46, "e": 497.36, "t": " प्रतिलोमम चएत यप ब्राम्हन", "w": []}
{"chunk": 0, "s": 497.36, "e": 501.16, "t": " क्षत्रियम उपेयात ब्रम्हम में", "w": []}
{"chunk": 0, "s": 501.16, "e": 502.82, "t": " वक्ष्यति इति", "w": []}
{"chunk": 0, "s": 502.82, "e": 507.36, "t": " विए वत्वा न्पःिश्या मि इति", "w": []}
{"chunk": 0, "s": 507.36, "e": 532.36, "t": " तंपानव आदाय वुत्तस्तो, तूह पुरुशगम सुप्तम आजक्मतू, तंबे तैहि नामभि, आमन्त्रयान चक्रे, बूहन पान्दर भासठ, सोमह राजन इदे, सानोद्तस्तो, तंपानिना अपेशम,", "w": []}
{"chunk": 0, "s": 532.36, "e": 537.16, "t": " बोद्यान चक्धार सावतस्तो", "w": []}
{"chunk": 0, "s": 537.16, "e": 539.96, "t": " सजोवाच आजात सेट्रो", "w": []}
{"chunk": 0, "s": 539.96, "e": 544.0, "t": " यत्र एश़ येटद शुप्तो अबहुद", "w": []}
{"chunk": 0, "s": 544.0, "e": 547.76, "t": " यह एशविज्यानम यएप पुरुशज़", "w": []}
{"chunk": 0, "s": 547.76, "e": 551.04, "t": " क्वाएश़ तदा अबहुद", "w": []}
{"chunk": 0, "s": 551.04, "e": 554.48, "t": " कोत येटद आगात इदेएज़", "w": []}
{"chunk": 0, "s": 554.48, "e": 557.68, "t": " तदूवन मेंने यार्गे है", "w": []}
{"chunk": 0, "s": 557.68, "e": 565.0, "t": " वाजास्वाच आजात्शेत्रू । यत्र एशज एतशुप्तो अबूथ", "w": []}
{"chunk": 0, "s": 565.0, "e": 569.66, "t": " यएश विच्च्चचनम यप पूभषभ ।", "w": []}
{"chunk": 0, "s": 569.66, "e": 574.96, "t": " तद एशम प्रनानाम विच्च्चनानेन भिच्च्चनम आदाया", "w": []}
{"chunk": 0, "s": 574.96, "e": 579.96, "t": " या येशो अंतर रूधय आखाच़ा", "w": []}
{"chunk": 0, "s": 579.96, "e": 584.96, "t": " तस्मिन चेत तान येदा गरुनाति", "w": []}
{"chunk": 0, "s": 584.96, "e": 588.96, "t": " आथा आये तख फुरुषवस्ववितिनामा", "w": []}
{"chunk": 0, "s": 588.96, "e": 592.96, "t": " तख रिही तए वप्प्रानो भबति", "w": []}
{"chunk": 0, "s": 592.96, "e": 597.96, "t": " ग्रही ता वाख, ग्रही तम चक्षूब", "w": []}
{"chunk": 0, "s": 597.96, "e": 599.96, "t": " ग्रही तगम श्रोट्ध्रा", "w": []}
{"chunk": 1, "s": 630.0, "e": 634.16, "t": " ये वजेश ये तत प्रानान भ्रिहित्वा", "w": []}
{"chunk": 1, "s": 634.16, "e": 638.84, "t": " श्वे शरीरे ये ठाका मं परिवर्तते", "w": []}
{"chunk": 1, "s": 638.84, "e": 642.44, "t": " आथा यदा शुषुप्तो भ्हवते", "w": []}
{"chunk": 1, "s": 642.44, "e": 645.08, "t": " यदा नकस्यचन वेदा", "w": []}
{"chunk": 1, "s": 645.08, "e": 647.64, "t": " लिताना मनाद्या है", "w": []}
{"chunk": 1, "s": 647.64, "e": 650.44, "t": " द्वा सबतति ही सहस्रान", "w": []}
{"chunk": 1, "s": 650.44, "e": 652.84, "t": " रुदयात पुरी ततम", "w": []}
{"chunk": 1, "s": 652.84, "e": 654.96, "t": " अभी प्रतिष्चनते", "w": []}
{"chunk": 1, "s": 654.96, "e": 660.76, "t": " ताभिभि प्रत्यवस्रुप्या भूरीतती शेते", "w": []}
{"chunk": 1, "s": 660.76, "e": 666.78, "t": " सयता कुमारोवा महाराजोवा महाब्राम्हनोवा", "w": []}
{"chunk": 1, "s": 666.78, "e": 672.12, "t": " अतिक्निम अनंद अनंदस्या गत्वा शएता", "w": []}
{"chunk": 1, "s": 672.12, "e": 676.56, "t": " येवम येवयेश एत शेते", "w": []}
{"chunk": 1, "s": 676.56, "e": 681.48, "t": " सयता और नाभि कन्तून उच्चरे", "w": []}
{"chunk": 1, "s": 741.48, "e": 747.72, "t": " नद्थिः आयम वाव शिष्टू योयम मज्यम of प्राना", "w": []}
