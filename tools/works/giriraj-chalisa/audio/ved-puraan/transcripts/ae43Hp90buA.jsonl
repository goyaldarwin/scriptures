{"chunk": 0, "s": 0.0, "e": 5.0, "t": " बन्द हुवीना वादिनी", "w": []}
{"chunk": 0, "s": 5.0, "e": 10.0, "t": " द़री गन पत्ति को द्यान वादिनी", "w": []}
{"chunk": 0, "s": 30.0, "e": 42.0, "t": " वाईशक्ति रादा सहित, ख्रिष्न करो कल्यान,", "w": []}
{"chunk": 0, "s": 42.0, "e": 50.0, "t": " सुमिरन करी सब देव गनकुरू, पिटु बारम बार,", "w": []}
{"chunk": 0, "s": 50.0, "e": 58.0, "t": " बरनो स्यीगी री राज याशनिज मति के अनुसार,", "w": []}
{"chunk": 0, "s": 58.0, "e": 62.16, "t": " जेहो जग बन्दित गिरी राजा", "w": []}
{"chunk": 0, "s": 62.16, "e": 65.8, "t": " पज्मन्दल के श्री महाराजा", "w": []}
{"chunk": 0, "s": 65.8, "e": 69.4, "t": " दिशनु रूप तुम हो अवतारी", "w": []}
{"chunk": 0, "s": 69.4, "e": 73.0, "t": " सुन्दर तापे जग भलिहारी", "w": []}
{"chunk": 0, "s": 73.0, "e": 76.6, "t": " स्वर्न शिक्धर अतिशो भापावे", "w": []}
