{"chunk": 0, "s": 0.0, "e": 11.0, "t": " देवि पूजितनर मदाए", "w": []}
{"chunk": 0, "s": 11.0, "e": 16.0, "t": " महिमा बडी आपार", "w": []}
{"chunk": 0, "s": 16.0, "e": 21.0, "t": " चाली सावरन करत", "w": []}
{"chunk": 0, "s": 21.0, "e": 26.0, "t": " कवियर उ भख्त उदार", "w": []}
{"chunk": 0, "s": 60.0, "e": 62.0, "t": " वाश्वनि माग्मास वतारा", "w": []}
{"chunk": 0, "s": 62.0, "e": 65.0, "t": " बाहन मकर आप को साजैं", "w": []}
{"chunk": 0, "s": 65.0, "e": 68.0, "t": " कमल पूष्प पर आप विराजैं", "w": []}
{"chunk": 0, "s": 68.0, "e": 70.0, "t": " द्रम्हा हरी हर तुम को द्यावैं", "w": []}
{"chunk": 0, "s": 70.0, "e": 73.0, "t": " तबही मनवाशित फल पावैं", "w": []}
{"chunk": 0, "s": 73.0, "e": 75.0, "t": " करषन करत पाप कटी जाते", "w": []}
{"chunk": 0, "s": 75.0, "e": 78.0, "t": " कोटी बखत गन नित्यन आठें", "w": []}
{"chunk": 0, "s": 78.0, "e": 80.0, "t": " जो नर तुम पावाश्वनि", "w": []}
{"chunk": 0, "s": 80.0, "e": 85.0, "t": " तब आप कटी जाते, पोटी भक्त गडन नित्या नहाते", "w": []}
{"chunk": 0, "s": 85.0, "e": 92.0, "t": " जोनर तुम को नित ही जावे, वो हनर लोट लोग को जावे", "w": []}
{"chunk": 0, "s": 92.0, "e": 98.0, "t": " मगर मच्छा तुम में सुख पावै, अन्तिम सवाय पर्मपद पावै", "w": []}
{"chunk": 0, "s": 98.0, "e": 104.0, "t": " मस्तक्म कुत सदाही साजाई, पावा पैंजे नीन तही राजै", "w": []}
{"chunk": 0, "s": 104.0, "e": 107.0, "t": " पाब पेंजनी नितही राजें", "w": []}
{"chunk": 0, "s": 107.0, "e": 112.0, "t": " कल, कल, भन करती हो माता पापता पहरती हो", "w": []}
{"chunk": 0, "s": 112.0, "e": 115.0, "t": " माता पुरभ से पष्च्च्म की योरा", "w": []}
{"chunk": 0, "s": 115.0, "e": 118.0, "t": " बहती माता नाचत्मुरा", "w": []}
{"chunk": 0, "s": 118.0, "e": 121.0, "t": " शाँन करिष तुम्बरो गुडगावे", "w": []}
{"chunk": 0, "s": 121.0, "e": 123.0, "t": " सत आदी तुम्बरो यष्गावे", "w": []}
{"chunk": 0, "s": 123.0, "e": 126.0, "t": " शिव गनेश भी तेरे गुडगावे", "w": []}
{"chunk": 0, "s": 126.0, "e": 130.0, "t": " सकल देव गड़ तुम को द्यावे", "w": []}
{"chunk": 0, "s": 132.0, "e": 134.0, "t": " कोटी तीर था नम्दा किनारे", "w": []}
{"chunk": 0, "s": 134.0, "e": 137.0, "t": " ये सब कहलाते दुक हारे", "w": []}
{"chunk": 0, "s": 137.0, "e": 139.0, "t": " मनोक मना पुरन करती", "w": []}
{"chunk": 0, "s": 139.0, "e": 142.0, "t": " सरव दुक मानत ही हरती", "w": []}
{"chunk": 0, "s": 142.0, "e": 144.0, "t": " कनखल में गंगा की महिमा", "w": []}
{"chunk": 0, "s": 144.0, "e": 147.0, "t": " कुरक शेटर में सरस्वती महिमा", "w": []}
{"chunk": 0, "s": 147.0, "e": 150.0, "t": " पर नर्मदा ग्राम जंगल में", "w": []}
{"chunk": 0, "s": 150.0, "e": 153.0, "t": " नित रहती माता मंगल में", "w": []}
{"chunk": 0, "s": 156.0, "e": 158.0, "t": " तब प्रदी है नरनारा", "w": []}
{"chunk": 0, "s": 158.0, "e": 161.0, "t": " मैं कल कन्या तुम ही रेवा", "w": []}
{"chunk": 0, "s": 161.0, "e": 164.0, "t": " तुमहरी भजन कडे मित देवा", "w": []}
{"chunk": 0, "s": 166.0, "e": 169.0, "t": " जता शंकरी नाम तुमहारा", "w": []}
{"chunk": 0, "s": 169.0, "e": 171.0, "t": " तुमने को टिजनो को है तारा", "w": []}
{"chunk": 0, "s": 171.0, "e": 173.0, "t": " समोद भवा नर्मदा", "w": []}
{"chunk": 0, "s": 173.0, "e": 176.0, "t": " तुम हो पापमो चनी रेवा", "w": []}
{"chunk": 0, "s": 176.0, "e": 179.0, "t": " तुमहरी महिमा कही नहीं जाए", "w": []}
{"chunk": 0, "s": 179.0, "e": 182.0, "t": " करत نہ बनती मा तु वराई", "w": []}
{"chunk": 0, "s": 182.0, "e": 185.0, "t": " जल प्रताप तुम में अट्यमाता", "w": []}
{"chunk": 0, "s": 185.0, "e": 187.0, "t": " जो रमनी अतता सुख्डाता", "w": []}
{"chunk": 0, "s": 187.0, "e": 190.0, "t": " चालिसर पिनी समहे तुमहारी", "w": []}
{"chunk": 0, "s": 190.0, "e": 193.0, "t": " महिमा अथी अपार हे तुमहारी", "w": []}
{"chunk": 0, "s": 193.0, "e": 196.0, "t": " तुम में पडियस थी भी भारी", "w": []}
{"chunk": 0, "s": 196.0, "e": 198.0, "t": " चुवत पशान होत वरवारी", "w": []}
{"chunk": 0, "s": 198.0, "e": 201.0, "t": " यमना में जो मनुज नहाता", "w": []}
{"chunk": 0, "s": 201.0, "e": 205.16, "t": " सात्द दिनो में वोध्पाता", "w": []}
{"chunk": 0, "s": 206.16, "e": 209.16, "t": " सरस्वती तीन दिनो में देती", "w": []}
{"chunk": 0, "s": 209.16, "e": 211.84, "t": " गंगा तुरत्वाद ही देती", "w": []}
{"chunk": 0, "s": 211.84, "e": 214.48, "t": " पर डेवाखा दरषन करके", "w": []}
{"chunk": 0, "s": 214.48, "e": 217.2, "t": " मानव प्फाता मन बरके", "w": []}
{"chunk": 0, "s": 217.2, "e": 219.44, "t": " तुम्री मही माहे अतिभारी", "w": []}
{"chunk": 0, "s": 219.44, "e": 222.12, "t": " जिसको गाते है नरनारी", "w": []}
{"chunk": 0, "s": 222.12, "e": 224.8, "t": " जो नर तुम्में निक्तिनाहाता", "w": []}
{"chunk": 0, "s": 224.8, "e": 227.8, "t": " उद्र लोक में पूजा जाता", "w": []}
{"chunk": 0, "s": 227.8, "e": 230.8, "t": " जडी भूटिया तटपर राजी", "w": []}
{"chunk": 0, "s": 230.8, "e": 232.8, "t": " मुहक द्रिष्षदाही साजी", "w": []}
{"chunk": 0, "s": 232.8, "e": 235.8, "t": " वायु सुगन्दिख चलती तीरा", "w": []}
{"chunk": 0, "s": 235.8, "e": 238.8, "t": " जो हरती नरतन की पीरा", "w": []}
{"chunk": 0, "s": 240.8, "e": 243.8, "t": " गात गात की महिमा बारी", "w": []}
{"chunk": 0, "s": 243.8, "e": 246.8, "t": " कवि भी गा नहीं सकते सारी", "w": []}
{"chunk": 0, "s": 246.8, "e": 248.8, "t": " नहीं जानु मैं तुम्हरी पूजा", "w": []}
{"chunk": 0, "s": 248.8, "e": 251.46, "t": " अर सहरा नहीं मम्दूजा", "w": []}
{"chunk": 0, "s": 251.46, "e": 254.02, "t": " हो प्रसन उपर मम्माता", "w": []}
{"chunk": 0, "s": 254.02, "e": 256.72, "t": " तुम ही मात मोखष की दाता", "w": []}
{"chunk": 0, "s": 256.72, "e": 259.4, "t": " जो माना हु यह लिठ फ़दता", "w": []}
{"chunk": 0, "s": 259.4, "e": 262.1, "t": " उस कामान सदा ही बडटा", "w": []}
{"chunk": 0, "s": 262.1, "e": 264.64, "t": " जो शत्वारी से है गाता", "w": []}
{"chunk": 0, "s": 264.64, "e": 267.64, "t": " वह विट्या दन दोलत पाता", "w": []}
{"chunk": 0, "s": 267.64, "e": 270.4, "t": " अगनित बार पड़े जो कोई", "w": []}
{"chunk": 0, "s": 270.4, "e": 272.94, "t": " पूरन मनो कामना होई", "w": []}
{"chunk": 0, "s": 272.94, "e": 275.94, "t": " सब के उर में बसत नर्मदा", "w": []}
{"chunk": 0, "s": 275.94, "e": 278.94, "t": " यहा वह सर तक्र नर्मदा", "w": []}
{"chunk": 0, "s": 279.94, "e": 282.94, "t": " बब भी भा उरानी के", "w": []}
{"chunk": 0, "s": 282.94, "e": 284.94, "t": " एजो करता है", "w": []}
{"chunk": 0, "s": 284.94, "e": 287.94, "t": " जापर माता जी की रपा से", "w": []}
{"chunk": 0, "s": 287.94, "e": 290.94, "t": " दूर होत संथापर", "w": []}
