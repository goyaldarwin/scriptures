{"chunk": 0, "s": 453.4, "e": 458.64, "t": " ॐ krishulad marodhaari bhaktavarada sada", "w": []}
{"chunk": 0, "s": 458.64, "e": 465.64, "t": " ॐ sukha kari deshi lamukti cari aesai iba", "w": []}
{"chunk": 0, "s": 585.64, "e": 589.64, "t": " Siddhasdha vinam te gtama kpyapriyantam", "w": []}
