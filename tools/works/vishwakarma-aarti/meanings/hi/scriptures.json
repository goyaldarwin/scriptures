{
"order": 1,
"numbers": "verse",
"m": {
"aarti.tek": ["हे प्रभु श्री विश्वकर्माजी! घर पधारिये;", "हे प्रभु विश्वकर्माजी!"],
"aarti.pad1": ["आपने सुदामाकी विनती सुनी", "और सोनेके महल बना दिये।", "हे प्रभु! सब पदार्थ देकर", "आपने दुःखियोंके दुःख दूर किये।"],
"aarti.pad2": ["भगवान् कृष्णने विनती की —", "द्वारकापुरी बनाइये।", "आपने ग्वालबालोंकी रक्षा की", "और प्रभुकी लाज बचायी।"],
"aarti.pad3": ["श्रीरामचन्द्रजीने आपका पूजन किया;", "तब आपने सेतु बाँधकर रच डाला।", "आपने सारी सेनाको पार कराया", "और, हे प्रभु, लंकापर विजय दिलायी।"],
"aarti.pad4": ["श्रीकृष्णकी विजय सुनिये;", "हे प्रभु, आकर दर्शन दीजिये।", "शिल्पविद्याका प्रकाश दीजिये", "और मेरा जीवन सफल बना दीजिये।"]
}
}
