{"chunk": 0, "s": 30.0, "e": 52.0, "t": " इशावास्यो पनिषत्त, शान्ति मन्त्रह, रहि, और,", "w": []}
{"chunk": 0, "s": 52.0, "e": 67.0, "t": " पूर्ण मदध, पूर्ण मिदं, पूर्णात पूर्ण मुदच्यते,", "w": []}
{"chunk": 0, "s": 67.0, "e": 80.0, "t": " औूरनस्यपूरनमादायन औरनवेवावःषिष्टे", "w": []}
{"chunk": 0, "s": 80.0, "e": 92.0, "t": " औूम्शान्दिश्चान्दिश्चान्देः", "w": []}
{"chunk": 0, "s": 92.0, "e": 106.0, "t": " इशावास्यमिदम सरवं, यत किं सजगत्यां जगतं,", "w": []}
{"chunk": 0, "s": 106.0, "e": 118.0, "t": " तेन चक्तेन भंजी था, माग्र्दख् कस्यस्विठ्धनं,", "w": []}
{"chunk": 0, "s": 118.0, "e": 132.0, "t": " खुर्वन्ने वेह कर्मानी जिजी विषे च्थगुम समा", "w": []}
{"chunk": 0, "s": 132.0, "e": 145.0, "t": " एवन् तवाई नान्यते तोस्ती नकर्म लिप्यते नरे", "w": []}
{"chunk": 0, "s": 145.0, "e": 157.0, "t": " आसुर्या नाम देलोका अंध्छेनतम साव्र्ता", "w": []}
{"chunk": 0, "s": 157.0, "e": 163.0, "t": " तामस्ते प्रेत्या भे गछ्छन्ति", "w": []}
{"chunk": 0, "s": 163.0, "e": 169.0, "t": " ये के चात्महनो जना", "w": []}
{"chunk": 0, "s": 169.0, "e": 185.0, "t": " अने ज़े कम वन सो जवी यो ने नंते वापन वन पूर्वमर्षतर,", "w": []}
{"chunk": 0, "s": 185.0, "e": 193.0, "t": " तद्धावतों न्यान अख्ये तिष्खाए", "w": []}
{"chunk": 0, "s": 193.0, "e": 200.0, "t": " तस्मिन्न पोमा दर्ष्वाड़ाती", "w": []}
{"chunk": 0, "s": 200.0, "e": 207.0, "t": " तदे जती तन्ने जती", "w": []}
{"chunk": 0, "s": 207.0, "e": 212.0, "t": " तद्धूरे तद्पन्दिके", "w": []}
{"chunk": 0, "s": 212.0, "e": 225.0, "t": " तदंतरस्य सर्वस्य, तदू सर्वस्या स्यमाख्यतध,", "w": []}
{"chunk": 0, "s": 225.0, "e": 238.0, "t": " यस्तू सर्वानि भूतानि आत्मन्ये वानु पश्यति,", "w": []}
{"chunk": 0, "s": 238.0, "e": 250.0, "t": " सर्व भूते शुचात्मानम, ततो नविजु भूट्सते", "w": []}
{"chunk": 0, "s": 250.0, "e": 264.0, "t": " यस्मिन सर्वान भूटानी, आत्मेवा भूध्विजानतहा,", "w": []}
{"chunk": 0, "s": 264.0, "e": 276.0, "t": " तत्र को मोह कश्षो का, एक त्वा आनु पश्यत है,", "w": []}
{"chunk": 0, "s": 276.0, "e": 290.0, "t": " सपर्यगा चुक्रम, कायम, अप्रन, मस्नावी, रगम, सुत्धम, पाप, विध्धम,", "w": []}
{"chunk": 0, "s": 290.0, "e": 307.0, "t": " भविर मनीशी परिभू स्वयम हु याता तर्ध्धोल खान विददाद चाश्वती भ्यस्समाभ याध.", "w": []}
{"chunk": 0, "s": 307.0, "e": 318.0, "t": " अंदन्तमण्प्रविशन्ती भे विज्या हु पासते", "w": []}
{"chunk": 0, "s": 318.0, "e": 330.0, "t": " ततबहुया इवते तमों या उ विज्याया वूभ्रका", "w": []}
{"chunk": 0, "s": 330.0, "e": 342.0, "t": " अन्यदेवाहुर मिद्याया", "w": []}
{"chunk": 0, "s": 342.0, "e": 348.0, "t": " इतिशुशु मनहीराना", "w": []}
{"chunk": 0, "s": 348.0, "e": 353.0, "t": " ये नस्तग्विचचक्षिरे", "w": []}
{"chunk": 0, "s": 353.0, "e": 359.0, "t": " विज्यान्चा इद्यान्चा", "w": []}
{"chunk": 0, "s": 359.0, "e": 365.0, "t": " यस्तद वेदो भायगुम्साः", "w": []}
{"chunk": 0, "s": 365.0, "e": 371.0, "t": " आविज्यायाम्रुट्युं तीर्ट्बा", "w": []}
{"chunk": 0, "s": 371.0, "e": 377.0, "t": " विज्यायाम्रुट्मश्नोते", "w": []}
{"chunk": 0, "s": 377.0, "e": 388.0, "t": " अंदन्तमख्प्रविशन्ति ये संबूति मुपासते", "w": []}
{"chunk": 0, "s": 388.0, "e": 400.0, "t": " ततवो लएईवते तमो यकु संबूत् लावंड़ाज", "w": []}
{"chunk": 0, "s": 400.0, "e": 412.0, "t": " अन्या देवाहु संभाबा, अन्या राहुर संभाबा,", "w": []}
{"chunk": 0, "s": 412.0, "e": 423.0, "t": " इतिशोश्म दिराना, ये नस्तबिच चक्षिरे,", "w": []}
{"chunk": 0, "s": 423.0, "e": 435.0, "t": " सम्वूदिंचविनाशमचा, यस्तद्वेदो भ्यगुम्साः,", "w": []}
{"chunk": 0, "s": 435.0, "e": 447.0, "t": " विनाशेनम्रुच्युं तिर्पा, सम्वूद्याम्रुटमश्नूते,", "w": []}
{"chunk": 0, "s": 447.0, "e": 460.0, "t": " भिरन्मये न पात्रेना सत्यस्याभिधम् मुखम्", "w": []}
{"chunk": 0, "s": 460.0, "e": 472.0, "t": " तत्वं पूशन् न पाव्रुनु सत्यदर्मायद्र्ष्करे", "w": []}
{"chunk": 0, "s": 472.0, "e": 480.52, "t": " पूशन्ने कर्षेयमसूर्यः प्राजाबग्यः", "w": []}
{"chunk": 0, "s": 480.52, "e": 486.16, "t": " यूह रश्मिं समुहते जोयते", "w": []}
{"chunk": 0, "s": 486.16, "e": 493.6, "t": " दूपं कल्यानतमं दक्ते पश्यामिं", "w": []}
{"chunk": 0, "s": 493.6, "e": 500.0, "t": " यो सावसो पूरुषस्सोहमस्मिं", "w": []}
{"chunk": 0, "s": 500.0, "e": 510.0, "t": " भायुरनिलम, आम्रुतम अखेदम, भस्मान तबम्शरीडम", "w": []}
{"chunk": 0, "s": 510.0, "e": 527.0, "t": " औं, क्रतोस्मरः, प्रितग्श्मरः", "w": []}
{"chunk": 0, "s": 527.0, "e": 535.0, "t": " अबने नयसुपतारा ये अस्मां", "w": []}
{"chunk": 0, "s": 535.0, "e": 542.0, "t": " विश्खारी देववायु नारी विद्वां", "w": []}
{"chunk": 0, "s": 542.0, "e": 549.0, "t": " युए जस्मचो हुरान मेंनो", "w": []}
{"chunk": 0, "s": 549.0, "e": 557.0, "t": " वूईश्खान देना मा उप्रिम्विधेमा", "w": []}
{"chunk": 0, "s": 557.0, "e": 562.0, "t": " इशावाश्शो पनिशत समाप्ता", "w": []}
