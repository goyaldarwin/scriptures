{"chunk": 0, "s": 0.0, "e": 6.0, "t": " श्रीनरस्सिं हचालीसा", "w": []}
{"chunk": 0, "s": 6.0, "e": 13.0, "t": " मास्वैशाख क्रतिका युत", "w": []}
{"chunk": 0, "s": 13.0, "e": 18.0, "t": " हरन महीएखो बार", "w": []}
{"chunk": 0, "s": 18.0, "e": 25.0, "t": " शुक्ल चतुर्दशी सोम दिन", "w": []}
{"chunk": 0, "s": 25.0, "e": 34.0, "t": " तो मदिन लियो नरसिंज अब तार", "w": []}
{"chunk": 0, "s": 34.0, "e": 40.0, "t": " दन तुमारो सिंज तनु दन तुमारो नाम", "w": []}
{"chunk": 0, "s": 40.0, "e": 46.0, "t": " तुमरे सुमरन से प्रभू पूरन हो सब काम", "w": []}
{"chunk": 0, "s": 46.0, "e": 52.0, "t": " जजईनर्सिंग देव मैं सुमरो तो ही", "w": []}
{"chunk": 0, "s": 52.0, "e": 58.0, "t": " दन्बल विद्या तान दे मोही", "w": []}
{"chunk": 0, "s": 58.0, "e": 64.0, "t": " जजईनर्सिंग कर पाला", "w": []}
{"chunk": 0, "s": 64.0, "e": 70.0, "t": " करो सदा भख्तन प्रतिपाला", "w": []}
{"chunk": 0, "s": 70.0, "e": 73.0, "t": " विष्नु के अवतार दयाला", "w": []}
{"chunk": 0, "s": 73.0, "e": 76.0, "t": " वाखाल काल लनको काला", "w": []}
{"chunk": 0, "s": 76.0, "e": 79.0, "t": " लाम नेक तुमारो बखानो", "w": []}
{"chunk": 0, "s": 79.0, "e": 82.0, "t": " पल्प गुध्ठ में नाक छुजानो", "w": []}
{"chunk": 0, "s": 82.0, "e": 85.0, "t": " फिरना कुष्न्र पवत यभिमानी", "w": []}
{"chunk": 0, "s": 85.0, "e": 88.0, "t": " तेहीके बार मही अखुलानी", "w": []}
{"chunk": 0, "s": 88.0, "e": 91.0, "t": " फिरना कुष्क यादूके जाए", "w": []}
{"chunk": 0, "s": 91.0, "e": 94.0, "t": " नाम भखत प्रहलाद कहाए", "w": []}
{"chunk": 0, "s": 94.0, "e": 97.0, "t": " भखत बना विश्नु को दासा", "w": []}
{"chunk": 0, "s": 97.0, "e": 100.0, "t": " ताखियो मारन पर साया", "w": []}
{"chunk": 0, "s": 100.0, "e": 103.0, "t": " आस्त्र शस्त्र मारे भुज्दंदा", "w": []}
{"chunk": 0, "s": 103.0, "e": 109.0, "t": " आगनिदा हकियो प्रच्टंदा", "w": []}
{"chunk": 0, "s": 109.0, "e": 112.0, "t": " बखत है तुम लियो अब तारा", "w": []}
{"chunk": 0, "s": 112.0, "e": 115.0, "t": " तुश्ट्रन एण रण मही बारा", "w": []}
{"chunk": 0, "s": 115.0, "e": 118.0, "t": " तुम भखतन के बखत तुमारे", "w": []}
{"chunk": 0, "s": 118.0, "e": 121.0, "t": " प्रहलाद के पेप्रान पियारे", "w": []}
{"chunk": 0, "s": 121.0, "e": 126.8, "t": " गद भए पाड कर तुम खमभा", "w": []}
{"chunk": 0, "s": 126.8, "e": 132.8, "t": " दिख दूश्त दल भए आचमभा", "w": []}
{"chunk": 0, "s": 132.8, "e": 138.8, "t": " खडग जिजव तनु सुंदर साजा", "w": []}
{"chunk": 0, "s": 138.8, "e": 141.8, "t": " और दव के अश महदश्ट्र वे राजा", "w": []}
{"chunk": 0, "s": 151.0, "e": 157.0, "t": " तक्त्स्वर्न सम बदन तुमहारा", "w": []}
{"chunk": 0, "s": 157.0, "e": 162.0, "t": " खोवर्न तुमहों विस्तारा", "w": []}
{"chunk": 0, "s": 162.0, "e": 166.0, "t": " रूप चत्र बुज बदन विशाला", "w": []}
{"chunk": 0, "s": 166.0, "e": 169.0, "t": " अगजिहिवाले अदिविक्राला", "w": []}
{"chunk": 0, "s": 169.0, "e": 172.0, "t": " वर्न मुक्ट बदन अतिबारी", "w": []}
{"chunk": 0, "s": 172.0, "e": 175.0, "t": " खानन खुंडल कीचविनारी", "w": []}
{"chunk": 0, "s": 175.0, "e": 179.0, "t": " भख्त प्रहलाद को तुमने अबारी", "w": []}
{"chunk": 0, "s": 179.0, "e": 183.0, "t": " वाद को तुमने उबारा", "w": []}
{"chunk": 0, "s": 184.0, "e": 187.0, "t": " विरना कुषखल चन मह्मारा", "w": []}
{"chunk": 0, "s": 187.0, "e": 192.0, "t": " द्रमा भिशनू तुम हे नित ध्धावे", "w": []}
{"chunk": 0, "s": 193.0, "e": 197.0, "t": " इंद्र महेश सदा मन्लावे", "w": []}
{"chunk": 0, "s": 199.0, "e": 203.0, "t": " वेद पुरान तुम तुम याशगावे", "w": []}
{"chunk": 0, "s": 205.0, "e": 208.0, "t": " शेश शार्दा पारन पावे", "w": []}
{"chunk": 0, "s": 268.0, "e": 270.66, "t": " दर दर दनी होई जावे", "w": []}
{"chunk": 0, "s": 270.66, "e": 276.52, "t": " जो नर सिंख का जाप कर आवे", "w": []}
{"chunk": 0, "s": 276.52, "e": 282.08, "t": " आईवि पत्ति सपने नहीं आवे", "w": []}
{"chunk": 0, "s": 282.08, "e": 288.04, "t": " जो काम ना करे मन माही", "w": []}
{"chunk": 0, "s": 288.04, "e": 291.56, "t": " सब निष चय सो सिथ रहोई जाही", "w": []}
{"chunk": 0, "s": 291.56, "e": 297.48, "t": " जीवन मैं जो कचु संकत होई", "w": []}
{"chunk": 0, "s": 297.48, "e": 301.68, "t": " निष्चय नर्सी हस्मर सोई", "w": []}
{"chunk": 0, "s": 303.68, "e": 306.68, "t": " रोग ग्रसित जो दावे कोई", "w": []}
{"chunk": 0, "s": 306.68, "e": 309.68, "t": " याकी काया कनचन होई", "w": []}
{"chunk": 0, "s": 309.68, "e": 312.68, "t": " याकी निशाकी निप्रेत बेताला", "w": []}
{"chunk": 0, "s": 312.68, "e": 315.68, "t": " रह्रादियरु यम विक्राला", "w": []}
{"chunk": 0, "s": 315.68, "e": 318.68, "t": " पेत पिशाच सबे भाये खाए", "w": []}
{"chunk": 0, "s": 318.68, "e": 321.68, "t": " यम के दूत निकत नही आवे", "w": []}
{"chunk": 0, "s": 321.68, "e": 324.68, "t": " सुमर नाम व्यादी सब भागे", "w": []}
{"chunk": 0, "s": 324.68, "e": 327.68, "t": " रोग शोक कब हुनही लागे", "w": []}
{"chunk": 0, "s": 327.68, "e": 333.68, "t": " जाग को नजर दोश हो भाई", "w": []}
{"chunk": 0, "s": 333.68, "e": 339.68, "t": " सोनर सी हच्छाली सागाई", "w": []}
{"chunk": 0, "s": 339.68, "e": 342.68, "t": " लगते नजर होगे कल्या नाना", "w": []}
{"chunk": 0, "s": 342.68, "e": 345.68, "t": " बचन सत्ते साखी भगवाना", "w": []}
{"chunk": 0, "s": 345.68, "e": 348.68, "t": " जोनर भियान तुमहारो लागे", "w": []}
{"chunk": 0, "s": 348.68, "e": 351.68, "t": " सोनर मन्वाजिद पल पावे", "w": []}
{"chunk": 0, "s": 351.68, "e": 357.68, "t": " पन्वाये जो मंद्र जानी", "w": []}
{"chunk": 0, "s": 357.68, "e": 363.68, "t": " हो जाओे वो हनर जग मानी", "w": []}
{"chunk": 0, "s": 363.68, "e": 369.68, "t": " नित प्रती पाथ कर एक बारा", "w": []}
{"chunk": 0, "s": 369.68, "e": 372.68, "t": " सोनर रहे तुमारा प्यारा", "w": []}
{"chunk": 0, "s": 372.68, "e": 377.68, "t": " नर सीज चाली साजो जन गावे", "w": []}
{"chunk": 0, "s": 377.68, "e": 382.68, "t": " दुखख दर इद्र ताके निकत नावे", "w": []}
{"chunk": 0, "s": 384.68, "e": 387.68, "t": " चाली सा जोनर पड़े पड़ावे", "w": []}
{"chunk": 0, "s": 387.68, "e": 390.68, "t": " सोनर जग में सब कुछ पावे", "w": []}
{"chunk": 0, "s": 390.68, "e": 393.68, "t": " येश्वीनर सीहा चाली सा", "w": []}
{"chunk": 0, "s": 393.68, "e": 396.68, "t": " पएरे रंक होगे वेनी सा", "w": []}
{"chunk": 0, "s": 396.68, "e": 401.68, "t": " जो द्यावे सोनर सुख पावे", "w": []}
{"chunk": 0, "s": 401.68, "e": 407.68, "t": " तो ही वि मुख बोह दूख उठावे", "w": []}
{"chunk": 0, "s": 407.68, "e": 413.68, "t": " शी स्वरूप है शरन तुमारी", "w": []}
{"chunk": 0, "s": 413.68, "e": 417.68, "t": " हरो नात सब विपती हमाली", "w": []}
{"chunk": 0, "s": 417.68, "e": 420.68, "t": " चारो युग गाए तेरी", "w": []}
{"chunk": 0, "s": 420.68, "e": 422.68, "t": " महिमा परम पार", "w": []}
