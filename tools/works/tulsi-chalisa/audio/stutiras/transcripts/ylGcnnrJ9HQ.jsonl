{"chunk": 0, "s": 0.0, "e": 23.0, "t": " जेजे तुलसी भगवती सत्यवती सुखदानी नमो नमो हरी प्रेयसी श्रीव्रंदागुन खाने", "w": []}
{"chunk": 0, "s": 23.0, "e": 42.0, "t": " श्री हरी शीश भी रजीने दे हु आम्र वर आम्ब, जनही तहेव रुंदावनी अब ना करहु विलंब,", "w": []}
{"chunk": 0, "s": 42.0, "e": 52.0, "t": " दन्यदन्यश्री तुलसी माता मही मागम सदाश्रुति गाता", "w": []}
{"chunk": 0, "s": 52.0, "e": 61.0, "t": " हरी के प्राणज्से तुम प्यारी हरी ही हे तुकीन हो तप्बारी", "w": []}
{"chunk": 0, "s": 61.0, "e": 71.0, "t": " जब प्रसंण है दर्षन दीन हो तब कर जोरी विनया उसकीन हो", "w": []}
{"chunk": 0, "s": 71.0, "e": 75.52, "t": " टे भग वन्त कंतमाम हो हु", "w": []}
{"chunk": 0, "s": 75.52, "e": 80.12, "t": " दीन जाने जन छाडा हु चो हु", "w": []}
{"chunk": 0, "s": 80.12, "e": 85.0, "t": " सूनी लक्ष्मी तूलसी की बानी", "w": []}
{"chunk": 0, "s": 85.0, "e": 89.68, "t": " दीन हो शाप कदपर आनी", "w": []}
{"chunk": 0, "s": 89.68, "e": 94.44, "t": " औस यो क्यवर माग नहारी", "w": []}
{"chunk": 0, "s": 94.44, "e": 99.08, "t": " हो हु विटप तुम जड तनू दारी", "w": []}
{"chunk": 0, "s": 99.08, "e": 103.72, "t": " सुनी तुलसी ही श्प्योदे ही तामा", "w": []}
{"chunk": 0, "s": 103.72, "e": 108.38, "t": " कर हु वास तुहु नी चन दामा", "w": []}
{"chunk": 0, "s": 108.38, "e": 113.08, "t": " दियो वचन हरी तब तखाला", "w": []}
{"chunk": 0, "s": 113.08, "e": 117.74, "t": " सुन हु सु मुखी जनी हो हु भी हाला", "w": []}
{"chunk": 0, "s": 117.74, "e": 121.92, "t": " समय पाए हो रो पाती", "w": []}
{"chunk": 0, "s": 121.92, "e": 127.24, "t": " तो रपुजी हाँ आस वचन सत मोरा", "w": []}
{"chunk": 0, "s": 127.24, "e": 132.36, "t": " तबगो उखल महगो पसुदा माता", "w": []}
{"chunk": 0, "s": 132.36, "e": 136.64, "t": " सुभही तुलसी तुबामा", "w": []}
{"chunk": 0, "s": 136.64, "e": 141.36, "t": " क्रिष्म रासली लाखे माही", "w": []}
{"chunk": 0, "s": 141.36, "e": 146.0, "t": " रादे शक्यो प्रेम लखी नाही", "w": []}
{"chunk": 0, "s": 146.0, "e": 150.72, "t": " दियो शाप तुलसी हतत काला", "w": []}
{"chunk": 0, "s": 150.72, "e": 155.44, "t": " नार लो कही तुम जन्महु भाला", "w": []}
{"chunk": 0, "s": 155.44, "e": 160.1, "t": " योगोप वहदान वराजा", "w": []}
{"chunk": 0, "s": 160.1, "e": 164.66, "t": " शंक जोडना मकशिर ताजा", "w": []}
{"chunk": 0, "s": 164.66, "e": 169.6, "t": " तुलसी भईता सोकी नारी", "w": []}
{"chunk": 0, "s": 169.6, "e": 174.28, "t": " परम सती खुन रूप अगारी", "w": []}
{"chunk": 0, "s": 174.28, "e": 179.0, "t": " आस्वे कल्प भेद जब गया।", "w": []}
{"chunk": 0, "s": 179.0, "e": 183.64, "t": " कल्प त्रित्ती एजन्म तब भेई।", "w": []}
{"chunk": 0, "s": 183.64, "e": 188.3, "t": " रिंदा नाम भ्यो तुलसी को", "w": []}
{"chunk": 0, "s": 188.3, "e": 193.06, "t": " असुर जलन्दर नाम पती को", "w": []}
{"chunk": 0, "s": 193.06, "e": 197.18, "t": " कर्या तिवन्द अतुल बलदाम", "w": []}
{"chunk": 0, "s": 197.18, "e": 202.38, "t": " अलीन हाशम कर से संग्राम", "w": []}
{"chunk": 0, "s": 202.38, "e": 207.08, "t": " जबने जसैंय सहित शिवहारे", "w": []}
{"chunk": 0, "s": 207.08, "e": 211.82, "t": " मरही नतब हर हरी भुकारे", "w": []}
{"chunk": 0, "s": 211.82, "e": 216.62, "t": " पत्टिव्रता व्रन्दा थी नारी", "w": []}
{"chunk": 0, "s": 216.62, "e": 221.32, "t": " कोन सके पतिजी संठारी", "w": []}
{"chunk": 0, "s": 221.32, "e": 226.02, "t": " तब जलन्दर ही भेश्वनाई", "w": []}
{"chunk": 0, "s": 226.02, "e": 230.62, "t": " व्रन्दा देग रही पोजो जाई", "w": []}
{"chunk": 0, "s": 230.62, "e": 235.42, "t": " शिर ही तलही करी कपट प्रसंगा", "w": []}
{"chunk": 0, "s": 235.42, "e": 240.12, "t": " की यो सती तो दरम तो ही भंगा", "w": []}
{"chunk": 0, "s": 240.12, "e": 244.78, "t": " भएो जलन्दर कर समहारा", "w": []}
{"chunk": 0, "s": 244.78, "e": 248.96, "t": " सूनी उर्शोग अपारा", "w": []}
{"chunk": 0, "s": 249.6, "e": 254.18, "t": " तिखषन दियो कपपट रिटारी", "w": []}
{"chunk": 0, "s": 254.18, "e": 258.94, "t": " लखी विंदा दुख गेरा उचारी", "w": []}
{"chunk": 0, "s": 258.94, "e": 263.56, "t": " जलन्दर जस हत्यो अभीता", "w": []}
{"chunk": 0, "s": 263.56, "e": 268.4, "t": " सोई रावन्तस रही सीता", "w": []}
{"chunk": 0, "s": 268.4, "e": 273.06, "t": " अस्प्रस्तर समहेद ये तुमहारा", "w": []}
{"chunk": 0, "s": 273.06, "e": 277.7, "t": " दर्मखन्दी ममपती ही समहारा", "w": []}
{"chunk": 0, "s": 277.7, "e": 282.5, "t": " यही कारन लही श्राप हमारा", "w": []}
{"chunk": 0, "s": 282.5, "e": 287.06, "t": " होगे तनु पाशान तुमहारा", "w": []}
{"chunk": 0, "s": 287.06, "e": 291.94, "t": " सूनी हरी तुरत ही वचन उचारे", "w": []}
{"chunk": 0, "s": 291.94, "e": 296.58, "t": " दियो शाप बिना भीचारे", "w": []}
{"chunk": 0, "s": 296.58, "e": 301.24, "t": " लग्यो नानिज कर तूदी पति को", "w": []}
{"chunk": 0, "s": 301.24, "e": 305.9, "t": " चलन चैह्यो जब पाररती को", "w": []}
{"chunk": 0, "s": 305.9, "e": 310.7, "t": " ज़ाड मती तूज वस हो ज़रूपा", "w": []}
{"chunk": 0, "s": 310.7, "e": 315.38, "t": " जक महे तुलसी वतप आनोपा", "w": []}
{"chunk": 0, "s": 315.38, "e": 320.1, "t": " दब रूप हम शालि ग्रामा", "w": []}
{"chunk": 0, "s": 320.1, "e": 324.78, "t": " नादी गंड की भीच ललामा", "w": []}
{"chunk": 0, "s": 324.78, "e": 329.12, "t": " जो तुलसी डल हमी चारे है", "w": []}
{"chunk": 0, "s": 329.44, "e": 333.78, "t": " सब सुखभोगी परम पपडप़े है", "w": []}
{"chunk": 0, "s": 334.2, "e": 338.94, "t": " भेनु तुलसी हरी चलत शरी रा", "w": []}
{"chunk": 0, "s": 338.94, "e": 343.48, "t": " दिशय उथत शीश वुर पीरा", "w": []}
{"chunk": 0, "s": 343.64, "e": 348.12, "t": " जो तुलसी डल हरी शीडधारत", "w": []}
{"chunk": 0, "s": 348.12, "e": 352.88, "t": " सो सहस्र खट नब्रत डारत", "w": []}
{"chunk": 0, "s": 352.88, "e": 357.88, "t": " तुलसी हरे मनरम जनिहारे", "w": []}
{"chunk": 0, "s": 357.88, "e": 362.88, "t": " रोग दोश दुख भनजनिहारे", "w": []}
{"chunk": 0, "s": 362.88, "e": 366.88, "t": " प्रेम सहित हरे भजनने रन्तर", "w": []}
{"chunk": 0, "s": 366.88, "e": 371.88, "t": " तुलसी रादा में आही अंतर", "w": []}
{"chunk": 0, "s": 371.88, "e": 376.88, "t": " व्यशन हो चब पनहु प्रकारा", "w": []}
{"chunk": 0, "s": 376.88, "e": 380.88, "t": " पिनु तुलसी दलना हरी ही प्यारा", "w": []}
{"chunk": 0, "s": 380.88, "e": 385.88, "t": " सकल तीर्ख तोलसी करुचाही", "w": []}
{"chunk": 0, "s": 385.88, "e": 390.88, "t": " लहत मोथी जन समश हिनाही", "w": []}
{"chunk": 0, "s": 390.88, "e": 394.88, "t": " कवी सुन्दर एक हरे गून खावत", "w": []}
{"chunk": 0, "s": 394.88, "e": 399.88, "t": " तोलसी ही निकत सहस गून पावत", "w": []}
{"chunk": 0, "s": 399.88, "e": 404.88, "t": " बसत निकत तुर्वासा धामा", "w": []}
{"chunk": 0, "s": 404.88, "e": 409.88, "t": " जो प्रयासते पूर्व ललामा", "w": []}
{"chunk": 0, "s": 409.88, "e": 414.22, "t": " वाथकर ही जोनितर रनारे", "w": []}
{"chunk": 0, "s": 414.22, "e": 419.1, "t": " हो ही सुखबाश लिटरे पुरारे", "w": []}
{"chunk": 0, "s": 428.48, "e": 432.96, "t": " तुलसी चाली सापड ही", "w": []}
{"chunk": 0, "s": 432.96, "e": 436.88, "t": " तुलसी तरुगर रहा दारे", "w": []}
{"chunk": 0, "s": 436.88, "e": 445.88, "t": " देख दान करी पुत्र फल्र पाही बन्द्र हूनारी", "w": []}
{"chunk": 0, "s": 445.88, "e": 454.88, "t": " सकल दुख्ख्दरी प्र हरी हार है पैर पर्म प्रसन्ना", "w": []}
