{"chunk": 0, "s": 0.0, "e": 13.0, "t": " जए जए श्री महालक्श्मी", "w": []}
{"chunk": 0, "s": 13.0, "e": 19.0, "t": " करु माधे तवएदा", "w": []}
{"chunk": 0, "s": 19.0, "e": 27.0, "t": " सिथगा जए च्री महालक्श्मी", "w": []}
{"chunk": 0, "s": 27.0, "e": 43.0, "t": " सित्ट काज माम की जी है, निज शिश्षु से वक जाए.", "w": []}
{"chunk": 0, "s": 43.0, "e": 56.0, "t": " नमू माहा लख्श्मी जै माता, तेरो नाम जगत विख्याता,", "w": []}
{"chunk": 0, "s": 56.0, "e": 67.0, "t": " आदी शप्ति हो मात भवानी, पुजत स्था विख्याता,", "w": []}
{"chunk": 0, "s": 67.0, "e": 71.34, "t": " अदिशप्यो मात भवानी", "w": []}
{"chunk": 0, "s": 72.0, "e": 76.96, "t": " पूजत सब नर्मुनि यानी", "w": []}
{"chunk": 0, "s": 77.4, "e": 82.3, "t": " जगत पालेनी सब सुकरेनी", "w": []}
{"chunk": 0, "s": 82.8, "e": 87.66, "t": " निजजनहित भंडार बारेनी", "w": []}
{"chunk": 0, "s": 88.3, "e": 93.2, "t": " श्वेत कमाले दल पर तवा आसन", "w": []}
{"chunk": 0, "s": 93.2, "e": 99.2, "t": " मात सुशो भीत है पद्मासरने", "w": []}
{"chunk": 0, "s": 109.2, "e": 115.2, "t": " श्वेताम बर वरु, श्वेताम वूशने", "w": []}
{"chunk": 0, "s": 115.2, "e": 120.2, "t": " श्वेत ही श्वेत सुसाज तपूश्पने", "w": []}
{"chunk": 0, "s": 120.2, "e": 125.2, "t": " शीश च्ट्र अति रूप विशाला", "w": []}
{"chunk": 0, "s": 125.2, "e": 131.2, "t": " गल सो हे मुक्तन की माला", "w": []}
{"chunk": 0, "s": 131.2, "e": 136.2, "t": " सुंदर सो हे कुनचित केशा", "w": []}
{"chunk": 0, "s": 136.2, "e": 142.2, "t": " विमलन यान औरू अनुपम वेशा", "w": []}
{"chunk": 0, "s": 142.2, "e": 147.2, "t": " कमलन आल समभूज तवचारी", "w": []}
{"chunk": 0, "s": 177.2, "e": 196.2, "t": " वाज़ा लख्शु में बन्यो माई पन्च तद्व में स्रेश्टि रचाई", "w": []}
{"chunk": 0, "s": 196.2, "e": 201.36, "t": " जीवचर आचर तुम उपजाए", "w": []}
{"chunk": 0, "s": 201.36, "e": 206.96, "t": " पशुपकशी नर नारी बनाई", "w": []}
{"chunk": 0, "s": 206.96, "e": 212.4, "t": " शितित लगनित प्रेख्ष जमाई", "w": []}
{"chunk": 0, "s": 212.4, "e": 217.68, "t": " आमी तरंग प्हले फुल सुहाई", "w": []}
{"chunk": 0, "s": 217.68, "e": 223.2, "t": " चब भी लोक सुर मुनी नर नारी", "w": []}
{"chunk": 0, "s": 223.2, "e": 228.64, "t": " करे सदा तवजय जयकारी", "w": []}
{"chunk": 0, "s": 228.64, "e": 234.0, "t": " सुरपत्यो नरपत सबध्यावे", "w": []}
{"chunk": 0, "s": 234.0, "e": 239.4, "t": " तेरे सम्मुखषी शनावे", "w": []}
{"chunk": 0, "s": 239.4, "e": 244.8, "t": " चारहु वेदन तवयशगाया", "w": []}
{"chunk": 0, "s": 244.8, "e": 250.6, "t": " मही मागम पार नही पाया", "w": []}
{"chunk": 0, "s": 253.2, "e": 259.2, "t": " अद्या पर कर हु मात तु मदाया", "w": []}
{"chunk": 0, "s": 259.2, "e": 264.2, "t": " तु मूदाया", "w": []}
{"chunk": 0, "s": 264.2, "e": 269.2, "t": " सोई जग में दन्या काया", "w": []}
{"chunk": 0, "s": 269.2, "e": 274.2, "t": " पल मेरा चही रवक बला", "w": []}
{"chunk": 0, "s": 274.2, "e": 280.2, "t": " रवक राव कर बिल मनला", "w": []}
{"chunk": 0, "s": 280.2, "e": 285.32, "t": " भी ल्मन लाओ जीन गर कर हु", "w": []}
{"chunk": 0, "s": 285.32, "e": 288.4, "t": " माअत तुम भासा", "w": []}
{"chunk": 0, "s": 288.4, "e": 293.92, "t": " वून का यशे हो वीश्व प्रकाशा", "w": []}
{"chunk": 0, "s": 293.92, "e": 299.32, "t": " जो थावे सो वहु सुखपावे", "w": []}
{"chunk": 0, "s": 299.32, "e": 304.92, "t": " वी मुखरे हो तुख उतावे", "w": []}
{"chunk": 0, "s": 304.92, "e": 310.04, "t": " महालक्षुमी जन सुखदाई", "w": []}
{"chunk": 0, "s": 310.04, "e": 315.26, "t": " द्याउ तुमको शीशन वाई", "w": []}
{"chunk": 0, "s": 315.26, "e": 320.64, "t": " निजजन जानी मोही अपनाओ", "w": []}
{"chunk": 0, "s": 320.64, "e": 326.24, "t": " सुखसम पती दे दुखन साओ", "w": []}
{"chunk": 0, "s": 326.24, "e": 348.24, "t": " अग, श्री, श्री जए ए, सुखकी खानी, रिठ्फिस थे उमात जन जानी,", "w": []}
{"chunk": 0, "s": 348.24, "e": 353.4, "t": " औम हीम हीम सव व्याति हटाओ", "w": []}
{"chunk": 0, "s": 353.68, "e": 358.84, "t": " जन उ रभी मल द्रिष्टे गरे शाओ", "w": []}
{"chunk": 0, "s": 359.04, "e": 364.08, "t": " औम खिंख्ण्शाद्रू लप्शय कीजे", "w": []}
{"chunk": 0, "s": 364.48, "e": 369.56, "t": " जन लिद मात बाय वर दीजे", "w": []}
{"chunk": 0, "s": 370.0, "e": 375.08, "t": " औम जय जय जय ती जय जननी", "w": []}
{"chunk": 0, "s": 375.08, "e": 380.4, "t": " सकल का जबा तन के सरनी", "w": []}
{"chunk": 0, "s": 380.4, "e": 385.78, "t": " हो मनमो नमो भवनी दितारनी", "w": []}
{"chunk": 0, "s": 385.78, "e": 391.08, "t": " तरनी बगर से पार हु तरनी", "w": []}
{"chunk": 0, "s": 391.08, "e": 396.4, "t": " सुन हु मातयह विनय हमारी", "w": []}
{"chunk": 0, "s": 396.4, "e": 402.08, "t": " पुरवहु पाशन करहु अबारी", "w": []}
{"chunk": 0, "s": 405.08, "e": 410.04, "t": " प्रवाद आप्रनी में के थाभाद।", "w": []}
{"chunk": 0, "s": 413.16, "e": 418.08, "t": " रीने दॏतार से ब्राणी इस फंखःाती 와भे", "w": []}
{"chunk": 0, "s": 419.2, "e": 427.36, "t": " रोगे गरसी तेख्छो थाबे ॢ़ावे कोई", "w": []}
{"chunk": 0, "s": 428.08, "e": 432.96, "t": " तागी निर मिले का या औआई", "w": []}
{"chunk": 0, "s": 432.96, "e": 444.96, "t": " भी श्नुप्रिया जैय जैय महारानी मही माई आमी तने जाय बखानी", "w": []}
{"chunk": 0, "s": 444.96, "e": 455.96, "t": " पुत्रहीन जो ध्यान लगावे पाए सुत अती ही उनसावे", "w": []}
{"chunk": 0, "s": 455.96, "e": 460.96, "t": " तराही तराही शरनागत तेरी", "w": []}
{"chunk": 0, "s": 460.96, "e": 466.96, "t": " करव मात अब नेकन देरी", "w": []}
{"chunk": 0, "s": 466.96, "e": 471.96, "t": " आवव मात भिलम बन कीजे", "w": []}
{"chunk": 0, "s": 471.96, "e": 477.96, "t": " रिधयने वास भखत बर दीजे", "w": []}
{"chunk": 0, "s": 485.96, "e": 498.96, "t": " जानो जब तप का लही भेवा पार करो भावनिद भीन खेवा", "w": []}
{"chunk": 0, "s": 498.96, "e": 509.96, "t": " पिन वो बार बार कर जोरी पूरन आशा कर हो ब मोरी", "w": []}
{"chunk": 0, "s": 509.96, "e": 520.96, "t": " जानिदास मम संकततारा सकल भ्यादी से मोहि नुभारा", "w": []}
{"chunk": 0, "s": 520.96, "e": 531.96, "t": " जो तव सुरति रहे लवनाई सो जग पावे सुयश भडाई", "w": []}
{"chunk": 0, "s": 531.96, "e": 536.96, "t": " चायो यश तेरो संसारा", "w": []}
{"chunk": 0, "s": 536.96, "e": 542.96, "t": " पावत शेश शम्वू नहीं पारा", "w": []}
{"chunk": 0, "s": 542.96, "e": 547.96, "t": " गोविंद निश दिन शरन तिहारी", "w": []}
{"chunk": 0, "s": 547.96, "e": 554.96, "t": " कर्वु पूरन अभिलाश हमारी", "w": []}
{"chunk": 0, "s": 554.96, "e": 560.96, "t": " बद्हाए सुने चितलाए", "w": []}
{"chunk": 0, "s": 560.96, "e": 567.96, "t": " ताई ही पदारते मिले आब", "w": []}
{"chunk": 0, "s": 567.96, "e": 574.96, "t": " कहाई वेध आसेगा", "w": []}
{"chunk": 0, "s": 574.96, "e": 583.96, "t": " बद्हाए वेध आसेगा", "w": []}
