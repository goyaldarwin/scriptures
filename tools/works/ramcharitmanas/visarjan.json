 "title": {
  "hi": "कथा-विसर्जन",
  "en": "Kathā-visarjana"
 },
 "when": {
  "hi": "पारायणके अन्तिम दिन, पाठ और आरतीके बाद",
  "en": "On the last day of the pārāyaṇa, after the reading and the āratī"
 },
 "verses": [
  {
   "v": [
    "कथा विसर्जन होत है, सुनहु वीर हनुमान ।",
    "राम लखन श्री जानकी, सदा करहु कल्याण ॥१॥"
   ],
   "hi": "हे वीर हनुमान्‌जी! सुनिये, अब कथाका विसर्जन (समापन) हो रहा है। श्रीराम, लक्ष्मण और श्रीजानकीजी सदा कल्याण करें।",
   "en": "Listen, O valiant Hanumān: the recitation is now being brought to its close. May Śrī Rāma, Lakṣmaṇa and Śrī Jānakī ever bless us."
  },
  {
   "v": [
    "एक घड़ी आधी घड़ी, आधी में पुनि आध ।",
    "तुलसी संगत साधु की, कटै कोटि अपराध ॥२॥"
   ],
   "hi": "एक घड़ी, आधी घड़ी, या उसकी भी आधी—तुलसीदासजी कहते हैं कि इतनी-सी देरका साधु-संग भी करोड़ों अपराधोंको काट देता है।",
   "en": "For one ghaṛī (about 24 minutes), half a ghaṛī, or even half of that: says Tulasī, the company of the holy, however brief, cuts away countless sins."
  },
  {
   "v": [
    "जो जन जहां से आयहु, कथा सुनेहु मन लाय ।",
    "अपने अपने धाम को विदा होहु हरषाय ॥३॥"
   ],
   "hi": "जो जहाँसे पधारे और मन लगाकर कथा सुनी, वे सब अब प्रसन्न होकर अपने-अपने धामको विदा हों।",
   "en": "All who came, from wherever they came, and listened to the story with attention: may each now joyfully take leave for their own abode."
  },
  {
   "v": [
    "श्रोता सब आश्रम गये, शंभु गये कैलाश ।",
    "रामायण मम हृदय में, आय करहु तुम बास ॥४॥"
   ],
   "hi": "सब श्रोता अपने-अपने आश्रमको गये और शिवजी कैलास गये। हे रामायण! आप आकर मेरे हृदयमें निवास कीजिये।",
   "en": "The listeners have gone to their homes, and Śambhu (Śiva) to Kailāsa. O Rāmāyaṇa, come and dwell in my heart."
  },
  {
   "v": [
    "कहेहु दन्डवत प्रभु सन, तुमहि कहौं कर जोरि ।",
    "बार बार रघुनाथ कहिं, सुरति करायहु मोरि ॥५॥"
   ],
   "hi": "(हे हनुमान्‌जी!) मैं हाथ जोड़कर आपसे कहता हूँ—प्रभुसे मेरा दण्डवत् प्रणाम कहियेगा, और श्रीरघुनाथजीको बार-बार मेरी याद दिलाते रहियेगा।",
   "en": "With joined palms I ask you (O Hanumān): convey my prostrations to the Lord, and remind Śrī Raghunātha of me again and again."
  },
  {
   "v": [
    "बार बार वर मांगहु, हर्षि देहु श्री रंग ।",
    "पद सरोज अनपायनी, भक्ति सदा सत्संग ॥६॥"
   ],
   "hi": "मैं बार-बार यही वर माँगता हूँ—हे श्रीरंग (प्रभु)! प्रसन्न होकर दीजिये: आपके चरणकमलोंमें अटल भक्ति और सदा सत्संग।",
   "en": "Again and again I ask one boon; grant it gladly, O Śrī Raṅga (the Lord): unwavering devotion to Your lotus feet, and the company of the holy always."
  },
  {
   "v": [
    "जाहु पवन सुत शयन करो, मानस भई विश्राम ।",
    "नाथ तुम्हारे दास को सिद्ध भये सब काम ॥७॥"
   ],
   "hi": "हे पवनपुत्र! अब जाकर विश्राम कीजिये, मानसका पाठ विश्रामको पहुँच गया। हे नाथ! आपके इस दासके सब काम सिद्ध हो गये।",
   "en": "Go now and rest, O Son of the Wind; the Mānasa has come to its close. O Lord, every undertaking of Your servant is fulfilled."
  },
  {
   "v": [
    "हरि शरनन गुरु शरनन, शरनन गौरि गणेश ।",
    "तुलसी दास प्रभु के शरनन, शरनन अवध नरेश ॥८॥"
   ],
   "hi": "मैं श्रीहरिकी शरणमें हूँ, गुरुकी शरणमें, गौरी और गणेशजीकी शरणमें; तुलसीदासके प्रभुकी शरणमें, अवधनरेश श्रीरामकी शरणमें हूँ।",
   "en": "I take refuge in Hari, in the Guru, in Gaurī and Gaṇeśa; in the Lord of Tulasīdāsa, in the King of Avadha."
  },
  {
   "v": [
    "राम लखन श्री जानकी, भरत शत्रुघन भाय ।",
    "कथा विसर्जन करतु हौं, ईशहिं शीश नवाय ॥९॥"
   ],
   "hi": "श्रीराम, लक्ष्मण, श्रीजानकीजी तथा भाई भरत और शत्रुघ्न—इन प्रभुओंको सिर नवाकर मैं कथाका विसर्जन करता हूँ।",
   "en": "Bowing my head to the Lord (Śrī Rāma, Lakṣmaṇa, Śrī Jānakī and the brothers Bharata and Śatrughna), I bring the recitation to its close."
  },
  {
   "v": [
    "साधु सन्त को बन्दगी, ब्राह्मन को परणाम ।",
    "श्रोता गण कर जोरि कर, सब को सीताराम ॥१०॥"
   ],
   "hi": "साधु-संतोंको वन्दना, ब्राह्मणोंको प्रणाम; और सब श्रोताओंको हाथ जोड़कर ‘सीताराम’।",
   "en": "Salutations to the saints and holy ones, obeisance to the brāhmaṇas; and to all the listeners, with joined palms: “Sītā-Rāma”."
  }
 ],
