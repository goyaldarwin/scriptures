{"chunk": 4, "s": 2683.26, "e": 2687.42, "t": " अदिन रव पज़ भीनेत", "w": []}
{"chunk": 4, "s": 2690.62, "e": 2696.1, "t": " मत्ति अन्रूप कता में बाखि", "w": []}
{"chunk": 4, "s": 2696.1, "e": 2701.7, "t": " जद्यप प्रथम दूप करी राखि", "w": []}
{"chunk": 4, "s": 2701.7, "e": 2707.3, "t": " तब मन प्रीट देखि अदिकाई", "w": []}
{"chunk": 4, "s": 2707.3, "e": 2712.98, "t": " तब में रगूप प्र्ति कता सुनाई", "w": []}
{"chunk": 4, "s": 2712.98, "e": 2718.64, "t": " यह न कही यह सत्ते ही रथ सी लही", "w": []}
{"chunk": 4, "s": 2718.64, "e": 2724.28, "t": " जो मन लाएन सुन रही ली लही", "w": []}
{"chunk": 4, "s": 2724.28, "e": 2729.98, "t": " कही अन लोगी गुरोदी ही कामी ही", "w": []}
{"chunk": 4, "s": 2729.98, "e": 2735.58, "t": " जो न भजएी सच्चरा चर स्वार मी", "w": []}
{"chunk": 4, "s": 2735.58, "e": 2741.18, "t": " दिजद्रो ही न सूना एक बहुं", "w": []}
{"chunk": 4, "s": 2741.18, "e": 2747.18, "t": " सुर पति सरी से होई ने पजब हुं", "w": []}
{"chunk": 4, "s": 2747.18, "e": 2752.18, "t": " राम कता के ती अदिकारी", "w": []}
{"chunk": 4, "s": 2752.18, "e": 2758.18, "t": " जिनके सत संगती अद्टी प्यारी", "w": []}
{"chunk": 4, "s": 2758.18, "e": 2764.18, "t": " गुर पद प्रीत नीती रत जेई", "w": []}
{"chunk": 4, "s": 2764.18, "e": 2769.18, "t": " दूज से वक अदिकारी ते", "w": []}
{"chunk": 4, "s": 2769.18, "e": 2781.18, "t": " ता कह यह भिसेश सुख्दाई, जाही प्रान प्रियए श्री रग भुराई", "w": []}
{"chunk": 4, "s": 2783.18, "e": 2792.18, "t": " राम चरन रतिजोच़ अख्वा पद निर्भान", "w": []}
{"chunk": 4, "s": 2792.18, "e": 2802.18, "t": " भाव सहित सोयह कता करा उशर्वन पूट पान", "w": []}
{"chunk": 4, "s": 2802.18, "e": 2816.18, "t": " राम कता गिर जा में बरनी कली मल समनी मनो मल हरनी", "w": []}
{"chunk": 4, "s": 2816.18, "e": 2822.18, "t": " संस्रित रोग सजीवन मूरी", "w": []}
{"chunk": 4, "s": 2822.18, "e": 2827.18, "t": " राम कता गावाही श्रुति सूरी", "w": []}
{"chunk": 4, "s": 2827.18, "e": 2833.18, "t": " एही महरुचीर साभ्त सोपाना", "w": []}
{"chunk": 4, "s": 2833.18, "e": 2839.18, "t": " रगु पती भागती केर पन्खाना", "w": []}
{"chunk": 4, "s": 2839.18, "e": 2844.18, "t": " अति हरी प्लिपा जाही पर होई", "w": []}
{"chunk": 4, "s": 2844.18, "e": 2850.18, "t": " पाओ देई ही मारग सोई", "w": []}
{"chunk": 4, "s": 2850.18, "e": 2856.18, "t": " मन कामना सीदिनर पावा", "w": []}
{"chunk": 4, "s": 2856.18, "e": 2861.18, "t": " जेयग कता कपत तजिगावा", "w": []}
{"chunk": 4, "s": 2861.18, "e": 2867.18, "t": " कहे सूनही पनुमोदन करही", "w": []}
{"chunk": 4, "s": 2867.18, "e": 2873.18, "t": " तेगो पदिव भावनी दितरही", "w": []}
{"chunk": 4, "s": 2873.18, "e": 2878.5, "t": " सुन्नि सब कता ख्रीदे अत्टिभाई", "w": []}
{"chunk": 4, "s": 2878.5, "e": 2884.26, "t": " गिरी जाबोली गिरा सुहाई", "w": []}
{"chunk": 4, "s": 2884.26, "e": 2890.02, "t": " नात्क्रिपामम गत्सन्देहा", "w": []}
{"chunk": 4, "s": 2890.02, "e": 2896.26, "t": " राम चरन उपजे उनवनेहा", "w": []}
{"chunk": 4, "s": 2897.26, "e": 2902.02, "t": " मैं ख्रित्ख्रीट भ्हयाँ अब", "w": []}
{"chunk": 4, "s": 2902.02, "e": 2906.82, "t": " तव प्रसाद भिस्वेस", "w": []}
{"chunk": 4, "s": 2906.82, "e": 2911.02, "t": " उपजी राम भगत द्रध", "w": []}
{"chunk": 4, "s": 2911.02, "e": 2916.02, "t": " भी ते सकल कलेस", "w": []}
{"chunk": 4, "s": 2919.02, "e": 2924.02, "t": " यह सुभसम भूमा समबादा", "w": []}
{"chunk": 4, "s": 2924.02, "e": 2930.02, "t": " सुभसम पादन समन भिशादा", "w": []}
{"chunk": 4, "s": 2930.02, "e": 2935.82, "t": " मवव बन जन गन जन संदेहा", "w": []}
{"chunk": 4, "s": 2935.82, "e": 2941.42, "t": " जन रन जन सजन प्रियएहा", "w": []}
{"chunk": 4, "s": 2941.42, "e": 2947.02, "t": " राम उपासक जे जग माही", "w": []}
{"chunk": 4, "s": 2947.02, "e": 2952.62, "t": " एह सम प्रियए तिनके कच्नाही", "w": []}
{"chunk": 4, "s": 2952.62, "e": 2958.22, "t": " रगु पति क्रिपा जखामत गावा", "w": []}
{"chunk": 4, "s": 2958.22, "e": 2963.88, "t": " मैं यबावन चरित सूहारवा", "w": []}
{"chunk": 4, "s": 2963.88, "e": 2969.58, "t": " एख कल कालन साधन दूजा", "w": []}
{"chunk": 4, "s": 2969.58, "e": 2975.04, "t": " जोग जगय जप तप प्रत पूजा", "w": []}
{"chunk": 4, "s": 2975.04, "e": 2980.92, "t": " रामही सुमीरी एं गाई रामही", "w": []}
{"chunk": 4, "s": 2980.92, "e": 2986.54, "t": " संतत सुमीरी राम गुन ग्रामही", "w": []}
{"chunk": 4, "s": 2986.54, "e": 2991.66, "t": " जासु पतित पावन बल भाना", "w": []}
{"chunk": 4, "s": 2991.66, "e": 2997.5, "t": " गावे ही कभी शुति संथ पुराना", "w": []}
{"chunk": 4, "s": 2997.5, "e": 2999.94, "t": " ताही भाज़ेईन", "w": []}
{"chunk": 5, "s": 3000.0, "e": 3003.52, "t": " भान तजी कुति लाई", "w": []}
{"chunk": 5, "s": 3003.52, "e": 3010.12, "t": " राम भजे केहिने ही पाही", "w": []}
{"chunk": 5, "s": 3014.0, "e": 3018.34, "t": " पाही न केही गति पतित पावन", "w": []}
{"chunk": 5, "s": 3018.34, "e": 3021.6, "t": " राम भजे सुनि सथ्मना", "w": []}
{"chunk": 5, "s": 3021.6, "e": 3025.7, "t": " गनि का आजा मिल भ्याद गीद", "w": []}
{"chunk": 5, "s": 3025.7, "e": 3029.34, "t": " गजा दिखल तारे खना", "w": []}
{"chunk": 5, "s": 3029.34, "e": 3036.78, "t": " आभीर जमन की रात खस सब पचाडी आती आगर रूप जे", "w": []}
{"chunk": 5, "s": 3036.78, "e": 3044.42, "t": " कही नाम बारकते पिपावन हो ही रामन मामी ते", "w": []}
{"chunk": 5, "s": 3044.42, "e": 3052.1, "t": " रग बन सभूशन चरित यहनर कहा ही सुनही जे गावहु", "w": []}
{"chunk": 5, "s": 3052.1, "e": 3059.66, "t": " कल मल मनो मल द्वोई भीनुश्नम राम दाम सிदावई", "w": []}
{"chunk": 5, "s": 3059.66, "e": 3067.4, "t": " सत पन्च चोपाई मनो हर जानी जो नर उर्दरे", "w": []}
{"chunk": 5, "s": 3067.4, "e": 3074.94, "t": " दारुन अभीट आप पन्च जनित भीकार श्री रकुबर हरे", "w": []}
{"chunk": 5, "s": 3074.94, "e": 3082.74, "t": " सुंदर सुजान क्रिपानि दान अनात्पर कर पीतिजो", "w": []}
{"chunk": 5, "s": 3082.74, "e": 3090.24, "t": " सो एक राम अकाम हित निर्मान प्रद समान को", "w": []}
{"chunk": 5, "s": 3090.24, "e": 3098.02, "t": " जागी क्रिपा लव लेस देमति मंद तुल सी दास हु", "w": []}
{"chunk": 5, "s": 3098.02, "e": 3107.02, "t": " पायो परम भीशाम राम समान कब नाही कहु।", "w": []}
{"chunk": 5, "s": 3109.62, "e": 3120.02, "t": " मुसम दीन न दीन हित तुम समान रगुदीर", "w": []}
{"chunk": 5, "s": 3120.02, "e": 3130.02, "t": " अस भीचार रगव बन्स्मन फरहु भीशम भववभीर", "w": []}
{"chunk": 5, "s": 3130.02, "e": 3141.02, "t": " कामिहिनार प्यार जी लोबिहि प्रियजि मिदाम", "w": []}
{"chunk": 5, "s": 3141.02, "e": 3151.02, "t": " तिमिरग हूना थनिरन्तर प्रियलाग हो मुही राम।", "w": []}
{"chunk": 5, "s": 3155.02, "e": 3167.02, "t": " या तोर्वं प्रभूडा क्रितम सुक्विना श्रीशम रूना दूर्म्गम", "w": []}
{"chunk": 5, "s": 3167.02, "e": 3178.02, "t": " श्री मद्राम पदावज भक्ति मनिशम प्राप्ते तुरामायडम", "w": []}
{"chunk": 5, "s": 3179.02, "e": 3185.02, "t": " मत्वा तद्रगुनात नामनिरतम", "w": []}
{"chunk": 5, "s": 3186.02, "e": 3191.02, "t": " स्वान्तस्तमह शांते", "w": []}
{"chunk": 5, "s": 3191.02, "e": 3204.02, "t": " भाशा बद्ध्मिदम चकार तुल्सी दास्त था मान सम", "w": []}
{"chunk": 5, "s": 3204.02, "e": 3213.02, "t": " पूड्यम पाप रम सदा श्यूकरम विग्यान भख्ति प्रदम", "w": []}
{"chunk": 5, "s": 3213.02, "e": 3226.02, "t": " मायामोध मलापहम सुभिमलम, प्रेमाम भूपुरम्शुवम,", "w": []}
{"chunk": 5, "s": 3226.02, "e": 3239.02, "t": " श्री मद्राम चर्ट्र मानस्मिधम, भख्त्याव गाहन्तिये,", "w": []}
{"chunk": 5, "s": 3239.02, "e": 3252.02, "t": " ते संसार पतंग गोर किरनेर यदहन्ती, नु मानवाओ.", "w": []}
{"chunk": 5, "s": 3282.02, "e": 3288.02, "t": " तब आब नवा वन वनुग यर भागे", "w": []}
{"chunk": 5, "s": 3288.02, "e": 3295.02, "t": " नवा उसो न से रखा आजी दल पिजाए", "w": []}
{"chunk": 5, "s": 3312.02, "e": 3333.62, "t": " आरसी श्वी रामायने जीकी", "w": []}
{"chunk": 5, "s": 3333.62, "e": 3360.22, "t": " रावक्स जम्हादिखम उदिनारग, पालनिख, इच्यार पिसारग, सुप्पसश्खादिसेश्यारुसारग, पलनिपमन सुद्ध्ये रख्ये लेके, आरतिशे डामालने जेके,", "w": []}
{"chunk": 5, "s": 3360.22, "e": 3387.22, "t": " गाबत्देग पुरान आज्ददस्छ, श्रोसाच्प सब नंपन कोरस्छ, भूनिजदधधध, संपन को सरबस्छ, सार्वन सशम्मत सबरेते, आरतिशी रामा लेगेगेगेगेगे.", "w": []}
{"chunk": 5, "s": 3387.22, "e": 3392.22, "t": " अरुवधष संदख संबुखमाने", "w": []}
{"chunk": 5, "s": 3392.22, "e": 3397.22, "t": " अरुवधष संवोवक भूनी भीच्याने", "w": []}
{"chunk": 5, "s": 3397.22, "e": 3402.22, "t": " यास अगिखमे बरजवखाने", "w": []}
{"chunk": 5, "s": 3402.22, "e": 3408.22, "t": " खागम सुन्दे परुडे के गे", "w": []}
{"chunk": 5, "s": 3408.22, "e": 3413.22, "t": " आरतिष्टे ला मालने जेगे", "w": []}
{"chunk": 5, "s": 3413.22, "e": 3418.62, "t": " कली मलہरनीं की शवेर सतीती", "w": []}
{"chunk": 5, "s": 3418.62, "e": 3423.62, "t": " सुबग सिंगार पूभती जुबतीती", "w": []}
{"chunk": 5, "s": 3423.62, "e": 3429.22, "t": " गलन रोग भाव, मुर्यमीती", "w": []}
{"chunk": 5, "s": 3429.22, "e": 3434.22, "t": " तातमात सब पिभि तुल्यसीती", "w": []}
{"chunk": 5, "s": 3434.22, "e": 3440.22, "t": " आरती शी रामायने जीगी", "w": []}
{"chunk": 5, "s": 3440.22, "e": 3457.22, "t": " आर्टिश़्ी रा मायने जीती", "w": []}
{"chunk": 5, "s": 3458.22, "e": 3462.22, "t": " बोलो स्यावर राम चंद्र की", "w": []}
{"chunk": 5, "s": 3463.22, "e": 3467.22, "t": " पवन सुतहनु मान की", "w": []}
