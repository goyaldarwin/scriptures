{"chunk": 0, "s": 0.0, "e": 11.0, "t": " बखगति पच्छ रख्ठ करी रहु, दीन महारिश्षाप,", "w": []}
{"chunk": 0, "s": 11.0, "e": 21.0, "t": " मुनि दूर लव बर पायओ, देखा हु भजन प्रताप.", "w": []}
{"chunk": 0, "s": 21.0, "e": 34.8, "t": " जे आसी भागती जानी परिहरहीं केवल ग्यान दे तुश्रम करहीं", "w": []}
{"chunk": 0, "s": 34.8, "e": 46.0, "t": " ते ज़ काम देन ग्रिह त्यागीं खोजत आपुप थि रहीं पेलागीं", "w": []}
{"chunk": 0, "s": 46.0, "e": 51.8, "t": " सुनुखखे सहरी भगती भिहाई", "w": []}
{"chunk": 0, "s": 51.8, "e": 57.44, "t": " जे सुख चाहे आनुपाई", "w": []}
{"chunk": 0, "s": 57.44, "e": 63.04, "t": " ते सत्महा सिंदू भीनु करनी", "w": []}
{"chunk": 0, "s": 63.04, "e": 68.76, "t": " पैरी पार चाहे ज़करनी", "w": []}
{"chunk": 0, "s": 68.76, "e": 74.32, "t": " सुन्वा सुन्दी के बचन भावानी", "w": []}
{"chunk": 0, "s": 74.32, "e": 79.64, "t": " बोलेउ गरुड़, रशीम्रे दुबानी", "w": []}
{"chunk": 0, "s": 79.64, "e": 85.42, "t": " तव प्रसाद प्रभु, मम उर्माही", "w": []}
{"chunk": 0, "s": 85.42, "e": 90.98, "t": " सन्से सोक मोहु, ब्रम्नाही", "w": []}
{"chunk": 0, "s": 90.98, "e": 96.72, "t": " सुने उंकुनीत राम, गुन ग्रामा", "w": []}
{"chunk": 0, "s": 96.72, "e": 102.16, "t": " तुम्हरी क्रिपा, लहें विश्रामा", "w": []}
{"chunk": 0, "s": 102.16, "e": 114.16, "t": " एक बात प्रभु पूच़ों तो ही कहुग जाए क्रिपाने दिमोही", "w": []}
{"chunk": 0, "s": 114.16, "e": 125.16, "t": " कही सम्त मुनी भेद पुराना नहीं कच्छुदर लब यान समाना", "w": []}
{"chunk": 0, "s": 125.16, "e": 130.82, "t": " सुई मुनि कुम सन कहे उबसाई", "w": []}
{"chunk": 0, "s": 130.82, "e": 136.16, "t": " नहीं आदरे हु बवगती की नाई", "w": []}
{"chunk": 0, "s": 136.16, "e": 142.16, "t": " या नहीं बवगती ही अंतर केता", "w": []}
{"chunk": 0, "s": 142.16, "e": 147.66, "t": " सकल कहु प्रभु ख्रिपान केता", "w": []}
{"chunk": 0, "s": 147.66, "e": 153.16, "t": " सुनि उर्गारी बचन सुक्माना", "w": []}
{"chunk": 0, "s": 153.16, "e": 159.16, "t": " सादर बोलेव, काग सुजाना", "w": []}
{"chunk": 0, "s": 159.16, "e": 164.16, "t": " बबगतिज्यानही, नहीं कच्छ भेदा", "w": []}
{"chunk": 0, "s": 164.16, "e": 170.16, "t": " उभाय रही, भाओ समखव खेदा", "w": []}
{"chunk": 0, "s": 170.16, "e": 176.16, "t": " नात्म नीस कहाई, कच्छ अंपर", "w": []}
{"chunk": 0, "s": 176.16, "e": 181.16, "t": " साव दान सोग, सुन भी हंग बर", "w": []}
{"chunk": 0, "s": 181.16, "e": 187.16, "t": " भी गान भी राग जोग भी गाना", "w": []}
{"chunk": 0, "s": 187.16, "e": 192.16, "t": " ए सब पुरुश सुनहो हरी जाना", "w": []}
{"chunk": 0, "s": 192.16, "e": 198.16, "t": " पुरुश प्रताप प्रभल सब भाथी", "w": []}
{"chunk": 0, "s": 198.16, "e": 205.16, "t": " आपला आबल सहज ज़जाती", "w": []}
{"chunk": 0, "s": 205.16, "e": 216.16, "t": " पूरुष्त्यागि सकनारिय, जो भिराख्त मत्दिदिर,", "w": []}
{"chunk": 0, "s": 216.16, "e": 227.16, "t": " नतुकामि भिश्याबस भी मुख्जु पद्रग्भीर,", "w": []}
{"chunk": 0, "s": 227.16, "e": 237.16, "t": " सो मुन्यान निदान म्रिग नयनी भिधु मुखनी रकि", "w": []}
{"chunk": 0, "s": 237.16, "e": 246.16, "t": " भिबस होई हरी जान नारी भिश्न माया प्रगता", "w": []}
{"chunk": 0, "s": 246.16, "e": 260.16, "t": " भीहान पच्पात कचुराखं भेद पुरान संथ मत्बाखं", "w": []}
{"chunk": 0, "s": 260.16, "e": 266.16, "t": " मुहन नारी नारी के रूपा", "w": []}
{"chunk": 0, "s": 266.16, "e": 271.66, "t": " पन्गारी यह रीति अनुपा", "w": []}
{"chunk": 0, "s": 271.66, "e": 277.16, "t": " माया बखति सुनहु तुम्हु तो", "w": []}
{"chunk": 0, "s": 277.16, "e": 283.16, "t": " नारी बरग जाने सब को", "w": []}
{"chunk": 0, "s": 283.16, "e": 288.66, "t": " उनिरग भी रही बखति प्यारी", "w": []}
{"chunk": 0, "s": 288.66, "e": 293.98, "t": " माया کھलु नरत की बीचारी", "w": []}
{"chunk": 0, "s": 293.98, "e": 299.8, "t": " बगते हिसानु पूल रगुराया", "w": []}
{"chunk": 0, "s": 299.8, "e": 305.32, "t": " ताते तेही दरपती अतिमाया", "w": []}
{"chunk": 0, "s": 305.32, "e": 311.24, "t": " राम भगती ने रुपम ने रुपादी", "w": []}
{"chunk": 0, "s": 311.24, "e": 316.74, "t": " बसअई जासु उर सदा अबादी", "w": []}
{"chunk": 0, "s": 316.74, "e": 322.06, "t": " तेही भिलो की माया सक चाई", "w": []}
{"chunk": 0, "s": 322.06, "e": 327.74, "t": " करिन सकई कच्षुः निज प्रब्ताई", "w": []}
{"chunk": 0, "s": 327.74, "e": 333.34, "t": " आस भीचारी जे मुनी भी यानी", "w": []}
{"chunk": 0, "s": 333.34, "e": 339.74, "t": " जाचे ही भगती सकल सुख खानी", "w": []}
{"chunk": 0, "s": 339.74, "e": 345.74, "t": " यह रहा से रगु नाथ कर", "w": []}
{"chunk": 0, "s": 345.74, "e": 361.74, "t": " भेगिन जानेई कोई, जो जानेई रगवु पतिक्रिपां सपने हु मोहन होई", "w": []}
{"chunk": 0, "s": 361.74, "e": 371.74, "t": " अगर उ ग्यान भगत कर भेद सुनहु सुप्रभीन", "w": []}
{"chunk": 0, "s": 371.74, "e": 380.74, "t": " जो सुन हो इ राम पद प्रीत सदा अभी चीन", "w": []}
{"chunk": 0, "s": 380.74, "e": 395.74, "t": " तो तात यह अकत कहानी समचत बनेन जाई बखानी", "w": []}
{"chunk": 0, "s": 395.74, "e": 406.74, "t": " इस्वर अंस जीव अबिनासी चेतन आमल सहज सुक्रासी", "w": []}
{"chunk": 0, "s": 406.74, "e": 412.54, "t": " सो माया बस भधयों को साई", "w": []}
{"chunk": 0, "s": 412.54, "e": 418.1, "t": " बधनो कीर मर कट की नाई", "w": []}
{"chunk": 0, "s": 418.1, "e": 423.74, "t": " ज़ज चेत नहीं गरन्खी परी गई", "w": []}
{"chunk": 0, "s": 423.74, "e": 429.58, "t": " जद पीम्रिखा चुटद कट की नहीं", "w": []}
{"chunk": 0, "s": 429.58, "e": 434.94, "t": " कब दे जीव भधयों सनसारी", "w": []}
{"chunk": 0, "s": 434.94, "e": 440.58, "t": " शुतन गरन्तिन औए सुखारी", "w": []}
{"chunk": 0, "s": 440.58, "e": 446.34, "t": " शुति पुरान भजु कहे उपाई", "w": []}
{"chunk": 0, "s": 446.34, "e": 451.98, "t": " शुतन अदिक अदिक अरुजाई", "w": []}
{"chunk": 0, "s": 451.98, "e": 457.78, "t": " जीव गर्दे तम्म वोलभिसेखी", "w": []}
{"chunk": 0, "s": 457.78, "e": 463.34, "t": " गरन्ति शुत्किन परईन लेखी", "w": []}
{"chunk": 0, "s": 463.34, "e": 468.5, "t": " अस सन्जोग इस जब कर एई", "w": []}
{"chunk": 0, "s": 468.5, "e": 474.34, "t": " तब हुख कदाचित सो निर अरेई", "w": []}
{"chunk": 0, "s": 474.34, "e": 479.9, "t": " सार्ट्विक श्थदा देनु सूहाई", "w": []}
{"chunk": 0, "s": 479.9, "e": 485.58, "t": " जो हरी करी पां क्रे दैंबस आई", "w": []}
{"chunk": 0, "s": 485.58, "e": 491.34, "t": " जब तप ब्रत जम नियम आपारा", "w": []}
{"chunk": 0, "s": 491.34, "e": 496.34, "t": " जेशुति कह सुभ दर्म आचारा", "w": []}
{"chunk": 0, "s": 497.34, "e": 502.34, "t": " तेद्रिन रधचरे जब गाई", "w": []}
{"chunk": 0, "s": 502.34, "e": 508.34, "t": " बाव बाचे सिस्वाई पिनाई", "w": []}
{"chunk": 0, "s": 508.34, "e": 513.34, "t": " नोईने व्रित्ति पात्र भिस्वासा", "w": []}
{"chunk": 0, "s": 514.34, "e": 519.34, "t": " निर्मल मन आहीर निज्दासा", "w": []}
{"chunk": 0, "s": 519.34, "e": 525.34, "t": " पर्म दर्म में पैदु ही भाई", "w": []}
{"chunk": 0, "s": 525.34, "e": 531.34, "t": " आवते अनल अकाम बनाई", "w": []}
{"chunk": 0, "s": 531.34, "e": 536.34, "t": " तोश मरुत तब च्यमा जुलावे", "w": []}
{"chunk": 0, "s": 536.34, "e": 542.34, "t": " द्रित सम जावनु देही जमावे", "w": []}
{"chunk": 0, "s": 542.34, "e": 547.34, "t": " मुदिताम दे बिचार मतानी", "w": []}
{"chunk": 0, "s": 547.34, "e": 553.34, "t": " दम अदार रजु साते सुबानी", "w": []}
{"chunk": 0, "s": 553.34, "e": 559.34, "t": " तब मत्खाडी लेई नावनी ता", "w": []}
{"chunk": 0, "s": 559.34, "e": 565.34, "t": " भीमल भी राग सुभग सुपुनी ता", "w": []}
{"chunk": 0, "s": 567.34, "e": 571.34, "t": " जोग अगिन करी प्रगत तब", "w": []}
{"chunk": 0, "s": 571.34, "e": 586.34, "t": " कर्म सुभा सुभलाय, बुद्धिस्यरावे जान ग्रित, मामतामल जरी जाय,", "w": []}
{"chunk": 0, "s": 586.34, "e": 591.34, "t": " तब भिग्यान रूपिनी", "w": []}
{"chunk": 0, "s": 591.34, "e": 596.34, "t": " बुद्धिभि सद ग्रित पाए", "w": []}
{"chunk": 0, "s": 596.34, "e": 599.34, "t": " चित दिया बहरी", "w": []}
{"chunk": 1, "s": 600.0, "e": 618.0, "t": " तीन आवास था तीनिगुन तेही का पास ते काडि", "w": []}
{"chunk": 1, "s": 618.0, "e": 628.0, "t": " तुल तुरी यसवारी पून बाती करे सुगाडि", "w": []}
{"chunk": 1, "s": 628.0, "e": 649.0, "t": " एह भी दीले से दीत। तेज रास भी गयान मैं जाते ही जास चमीप जर ही मदादिक सलभ सबा", "w": []}
{"chunk": 1, "s": 649.0, "e": 663.0, "t": " तब भव नुल देद भ्रमनासा प्रभल अदीद्या कर परिवारा अदीगा दिप शिखा सुई परम प्रचन्डा", "w": []}
{"chunk": 1, "s": 663.0, "e": 674.0, "t": " आतम अनुबवो सुख सुप्रकासा तब भव नुल देद भ्रमनासा", "w": []}
{"chunk": 1, "s": 674.0, "e": 679.64, "t": " प्रभल अदीद्या कर पर्वारा", "w": []}
{"chunk": 1, "s": 679.64, "e": 685.22, "t": " मोहा दी तम्मिटई आपारा", "w": []}
{"chunk": 1, "s": 685.22, "e": 691.04, "t": " तब सोई भूदि पाई उजी आरा", "w": []}
{"chunk": 1, "s": 691.04, "e": 696.58, "t": " वुरग्रिज बेख गरन्ति निर्वारा", "w": []}
{"chunk": 1, "s": 696.58, "e": 700.2, "t": " चोरन गरन्ति पाओ", "w": []}
{"chunk": 1, "s": 700.2, "e": 707.64, "t": " जों सोई तब यह जीओ ग्रितारत होई", "w": []}
{"chunk": 1, "s": 708.12, "e": 713.36, "t": " चोरत ग्रन्ती जान खगर आया", "w": []}
{"chunk": 1, "s": 713.76, "e": 719.04, "t": " भीगन अनेक करई तब माया", "w": []}
{"chunk": 1, "s": 719.4, "e": 724.52, "t": " रेद सीदि प्रे रही भजु भाई", "w": []}
{"chunk": 1, "s": 724.52, "e": 730.52, "t": " बूदि हि लोग दिखाव आई आई", "w": []}
{"chunk": 1, "s": 730.52, "e": 736.52, "t": " कल बल चल करी जाहि समीपा", "w": []}
{"chunk": 1, "s": 736.52, "e": 741.52, "t": " अन चल भात बूजाव आई दिपा", "w": []}
{"chunk": 1, "s": 741.52, "e": 747.52, "t": " औई बूदि जो परम सयानी", "w": []}
{"chunk": 1, "s": 747.52, "e": 752.52, "t": " तिन तन चितवन आनहित जानी", "w": []}
{"chunk": 1, "s": 752.52, "e": 758.52, "t": " जोते ही भीगन भूदि नहीं बादि", "w": []}
{"chunk": 1, "s": 758.52, "e": 764.52, "t": " तो भोहोरी सुर्ट करही उपादि", "w": []}
{"chunk": 1, "s": 764.52, "e": 769.52, "t": " आंदरी दुार जरो काना आना", "w": []}
{"chunk": 1, "s": 769.52, "e": 775.52, "t": " ताहताह सुर्ट बैटे करिथाना", "w": []}
{"chunk": 1, "s": 775.52, "e": 780.52, "t": " आवत देखाही भीश्टे पयारी", "w": []}
{"chunk": 1, "s": 780.52, "e": 786.52, "t": " तेहत्ति देहि कपात उगारी", "w": []}
{"chunk": 1, "s": 786.52, "e": 792.52, "t": " जब सो प्रभन जन उरग्रिज जाई", "w": []}
{"chunk": 1, "s": 792.52, "e": 797.52, "t": " तबहि दिप भी ग्यान भुजाई", "w": []}
{"chunk": 1, "s": 797.52, "e": 803.52, "t": " गरन्ति न छुटि मितासो प्रकासा", "w": []}
{"chunk": 1, "s": 803.52, "e": 809.52, "t": " बूदि भिकले भई भिश्ये बतासा", "w": []}
{"chunk": 1, "s": 809.52, "e": 814.84, "t": " इंद्रिंघ, रशुर, नन, ग्यान, सुहाई", "w": []}
{"chunk": 1, "s": 814.84, "e": 820.52, "t": " भिश्य यवोग पर प्रीटी सदाई", "w": []}
{"chunk": 1, "s": 820.52, "e": 826.12, "t": " भिश्य समीर, वूदि, क्रित, भूरी", "w": []}
{"chunk": 1, "s": 826.12, "e": 833.12, "t": " तेही भिदि, भिपको, बार, भाहोरी", "w": []}
{"chunk": 1, "s": 833.12, "e": 845.12, "t": " तब फिर जीव भी भी भी भी भी, पावए सन्स्त्रिठ क्लेस,", "w": []}
{"chunk": 1, "s": 845.12, "e": 854.12, "t": " लरी माया अती दूस्तर तरीन जाए भीहगेस,", "w": []}
{"chunk": 1, "s": 854.12, "e": 864.12, "t": " कहत कठिन समजद कठिन सादद कठिन भी बेख", "w": []}
{"chunk": 1, "s": 864.12, "e": 874.12, "t": " होई गुना चरनय जाए पूनि प्रत्योग अनेक", "w": []}
{"chunk": 1, "s": 874.12, "e": 888.12, "t": " गियान पन्त क्रिपान के दारा परत खगेस खोई नहीं बारा", "w": []}
{"chunk": 1, "s": 888.12, "e": 899.12, "t": " जो निर भीगन पन्त निर भहाई सो कैवल्य परम पडलई", "w": []}
{"chunk": 1, "s": 899.12, "e": 905.12, "t": " अति दूर लव कैवल लपरम पद", "w": []}
{"chunk": 1, "s": 905.12, "e": 911.12, "t": " सन्त पुरान निगम आगम बद", "w": []}
{"chunk": 1, "s": 911.12, "e": 916.12, "t": " राम भजत सोई मुखति बुसाई", "w": []}
{"chunk": 1, "s": 916.12, "e": 922.12, "t": " आन इछित आवएई बरियाई", "w": []}
{"chunk": 1, "s": 922.12, "e": 927.12, "t": " जिमि ठल बिनु जल रहिन सकाई", "w": []}
{"chunk": 1, "s": 927.12, "e": 932.12, "t": " तदा मोच सुख सुनुख खराई", "w": []}
{"chunk": 1, "s": 932.12, "e": 938.12, "t": " रहिन सकः रहि रहि भगती बिहाई", "w": []}
{"chunk": 1, "s": 938.12, "e": 943.12, "t": " आस भीचारी रहि भगत सयाने", "w": []}
{"chunk": 1, "s": 943.12, "e": 949.12, "t": " मुखती निरादर भगती लुबाने", "w": []}
{"chunk": 1, "s": 949.12, "e": 954.12, "t": " भगती को तबाई बिश्वाई", "w": []}
{"chunk": 1, "s": 954.12, "e": 960.12, "t": " अगती करत भीनु जतन प्रयासा", "w": []}
{"chunk": 1, "s": 960.12, "e": 966.12, "t": " संस्री तिमूल अभी ध्यानासा", "w": []}
{"chunk": 1, "s": 966.12, "e": 972.12, "t": " ओजन करीय प्रिपिती हित्लागी", "w": []}
{"chunk": 1, "s": 972.12, "e": 978.12, "t": " जी मिसो आसन पच्वए जध्ध्रागी", "w": []}
{"chunk": 1, "s": 978.12, "e": 984.12, "t": " आस इहरी भागती सुगम सुख्दाई", "w": []}
{"chunk": 1, "s": 984.12, "e": 991.12, "t": " को आस मुड़न जाही सुहाई", "w": []}
{"chunk": 1, "s": 992.12, "e": 997.12, "t": " सी वक से ब्यभाव बिन", "w": []}
{"chunk": 1, "s": 997.12, "e": 1002.12, "t": " भावन परी आवुर गारी", "w": []}
{"chunk": 1, "s": 1002.12, "e": 1006.12, "t": " बजज उराम पद पन्कज", "w": []}
{"chunk": 1, "s": 1006.12, "e": 1011.12, "t": " आज अस से दानत भीचारी", "w": []}
{"chunk": 1, "s": 1012.12, "e": 1016.12, "t": " जो चे तन कह ज़ग करए", "w": []}
{"chunk": 1, "s": 1017.12, "e": 1021.12, "t": " ज़ही करए चैटन", "w": []}
{"chunk": 1, "s": 1022.12, "e": 1025.12, "t": " आस समर खर गुनाय कही", "w": []}
{"chunk": 1, "s": 1026.12, "e": 1031.12, "t": " बजगी जीवते दन्न", "w": []}
{"chunk": 1, "s": 1031.12, "e": 1044.66, "t": " उग्यान सीदान्त भूजाई, सुनहु भगती मन के प्रभ्ताई,", "w": []}
{"chunk": 1, "s": 1044.66, "e": 1056.36, "t": " राम भगती चिंता मन सुन्दर, भस्य गरुड्जाके उर अन्तर,", "w": []}
{"chunk": 1, "s": 1056.36, "e": 1061.68, "t": " परम प्रकास रोप दिन राती", "w": []}
{"chunk": 1, "s": 1061.68, "e": 1067.36, "t": " नहीं कच्छचवी यड्या ग्रित बाती", "w": []}
{"chunk": 1, "s": 1067.36, "e": 1073.08, "t": " मोहदरीद्र निकखत नहीं यावा", "w": []}
{"chunk": 1, "s": 1073.08, "e": 1078.64, "t": " लोग बात नहीं ताही भुजावा", "w": []}
{"chunk": 1, "s": 1078.64, "e": 1084.32, "t": " प्रभल अभीदा तम मिट जाही", "w": []}
{"chunk": 1, "s": 1084.32, "e": 1089.64, "t": " आरें सकल सलभ समदाई", "w": []}
{"chunk": 1, "s": 1089.64, "e": 1095.44, "t": " खल का मादिनी कट नहीं", "w": []}
{"chunk": 1, "s": 1095.44, "e": 1101.04, "t": " बस़ई भगत जाके वूर्माई", "w": []}
{"chunk": 1, "s": 1101.04, "e": 1106.76, "t": " गरल सुदासम अरिठ होए", "w": []}
{"chunk": 1, "s": 1106.76, "e": 1112.32, "t": " तेही मनी भीनु सुख पाव नकोई", "w": []}
{"chunk": 1, "s": 1112.32, "e": 1117.32, "t": " द्यापविमानस रोगन बारी", "w": []}
{"chunk": 1, "s": 1117.32, "e": 1123.32, "t": " जिनके बस सब जीव दुखारी", "w": []}
{"chunk": 1, "s": 1123.32, "e": 1129.32, "t": " राम भगत मनी उर पस जाके", "w": []}
{"chunk": 1, "s": 1129.32, "e": 1135.32, "t": " दुखलवले सन सपने हुताके", "w": []}
{"chunk": 1, "s": 1135.32, "e": 1140.32, "t": " चतृर सी रो मनी दीजग माही", "w": []}
{"chunk": 1, "s": 1140.32, "e": 1146.32, "t": " जे मनि लागि सुजतन कराई", "w": []}
{"chunk": 1, "s": 1146.32, "e": 1152.32, "t": " सो मनि जदबि प्रगत जग आहाई", "w": []}
{"chunk": 1, "s": 1152.32, "e": 1157.32, "t": " रामद भि पाबिनु नहीं को लहाई", "w": []}
{"chunk": 1, "s": 1157.32, "e": 1163.32, "t": " सुगम उपाए पाए भे केरे", "w": []}
{"chunk": 1, "s": 1163.32, "e": 1169.32, "t": " नरहत भाग्डे हिभध भेरे", "w": []}
{"chunk": 1, "s": 1169.32, "e": 1174.64, "t": " पावन पर्बत भेद पुराना", "w": []}
{"chunk": 1, "s": 1174.64, "e": 1180.32, "t": " राम कता रुच्रा करनाना", "w": []}
{"chunk": 1, "s": 1180.32, "e": 1185.92, "t": " मर्मी सचन सुमति कुदारी", "w": []}
{"chunk": 1, "s": 1185.92, "e": 1191.72, "t": " ग्यान भिराग नयन उर्गारी", "w": []}
{"chunk": 1, "s": 1191.72, "e": 1197.32, "t": " बाव सहित खोजई जो प्रानी", "w": []}
{"chunk": 1, "s": 1197.32, "e": 1199.98, "t": " पाव बगत्ती मनी", "w": []}
{"chunk": 2, "s": 1200.0, "e": 1225.32, "t": " सब सुख्khāṇi, मोरे मन, प्रभू, आस्भी स्वासा, रामते अदिक, राम कर्दासा, राम सिंदूगन, सच्चन दीरा, चंदन तरु, हरी, संत समीरा,", "w": []}
{"chunk": 2, "s": 1225.32, "e": 1231.32, "t": " सब कर प्हल रही भगत सुहाई", "w": []}
{"chunk": 2, "s": 1231.32, "e": 1236.32, "t": " सो भीन संटन काहु पाई", "w": []}
{"chunk": 2, "s": 1236.32, "e": 1242.32, "t": " अस भीचारी जोई कर सत संगा", "w": []}
{"chunk": 2, "s": 1242.32, "e": 1248.32, "t": " राम भगती तही सुढ़भ भिहंगा", "w": []}
{"chunk": 2, "s": 1248.32, "e": 1259.32, "t": " ब्रम्ह पयोनि दिमन्दर ग्यान संट सुर आहि", "w": []}
{"chunk": 2, "s": 1259.32, "e": 1268.32, "t": " कता सुदामत्ति काडहि भागत्मदुरे ताजाय।", "w": []}
{"chunk": 2, "s": 1268.32, "e": 1279.32, "t": " बीरत चर्म अस्ज्यान मद, लोभ मोहरिप मारी,", "w": []}
{"chunk": 2, "s": 1279.32, "e": 1289.32, "t": " जै पाए यसो हरी भगती देख हु खगे से बीचारी.", "w": []}
{"chunk": 2, "s": 1289.32, "e": 1303.32, "t": " वूनि सप्रेम बोले उखगराओ जोग्रिपाल मही उपर बाओ", "w": []}
{"chunk": 2, "s": 1303.32, "e": 1314.32, "t": " नात्मोही निज सेवक जानी साभ्द प्रास्न मम कहो भखानी", "w": []}
{"chunk": 2, "s": 1314.32, "e": 1320.32, "t": " प्रत्ठ मही कहा हु नाध्मत दीरा", "w": []}
{"chunk": 2, "s": 1320.32, "e": 1325.32, "t": " सब ते दूलव कवन सरी़ा", "w": []}
{"chunk": 2, "s": 1325.32, "e": 1331.32, "t": " बडदूख कवन कवन सुखबारी", "w": []}
{"chunk": 2, "s": 1331.32, "e": 1337.32, "t": " सो संछे पही कहा हो भीचारी", "w": []}
{"chunk": 2, "s": 1337.32, "e": 1342.32, "t": " संत असंत माराम तुम जान हु", "w": []}
{"chunk": 2, "s": 1342.32, "e": 1348.32, "t": " तिन्ह कर सज्य सुबाव बखान हूँ", "w": []}
{"chunk": 2, "s": 1348.32, "e": 1353.32, "t": " कवन पून्नश्रूति भिदित भिसाला", "w": []}
{"chunk": 2, "s": 1353.32, "e": 1359.32, "t": " कहु कवन अग परम कराला", "w": []}
{"chunk": 2, "s": 1359.32, "e": 1365.32, "t": " मानस रोग कहु समजाई", "w": []}
{"chunk": 2, "s": 1365.32, "e": 1370.32, "t": " तुम सर्वाग्य क्रिपाख अदिकाई", "w": []}
{"chunk": 2, "s": 1370.32, "e": 1382.32, "t": " तात सुनव सादर अतित्रीती मैं संछेप कहाँ यहनीती", "w": []}
{"chunk": 2, "s": 1382.32, "e": 1393.32, "t": " नरतन सम नहीं कवनी उदेही जीव चराचर जाचते ही", "w": []}
{"chunk": 2, "s": 1393.32, "e": 1399.32, "t": " नरक स्वर्ग अप भर्ग न सेनी", "w": []}
{"chunk": 2, "s": 1399.32, "e": 1404.32, "t": " यान भिराग भगत सुभदेनी", "w": []}
{"chunk": 2, "s": 1404.32, "e": 1410.32, "t": " सो तन दहरी रही भजहीन जेनर", "w": []}
{"chunk": 2, "s": 1410.32, "e": 1416.32, "t": " हो ही नभी शेरत मंद मंद तर", "w": []}
{"chunk": 2, "s": 1416.32, "e": 1421.32, "t": " का चकी रिची बदले ते ले ही", "w": []}
{"chunk": 2, "s": 1421.32, "e": 1427.32, "t": " करते डारी परस मनि देहीं", "w": []}
{"chunk": 2, "s": 1427.32, "e": 1433.32, "t": " नहीं दरीद्र सम्थ दुखजग माहीं", "w": []}
{"chunk": 2, "s": 1433.32, "e": 1438.32, "t": " संत मिलन सम्थ सुखजग नाहीं", "w": []}
{"chunk": 2, "s": 1438.32, "e": 1444.32, "t": " पर उपकार बचन मन काया", "w": []}
{"chunk": 2, "s": 1444.32, "e": 1450.32, "t": " संत सहज सुभाओ खगराया", "w": []}
{"chunk": 2, "s": 1450.32, "e": 1455.64, "t": " संत सही दुख परहित लागी", "w": []}
{"chunk": 2, "s": 1456.04, "e": 1461.32, "t": " पर दुख हे तुव असंत अब आगी", "w": []}
{"chunk": 2, "s": 1461.72, "e": 1466.92, "t": " वूर्ज तरुसम संत क्रिपाला", "w": []}
{"chunk": 2, "s": 1467.32, "e": 1472.56, "t": " परहित निती सह भिपती भिसाला", "w": []}
{"chunk": 2, "s": 1472.88, "e": 1478.28, "t": " सन इव खल पर पन्दन कराई", "w": []}
{"chunk": 2, "s": 1478.28, "e": 1484.08, "t": " खाल कराई भिपती सहिमरई", "w": []}
{"chunk": 2, "s": 1484.08, "e": 1489.68, "t": " खल बिन स्वारत पर अपकारी", "w": []}
{"chunk": 2, "s": 1489.68, "e": 1495.28, "t": " आहिम उषक इव सुन उर्गारी", "w": []}
{"chunk": 2, "s": 1495.28, "e": 1501.08, "t": " पर समपडा भिनासिन साही", "w": []}
{"chunk": 2, "s": 1501.08, "e": 1506.68, "t": " जिम ससी हतिहिम उपल भिलाही", "w": []}
{"chunk": 2, "s": 1506.68, "e": 1517.68, "t": " दोश्ट उदे जग आरति हे तु, जठा प्रसीध पनाम गरा के तु,", "w": []}
{"chunk": 2, "s": 1517.68, "e": 1528.68, "t": " संत उदे संतत सुखकारी, भी स्वस्वखद जिनी इंदो तमारी,", "w": []}
{"chunk": 2, "s": 1528.68, "e": 1534.68, "t": " पर्मदर्मश्रूति भिदित आहिन्सा", "w": []}
{"chunk": 2, "s": 1534.68, "e": 1540.68, "t": " परनिंदासम आगन गरीसा", "w": []}
{"chunk": 2, "s": 1540.68, "e": 1545.68, "t": " रगुर निंदक दादूर होई", "w": []}
{"chunk": 2, "s": 1545.68, "e": 1551.68, "t": " जन्म साज्र पावतन सोई", "w": []}
{"chunk": 2, "s": 1551.68, "e": 1554.68, "t": " दूज निंदक भहु", "w": []}
{"chunk": 2, "s": 1554.68, "e": 1562.88, "t": " नरक भोग करी जग जन मैं बाया सर सरीर दरी", "w": []}
{"chunk": 2, "s": 1563.38, "e": 1568.5, "t": " सुर्शुत निंदक जे अभिमानी", "w": []}
{"chunk": 2, "s": 1568.94, "e": 1574.1, "t": " रो रो नरक परहीते प्रानी", "w": []}
{"chunk": 2, "s": 1574.1, "e": 1585.1, "t": " खोहि कुलुक संत निंदारत, मोहनि साप्रिय ज्यान मानुगत", "w": []}
{"chunk": 2, "s": 1585.1, "e": 1596.1, "t": " सब कै निंदाजे ज़ड करही, ते चम गादुर, खोई आवतरही", "w": []}
{"chunk": 2, "s": 1596.1, "e": 1602.1, "t": " पुप ज़ेही भगु सुनूथ तात आभ मानस रोगा", "w": []}
{"chunk": 2, "s": 1602.1, "e": 1608.1, "t": " जिनहते दुख पावई सब लोगा", "w": []}
{"chunk": 2, "s": 1608.1, "e": 1614.1, "t": " मूह सकल भ्यादिन कर मुला", "w": []}
{"chunk": 2, "s": 1614.1, "e": 1619.1, "t": " तिनहते पुप ज़ेही बहु सुला", "w": []}
{"chunk": 2, "s": 1619.1, "e": 1625.1, "t": " काम बात कप लोग आपारा", "w": []}
{"chunk": 2, "s": 1625.1, "e": 1631.1, "t": " प्रोदखित नित चातिजारा", "w": []}
{"chunk": 2, "s": 1631.1, "e": 1636.1, "t": " प्रीति करहें जाए तीने उभाई", "w": []}
{"chunk": 2, "s": 1636.1, "e": 1642.1, "t": " उपजैई सन्ने पात दुख्डाई", "w": []}
{"chunk": 2, "s": 1642.1, "e": 1648.1, "t": " भिश्य मनोरत दूर्गम नाना", "w": []}
{"chunk": 2, "s": 1648.1, "e": 1653.1, "t": " ते सब सुल नाम को जाना", "w": []}
{"chunk": 2, "s": 1653.1, "e": 1659.1, "t": " मम्ता दादु कन्दु इर्शाई", "w": []}
{"chunk": 2, "s": 1659.1, "e": 1665.1, "t": " रश्विशाद गराभ उताई", "w": []}
{"chunk": 2, "s": 1665.1, "e": 1670.1, "t": " पर सुखदेखि जरनी सोई चाई", "w": []}
{"chunk": 2, "s": 1670.1, "e": 1676.1, "t": " कोश्ट दोश्ट ता मनको टिलए", "w": []}
{"chunk": 2, "s": 1676.1, "e": 1681.1, "t": " आंकार अति तुखद तमरूँ", "w": []}
{"chunk": 2, "s": 1681.1, "e": 1687.1, "t": " दम्ब कपट्मद मान ने हरुवा", "w": []}
{"chunk": 2, "s": 1687.1, "e": 1693.1, "t": " त्रेश्ना उदर ब्रीधि अतिभारी", "w": []}
{"chunk": 2, "s": 1693.1, "e": 1698.1, "t": " त्रीभिद इश्ना परुन तिजारी", "w": []}
{"chunk": 2, "s": 1698.1, "e": 1704.1, "t": " जुग भिदिजवर मत्सर अभीबे का", "w": []}
{"chunk": 2, "s": 1704.1, "e": 1710.22, "t": " कहल गी कहां कुरोग अने का", "w": []}
{"chunk": 2, "s": 1710.22, "e": 1715.9, "t": " एक ब्यादि बस नर्मरे है", "w": []}
{"chunk": 2, "s": 1715.9, "e": 1721.1, "t": " एसादि भजब्यादि", "w": []}
{"chunk": 2, "s": 1721.1, "e": 1725.9, "t": " पीडहि संतत जीव कहु", "w": []}
{"chunk": 2, "s": 1725.9, "e": 1730.9, "t": " सो की मिल एशमादि", "w": []}
{"chunk": 2, "s": 1730.9, "e": 1741.9, "t": " नेम दर्म आचार तप ग्यान जग्य जब्दान", "w": []}
{"chunk": 2, "s": 1741.9, "e": 1751.9, "t": " बेश जपुनि कोटिन है नहीं प्रोग जाही हरी जान", "w": []}
{"chunk": 2, "s": 1751.9, "e": 1760.74, "t": " यही भीद्फिसा कल जीव जग रोगी", "w": []}
{"chunk": 2, "s": 1760.74, "e": 1766.38, "t": " सोग एडष भएए प्रीत भी योगी", "w": []}
{"chunk": 2, "s": 1766.38, "e": 1771.94, "t": " मानस रोग काछुक मैगाए", "w": []}
{"chunk": 2, "s": 1771.94, "e": 1777.7, "t": " हैं, सब के लगी भिर लेंड पाए", "w": []}
{"chunk": 2, "s": 1777.7, "e": 1783.34, "t": " जाने ते चीजही कच्षुपापी", "w": []}
{"chunk": 2, "s": 1783.34, "e": 1789.02, "t": " नासन पाभई ही जन परितापी", "w": []}
{"chunk": 2, "s": 1789.02, "e": 1794.7, "t": " भिशय कुपाच पाई अंकुरे", "w": []}
{"chunk": 2, "s": 1794.7, "e": 1800.02, "t": " मुनि हुफिदेका नर्बापुरे", "w": []}
{"chunk": 3, "s": 1800.0, "e": 1805.96, "t": " राम क्रिपां नासही सब रोगा", "w": []}
