{"chunk": 3, "s": 2235.62, "e": 2241.34, "t": " करहीन भिनु से मम स्वामी", "w": []}
{"chunk": 3, "s": 2241.34, "e": 2247.34, "t": " राम नमामी, नमामी, नमामी,", "w": []}
