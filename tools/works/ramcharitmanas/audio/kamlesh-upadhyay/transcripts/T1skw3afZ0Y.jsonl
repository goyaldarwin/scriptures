{"chunk": 0, "s": 30.0, "e": 36.0, "t": " तो उसो न सरग ता आजी न प्याए", "w": []}
{"chunk": 0, "s": 36.0, "e": 43.0, "t": " मंगल भामन, मंगल आजाए", "w": []}
{"chunk": 0, "s": 43.0, "e": 50.0, "t": " तो उसो न सरग ता आजी न प्याए", "w": []}
{"chunk": 0, "s": 52.0, "e": 58.0, "t": " वुंदें दीवर सुंदरा वति पलो", "w": []}
{"chunk": 0, "s": 58.0, "e": 63.12, "t": " विग्यान दामा वुबवु", "w": []}
{"chunk": 0, "s": 63.12, "e": 67.72, "t": " शोभाड्यो वर्दन विनो", "w": []}
{"chunk": 0, "s": 67.72, "e": 75.4, "t": " श्र्तिन तो गोभि प्रविंद प्रियां", "w": []}
{"chunk": 0, "s": 75.4, "e": 79.6, "t": " माया मानुशरू पिडाउ", "w": []}
{"chunk": 0, "s": 79.6, "e": 82.32, "t": " रग्वराउ", "w": []}
{"chunk": 0, "s": 82.32, "e": 88.32, "t": " सद्द्ध्यल्मवर्मवूएतू", "w": []}
{"chunk": 0, "s": 88.32, "e": 95.32, "t": " सीतान्वेश़ तत्परो पत्गतो", "w": []}
{"chunk": 0, "s": 95.32, "e": 103.32, "t": " भख्ती प्रदो तो हीना", "w": []}
{"chunk": 0, "s": 103.32, "e": 107.32, "t": " ब्रम्हाम भोदि समुद्भवम", "w": []}
{"chunk": 0, "s": 107.32, "e": 115.32, "t": " कली मले प्रद्वं सनम चाभ्यायं", "w": []}
{"chunk": 0, "s": 115.32, "e": 121.32, "t": " श्री मच्छंभ मुखें दूसुं दर्वरे", "w": []}
{"chunk": 0, "s": 121.32, "e": 128.32, "t": " सन्शो भी तम सर्वदा", "w": []}
{"chunk": 0, "s": 128.32, "e": 134.32, "t": " सन्सारा मयवेशजं सुक्करम", "w": []}
{"chunk": 0, "s": 134.32, "e": 140.32, "t": " श्रीजान की जेवनं", "w": []}
{"chunk": 0, "s": 141.32, "e": 147.32, "t": " द्हन्यास्ते क्रितिना पिवन्ति", "w": []}
{"chunk": 0, "s": 147.32, "e": 154.32, "t": " सत्तम श्रीराम नामाम्रितम", "w": []}
{"chunk": 0, "s": 154.32, "e": 161.32, "t": " वगद जन्म वहिजानी ग्यान खानी अग्हानी कर,", "w": []}
{"chunk": 0, "s": 161.32, "e": 169.32, "t": " जह बस संभु भवानी सो कासी से यकसना,", "w": []}
{"chunk": 0, "s": 169.32, "e": 177.32, "t": " जरत सकल सुर ब्रिंद,", "w": []}
{"chunk": 0, "s": 177.32, "e": 197.32, "t": " जरत सकल सुर ब्रिंद बिशम गरल जेहि पान किय तिहिन भजसी मन्मन्द को क्रिपाल संकर सरिसार", "w": []}
{"chunk": 0, "s": 197.32, "e": 222.64, "t": " आगे चले बहुरी रगुराया रिश मुक परबत नियराया ताहरा सचीव सहित सोगरीवा आवत देखी अतुल बल सीवा", "w": []}
{"chunk": 0, "s": 222.64, "e": 228.64, "t": " अति सभीत का सुन्हन माना", "w": []}
{"chunk": 0, "s": 228.64, "e": 233.64, "t": " पूरुश्जगल बल रूप निदाना", "w": []}
{"chunk": 0, "s": 233.64, "e": 239.64, "t": " भारी बत रूप देखुते जाई", "w": []}
{"chunk": 0, "s": 239.64, "e": 245.64, "t": " कहे सुजानी जीं सैन भुजाई", "w": []}
{"chunk": 0, "s": 245.64, "e": 248.64, "t": " बत्धे बाली होई", "w": []}
{"chunk": 0, "s": 248.64, "e": 268.64, "t": " बागों तुरत तजुं यर सेला बेप्र दूप दहरे का पिता हु आप आई पुचत आस्भाया।", "w": []}
{"chunk": 0, "s": 268.64, "e": 273.64, "t": " उ तुम्ह स्यामल गवर सरीरा", "w": []}
{"chunk": 0, "s": 273.64, "e": 279.64, "t": " चात्री रूप थिराहु बन भीरा", "w": []}
{"chunk": 0, "s": 279.64, "e": 285.64, "t": " कट्पिन भूमी को मल पद्गामी", "w": []}
{"chunk": 0, "s": 285.64, "e": 290.64, "t": " ववन हे तु बिच्ड़ाहु बन स्वामी", "w": []}
{"chunk": 0, "s": 290.64, "e": 296.64, "t": " मरी दुल मनु हर सुंदर गाता", "w": []}
{"chunk": 0, "s": 296.64, "e": 301.76, "t": " साथ ते दु सबन आतक बाता", "w": []}
{"chunk": 0, "s": 302.28, "e": 307.6, "t": " की तुम तीन देव महको", "w": []}
{"chunk": 0, "s": 307.84, "e": 313.68, "t": " नरना रायन की तुम दो", "w": []}
{"chunk": 0, "s": 317.08, "e": 320.68, "t": " जग कारन तारन भव", "w": []}
{"chunk": 0, "s": 321.28, "e": 326.12, "t": " बन जन दरनी बार", "w": []}
{"chunk": 0, "s": 326.64, "e": 335.64, "t": " की तुम अख्ल भूवन पती लीन मनुज अवतार", "w": []}
{"chunk": 0, "s": 338.64, "e": 349.64, "t": " औस लेस दस रठ के जाए, हम पित बचन मानिवन आए", "w": []}
{"chunk": 0, "s": 349.64, "e": 355.64, "t": " नाम राम लच्छ्मन दोबाई", "w": []}
{"chunk": 0, "s": 355.64, "e": 360.64, "t": " संग नारी सुक्मारे सुराई", "w": []}
{"chunk": 0, "s": 360.64, "e": 366.64, "t": " इहा रही निस चर बैदे ही", "w": []}
{"chunk": 0, "s": 366.64, "e": 372.64, "t": " भे प्रप्रही हम खोजते ही", "w": []}
{"chunk": 0, "s": 372.64, "e": 377.64, "t": " आपन चरीत कहाम गाई", "w": []}
{"chunk": 0, "s": 377.64, "e": 383.64, "t": " विप्र निज़ कता बुजाई", "w": []}
{"chunk": 0, "s": 383.64, "e": 389.64, "t": " ब्रभू पहिचानि पारे उग़े चरना", "w": []}
{"chunk": 0, "s": 389.64, "e": 394.64, "t": " सो सुख उमा जाई नहीं बरना", "w": []}
{"chunk": 0, "s": 394.64, "e": 400.64, "t": " वो लेकित तन मुख आवन बचना", "w": []}
{"chunk": 0, "s": 400.64, "e": 406.64, "t": " देखध रुचिर बेश्खे रचना", "w": []}
{"chunk": 0, "s": 406.64, "e": 411.96, "t": " उनिदि रज दहरी आस्तुति की नहीं", "w": []}
{"chunk": 0, "s": 411.96, "e": 417.64, "t": " फरशव देनिज नात ही चीन हीं", "w": []}
{"chunk": 0, "s": 417.64, "e": 423.3, "t": " मोर ना अ मैं पूचा साईं", "w": []}
{"chunk": 0, "s": 423.3, "e": 428.8, "t": " तुम पूचा हु कस नर की नाईं", "w": []}
{"chunk": 0, "s": 428.8, "e": 434.6, "t": " पव माया बस खिराउ भूनाना", "w": []}
{"chunk": 0, "s": 434.6, "e": 440.6, "t": " ताते मैं नहीं प्रभू पही चाना", "w": []}
{"chunk": 0, "s": 443.6, "e": 447.6, "t": " एक मैं मडमोह बस", "w": []}
{"chunk": 0, "s": 448.6, "e": 452.6, "t": " पुटि लग्रिदे आग्यान", "w": []}
{"chunk": 0, "s": 453.6, "e": 457.6, "t": " पुनि प्रभू मोही भिसारे उ", "w": []}
{"chunk": 0, "s": 458.6, "e": 462.6, "t": " दीन बन्द भाग्वान", "w": []}
{"chunk": 0, "s": 464.6, "e": 476.6, "t": " जद पिनात भवु आवगुन मोरे सेवक प्रभूँँ परे जन मोरे", "w": []}
{"chunk": 0, "s": 476.6, "e": 487.6, "t": " आप जीव तव माया मोहा सोनि स्तरै तुमहारे इचोहा", "w": []}
{"chunk": 0, "s": 487.6, "e": 493.6, "t": " ता पर मैं रभ्भीर दोहाई", "w": []}
{"chunk": 0, "s": 493.6, "e": 498.6, "t": " जानाउ नहीं कच्छु भजन उपाई", "w": []}
{"chunk": 0, "s": 498.6, "e": 504.6, "t": " सेवक सुत पती मात बहरो से", "w": []}
{"chunk": 0, "s": 504.6, "e": 510.6, "t": " रहाई असोच बनेई प्रभुंपो से", "w": []}
{"chunk": 0, "s": 510.6, "e": 516.6, "t": " आस कै पहरे उचरन अक्लाई", "w": []}
{"chunk": 0, "s": 516.6, "e": 521.92, "t": " निज तन प्रगडी प्रीप वुर चाई", "w": []}
{"chunk": 0, "s": 521.92, "e": 527.76, "t": " तब रग पती उठाई उर लावा", "w": []}
{"chunk": 0, "s": 527.76, "e": 533.2, "t": " निज लो चन जल सीच जुडावा", "w": []}
{"chunk": 0, "s": 533.2, "e": 539.04, "t": " सुन कपी जी न मानसे जन उना", "w": []}
{"chunk": 0, "s": 539.04, "e": 544.6, "t": " आई मम प्रीः लच्मन ते दूना", "w": []}
{"chunk": 0, "s": 544.6, "e": 550.6, "t": " सम्दर्सी मोहु का सब को", "w": []}
{"chunk": 0, "s": 550.6, "e": 556.6, "t": " सेवक प्रियएद अनन्या गधी सो", "w": []}
{"chunk": 0, "s": 559.6, "e": 563.6, "t": " सो अनन्य जाके यसित", "w": []}
{"chunk": 0, "s": 563.6, "e": 569.6, "t": " मतिन तरही हनमन्क", "w": []}
{"chunk": 0, "s": 569.6, "e": 573.6, "t": " मैं सेवक सचर आचर", "w": []}
{"chunk": 0, "s": 573.6, "e": 578.4, "t": " रूप स्वामि भग्वन्त", "w": []}
{"chunk": 0, "s": 581.6, "e": 587.4, "t": " देखि पवन सुत्प, पति अन्पूला", "w": []}
{"chunk": 0, "s": 587.4, "e": 592.8, "t": " ख्रेदय रश्भ, भी ती सब सुला", "w": []}
{"chunk": 0, "s": 592.8, "e": 598.6, "t": " नात सेल पर कपि पति रहा है", "w": []}
{"chunk": 0, "s": 598.6, "e": 600.6, "t": " सो सुग्रि", "w": []}
{"chunk": 1, "s": 600.0, "e": 615.0, "t": " तेहि सननात मयात्रे कीजे दीन जान तेहि अभाया करीजे", "w": []}
{"chunk": 1, "s": 615.0, "e": 621.0, "t": " सो सी ता कर फोज कराई", "w": []}
{"chunk": 1, "s": 621.0, "e": 627.0, "t": " जहत हमर कत बोटी पताई", "w": []}
{"chunk": 1, "s": 627.0, "e": 632.0, "t": " इभी दिसा कल कता समजाई", "w": []}
{"chunk": 1, "s": 632.0, "e": 638.0, "t": " लिए ब्दोजन पीट चनाई", "w": []}
{"chunk": 1, "s": 638.0, "e": 642.0, "t": " जब सुगरी वो राम", "w": []}
{"chunk": 1, "s": 642.0, "e": 649.08, "t": " अब देखा अतिसे जंँम दन कर लेखा", "w": []}
{"chunk": 1, "s": 649.08, "e": 655.0, "t": " सादर मिलेव नाई पद्मा था", "w": []}
{"chunk": 1, "s": 655.0, "e": 660.44, "t": " भेट्यो अनुज सहित रवना था", "w": []}
{"chunk": 1, "s": 660.44, "e": 666.24, "t": " कपि कर मन भिचार एह रीती", "w": []}
{"chunk": 1, "s": 666.24, "e": 672.24, "t": " करिया ही भिदिमो सन एप रिटे", "w": []}
{"chunk": 1, "s": 674.24, "e": 683.24, "t": " तब हन मन्त उभाए दिसी की सब कता सूनाई", "w": []}
{"chunk": 1, "s": 684.24, "e": 694.24, "t": " पावक साखी देए करी जोरी प्रीत द्रडाय", "w": []}
{"chunk": 1, "s": 696.24, "e": 708.24, "t": " कीन पीती कचु दीचन राखा, लच्छि मन राम चरीत सब भाखा,", "w": []}
{"chunk": 1, "s": 708.24, "e": 719.24, "t": " कासु ग्रीव नयन भरिबारी, मिलिई नात् मित्ले से कुमारी,", "w": []}
{"chunk": 1, "s": 719.24, "e": 723.24, "t": " बद्द रहाम में करत बिचारा", "w": []}
{"chunk": 1, "s": 723.24, "e": 729.24, "t": " गगन पन्फ देखी में जाता", "w": []}
{"chunk": 1, "s": 729.24, "e": 734.24, "t": " पर बस परी बहुत भील पाता", "w": []}
{"chunk": 1, "s": 734.24, "e": 738.24, "t": " राम राम हा", "w": []}
{"chunk": 1, "s": 738.24, "e": 741.24, "t": " राम पुकारी", "w": []}
{"chunk": 1, "s": 741.24, "e": 746.24, "t": " हमहिग भील पाता", "w": []}
{"chunk": 1, "s": 746.24, "e": 753.68, "t": " बबबबारी हम देखी दिन हम पटडारी", "w": []}
{"chunk": 1, "s": 753.68, "e": 759.64, "t": " मागा राम तुरत तेही दिन हां", "w": []}
{"chunk": 1, "s": 759.64, "e": 765.24, "t": " पट वुर लाई सोच अतिकीन हां", "w": []}
{"chunk": 1, "s": 765.24, "e": 770.64, "t": " कासु गरीव सूनां रगुभीरा", "w": []}
{"chunk": 1, "s": 770.64, "e": 776.64, "t": " तजजग सोच मन आन रहु देरा", "w": []}
{"chunk": 1, "s": 776.64, "e": 782.14, "t": " सब प्रगार करि हम से वकाई", "w": []}
{"chunk": 1, "s": 782.14, "e": 788.64, "t": " जेही भिद्दिने लिए जान कि आई", "w": []}
{"chunk": 1, "s": 790.64, "e": 794.64, "t": " सखाए बचन सुनि हरषे", "w": []}
{"chunk": 1, "s": 794.64, "e": 799.64, "t": " क्रिपा सिंधु भल्सीम", "w": []}
{"chunk": 1, "s": 800.64, "e": 808.64, "t": " कारन कवन बस हुबन मुहि कहा हु सुगरी", "w": []}
{"chunk": 1, "s": 811.64, "e": 817.64, "t": " नात भाली आरु मैं दो बाई", "w": []}
{"chunk": 1, "s": 817.64, "e": 822.64, "t": " प्रीत रही कचु बरनिन जाई", "w": []}
{"chunk": 1, "s": 822.64, "e": 826.64, "t": " मैं सुत्माया वी", "w": []}
{"chunk": 1, "s": 826.64, "e": 834.08, "t": " तिहिनाओ आवासो प्रभु हमरे गाँ", "w": []}
{"chunk": 1, "s": 834.48, "e": 839.8, "t": " आरदराती पुर गवार प्कारा", "w": []}
{"chunk": 1, "s": 840.2, "e": 845.24, "t": " बाली रिपुबल सहें पारा", "w": []}
{"chunk": 1, "s": 845.76, "e": 851.12, "t": " दावा बाली देकि स्वागा", "w": []}
{"chunk": 1, "s": 851.12, "e": 856.44, "t": " मैं पुन्गयां बंधु संग लागा", "w": []}
{"chunk": 1, "s": 856.44, "e": 862.28, "t": " गेरी बर गूहा पैट्चो जाई", "w": []}
{"chunk": 1, "s": 862.28, "e": 867.84, "t": " तब भाली मुहि कहाब जाई", "w": []}
{"chunk": 1, "s": 867.84, "e": 873.52, "t": " परिक्स मुही एक पक्वारा", "w": []}
{"chunk": 1, "s": 873.52, "e": 879.12, "t": " नहीं आए तब जाने सुमारा", "w": []}
{"chunk": 1, "s": 879.12, "e": 885.12, "t": " मास दिवस तह रहे हूँ करारी", "w": []}
{"chunk": 1, "s": 885.12, "e": 890.12, "t": " निसरी रुदेर दार कंबारी", "w": []}
{"chunk": 1, "s": 890.12, "e": 896.12, "t": " बाली हतसी मुही मारी ही आई", "w": []}
{"chunk": 1, "s": 896.12, "e": 902.12, "t": " सिला देई तह चले उखराई", "w": []}
{"chunk": 1, "s": 902.12, "e": 907.12, "t": " मंत्रिनख्पृर देखा बिन साई", "w": []}
{"chunk": 1, "s": 907.12, "e": 913.12, "t": " दीन हुमोद राज बरियाई", "w": []}
{"chunk": 1, "s": 913.12, "e": 919.12, "t": " बाली ताही मारी गरिज आवा", "w": []}
{"chunk": 1, "s": 919.12, "e": 924.12, "t": " देकी मोही जीः भेद बड़ावा", "w": []}
{"chunk": 1, "s": 924.12, "e": 930.12, "t": " रिपुसम मोही मारे सी आप्बारी", "w": []}
{"chunk": 1, "s": 930.12, "e": 936.12, "t": " हर लिन है सी सर्वसु अरुनारी", "w": []}
{"chunk": 1, "s": 936.12, "e": 941.34, "t": " ताके भे रगवीर क्रिपाला", "w": []}
{"chunk": 1, "s": 941.34, "e": 947.12, "t": " सकल भूवन में फिरे वूँं भिहाला", "w": []}
{"chunk": 1, "s": 947.12, "e": 952.96, "t": " इहा साप बस आवत नाही", "w": []}
{"chunk": 1, "s": 952.96, "e": 958.52, "t": " तदपी सभीत रहाँ मनमाही", "w": []}
{"chunk": 1, "s": 958.52, "e": 964.12, "t": " सून से वक दुख दीन दयाला", "w": []}
{"chunk": 1, "s": 964.12, "e": 970.12, "t": " खरकी उठीवः भूजा भी साना", "w": []}
{"chunk": 1, "s": 973.12, "e": 977.12, "t": " सुन सु ग्रीव मारि हूँ", "w": []}
{"chunk": 1, "s": 977.12, "e": 982.12, "t": " बालि ही एक हिमान", "w": []}
{"chunk": 1, "s": 982.12, "e": 986.12, "t": " ब्रम्हरुद्र सर नागत", "w": []}
{"chunk": 1, "s": 986.12, "e": 991.12, "t": " गएन उपरी ही प्रान", "w": []}
{"chunk": 1, "s": 994.12, "e": 1006.12, "t": " जिन मित्र दुख हो ही दुखारी दिनहीं भिलोकत पातक भारी", "w": []}
{"chunk": 1, "s": 1006.12, "e": 1012.12, "t": " निज दुख गीरी सम्ज रज कर जाना", "w": []}
{"chunk": 1, "s": 1012.12, "e": 1017.12, "t": " मित्र क दुख रज मेरु समाना", "w": []}
{"chunk": 1, "s": 1017.12, "e": 1023.12, "t": " जिनके आस्मती साजन आई", "w": []}
{"chunk": 1, "s": 1023.12, "e": 1028.12, "t": " ते सत्खत रखि करत मिताई", "w": []}
{"chunk": 1, "s": 1028.12, "e": 1034.12, "t": " गुपतनिवारि सुपन्त चलावा", "w": []}
{"chunk": 1, "s": 1034.12, "e": 1039.12, "t": " गुन प्रगते अवगुन ही दूरावा", "w": []}
{"chunk": 1, "s": 1039.12, "e": 1045.12, "t": " देत लेत मन संकन दहर एई", "w": []}
{"chunk": 1, "s": 1045.12, "e": 1051.12, "t": " बल अन्मान सदाहे तकर एई", "w": []}
{"chunk": 1, "s": 1051.12, "e": 1056.76, "t": " बिपति काल कर सत्गुन नेहा", "w": []}
{"chunk": 1, "s": 1056.76, "e": 1062.44, "t": " शुति कह संथ मीप्रगुन एहा", "w": []}
{"chunk": 1, "s": 1062.44, "e": 1068.04, "t": " आगे कह म्रिदु बचन बनाई", "w": []}
{"chunk": 1, "s": 1068.04, "e": 1073.56, "t": " पाचे अनहित मन कुतिलाई", "w": []}
{"chunk": 1, "s": 1073.56, "e": 1079.32, "t": " जाकर चित आई गति समबाई", "w": []}
{"chunk": 1, "s": 1079.32, "e": 1084.64, "t": " आसक मीत्र परी हरे ही बलाई", "w": []}
{"chunk": 1, "s": 1084.64, "e": 1090.44, "t": " सेवक सत्धन्रिप क्रिपन कुनारी", "w": []}
{"chunk": 1, "s": 1090.44, "e": 1096.04, "t": " कपती मीत्र सुल समचारी", "w": []}
{"chunk": 1, "s": 1096.04, "e": 1101.72, "t": " सका सोच त्यागाम भल्मोरे", "w": []}
{"chunk": 1, "s": 1101.72, "e": 1107.28, "t": " सब भी दिधध काज में खोरे", "w": []}
{"chunk": 1, "s": 1107.28, "e": 1113.28, "t": " का सु ग्रीव सुनम रगवीरा", "w": []}
{"chunk": 1, "s": 1113.28, "e": 1118.28, "t": " बाली महां बल अत्रन दीरा", "w": []}
{"chunk": 1, "s": 1118.28, "e": 1124.28, "t": " दुंदु भी आस्ति ताल देक्राए", "w": []}
{"chunk": 1, "s": 1124.28, "e": 1130.28, "t": " बिन प्रयास रगुनात खाय", "w": []}
{"chunk": 1, "s": 1130.28, "e": 1136.28, "t": " देकी आमित बल बाडी प्रीपी", "w": []}
{"chunk": 1, "s": 1136.28, "e": 1141.2, "t": " भाली बदब इन भ़ई पर ती ती", "w": []}
{"chunk": 1, "s": 1141.8, "e": 1147.04, "t": " बार भार नावए पदसी सा", "w": []}
{"chunk": 1, "s": 1147.44, "e": 1152.48, "t": " प्रभुही जानी मन रश्ख कपी सा", "w": []}
{"chunk": 1, "s": 1153.08, "e": 1158.2, "t": " उप जाग्यान बचन अब बोला", "w": []}
{"chunk": 1, "s": 1158.64, "e": 1163.8, "t": " नाथ करिपा मन भायव बलोला", "w": []}
{"chunk": 1, "s": 1163.8, "e": 1169.6, "t": " सुkh sam pati parivaar baadahi", "w": []}
{"chunk": 1, "s": 1169.6, "e": 1175.2, "t": " सब परिहरि करिहम सेवताई", "w": []}
{"chunk": 1, "s": 1175.2, "e": 1180.8, "t": " एसब राम भगति के बादख", "w": []}
{"chunk": 1, "s": 1180.8, "e": 1186.6, "t": " कही संट कवब पद अवरादख", "w": []}
{"chunk": 1, "s": 1186.6, "e": 1192.2, "t": " सात्रु मित्र सुkh dukh jag maahi", "w": []}
{"chunk": 1, "s": 1192.2, "e": 1197.52, "t": " मायाग्रित पर्मारत्नाही", "w": []}
{"chunk": 1, "s": 1197.52, "e": 1200.02, "t": " बाली परमही", "w": []}
{"chunk": 2, "s": 1200.0, "e": 1209.0, "t": " जा सुप्र सादा मिले हु राम तुम समन भिशादा", "w": []}
{"chunk": 2, "s": 1209.0, "e": 1220.0, "t": " सपने जेहिसन औई लराई जागे समुजध मन सक तुचाई", "w": []}
{"chunk": 2, "s": 1220.0, "e": 1226.0, "t": " अब प्रभुक्रिठा करम एह माती", "w": []}
{"chunk": 2, "s": 1226.0, "e": 1232.0, "t": " सब तजी भजन करो दीन राती", "w": []}
{"chunk": 2, "s": 1232.0, "e": 1237.0, "t": " सुनि भिराग संजुत का पिमानी", "w": []}
{"chunk": 2, "s": 1237.0, "e": 1243.0, "t": " बोले भीहासी राम दन पानी", "w": []}
{"chunk": 2, "s": 1243.0, "e": 1246.0, "t": " जो कच्छु कहे हु साथ", "w": []}
{"chunk": 2, "s": 1246.0, "e": 1253.04, "t": " टब सोई, सकाबचन मम, म्रिषान होई,", "w": []}
{"chunk": 2, "s": 1253.04, "e": 1260.22, "t": " नध मर कत इव, सबही न चावत,", "w": []}
{"chunk": 2, "s": 1260.22, "e": 1265.96, "t": " राम्खध एस, भेप आसगावत,", "w": []}
{"chunk": 2, "s": 1265.96, "e": 1271.36, "t": " ले सु भ्रीव संग, रगुना था,", "w": []}
{"chunk": 2, "s": 1271.36, "e": 1276.52, "t": " चले चाएक सायक गईहाथा", "w": []}
{"chunk": 2, "s": 1277.12, "e": 1282.36, "t": " तब रग पति सुगरीव पथावा", "w": []}
{"chunk": 2, "s": 1282.76, "e": 1287.8, "t": " गर जे सी जाए निकत बल पावा", "w": []}
{"chunk": 2, "s": 1288.36, "e": 1293.64, "t": " सुनत भाली प्रोदा तुर्दावा", "w": []}
{"chunk": 2, "s": 1293.96, "e": 1299.08, "t": " गईखर चरन नारी समजावा", "w": []}
{"chunk": 2, "s": 1299.08, "e": 1323.08, "t": " सुन पत्जी नहीं लेव, सुग्री वाद, तेदो बन्धु तेज, बल सीवाद, कोस लेसे सुत लच्मन रामा, कालग जीत सकही संग्रामा.", "w": []}
{"chunk": 2, "s": 1323.08, "e": 1334.48, "t": " अपने बादे सुन भीर प्रिया सम्दर सी रगुनात", "w": []}
{"chunk": 2, "s": 1334.48, "e": 1343.52, "t": " जों कदाच मुहिमारि है तो पूनि हों सनात", "w": []}
{"chunk": 2, "s": 1343.52, "e": 1357.52, "t": " अशकए ही चला महां अभिमानी प्रिन समान सुग्रीव ही जानी", "w": []}
{"chunk": 2, "s": 1357.52, "e": 1368.52, "t": " दिरे उबो बाली आतिटर जा मुटिका मारी महां दून गर जा", "w": []}
{"chunk": 2, "s": 1368.52, "e": 1374.52, "t": " तब सुग्रीव बिकले हो इबागा", "w": []}
{"chunk": 2, "s": 1374.52, "e": 1380.52, "t": " मुष्टि प्रहार भज्र सम लागा", "w": []}
{"chunk": 2, "s": 1380.52, "e": 1385.52, "t": " मैंजो काह रगभीर एक प्रिपाला", "w": []}
{"chunk": 2, "s": 1385.52, "e": 1391.52, "t": " बन्दुन भोई मुर्या काला", "w": []}
{"chunk": 2, "s": 1391.52, "e": 1397.52, "t": " एक रूप तुम प्राता दो", "w": []}
{"chunk": 2, "s": 1397.52, "e": 1402.84, "t": " तेहिब्रमते नहीं मारे उसो", "w": []}
{"chunk": 2, "s": 1402.84, "e": 1408.84, "t": " कर पर सा सो गरीव सरीरा", "w": []}
{"chunk": 2, "s": 1408.84, "e": 1414.36, "t": " कनबा खुलिस गई सब पीरा", "w": []}
{"chunk": 2, "s": 1414.36, "e": 1420.12, "t": " नेली कन्ध् सुमन के माला", "w": []}
{"chunk": 2, "s": 1420.12, "e": 1425.52, "t": " पत्वा पुनी भल देए भिसाला", "w": []}
{"chunk": 2, "s": 1425.52, "e": 1431.52, "t": " उनिना ना दिदि भाई लराई", "w": []}
{"chunk": 2, "s": 1431.52, "e": 1437.52, "t": " बिटप अट दे कही रग वुराई", "w": []}
{"chunk": 2, "s": 1440.52, "e": 1444.52, "t": " बहुच्छल बल सुग्रीव कर", "w": []}
{"chunk": 2, "s": 1444.52, "e": 1449.52, "t": " यहारा भैमानी", "w": []}
{"chunk": 2, "s": 1449.52, "e": 1458.52, "t": " मारा बाली राम तब ख्रिदै माज सर्टानी", "w": []}
{"chunk": 2, "s": 1460.52, "e": 1466.52, "t": " परा बि कल मैं सर्के लागे", "w": []}
{"chunk": 2, "s": 1466.52, "e": 1472.52, "t": " उनी उठी बेट्ध देख प्रभ आगे", "w": []}
{"chunk": 2, "s": 1472.52, "e": 1477.52, "t": " स्याम गात सिर्ज जटा बनाए", "w": []}
{"chunk": 2, "s": 1477.52, "e": 1483.52, "t": " आरुन नयन सर चाप चलाए", "w": []}
{"chunk": 2, "s": 1483.52, "e": 1489.52, "t": " पूनि पूनि चीताई चरन चीत दीना", "w": []}
{"chunk": 2, "s": 1489.52, "e": 1494.52, "t": " सुपल जन माना प्रभूचीना", "w": []}
{"chunk": 2, "s": 1494.52, "e": 1500.52, "t": " ख्रेदाय पीती मुख बचन कदोरा", "w": []}
{"chunk": 2, "s": 1500.52, "e": 1505.52, "t": " बोला चीताई राम की औरा", "w": []}
{"chunk": 2, "s": 1505.52, "e": 1511.68, "t": " दर्म ले तु आव तरे हु गो साई", "w": []}
{"chunk": 2, "s": 1511.68, "e": 1517.36, "t": " मारे हु मोहि भ्याद की नाई", "w": []}
{"chunk": 2, "s": 1517.36, "e": 1523.36, "t": " मैं बेरी सो गरी वब प्यारा", "w": []}
{"chunk": 2, "s": 1523.36, "e": 1528.64, "t": " आव गुन कावन नाच मोहि मारा", "w": []}
{"chunk": 2, "s": 1528.64, "e": 1534.48, "t": " आनुज बदु भगनी सुतनारी", "w": []}
{"chunk": 2, "s": 1534.48, "e": 1540.12, "t": " सुन सत्खकन्या सम्ए चारी", "w": []}
{"chunk": 2, "s": 1540.12, "e": 1545.92, "t": " इनहीं कुद्रीष्ट भिलो कै जोई", "w": []}
{"chunk": 2, "s": 1545.92, "e": 1551.32, "t": " ताही पदे कच्षु आप नवोई", "w": []}
{"chunk": 2, "s": 1551.32, "e": 1557.08, "t": " मूड तोही अथिसे अभिमाना", "w": []}
{"chunk": 2, "s": 1557.08, "e": 1562.56, "t": " नारी सिखावन करसी नकाना", "w": []}
{"chunk": 2, "s": 1562.56, "e": 1568.56, "t": " मम्म भूज बल आश्वित तेहिजानी", "w": []}
{"chunk": 2, "s": 1568.56, "e": 1575.56, "t": " मारा चहसी अदम अदिमानी", "w": []}
{"chunk": 2, "s": 1576.56, "e": 1586.56, "t": " सूनहु राम स्वानी सन चलन चातुरी मोरी", "w": []}
{"chunk": 2, "s": 1586.56, "e": 1595.56, "t": " प्रभ्व आजहु में पापी अंत काल गती तोरी", "w": []}
{"chunk": 2, "s": 1597.56, "e": 1603.56, "t": " सुनत राम अती पो मल भानी", "w": []}
{"chunk": 2, "s": 1603.56, "e": 1609.56, "t": " भाल सीस पर से उनी जपानी", "w": []}
{"chunk": 2, "s": 1609.56, "e": 1614.56, "t": " अचल करो तनु राक हु प्राना", "w": []}
{"chunk": 2, "s": 1614.56, "e": 1620.56, "t": " बालि कहा सुनु क्रिपानि दाना", "w": []}
{"chunk": 2, "s": 1620.56, "e": 1626.56, "t": " जन्म जन्म मुनि जतनु कराही", "w": []}
{"chunk": 2, "s": 1626.56, "e": 1631.56, "t": " अन्त्राम कही आवत नाही", "w": []}
{"chunk": 2, "s": 1631.56, "e": 1637.56, "t": " जासु नाम भल संकर कासी", "w": []}
{"chunk": 2, "s": 1637.56, "e": 1642.56, "t": " देत सभही सम गत्य अदिनासी", "w": []}
{"chunk": 2, "s": 1642.56, "e": 1656.9, "t": " वफरी कि प्रभु आच बने ही बना, वा", "w": []}
{"chunk": 2, "s": 1657.32, "e": 1665.48, "t": " सो नयन गोचर जास गूननत ने ति कैज्शू ति गावाही", "w": []}
{"chunk": 2, "s": 1665.48, "e": 1674.48, "t": " तिगावही जिति पावन मगगो निरस करी मुनिद्यान कभजुक पावही", "w": []}
{"chunk": 2, "s": 1674.48, "e": 1682.48, "t": " मुही जानि आति अभि मान बस प्रभू कहे वू राखु सरी रही", "w": []}
{"chunk": 2, "s": 1682.48, "e": 1689.48, "t": " आस कवन सत्थ एखाति सुर तरु बारी करी ही भबू रही", "w": []}
{"chunk": 2, "s": 1689.48, "e": 1697.48, "t": " आब आत करि करू ना भिलो का हू देखु जो बर मागाू", "w": []}
{"chunk": 2, "s": 1697.48, "e": 1704.48, "t": " जिह जोन जन्माउ कर्म बस तह राम पद आनुरागाू", "w": []}
{"chunk": 2, "s": 1704.48, "e": 1712.48, "t": " यह तन्यम सम भिनय बल कल्यान प्रद प्रभू लिजिये", "w": []}
{"chunk": 2, "s": 1712.48, "e": 1721.48, "t": " ये गईबाह सुरनरनाह आपन दास अंगद की जीए", "w": []}
{"chunk": 2, "s": 1723.48, "e": 1733.48, "t": " राम चरन द्रद हप्रीत करी बालिकी नहें तनुत्याग", "w": []}
{"chunk": 2, "s": 1733.48, "e": 1742.0, "t": " सुमन मालज में कन्ठते गीरतन जानें आग", "w": []}
{"chunk": 2, "s": 1745.0, "e": 1750.52, "t": " राम भाली निज श्दाम पथावा", "w": []}
{"chunk": 2, "s": 1750.52, "e": 1755.88, "t": " नगर लोग सब भ्याकुल दावा", "w": []}
{"chunk": 2, "s": 1755.88, "e": 1761.8, "t": " नाना भिधि भिलाप कर तारा", "w": []}
{"chunk": 2, "s": 1761.8, "e": 1767.44, "t": " शुटे के सन देह समारा", "w": []}
{"chunk": 2, "s": 1767.44, "e": 1773.12, "t": " तारा दिकल देखिर भुराया", "w": []}
{"chunk": 2, "s": 1773.12, "e": 1778.64, "t": " दिन ग्यान हरी लीन माया", "w": []}
{"chunk": 2, "s": 1778.64, "e": 1784.4, "t": " शित जल पावक गगन समीरा", "w": []}
{"chunk": 2, "s": 1784.4, "e": 1789.88, "t": " पन्च रचित अति अदम सरीरा", "w": []}
{"chunk": 2, "s": 1789.88, "e": 1795.88, "t": " ब्रगत सुतनु तव आगे सोवाग", "w": []}
{"chunk": 2, "s": 1795.88, "e": 1800.88, "t": " जीव निद के ही लगि तुम्ब्रग", "w": []}
