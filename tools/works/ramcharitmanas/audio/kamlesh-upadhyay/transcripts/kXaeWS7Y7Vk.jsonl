{"chunk": 0, "s": 30.0, "e": 35.0, "t": " वामन्गण यराई", "w": []}
{"chunk": 0, "s": 35.0, "e": 42.0, "t": " न्वाउसुन सरखा आजीड बिधाई", "w": []}
{"chunk": 0, "s": 46.0, "e": 52.0, "t": " शान्तम, शाश्वतम, अप्रने, आमनगभम", "w": []}
{"chunk": 0, "s": 52.0, "e": 58.0, "t": " निर्वार, शान्ति प्रदम", "w": []}
{"chunk": 0, "s": 58.0, "e": 64.0, "t": " ब्रम्हाशम् भूफव्रिंद्र से भ्यमनिशम्", "w": []}
{"chunk": 0, "s": 64.0, "e": 70.0, "t": " वेदान्त्वेदम्विव्हुं", "w": []}
{"chunk": 0, "s": 70.0, "e": 76.0, "t": " रामाख्यम् जग्दिश्वरम् सुर्गुरम्", "w": []}
{"chunk": 0, "s": 76.0, "e": 82.0, "t": " माया मनुशम् फर्म्", "w": []}
{"chunk": 0, "s": 82.0, "e": 94.0, "t": " वन्दे हम करुडा करम रगवरम दूपाल चूडाम्डिम", "w": []}
{"chunk": 0, "s": 94.0, "e": 102.0, "t": " नानास प्रिहा रगवृपते ख्रिदे स्मदिये", "w": []}
{"chunk": 0, "s": 102.0, "e": 111.0, "t": " सत्तम वदामिच्य भवान खिलान तरात्मा", "w": []}
{"chunk": 0, "s": 111.0, "e": 119.0, "t": " बख्तिम प्रयच्छ रगुपुंगवड निरभ्राम में", "w": []}
{"chunk": 0, "s": 119.0, "e": 127.0, "t": " कामादि दोष रही तंपुरुमान सम्चा", "w": []}
{"chunk": 0, "s": 127.0, "e": 134.8, "t": " अत्लित्वल्द्हाम फेम शेलाव देखम", "w": []}
{"chunk": 0, "s": 134.8, "e": 142.84, "t": " दनुज्वन् क्रिशानुम ग्यानि नाम ग्रगल्न्यम", "w": []}
{"chunk": 0, "s": 142.84, "e": 149.84, "t": " सकल गुलनि दानम वान राना मदिशम", "w": []}
{"chunk": 0, "s": 149.84, "e": 157.84, "t": " रग पत्प्री यवख्तम वात जातम नमाँ", "w": []}
{"chunk": 0, "s": 159.84, "e": 166.84, "t": " जाम वन्त के बाचन सुहाए", "w": []}
{"chunk": 0, "s": 166.84, "e": 173.84, "t": " सूनि हन्मन्त ख़िदे अतिबाए", "w": []}
{"chunk": 0, "s": 173.84, "e": 180.8, "t": " तब लगी मोही परी के हु तुम बाई", "w": []}
{"chunk": 0, "s": 180.8, "e": 187.84, "t": " सह दुख कंद मुल पल खाई", "w": []}
{"chunk": 0, "s": 187.84, "e": 194.84, "t": " जब लगी आए उसी तही देखी", "w": []}
{"chunk": 0, "s": 194.84, "e": 201.84, "t": " हो यह काज मही रश्भ भिसे की", "w": []}
{"chunk": 0, "s": 201.84, "e": 208.84, "t": " यह कही नाही सबन कहु माथा", "w": []}
{"chunk": 0, "s": 208.84, "e": 215.84, "t": " चले उहर अशी ही आगरी रगना था", "w": []}
{"chunk": 0, "s": 215.84, "e": 222.84, "t": " सिंदू तीर एक भूदर सुंदर", "w": []}
{"chunk": 0, "s": 222.84, "e": 229.84, "t": " बोटूख भूद चडे उता उपर", "w": []}
{"chunk": 0, "s": 229.84, "e": 236.92, "t": " बार बार रगुभीर समहारी", "w": []}
{"chunk": 0, "s": 236.92, "e": 243.96, "t": " तरे के उपावन तने बल मारी", "w": []}
{"chunk": 0, "s": 243.96, "e": 251.24, "t": " जेही गिर चारन देई हनुमन्ता", "w": []}
{"chunk": 0, "s": 251.24, "e": 257.92, "t": " चले हु सुगा पाताल पूरन्ता", "w": []}
{"chunk": 0, "s": 257.92, "e": 264.92, "t": " जिम्या मोग रगु पाति कर भाना", "w": []}
{"chunk": 0, "s": 264.92, "e": 271.92, "t": " एही भाति चले हुट रन्माना", "w": []}
{"chunk": 0, "s": 271.92, "e": 278.92, "t": " जलनिद रगु पाति दूत भीचारी", "w": []}
{"chunk": 0, "s": 278.92, "e": 286.92, "t": " ते मैं आख हो ही शमहारे", "w": []}
{"chunk": 0, "s": 288.92, "e": 306.92, "t": " राम काजु की ने विन, मोही कहा भेश्राम", "w": []}
{"chunk": 0, "s": 308.92, "e": 316.0, "t": " जात पवन सुत देवन देखा", "w": []}
{"chunk": 0, "s": 316.0, "e": 323.04, "t": " जाने कहु बल भूज़िभ सेखा", "w": []}
{"chunk": 0, "s": 323.04, "e": 330.04, "t": " सुर्सा नाम आहिन के माता", "w": []}
{"chunk": 0, "s": 330.04, "e": 337.04, "t": " पथ इन आई कही तेहि बाता", "w": []}
{"chunk": 0, "s": 337.04, "e": 343.04, "t": " आजु सुरन मोही दीन आईरा", "w": []}
{"chunk": 0, "s": 344.04, "e": 350.04, "t": " सुनत बचन कहः पवन कुमारा", "w": []}
{"chunk": 0, "s": 351.04, "e": 358.04, "t": " राम्ता आजु करी तिर में आऔ", "w": []}
{"chunk": 0, "s": 359.04, "e": 364.04, "t": " सीता कै सुदी प्रभूही सुना।", "w": []}
{"chunk": 0, "s": 364.04, "e": 372.04, "t": " तब तव बदन पैकि हाँ आई", "w": []}
{"chunk": 0, "s": 372.04, "e": 379.04, "t": " सद कहाँ मोही जान दमाई", "w": []}
{"chunk": 0, "s": 379.04, "e": 386.04, "t": " कवने हु जातन देई नहीं जाना", "w": []}
{"chunk": 0, "s": 386.04, "e": 394.04, "t": " गरस सिन मोहि कहेव रवाना", "w": []}
{"chunk": 0, "s": 394.04, "e": 401.04, "t": " जो जन भारी तेही बदन पसारा", "w": []}
{"chunk": 0, "s": 401.04, "e": 408.04, "t": " कपितन की न दुगन भिस्तारा", "w": []}
{"chunk": 0, "s": 408.04, "e": 415.04, "t": " सो रह जो जन मुखते ही ठाया", "w": []}
{"chunk": 0, "s": 415.04, "e": 422.12, "t": " तुरत पवाल सुत बधिस भाया", "w": []}
{"chunk": 0, "s": 422.12, "e": 429.16, "t": " जस जस सुर साभडन बलावा", "w": []}
{"chunk": 0, "s": 429.16, "e": 436.16, "t": " तास्भून का पिभूप देखावा", "w": []}
{"chunk": 0, "s": 436.16, "e": 443.12, "t": " सत जो जनते हे आनन की ना", "w": []}
{"chunk": 0, "s": 443.12, "e": 449.12, "t": " अतिलग रूप पवन सुत्लिना", "w": []}
{"chunk": 0, "s": 450.12, "e": 457.12, "t": " बदन पाएटि पूनि बाहर आवा", "w": []}
{"chunk": 0, "s": 457.12, "e": 464.12, "t": " मांगा विदाता ही सिर्नावा", "w": []}
{"chunk": 0, "s": 464.12, "e": 471.12, "t": " मोहि सुरन जेही लागी पथावा", "w": []}
{"chunk": 0, "s": 471.12, "e": 479.12, "t": " वूदिबल मरम।ोर में पावा", "w": []}
{"chunk": 0, "s": 481.12, "e": 486.12, "t": " राम काजु सब करिजू", "w": []}
{"chunk": 0, "s": 486.12, "e": 490.12, "t": " तुम बल भूदिनिदान", "w": []}
{"chunk": 0, "s": 490.12, "e": 495.12, "t": " आस श्व्डेई गईशो", "w": []}
{"chunk": 0, "s": 495.12, "e": 500.12, "t": " रख़श चले उ हनुमा", "w": []}
{"chunk": 0, "s": 501.12, "e": 508.12, "t": " निस चरी एक सिंदुमा हुराई", "w": []}
{"chunk": 0, "s": 508.12, "e": 515.12, "t": " करी माया नबूके खगगाई", "w": []}
{"chunk": 0, "s": 515.12, "e": 522.12, "t": " जीव जन तुजे गागन तुडाई", "w": []}
{"chunk": 0, "s": 522.12, "e": 529.04, "t": " जल भिलो की तिन के परचाही", "w": []}
{"chunk": 0, "s": 529.04, "e": 536.24, "t": " गाई चाहं सक शोन पुलाई", "w": []}
{"chunk": 0, "s": 536.24, "e": 543.24, "t": " एभिदि सदागगन चर खाई", "w": []}
{"chunk": 0, "s": 543.24, "e": 550.2, "t": " सोई चल एणु मान काहे खिना", "w": []}
{"chunk": 0, "s": 550.2, "e": 556.2, "t": " ता सु कपतु कपी तुर तैह चीना", "w": []}
{"chunk": 0, "s": 557.2, "e": 564.2, "t": " ताही मारी मारुत सुत भीरा", "w": []}
{"chunk": 0, "s": 565.2, "e": 571.2, "t": " बारिदि पारे कया उमत भीरा", "w": []}
{"chunk": 0, "s": 572.2, "e": 578.2, "t": " ताहा जाए देखी बने सोबा", "w": []}
{"chunk": 0, "s": 578.2, "e": 585.2, "t": " वून्जत चन्चरीक मद्दूलो माझा", "w": []}
{"chunk": 0, "s": 585.2, "e": 592.2, "t": " नाना तरुपल पूल सूहाए", "w": []}
{"chunk": 0, "s": 592.2, "e": 599.2, "t": " खागम्रिग ब्रिंद देक्य मन बाए", "w": []}
{"chunk": 1, "s": 600.0, "e": 607.08, "t": " सेल भी साल देखी एक आगे", "w": []}
{"chunk": 1, "s": 607.08, "e": 614.0, "t": " तापर भाई चले उभे त्यागे", "w": []}
{"chunk": 1, "s": 614.0, "e": 621.0, "t": " उमान का चूकपी कै अदिकाई", "w": []}
{"chunk": 1, "s": 621.0, "e": 628.0, "t": " प्रभुप्रताप जो काल इखाई", "w": []}
{"chunk": 1, "s": 628.0, "e": 634.8, "t": " गिरी पर चाडी लंकाते ही देखी", "w": []}
{"chunk": 1, "s": 634.8, "e": 641.8, "t": " कहिन जाए अती भुर्ग भी सेखी", "w": []}
{"chunk": 1, "s": 641.8, "e": 648.8, "t": " अती उतंग जलनी दीच हुपासा", "w": []}
{"chunk": 1, "s": 648.8, "e": 655.8, "t": " कनक खोट कर परम प्रकासा", "w": []}
{"chunk": 1, "s": 658.0, "e": 669.0, "t": " गडज भाजिखा चरनी करपद चर रच बरुठन Dhaana Kakot bi cheetra mani krita sundarayat naagana", "w": []}
{"chunk": 1, "s": 669.0, "e": 674.0, "t": " चाउहात फात सुभाट बी थी Chauhata hat subaat bithi", "w": []}
{"chunk": 1, "s": 674.0, "e": 677.0, "t": " चार पुर भाजु भिदि बना Chaa Rupur Bahubhidhi bana", "w": []}
{"chunk": 1, "s": 677.0, "e": 685.0, "t": " गज भाजिखा चरनी करपद चरनी रच बरुठनी को गनै। Gaj Baajikha chareni kar pad chare rath paruthani koga nahi", "w": []}
{"chunk": 1, "s": 685.0, "e": 692.44, "t": " बहु रूपनि सिचर जूथ अतिबल सेन बरनत नहीं बने", "w": []}
{"chunk": 1, "s": 692.44, "e": 700.08, "t": " बन बाग उप बन भाटि का सर गुप भापी सोगें", "w": []}
{"chunk": 1, "s": 700.08, "e": 707.84, "t": " नर नाग सुर गंदर्ब कन्या रूपनि मन्मोहें", "w": []}
{"chunk": 1, "s": 707.84, "e": 715.56, "t": " कहु माल देह भी साल सेल समान अतिबल गर जहु", "w": []}
{"chunk": 1, "s": 715.56, "e": 723.16, "t": " नाना अठारन भी रही भाहु भी दी एक एक नधर जहु", "w": []}
{"chunk": 1, "s": 723.16, "e": 730.84, "t": " करी जतन भद्कोटिन भी कट्तन नगर चहु दिसी रच हु", "w": []}
{"chunk": 1, "s": 730.84, "e": 738.44, "t": " कहु महिश्वानुश देनुखर आजगलनि साचर भाचही", "w": []}
{"chunk": 1, "s": 738.44, "e": 746.08, "t": " एहि लागि तुलसी दास इनकी गता गच्छु एक आए कही", "w": []}
{"chunk": 1, "s": 746.08, "e": 754.84, "t": " रगु भीर सरती रत सरी रनी त्यागी गत पाए ही सही", "w": []}
{"chunk": 1, "s": 754.84, "e": 776.84, "t": " पुर रख्वारे देकि बहुज, कपी मनकिन बिचार, आतिलग रूप दरोन, इस नगर करों पएसार.", "w": []}
{"chunk": 1, "s": 776.84, "e": 802.6, "t": " बस्च्समान रुब कपी दरी, लंके हे चले उ सुम्रेनर रहरी, नाम लंकनी, एकने सच्री, सो कह चले सी मोहि निंदरी,", "w": []}
{"chunk": 1, "s": 802.6, "e": 808.6, "t": " जाने ही नहीं मरम सट्वोरा", "w": []}
{"chunk": 1, "s": 808.6, "e": 813.6, "t": " मोर आहार जहां लगी चोरा", "w": []}
{"chunk": 1, "s": 813.6, "e": 819.6, "t": " मुछिका एक महाक पीहनी", "w": []}
{"chunk": 1, "s": 819.6, "e": 825.6, "t": " रुदिर बमत दरनी ठन मनी", "w": []}
{"chunk": 1, "s": 825.6, "e": 831.0, "t": " वूनि समहारी उठी सो लंका", "w": []}
{"chunk": 1, "s": 831.0, "e": 836.6, "t": " जोरी पानी कर भीने ससंका", "w": []}
{"chunk": 1, "s": 836.6, "e": 842.6, "t": " जब रावा नहीं द्रम्ह बर्दीना", "w": []}
{"chunk": 1, "s": 842.6, "e": 847.6, "t": " चलत भीरंची कहा मोही चीना", "w": []}
{"chunk": 1, "s": 847.6, "e": 853.6, "t": " भी कलगो सी तें कपीके मारे", "w": []}
{"chunk": 1, "s": 853.6, "e": 858.92, "t": " तब जाने सुखने सिचर संगारे", "w": []}
{"chunk": 1, "s": 858.92, "e": 864.92, "t": " तात मुर आति फुन भहुता", "w": []}
{"chunk": 1, "s": 864.92, "e": 871.12, "t": " देखें लियन राम कर दूता", "w": []}
{"chunk": 1, "s": 873.76, "e": 878.32, "t": " तात स्वर्ग अपवर्ग सुखन", "w": []}
{"chunk": 1, "s": 878.32, "e": 883.32, "t": " दब आर्यतुला एक आंग", "w": []}
{"chunk": 1, "s": 884.32, "e": 887.32, "t": " तूलनता ही सकल मिलि", "w": []}
{"chunk": 1, "s": 888.32, "e": 892.32, "t": " जो सुखल वसत संग", "w": []}
{"chunk": 1, "s": 896.32, "e": 901.32, "t": " प्रविसी नगर की जे सब काजा", "w": []}
{"chunk": 1, "s": 902.32, "e": 907.32, "t": " विदन्रा की खो सल पुर राजा", "w": []}
{"chunk": 1, "s": 908.32, "e": 913.32, "t": " अदर ले सुदारी पूख करह्मिताई", "w": []}
{"chunk": 1, "s": 913.32, "e": 919.32, "t": " गो पद सिंधु अनल सितलाई", "w": []}
{"chunk": 1, "s": 919.32, "e": 924.32, "t": " गरुड सु मेरु क्रेन समताई", "w": []}
{"chunk": 1, "s": 924.32, "e": 930.32, "t": " राम क्रिपा करी चित्वाजाई", "w": []}
{"chunk": 1, "s": 930.32, "e": 936.32, "t": " अत्तिला गुरुप दھरे उहनु माना", "w": []}
{"chunk": 1, "s": 936.32, "e": 941.32, "t": " अद्दानगर स्मिर भग्वाना", "w": []}
{"chunk": 1, "s": 941.32, "e": 947.32, "t": " मंदिर मंदिर प्रतिकर सोदा", "w": []}
{"chunk": 1, "s": 947.32, "e": 953.32, "t": " देके जांता हं अगनित जोदा", "w": []}
{"chunk": 1, "s": 953.32, "e": 958.32, "t": " गया उदसानन मंदिर माही", "w": []}
{"chunk": 1, "s": 958.32, "e": 964.32, "t": " अट्पिचीत्र कही जात सूनाही", "w": []}
{"chunk": 1, "s": 964.32, "e": 969.64, "t": " सयन की देखा कब तेही", "w": []}
{"chunk": 1, "s": 969.64, "e": 975.32, "t": " मन्दिर महुन दीख मेदेही", "w": []}
{"chunk": 1, "s": 975.32, "e": 981.04, "t": " भावन एक पुनी दीख सुहावा", "w": []}
{"chunk": 1, "s": 981.04, "e": 987.16, "t": " हर मन्दिर तह भिन बनावा", "w": []}
{"chunk": 1, "s": 987.16, "e": 999.16, "t": " रामा युद अंकित गरिज, सोभा बरनिन जाई", "w": []}
{"chunk": 1, "s": 999.16, "e": 1008.16, "t": " नवतुलसिका ब्रिंदतह, देकि हरष्क पिराई", "w": []}
{"chunk": 1, "s": 1008.16, "e": 1034.16, "t": " लंकानिसी चर्ध निकरे निवासा, इहां कहां सजन कर्वासा, वन मुँ खरक करे कपि लागा, तेही समय भिभीशन जागा.", "w": []}
{"chunk": 1, "s": 1034.16, "e": 1040.16, "t": " राम राम ते ही सुमिरन कीन हां", "w": []}
{"chunk": 1, "s": 1040.16, "e": 1046.16, "t": " द्रिदाय रश्ग कपे साजन चीन हां", "w": []}
{"chunk": 1, "s": 1046.16, "e": 1051.16, "t": " एह सनहाती करिहां पहिचानी", "w": []}
{"chunk": 1, "s": 1051.16, "e": 1057.16, "t": " साधुते वो इन तारजहानी", "w": []}
{"chunk": 1, "s": 1057.16, "e": 1062.16, "t": " बी प्र रुप दहरी बचने सुना है", "w": []}
{"chunk": 1, "s": 1062.16, "e": 1068.16, "t": " सुनत भी लिशन अद्छी तफ आए", "w": []}
{"chunk": 1, "s": 1068.16, "e": 1073.16, "t": " करी प्रनाम पूची कुस लाई", "w": []}
{"chunk": 1, "s": 1073.16, "e": 1079.16, "t": " भी प्रे कहां हुनिजे कता भुजाई", "w": []}
{"chunk": 1, "s": 1079.16, "e": 1085.16, "t": " के तुम रही दासन मह कोई", "w": []}
{"chunk": 1, "s": 1085.16, "e": 1090.16, "t": " मोरे रिदयक प्रीत अथि होई", "w": []}
{"chunk": 1, "s": 1090.16, "e": 1096.16, "t": " तुम हराम भीन अनुरागी", "w": []}
{"chunk": 1, "s": 1096.16, "e": 1102.16, "t": " आया वुमोही करन बड़ भागी", "w": []}
{"chunk": 1, "s": 1104.16, "e": 1114.16, "t": " तब हन मन्त कही सब राम कताने जिनाम", "w": []}
{"chunk": 1, "s": 1114.16, "e": 1123.16, "t": " सुनत जुगल तन पूलग मन मगन सुमीरे गोन गरास", "w": []}
{"chunk": 1, "s": 1127.16, "e": 1138.16, "t": " सुनहो पवन सुत्र रहनी हमारे जी मिदसन हु महु जीभ भीचारी", "w": []}
{"chunk": 1, "s": 1138.16, "e": 1150.16, "t": " तात कभवहु महिजानिया ना था, करिहाई क्रिब्ःा, भानु कुलना था,", "w": []}
{"chunk": 1, "s": 1150.16, "e": 1161.16, "t": " तामस तनु कचु सादन नाही, प्रीत नपद सरोज मनमाही,", "w": []}
{"chunk": 1, "s": 1161.16, "e": 1166.74, "t": " आबु मोहिबा बरोस रनुमन्ता", "w": []}
{"chunk": 1, "s": 1166.74, "e": 1172.26, "t": " बिनु हरे क्रिपा मिले हुने संता", "w": []}
{"chunk": 1, "s": 1172.26, "e": 1178.0, "t": " जो रग भीर अनुग्रा कीना", "w": []}
{"chunk": 1, "s": 1178.0, "e": 1183.6, "t": " पोतुम मोहि दरस वह खिडीना", "w": []}
{"chunk": 1, "s": 1183.6, "e": 1189.5, "t": " सून हु भिगेशन रबु केरी ती", "w": []}
{"chunk": 1, "s": 1189.5, "e": 1194.82, "t": " करह सदा सेवाग पर प्रीती", "w": []}
{"chunk": 1, "s": 1194.82, "e": 1199.9, "t": " कहो कवन मैं परम तुलीन", "w": []}
{"chunk": 2, "s": 1200.0, "e": 1218.0, "t": " अप्राद लेईजो नाम हमाराए तेदिन ताहिन निले आहारा", "w": []}
{"chunk": 2, "s": 1218.0, "e": 1230.0, "t": " आश मै आदम सका सुन मोहु पर रगभीर", "w": []}
{"chunk": 2, "s": 1230.0, "e": 1239.0, "t": " की नि क्रिपास मिरी गुन बहरे भिलो चननी", "w": []}
{"chunk": 2, "s": 1239.0, "e": 1254.0, "t": " जानत हु आस वामी भिसारी फिरहित काहें बोही दुखारी", "w": []}
{"chunk": 2, "s": 1254.0, "e": 1259.32, "t": " एह भिदि काहत राम गुन गरामा", "w": []}
{"chunk": 2, "s": 1259.32, "e": 1265.0, "t": " पावा अनी बार्चे भिश्रामा", "w": []}
{"chunk": 2, "s": 1265.0, "e": 1270.66, "t": " वूनि सब कता भिदिशन कही", "w": []}
{"chunk": 2, "s": 1270.66, "e": 1276.58, "t": " जेह भिदि जनक सुताता हरही", "w": []}
{"chunk": 2, "s": 1276.58, "e": 1282.08, "t": " तब हनु मन्त कहा सुन ब्राता", "w": []}
{"chunk": 2, "s": 1282.08, "e": 1287.72, "t": " देकी चाहव जान की माता", "w": []}
{"chunk": 2, "s": 1287.72, "e": 1293.44, "t": " जो भूती भीवीशन सकल सुनाई", "w": []}
{"chunk": 2, "s": 1293.44, "e": 1299.12, "t": " चले वुपवन सुत भिदा कराई", "w": []}
{"chunk": 2, "s": 1299.12, "e": 1304.8, "t": " करी सोई रूप गायाउ पूनिताहावा", "w": []}
{"chunk": 2, "s": 1304.8, "e": 1310.28, "t": " बन असोग सी तारजाहावा", "w": []}
{"chunk": 2, "s": 1310.28, "e": 1316.28, "t": " देक्कि मनही महु कीन्ह प्रनामा", "w": []}
{"chunk": 2, "s": 1316.28, "e": 1321.28, "t": " बेटें दीत जातनी सिजामा", "w": []}
{"chunk": 2, "s": 1321.28, "e": 1327.28, "t": " ग्रिस तन्सी सिजाता एक भेनी", "w": []}
{"chunk": 2, "s": 1327.28, "e": 1333.28, "t": " जद पिख्र दें रग पती गुन श्रेनी", "w": []}
{"chunk": 2, "s": 1333.28, "e": 1345.28, "t": " निजपद नयन दिये मन राम पद कम ललीन", "w": []}
{"chunk": 2, "s": 1345.28, "e": 1355.28, "t": " परम दुखी भाप पवन सुत देख जान की दी", "w": []}
{"chunk": 2, "s": 1355.28, "e": 1369.28, "t": " तर्पल्लव महु रहालु काई करई बिचार करों काई", "w": []}
{"chunk": 2, "s": 1369.28, "e": 1380.28, "t": " तेही आवसर लावनू तहावा संगनारी बहु किये बनावा", "w": []}
{"chunk": 2, "s": 1380.28, "e": 1386.28, "t": " बहुभी दिखल सीतही समजावा", "w": []}
{"chunk": 2, "s": 1386.28, "e": 1392.28, "t": " साम्दान भई भेद दिखावा", "w": []}
{"chunk": 2, "s": 1392.28, "e": 1397.28, "t": " कह रावानु सुनु सुमुख्षयानी", "w": []}
{"chunk": 2, "s": 1397.28, "e": 1403.28, "t": " मन्दो दरी आदी सब रानी", "w": []}
{"chunk": 2, "s": 1403.28, "e": 1409.28, "t": " तब अनचरी करूँ पन्मुरा", "w": []}
{"chunk": 2, "s": 1409.28, "e": 1414.28, "t": " तीद भार भिलो कुमम ओरा", "w": []}
{"chunk": 2, "s": 1414.28, "e": 1420.28, "t": " तरीन दरी अट्ट कहती बैदे ही", "w": []}
{"chunk": 2, "s": 1420.28, "e": 1425.28, "t": " सु मिरी अवड़ पती परम सने ही", "w": []}
{"chunk": 2, "s": 1425.28, "e": 1431.28, "t": " सुम दस मुख खदोत प्राटासा", "w": []}
{"chunk": 2, "s": 1431.28, "e": 1437.28, "t": " कबहु कि नलीनी कर ये विकासा", "w": []}
{"chunk": 2, "s": 1437.28, "e": 1442.6, "t": " अस्मन समुजु कहती जान की", "w": []}
{"chunk": 2, "s": 1443.04, "e": 1448.2, "t": " खल सुदी नहीं रगभीर भान की", "w": []}
{"chunk": 2, "s": 1448.48, "e": 1453.88, "t": " सक्सुमने हरी आने ही मोही", "w": []}
{"chunk": 2, "s": 1454.24, "e": 1460.36, "t": " अदमनी लाज लाज नहीं तो ही", "w": []}
{"chunk": 2, "s": 1460.36, "e": 1472.36, "t": " आप उही सुनि का दोत सम्द रामही भाँन समान", "w": []}
{"chunk": 2, "s": 1472.36, "e": 1481.36, "t": " परुश बचन सुनि कार ही आसी बोला अतिक हिस्यान", "w": []}
{"chunk": 2, "s": 1481.36, "e": 1501.36, "t": " शीता ते मम क्रित आप्माना कटिहाँ तव सिर कटिन क्रिपाना नाहित सपपदी मानु मम बानी", "w": []}
{"chunk": 2, "s": 1501.36, "e": 1507.36, "t": " तो सुम्कि होती नत जीवान हानी", "w": []}
{"chunk": 2, "s": 1507.36, "e": 1513.36, "t": " स्याम सरोज दाम सम सुंदर", "w": []}
{"chunk": 2, "s": 1513.36, "e": 1518.36, "t": " प्रभुबुज करी कर सम दस कंदर", "w": []}
{"chunk": 2, "s": 1518.36, "e": 1524.36, "t": " सो भुज कंठा की तव आसी भोरा", "w": []}
{"chunk": 2, "s": 1524.36, "e": 1529.36, "t": " सुन सत्ध आस प्रवान कन्मोरा", "w": []}
{"chunk": 2, "s": 1529.36, "e": 1541.36, "t": " चंद्र हास्ट रु मम परितापम रगु पति भी रह अनन संजातम", "w": []}
{"chunk": 2, "s": 1541.36, "e": 1552.36, "t": " से तल लिसे त बहसे बर्दारा कह से तारु मम दुखभारा", "w": []}
{"chunk": 2, "s": 1552.36, "e": 1558.16, "t": " सुनत बचन पूनी मारन दावा", "w": []}
{"chunk": 2, "s": 1558.16, "e": 1563.68, "t": " मयतन याग कही नीटी भुजावा", "w": []}
{"chunk": 2, "s": 1563.68, "e": 1569.52, "t": " कैसी सकलनिसी चरीन बूलाई", "w": []}
{"chunk": 2, "s": 1569.52, "e": 1575.08, "t": " सी ते बहु भिदि त्रास हुजाई", "w": []}
{"chunk": 2, "s": 1575.08, "e": 1580.72, "t": " मास दिवस महु कहान माना", "w": []}
{"chunk": 2, "s": 1580.72, "e": 1586.72, "t": " तो में मार भी कारी क्रिपाना", "w": []}
{"chunk": 2, "s": 1589.72, "e": 1593.72, "t": " भावन गयोदस कंदर", "w": []}
{"chunk": 2, "s": 1593.72, "e": 1598.72, "t": " इहा पिसा चिन ब्रिंद", "w": []}
{"chunk": 2, "s": 1598.72, "e": 1603.72, "t": " सी तही त्रास दिखावह", "w": []}
{"chunk": 2, "s": 1603.72, "e": 1607.72, "t": " दहरही रूप भवुमन्द", "w": []}
{"chunk": 2, "s": 1610.72, "e": 1622.72, "t": " त्रिजटा नाम राज्श्सी एका, राम चरन रती निपुन भिभेका,", "w": []}
{"chunk": 2, "s": 1622.72, "e": 1633.72, "t": " सवनो बोली सुनायसी सप्णा, सी तहिसे करहू हित अपना,", "w": []}
{"chunk": 2, "s": 1633.72, "e": 1639.72, "t": " सप्ने भानर लंका जारी", "w": []}
{"chunk": 2, "s": 1639.72, "e": 1645.72, "t": " जातुदान सेना सब मारी", "w": []}
{"chunk": 2, "s": 1645.72, "e": 1650.72, "t": " खर आरुड नगन दस सीसा", "w": []}
{"chunk": 2, "s": 1650.72, "e": 1656.72, "t": " मुंडित सिर खंदित भुजभीसा", "w": []}
{"chunk": 2, "s": 1656.72, "e": 1661.72, "t": " एभिदिसो दचिन भिस जाए", "w": []}
{"chunk": 2, "s": 1661.72, "e": 1667.72, "t": " लंका मन्हु भिवीशन पाए", "w": []}
{"chunk": 2, "s": 1667.72, "e": 1672.72, "t": " नगर फिरी रग भीर दूहाए", "w": []}
{"chunk": 2, "s": 1672.72, "e": 1678.72, "t": " तब प्रभ्वु सी ता बोली पठाए", "w": []}
{"chunk": 2, "s": 1678.72, "e": 1684.72, "t": " या सप्ना में कहाँ पुकारी", "w": []}
{"chunk": 2, "s": 1684.72, "e": 1689.72, "t": " औए भी साथ गये दिन चारी", "w": []}
{"chunk": 2, "s": 1689.72, "e": 1695.72, "t": " तास्व बच्चन सूनी ते सब तारी", "w": []}
{"chunk": 2, "s": 1695.72, "e": 1701.72, "t": " जनक सुता के चरन लिए पारी", "w": []}
{"chunk": 2, "s": 1704.72, "e": 1714.72, "t": " जहता हगाई सकल तब सीता कर मन सोच", "w": []}
{"chunk": 2, "s": 1714.72, "e": 1723.72, "t": " मास दिवस भी ते महि मारी निस छर पोचे", "w": []}
{"chunk": 2, "s": 1726.72, "e": 1732.72, "t": " त्रिज तासन बोली कर जोरी", "w": []}
{"chunk": 2, "s": 1732.72, "e": 1737.72, "t": " मात उभी पती संगी नी तेमोरी", "w": []}
{"chunk": 2, "s": 1737.72, "e": 1743.72, "t": " तजो देह कर उबेगी उपाए", "w": []}
{"chunk": 2, "s": 1743.72, "e": 1749.72, "t": " दूसध भी रवू अब नहीं सईजाई", "w": []}
{"chunk": 2, "s": 1749.72, "e": 1754.72, "t": " आन्काध रचु चिता बनाई", "w": []}
{"chunk": 2, "s": 1754.72, "e": 1760.72, "t": " मात अनल पुन देज लगाई", "w": []}
{"chunk": 2, "s": 1760.72, "e": 1766.72, "t": " सात कराही मम प्रीत सयानी", "w": []}
{"chunk": 2, "s": 1766.72, "e": 1771.72, "t": " सुने कोशमन सुल सम भानी", "w": []}
{"chunk": 2, "s": 1771.72, "e": 1777.72, "t": " तुनत बचन पद गई समजा येसी", "w": []}
{"chunk": 2, "s": 1777.72, "e": 1783.72, "t": " प्रवुख्र ताप बल सुजसु सुना येसी", "w": []}
{"chunk": 2, "s": 1783.72, "e": 1788.72, "t": " निसिन अनल मिली सुन सुक्मारी", "w": []}
{"chunk": 2, "s": 1788.72, "e": 1794.72, "t": " आस कै हिसो निज भावन सिदारी", "w": []}
{"chunk": 2, "s": 1794.72, "e": 1799.72, "t": " काईसी ताभी दि भाप्रति कुला", "w": []}
