{"chunk": 2, "s": 1787.28, "e": 1792.32, "t": " समझी करी आब लग कह सब को", "w": []}
{"chunk": 2, "s": 1792.84, "e": 1799.96, "t": " सहसा करी आचे पच्टा ही कहाई बेड", "w": []}
{"chunk": 3, "s": 1800.0, "e": 1804.0, "t": " तब दद तेबद नाही", "w": []}
{"chunk": 3, "s": 1804.0, "e": 1807.0, "t": " सुनि सुर बचन लखन", "w": []}
