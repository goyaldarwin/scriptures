{"chunk": 2, "s": 1216.88, "e": 1219.44, "t": " लखन सखन यज", "w": []}
{"chunk": 2, "s": 1219.76, "e": 1222.24, "t": " निकन होई", "w": []}
{"chunk": 2, "s": 1222.56, "e": 1224.72, "t": " कत्छिन कुचार", "w": []}
{"chunk": 2, "s": 1224.92, "e": 1227.72, "t": " सूना है ही कोई", "w": []}
{"chunk": 2, "s": 1227.72, "e": 1233.72, "t": " आस कही बन्दो समेत नहाने", "w": []}
{"chunk": 2, "s": 1233.72, "e": 1240.72, "t": " पूजी पूरारी साध सन्माने", "w": []}
{"chunk": 2, "s": 1243.72, "e": 1248.72, "t": " सल्मानी सुर्मनी बन्दी बेटे", "w": []}
