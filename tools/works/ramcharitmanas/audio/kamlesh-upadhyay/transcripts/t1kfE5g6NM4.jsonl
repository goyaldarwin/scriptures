{"chunk": 1, "s": 980.4, "e": 985.4, "t": " बार तही देखी जनाम पलुलही", "w": []}
{"chunk": 1, "s": 986.1, "e": 991.14, "t": " जे जन कही रुसल हम देखे", "w": []}
{"chunk": 1, "s": 991.14, "e": 996.14, "t": " तेप्री आराम्द लखन सम लेके", "w": []}
{"chunk": 1, "s": 997.14, "e": 1002.14, "t": " तेबि दिबूजद सबही सुबानी", "w": []}
{"chunk": 1, "s": 1003.14, "e": 1009.14, "t": " सुनक्राम् बन भास कहानी", "w": []}
{"chunk": 1, "s": 1011.14, "e": 1015.14, "t": " तेभासर भस प्रात ही", "w": []}
{"chunk": 1, "s": 1016.14, "e": 1020.14, "t": " चले सुमिरी रगुना", "w": []}
{"chunk": 1, "s": 1021.14, "e": 1031.14, "t": " राम दरस की लाल सा, बहरत सरिस सब सात.", "w": []}
{"chunk": 1, "s": 1034.14, "e": 1045.14, "t": " मंगल सगून हो हु, सब का हु, फर कही सुखद भिलो चन भाहु", "w": []}
{"chunk": 1, "s": 1045.14, "e": 1056.14, "t": " भरतए सहीत समाज उचाहू, मिलि है राम। मिटि ही दुख्डाहू", "w": []}
{"chunk": 1, "s": 1056.14, "e": 1067.14, "t": " करत मनुरत जस जी जाके जाही सने है, सुरां सब चाके", "w": []}
{"chunk": 1, "s": 1067.14, "e": 1085.14, "t": " वग़ाग दोल हैं बिध्वल बच्छन पेम बस भोल हैं राम सखाते हैं समय दिखावा", "w": []}
{"chunk": 1, "s": 1085.14, "e": 1090.46, "t": " सेल सी रो मैंनी साहज सूहावा", "w": []}
{"chunk": 1, "s": 1090.86, "e": 1096.24, "t": " जासु समीप सरित पैतीरा", "w": []}
{"chunk": 1, "s": 1096.5, "e": 1101.74, "t": " सी समीप बसही तुदीरा", "w": []}
{"chunk": 1, "s": 1102.18, "e": 1107.58, "t": " देकि कलही सब दन्द प्रनामा", "w": []}
{"chunk": 1, "s": 1107.82, "e": 1113.1, "t": " कही जै जान की जीवान रामा", "w": []}
{"chunk": 1, "s": 1113.1, "e": 1125.1, "t": " प्रेम मगन आस राज समाजु, जन्फीरी आवद चले रग भुराजु", "w": []}
{"chunk": 1, "s": 1127.1, "e": 1136.1, "t": " भब्रत प्रेम देही समय जस, तस कही सकही नसेशु", "w": []}
{"chunk": 1, "s": 1136.1, "e": 1146.1, "t": " कबी ही आगम जिम भ्रम्ह सुखु आहम आमालीन जनेशु", "w": []}
{"chunk": 1, "s": 1149.1, "e": 1160.1, "t": " सकल सने हा सी पिल रग भर के गए को से दुई दिन कर ड़र के", "w": []}
{"chunk": 1, "s": 1160.1, "e": 1171.1, "t": " जल उ खल देकि भाशे निस भीतें कीन गवन रगुनात पिरीतें", "w": []}
{"chunk": 1, "s": 1171.1, "e": 1182.1, "t": " उहा राम रजनी आव से खा जागे सी सपन्यस देखा", "w": []}
{"chunk": 1, "s": 1182.1, "e": 1188.1, "t": " सहित समाज भरत जन्याे", "w": []}
{"chunk": 1, "s": 1188.1, "e": 1194.1, "t": " नाथ भियोग ताप तनताय", "w": []}
{"chunk": 1, "s": 1194.1, "e": 1199.1, "t": " सखल मलिन मन दीन धुखारि", "w": []}
