{"chunk": 2, "s": 1491.76, "e": 1497.6, "t": " बारे तई दो सुभेई को जाए", "w": []}
{"chunk": 2, "s": 1497.6, "e": 1503.84, "t": " जग बो राई राज पद पाए", "w": []}
{"chunk": 2, "s": 1505.96, "e": 1510.48, "t": " सस्विगुरत्या गामी नगुष्ः", "w": []}
{"chunk": 2, "s": 1510.48, "e": 1515.44, "t": " चल है उबूम सुर जान", "w": []}
{"chunk": 2, "s": 1515.44, "e": 1525.44, "t": " लोक भेद तेभ मुखभा अदह मन भेन समान", "w": []}
{"chunk": 2, "s": 1528.44, "e": 1533.44, "t": " सहस भाहु सुरनातु तरी संकु", "w": []}
{"chunk": 2, "s": 1533.44, "e": 1539.44, "t": " के हिन राज मद दीन कलंकु", "w": []}
{"chunk": 2, "s": 1539.44, "e": 1550.44, "t": " बबरत कीन है यह उचित उपाओ, त्रिपूरीन रनचन राखभ काओ.", "w": []}
{"chunk": 2, "s": 1550.44, "e": 1561.44, "t": " एक कीन ही नहीं बबरत भलाई, निदरे राम जान्या सहाई.", "w": []}
