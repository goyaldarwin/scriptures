{"chunk": 0, "s": 30.0, "e": 38.0, "t": " अगर तब आप सब लीन हैं चले चीट्र पूट़ही चीट्दीन हैं", "w": []}
{"chunk": 0, "s": 38.0, "e": 44.0, "t": " राम सखाकर दीन हैं लागु", "w": []}
{"chunk": 0, "s": 44.0, "e": 49.0, "t": " चलत देह दहरी जन अन रागु", "w": []}
{"chunk": 0, "s": 49.0, "e": 55.0, "t": " नहीं पद्ट्रान सीस नहीं चाया", "w": []}
{"chunk": 0, "s": 55.0, "e": 60.12, "t": " पेम नेम ब्रतु दरम वामाया", "w": []}
{"chunk": 0, "s": 60.56, "e": 65.96, "t": " लक्ण राम सिय पन्त काहनी", "w": []}
{"chunk": 0, "s": 66.32, "e": 71.44, "t": " पूचत सकिज कहत म्रे दुमानी", "w": []}
{"chunk": 0, "s": 71.88, "e": 77.28, "t": " राम भास खल भिटप भिलोके", "w": []}
{"chunk": 0, "s": 77.6, "e": 82.72, "t": " उर अन्राग रहत नहीरोके", "w": []}
{"chunk": 0, "s": 82.72, "e": 88.72, "t": " देखी दसासुर बरिसाई पूला", "w": []}
{"chunk": 0, "s": 88.72, "e": 94.72, "t": " भाईम्रिद मही मगु मंगल मुला", "w": []}
{"chunk": 0, "s": 96.72, "e": 106.72, "t": " कि ये जाही चाया जलद सुखद भहे बरबात", "w": []}
{"chunk": 0, "s": 106.72, "e": 115.72, "t": " तस्मग भ्या उन्राम कह जस्भा ब्रत फीजात", "w": []}
{"chunk": 0, "s": 118.72, "e": 124.72, "t": " जडचे तन्मग जीवगनेरे", "w": []}
{"chunk": 0, "s": 124.72, "e": 129.72, "t": " जे चिते प्रभु जिन प्रभु हेरे", "w": []}
{"chunk": 0, "s": 129.72, "e": 135.72, "t": " ते सब भ्या परंपद जोगु", "w": []}
{"chunk": 0, "s": 135.72, "e": 141.38, "t": " भरत दरस मेटा भावरोगो", "w": []}
{"chunk": 0, "s": 141.38, "e": 147.12, "t": " यह भडी भात भरत कई नहीं", "w": []}
{"chunk": 0, "s": 147.12, "e": 152.72, "t": " सुमिरत जी नहीं राम मन माहीं", "w": []}
{"chunk": 0, "s": 152.72, "e": 158.48, "t": " बारक राम कहत जग जेओ", "w": []}
{"chunk": 0, "s": 158.48, "e": 163.72, "t": " भोत तरन तारन नरतेओ", "w": []}
{"chunk": 0, "s": 163.72, "e": 169.72, "t": " बरत राम प्रियः उन्लग ब्राता", "w": []}
{"chunk": 0, "s": 169.72, "e": 175.72, "t": " कसन हो इमगु मंगल दाता", "w": []}
{"chunk": 0, "s": 175.72, "e": 180.72, "t": " सीथ साधु मुनिबर आस कहाई", "w": []}
{"chunk": 0, "s": 180.72, "e": 186.72, "t": " भरत फिने रहाखी, रश्वो ही लहागी", "w": []}
{"chunk": 0, "s": 186.72, "e": 191.72, "t": " देखी प्रभाउ सुरे सही सोचु", "w": []}
{"chunk": 0, "s": 191.72, "e": 197.72, "t": " जग भल भल पोच कह पोचु", "w": []}
{"chunk": 0, "s": 197.72, "e": 203.72, "t": " गूर सन कह आई उ करी प्रभ शोई", "w": []}
{"chunk": 0, "s": 203.72, "e": 209.72, "t": " राम एभ भर तही देट नहोई", "w": []}
{"chunk": 0, "s": 209.72, "e": 221.72, "t": " राम संकोची प्रेम बस बभरत सपेम पयोदि", "w": []}
{"chunk": 0, "s": 221.72, "e": 230.72, "t": " बनी बात भेगरन चाहति कर्यजतन चलु सोदि", "w": []}
{"chunk": 0, "s": 230.72, "e": 245.72, "t": " बच्चन सुनत सुरगुरु मुस्काने सहसन यन भिनु लोचन जाने", "w": []}
{"chunk": 0, "s": 245.72, "e": 256.72, "t": " माया पत्ति सेवक सन माया कराई तपूलति पराई सुर राया", "w": []}
{"chunk": 0, "s": 256.72, "e": 268.72, "t": " कब कि चुकीन राम रुक जानी अब कुचाली करे फोई हानी", "w": []}
{"chunk": 0, "s": 268.72, "e": 274.36, "t": " सुन्सुरेस रगुनात सुभा।", "w": []}
{"chunk": 0, "s": 274.36, "e": 279.88, "t": " निज अप्राद रिसाही नका।", "w": []}
{"chunk": 0, "s": 279.88, "e": 285.72, "t": " जो अप्राद भगत कर कर लेई", "w": []}
{"chunk": 0, "s": 285.72, "e": 291.24, "t": " राम रोश पावक सोजर लेई", "w": []}
{"chunk": 0, "s": 291.24, "e": 296.96, "t": " लोकं भेद भिदित इतिहासा", "w": []}
{"chunk": 0, "s": 296.96, "e": 302.28, "t": " यह महिमा जानही दूर भासा", "w": []}
{"chunk": 0, "s": 302.28, "e": 308.06, "t": " बारत सरिस को राम सने ही", "w": []}
{"chunk": 0, "s": 308.06, "e": 314.76, "t": " जगु चप राम राम जप जे ही", "w": []}
{"chunk": 0, "s": 316.76, "e": 320.96, "t": " मनहुन आन्या आमर पती", "w": []}
{"chunk": 0, "s": 320.96, "e": 325.96, "t": " रग बर भरत अकाजु", "w": []}
{"chunk": 0, "s": 326.96, "e": 330.92, "t": " आजस लोक पर लोक दुख", "w": []}
{"chunk": 0, "s": 330.92, "e": 335.48, "t": " दिन दिन सोग समाज", "w": []}
{"chunk": 0, "s": 338.92, "e": 344.68, "t": " सुन सुरे से उप्डेस हमारा", "w": []}
{"chunk": 0, "s": 344.68, "e": 350.04, "t": " रामही सेवक उपरम कियारा", "w": []}
{"chunk": 0, "s": 350.04, "e": 355.88, "t": " मानत सुख सेवक सेवकाई", "w": []}
{"chunk": 0, "s": 355.88, "e": 361.2, "t": " सेवक बेर बेरु अदिकाई", "w": []}
{"chunk": 0, "s": 361.2, "e": 367.1, "t": " जद्दपि सम नहीं राग नरोशु", "w": []}
{"chunk": 0, "s": 367.1, "e": 372.7, "t": " गहीं पाप पुन गुन दोशु", "w": []}
{"chunk": 0, "s": 372.7, "e": 378.4, "t": " करम प्रदान भीस्व करी राखा", "w": []}
{"chunk": 0, "s": 378.4, "e": 383.84, "t": " जो जस करही सो तस फल चाखा", "w": []}
{"chunk": 0, "s": 383.84, "e": 389.84, "t": " तदपी करही सम भिशम भिहारा", "w": []}
{"chunk": 0, "s": 389.84, "e": 394.84, "t": " दबखत अभखत प्रदे अनसारा", "w": []}
{"chunk": 0, "s": 394.84, "e": 403.84, "t": " आगुन अलेप आमान एक रस्राम सगुन भै", "w": []}
{"chunk": 0, "s": 403.84, "e": 408.84, "t": " भखत पेम बस्राम सदा", "w": []}
{"chunk": 0, "s": 408.84, "e": 412.44, "t": " सेवग रुच़्ाखि", "w": []}
{"chunk": 0, "s": 412.44, "e": 414.84, "t": " भेद पुरान", "w": []}
{"chunk": 0, "s": 414.84, "e": 418.04, "t": " साद सुर साखि", "w": []}
{"chunk": 0, "s": 418.04, "e": 421.64, "t": " आस जिय जानि तजज़ू", "w": []}
{"chunk": 0, "s": 421.64, "e": 423.84, "t": " उटिलाए", "w": []}
{"chunk": 0, "s": 423.84, "e": 425.64, "t": " करहु भरत", "w": []}
{"chunk": 0, "s": 425.64, "e": 429.84, "t": " पद प्रीत सुहाए", "w": []}
{"chunk": 0, "s": 432.84, "e": 436.84, "t": " राम भगत परहित निरत", "w": []}
{"chunk": 0, "s": 436.84, "e": 441.84, "t": " पर दुख दुखी दयाल", "w": []}
{"chunk": 0, "s": 442.84, "e": 446.84, "t": " बवगत सिलो मनी भरत्तें", "w": []}
{"chunk": 0, "s": 446.84, "e": 451.84, "t": " जन दर पहु सूर पाल", "w": []}
{"chunk": 0, "s": 454.84, "e": 457.84, "t": " साथ संग प्रभु", "w": []}
{"chunk": 0, "s": 457.84, "e": 460.84, "t": " सुरहित कारी", "w": []}
{"chunk": 0, "s": 460.84, "e": 465.84, "t": " भरत राम आयस अनसारी", "w": []}
{"chunk": 0, "s": 465.84, "e": 471.84, "t": " सवारत्द भी भास भी काल तुम हो हो", "w": []}
{"chunk": 0, "s": 471.84, "e": 477.84, "t": " भवरत्द तो सु नहीं राव वोर मोहो", "w": []}
{"chunk": 0, "s": 477.84, "e": 482.84, "t": " सूनि सुर बर सूर गुर बर्वानी", "w": []}
{"chunk": 0, "s": 482.84, "e": 488.84, "t": " बाप्र मोदु मन मिटी गलानी", "w": []}
{"chunk": 0, "s": 488.84, "e": 493.84, "t": " बरश्प्रसुन रश्प्रसुर राव।", "w": []}
{"chunk": 0, "s": 493.84, "e": 510.84, "t": " बवर्द शबाओ, एभिदि भवर्द चले मगजाही, दसा देखी मुनी सीथ सिहाही,", "w": []}
{"chunk": 0, "s": 510.84, "e": 516.84, "t": " जबही राम। कही लेही उसासा", "w": []}
{"chunk": 0, "s": 516.84, "e": 521.84, "t": " उमगत पेम। मनहु चव पासा", "w": []}
{"chunk": 0, "s": 521.84, "e": 527.84, "t": " द्रवही बचने सूनी उलिस पशाना", "w": []}
{"chunk": 0, "s": 527.84, "e": 533.84, "t": " फुर जन पेम। नजाई बखाना", "w": []}
{"chunk": 0, "s": 533.84, "e": 538.84, "t": " दीच भास करी जम। नही आए", "w": []}
{"chunk": 0, "s": 538.84, "e": 544.84, "t": " निरकि निरु लो चन जल चाहे", "w": []}
{"chunk": 0, "s": 546.84, "e": 551.84, "t": " रगु बर बरन भिलो कि बर", "w": []}
{"chunk": 0, "s": 551.84, "e": 557.84, "t": " बारि समेट समाज", "w": []}
{"chunk": 0, "s": 557.84, "e": 561.84, "t": " अप्मगन बारिध भिरध", "w": []}
{"chunk": 0, "s": 561.84, "e": 566.84, "t": " चडे भिभे एक जहाज", "w": []}
{"chunk": 0, "s": 568.84, "e": 581.84, "t": " जमनतीर तेही दिन करी भासु भाया उ सम्झे सम्सबही सुपासु", "w": []}
{"chunk": 0, "s": 581.84, "e": 592.84, "t": " राती खात गात की तरनी आए आगनित जाहीन बरनी", "w": []}
{"chunk": 0, "s": 592.84, "e": 599.92, "t": " प्रात पार भए एक एह के माद पूषे", "w": []}
{"chunk": 1, "s": 600.0, "e": 605.0, "t": " ने राम सक्ठा की सेवां", "w": []}
{"chunk": 1, "s": 605.0, "e": 610.0, "t": " चले नहाए, नदिजी सिर नहाए", "w": []}
{"chunk": 1, "s": 610.0, "e": 616.0, "t": " सातन शाद नात दो बाई", "w": []}
{"chunk": 1, "s": 616.0, "e": 621.0, "t": " आगे मुनी बरे बाहन आचे", "w": []}
{"chunk": 1, "s": 621.0, "e": 627.0, "t": " राज समाज जाए सब पाचे", "w": []}
{"chunk": 1, "s": 627.0, "e": 632.32, "t": " देपाचे दो बन्दु पयादे", "w": []}
{"chunk": 1, "s": 632.32, "e": 637.96, "t": " भूशन भसन भेश सुत्टि सादे", "w": []}
{"chunk": 1, "s": 637.96, "e": 643.72, "t": " सेवक सुभ्रेद सच्व सुत्साथा", "w": []}
{"chunk": 1, "s": 643.72, "e": 649.32, "t": " सुमिरत लखन सी आरगना था", "w": []}
{"chunk": 1, "s": 649.32, "e": 654.96, "t": " जाह जाह राम भास भेश्रामा", "w": []}
{"chunk": 1, "s": 654.96, "e": 660.96, "t": " ताहता है करही सप्रेम प्रनामा", "w": []}
{"chunk": 1, "s": 662.96, "e": 667.96, "t": " मगभासी नरनारी सूनी", "w": []}
{"chunk": 1, "s": 667.96, "e": 672.96, "t": " डाम काम तजीदाई", "w": []}
{"chunk": 1, "s": 673.96, "e": 677.96, "t": " देखि सरूप सने है सब", "w": []}
{"chunk": 1, "s": 677.96, "e": 682.96, "t": " मुदित जनम फलुपाई", "w": []}
{"chunk": 1, "s": 684.96, "e": 697.96, "t": " भाहे सपेम एक एक पाही राम लखनु सक्वि औहे किनाही", "w": []}
{"chunk": 1, "s": 697.96, "e": 703.44, "t": " भैबप भरन रूप सोयाली", "w": []}
{"chunk": 1, "s": 703.44, "e": 708.96, "t": " सीलू सने हुट सरिस समचाली", "w": []}
{"chunk": 1, "s": 708.96, "e": 714.96, "t": " बेशुन सो सकी सीयन संगा", "w": []}
{"chunk": 1, "s": 714.96, "e": 719.96, "t": " आगे अनी चली चटुरंगा", "w": []}
{"chunk": 1, "s": 719.96, "e": 722.96, "t": " नहीं प्रसं न मुख", "w": []}
{"chunk": 1, "s": 722.96, "e": 731.48, "t": " मानस्केदा सक्छिसंदे हूँ येही मेदा", "w": []}
{"chunk": 1, "s": 731.48, "e": 737.12, "t": " तासु तरकतिया गन्मन्मानी", "w": []}
{"chunk": 1, "s": 737.12, "e": 742.76, "t": " काहि सकलतिये समन सयानी", "w": []}
{"chunk": 1, "s": 742.76, "e": 748.44, "t": " तिः सराही मानी फुरी पूजी", "w": []}
{"chunk": 1, "s": 748.44, "e": 753.76, "t": " बोली मदोर बचनती यदूजी", "w": []}
{"chunk": 1, "s": 753.76, "e": 759.54, "t": " कही सपेम सब कता प्रसंगु", "w": []}
{"chunk": 1, "s": 759.54, "e": 765.26, "t": " जेही भी दिराम राज्रस बंगु", "w": []}
{"chunk": 1, "s": 765.26, "e": 770.84, "t": " बरतइ भजुरी सरान लागी", "w": []}
{"chunk": 1, "s": 770.84, "e": 777.26, "t": " सील सने है, सुभाय सुभागी", "w": []}
{"chunk": 1, "s": 778.44, "e": 790.44, "t": " चलत पयादे, खात फलक, पितादीने तजी राजु,", "w": []}
{"chunk": 1, "s": 790.44, "e": 799.44, "t": " जात मनावन रगु बरहें, भहरत सरिसे को आजु", "w": []}
{"chunk": 1, "s": 799.44, "e": 813.44, "t": " आप भागति भारत आचरनू काहत सुनत दुख दूशन एरनू", "w": []}
{"chunk": 1, "s": 813.44, "e": 824.44, "t": " जो कि चुका हभ खोर सक्सोई राम बन्दू अस काहे नहोई", "w": []}
{"chunk": 1, "s": 824.44, "e": 830.44, "t": " रानी नाहीन, भिद्छ सब चानुज भरत देखे,", "w": []}
{"chunk": 1, "s": 830.44, "e": 835.44, "t": " भाईन दन जुबती जन लेखे,", "w": []}
{"chunk": 1, "s": 835.44, "e": 841.44, "t": " सुनिगुन देखी दसा पच्टाही,", "w": []}
{"chunk": 1, "s": 841.44, "e": 847.44, "t": " कै कै जनन जोब सो तुनाहीन,", "w": []}
{"chunk": 1, "s": 847.44, "e": 852.44, "t": " उक अह दूशनु रानी नाहीन,", "w": []}
{"chunk": 1, "s": 852.44, "e": 858.44, "t": " बिद्य सब कीन हमें जो दाहिन", "w": []}
{"chunk": 1, "s": 858.44, "e": 864.44, "t": " काहाम लोक भेद भिदीनी", "w": []}
{"chunk": 1, "s": 864.44, "e": 869.44, "t": " लगती या खुल कर तुती मलीनी", "w": []}
{"chunk": 1, "s": 869.44, "e": 875.44, "t": " बस आई कुदेसे कुगाँ उबामा", "w": []}
{"chunk": 1, "s": 875.44, "e": 881.44, "t": " काहा यह दरस उपुन परिनामा", "w": []}
{"chunk": 1, "s": 881.44, "e": 886.44, "t": " आस अनन्द आचेलिजु प्रति ग्रामा", "w": []}
{"chunk": 1, "s": 886.44, "e": 893.44, "t": " जन्मर बूमि कलप्र तरुजामा", "w": []}
{"chunk": 1, "s": 895.44, "e": 899.44, "t": " बहरत दरस्दे कद खुलेओ", "w": []}
{"chunk": 1, "s": 899.44, "e": 905.44, "t": " मगलो गन कर बागु", "w": []}
{"chunk": 1, "s": 905.44, "e": 910.44, "t": " जनु सिंगल भासिन भ्यएओ", "w": []}
{"chunk": 1, "s": 910.44, "e": 915.44, "t": " भिदिभस सुलव प्रयाग।", "w": []}
{"chunk": 1, "s": 918.44, "e": 923.44, "t": " निजगुन सहीत राम गुन्गाता", "w": []}
{"chunk": 1, "s": 923.44, "e": 929.44, "t": " सुनत जाही सुमिरत रगनाता", "w": []}
{"chunk": 1, "s": 929.44, "e": 934.44, "t": " तीरत मुनि आशम सुर्दामा", "w": []}
