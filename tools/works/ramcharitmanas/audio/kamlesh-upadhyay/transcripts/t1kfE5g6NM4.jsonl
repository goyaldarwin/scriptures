{"chunk": 3, "s": 1829.0, "e": 1849.4, "t": " मा तही ते Hanım, नाहिन साथु सबाजेजे, सुनहो लखन भल भरत सरीषा, बिधिप्र पन्छ मह, सु नाण्तीषा.", "w": []}
{"chunk": 3, "s": 1849.4, "e": 1861.4, "t": " बहरतही हो यी नराज मद भिदिहर रह पद पाए", "w": []}
{"chunk": 3, "s": 1861.4, "e": 1870.4, "t": " कबहुकी काजी सी करन चीर सिंदू भीन साई", "w": []}
{"chunk": 3, "s": 1870.4, "e": 1884.4, "t": " ती मिरु तरून तरनी माकु गिलए गगनु मगन माकु मेगाई मिलए", "w": []}
{"chunk": 3, "s": 1884.4, "e": 1890.4, "t": " गो पदजल बोड़े ही गडद जोनी", "w": []}
{"chunk": 3, "s": 1890.4, "e": 1895.4, "t": " साज चमा बरु चाल चोने", "w": []}
{"chunk": 3, "s": 1896.4, "e": 1901.4, "t": " मसक फुख माकु मेरु उडाई", "w": []}
{"chunk": 3, "s": 1902.4, "e": 1907.4, "t": " होई नरिप मदू बरत आई", "w": []}
{"chunk": 3, "s": 1908.4, "e": 1913.4, "t": " लखन तुमार सपत की तुाना", "w": []}
{"chunk": 3, "s": 1914.4, "e": 1918.4, "t": " सुच सुबन्दू नहीं बरत समाना", "w": []}
{"chunk": 3, "s": 1918.4, "e": 1924.4, "t": " सगुन खिरू आवगुन जलू ताता", "w": []}
{"chunk": 3, "s": 1924.4, "e": 1930.4, "t": " मिलाई रचै पर पन्चु भिलाता", "w": []}
{"chunk": 3, "s": 1930.4, "e": 1935.4, "t": " बरतु हमस रभी बन सतलागा", "w": []}
{"chunk": 3, "s": 1935.4, "e": 1941.4, "t": " जनमिकी नगुन दोष भिबागा", "w": []}
{"chunk": 3, "s": 1941.4, "e": 1944.4, "t": " गईगुन पैतजी", "w": []}
{"chunk": 3, "s": 1944.4, "e": 1952.4, "t": " आवे गुन बारी निजजस जगत की नहो जी आरी", "w": []}
{"chunk": 3, "s": 1952.4, "e": 1958.4, "t": " काद भरत गुन सीलू सुबाओ", "w": []}
{"chunk": 3, "s": 1958.4, "e": 1964.4, "t": " पेम पयोदि मगन रगु राओ", "w": []}
{"chunk": 3, "s": 1964.4, "e": 1986.4, "t": " सुन्नी रग भर्भानी भिबुद, देख भरत परहेत, सकल सराह तराम सो प्रभू को क्रिपानिकेत", "w": []}
{"chunk": 3, "s": 1986.4, "e": 2011.4, "t": " जोन होत जग जनम भबरत को सकल दरम दूर दरनी दरत को कभी कुल आगम भबरत उन्गा था को जाने तुम भीन रगना था", "w": []}
{"chunk": 3, "s": 2011.4, "e": 2017.04, "t": " लखन राम सी एं सुन सुर्भानी", "w": []}
{"chunk": 3, "s": 2017.04, "e": 2022.72, "t": " अति सुखले है वुन जाई बखानी", "w": []}
{"chunk": 3, "s": 2022.72, "e": 2028.32, "t": " इहा बरतु सब सहित सहाए", "w": []}
{"chunk": 3, "s": 2028.32, "e": 2033.92, "t": " मन्दा किनी उनी तनाए", "w": []}
{"chunk": 3, "s": 2033.92, "e": 2037.52, "t": " सरित समीप राखि", "w": []}
{"chunk": 3, "s": 2037.52, "e": 2045.32, "t": " सब लोगा मागी मातु गुर सच्छिवनुगा", "w": []}
{"chunk": 3, "s": 2045.32, "e": 2051.08, "t": " चले बारतु जहन सीर गुराई", "w": []}
{"chunk": 3, "s": 2051.08, "e": 2056.64, "t": " साथ निशाद ना तु लग भाई", "w": []}
{"chunk": 3, "s": 2056.64, "e": 2062.44, "t": " समज्झी मातु करतब सकु चाही", "w": []}
{"chunk": 3, "s": 2062.44, "e": 2067.76, "t": " करत कु तरक कोटी मनमाही", "w": []}
{"chunk": 3, "s": 2067.76, "e": 2073.52, "t": " राम लकन सी एज सुनि ममनाउ", "w": []}
{"chunk": 3, "s": 2073.52, "e": 2079.76, "t": " उठी जन आनत जाही तजठाू।", "w": []}
{"chunk": 3, "s": 2081.76, "e": 2086.28, "t": " मात्मते महुमानी मुही", "w": []}
{"chunk": 3, "s": 2086.28, "e": 2091.68, "t": " जो कचु कर ही सुत्फोर", "w": []}
{"chunk": 3, "s": 2091.68, "e": 2100.68, "t": " अग अव गुन छम आदर है समझ आपनी ओर", "w": []}
{"chunk": 3, "s": 2103.68, "e": 2109.68, "t": " जो परी हरही मली न मनु जानी", "w": []}
{"chunk": 3, "s": 2109.68, "e": 2114.68, "t": " जो सन मानही सेवा कुमानी", "w": []}
{"chunk": 3, "s": 2114.68, "e": 2125.68, "t": " मोरे सरन रामहे के पनही, रामसु सुमि दोस सब जनही.", "w": []}
{"chunk": 3, "s": 2125.68, "e": 2137.68, "t": " जगजस भाजन चातक मीना, नेम पेम निजे निपुन नभीना,", "w": []}
{"chunk": 3, "s": 2137.68, "e": 2143.48, "t": " आस्मन गुनत चले मग जाता", "w": []}
{"chunk": 3, "s": 2143.48, "e": 2149.08, "t": " सकुछ सनेज सितिल सब गाता", "w": []}
{"chunk": 3, "s": 2149.08, "e": 2154.68, "t": " खेर दिमन हु मातु प्रित खोरी", "w": []}
{"chunk": 3, "s": 2154.68, "e": 2160.28, "t": " चलत भागती भल दीर जथोरी", "w": []}
{"chunk": 3, "s": 2160.28, "e": 2165.88, "t": " जब समजध रगुनात सुभाओ", "w": []}
{"chunk": 3, "s": 2165.88, "e": 2171.68, "t": " तब पत परत उता येल पाओ", "w": []}
{"chunk": 3, "s": 2171.68, "e": 2177.32, "t": " भरत दसाते ही आव सर कैसी", "w": []}
{"chunk": 3, "s": 2177.32, "e": 2182.92, "t": " जल प्रवाँ जल आलीगत जैसी", "w": []}
{"chunk": 3, "s": 2182.92, "e": 2188.8, "t": " देखी भरत कर सोच उसने हु", "w": []}
{"chunk": 3, "s": 2188.8, "e": 2194.88, "t": " भान शाद तेही समय भी दे हु", "w": []}
{"chunk": 3, "s": 2195.88, "e": 2206.88, "t": " लगे होन मंगल सगुन सुनिगुन कहतनिशाद", "w": []}
{"chunk": 3, "s": 2206.88, "e": 2215.88, "t": " मिति ही सोच हो यही हरष्पूनि परिनाम भी शाद", "w": []}
{"chunk": 3, "s": 2215.88, "e": 2229.88, "t": " शेवक बच्चन साथ सब जाने आश्रमनी कट जाहीनी राने", "w": []}
{"chunk": 3, "s": 2229.88, "e": 2235.88, "t": " बरत दिख बन सेल समाजु", "w": []}
{"chunk": 3, "s": 2235.88, "e": 2241.88, "t": " मुदित चुदित जनु पाए सुनाजु", "w": []}
{"chunk": 3, "s": 2241.88, "e": 2246.88, "t": " एत भी ती जनु प्रजा दुखाएरी", "w": []}
{"chunk": 3, "s": 2246.88, "e": 2252.88, "t": " त्री भिध्ताप पेडित गरामारी", "w": []}
{"chunk": 3, "s": 2252.88, "e": 2257.88, "t": " जाए सुराज सुदेस सुकारी", "w": []}
{"chunk": 3, "s": 2257.88, "e": 2263.88, "t": " वो ही भरत गती देहि यनूहरी", "w": []}
{"chunk": 3, "s": 2263.88, "e": 2269.88, "t": " राम भास बन समपत ब्राजा", "w": []}
{"chunk": 3, "s": 2269.88, "e": 2274.88, "t": " सुखि प्रजा जनू पाहि सुराजा", "w": []}
{"chunk": 3, "s": 2274.88, "e": 2280.88, "t": " सच्छिव भिरागु भी भे कुनरे सु", "w": []}
{"chunk": 3, "s": 2280.88, "e": 2286.88, "t": " भिपिन सुहावन पावन देसु", "w": []}
{"chunk": 3, "s": 2286.88, "e": 2292.2, "t": " भद्जमनियम सेल रजदानी", "w": []}
{"chunk": 3, "s": 2292.2, "e": 2297.88, "t": " सान्ति सुमति सुचि सुंदर रानी", "w": []}
{"chunk": 3, "s": 2297.88, "e": 2303.8, "t": " सकल अंग सम्खन सुराओ", "w": []}
{"chunk": 3, "s": 2303.8, "e": 2309.96, "t": " राम चरन आश्रित चिथ चाओ", "w": []}
{"chunk": 3, "s": 2309.96, "e": 2321.96, "t": " जीत मोह महिपालु दल सहित भी बेख भुालु", "w": []}
{"chunk": 3, "s": 2321.96, "e": 2330.96, "t": " करत अकन तक राजुपुर सुख सम्पदा सुकालु", "w": []}
{"chunk": 3, "s": 2330.96, "e": 2344.96, "t": " बन प्रदे समुनि भास गनेरे जन्पूर नगर गाम गन केरे", "w": []}
{"chunk": 3, "s": 2344.96, "e": 2355.96, "t": " भिपुलब चीत्र भी हग म्रिग नाना प्रजा समाजुन जाई बखाना", "w": []}
{"chunk": 3, "s": 2355.96, "e": 2361.96, "t": " वहना खगहा करी एडी बाग बना", "w": []}
{"chunk": 3, "s": 2361.96, "e": 2367.96, "t": " देखी महिष ब्रिष साजु सदास", "w": []}
{"chunk": 3, "s": 2367.96, "e": 2372.96, "t": " बयर विहाई चरही एक संगा", "w": []}
{"chunk": 3, "s": 2372.96, "e": 2378.96, "t": " जाहता हमने हु सेन चतु रंगा", "w": []}
{"chunk": 3, "s": 2378.96, "e": 2383.96, "t": " जरना जरही मात कजगा", "w": []}
{"chunk": 3, "s": 2383.96, "e": 2389.96, "t": " वाज़ेहि मनहो निसान बिभिद़ भिदिबाज़ेहि", "w": []}
{"chunk": 3, "s": 2389.96, "e": 2395.96, "t": " चक चकोर चातक सुक तिक गन", "w": []}
{"chunk": 3, "s": 2395.96, "e": 2399.96, "t": " कोजत मनज मराल", "w": []}
{"chunk": 4, "s": 2400.0, "e": 2424.9, "t": " मुदित मन, वलिगन गावत, नाचत मुडा, जन सुराज मंगल चहु उरा, भेली बिटप प्त्रिन, सफल सपूला, सब समाजु मुड, मंगल मुला.", "w": []}
{"chunk": 4, "s": 2424.9, "e": 2446.9, "t": " राम सेल सोभान रकि, बहरत ख्रिदएं अत्पेम, तापस तप फल पाएजि मि, सुखि सिराने नेम।", "w": []}
