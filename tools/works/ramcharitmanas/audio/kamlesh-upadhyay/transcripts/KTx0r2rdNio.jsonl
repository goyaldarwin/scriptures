{"chunk": 0, "s": 310.96, "e": 315.96, "t": " रामहि देवनरे", "w": []}
{"chunk": 0, "s": 315.96, "e": 323.96, "t": " एक समय सब साहित समाजा", "w": []}
{"chunk": 0, "s": 323.96, "e": 330.96, "t": " राज सबहा रगु राज भी राजा", "w": []}
{"chunk": 0, "s": 330.96, "e": 337.96, "t": " सकल सुक्रित मुरती नरे ना हु", "w": []}
