{"chunk": 1, "s": 1107.66, "e": 1112.66, "t": " सूनी रहसे वूरनिवास", "w": []}
{"chunk": 1, "s": 1112.66, "e": 1117.66, "t": " सो बद्लकी भिदु बड़ध जन", "w": []}
{"chunk": 1, "s": 1117.66, "e": 1122.82, "t": " बार दिभीच भिलास", "w": []}
{"chunk": 1, "s": 1124.54, "e": 1130.82, "t": " प्रत्म जाए जिन भचन सुनाए", "w": []}
{"chunk": 1, "s": 1131.62, "e": 1137.86, "t": " भूशन भशन भूरी तिम्ठाए", "w": []}
{"chunk": 1, "s": 1138.62, "e": 1145.18, "t": " प्रेम पुला की तन मन अनुरागी", "w": []}
{"chunk": 1, "s": 1145.18, "e": 1159.18, "t": " मंगल, कलस, सजन, सब लागी, चोके चार, सुमित्रा पूरी", "w": []}
{"chunk": 1, "s": 1159.18, "e": 1166.18, "t": " मनी मैं भी भिदबाते अत्रूरी", "w": []}
{"chunk": 1, "s": 1166.18, "e": 1172.18, "t": " आन्द मगन राम महतारी", "w": []}
{"chunk": 1, "s": 1172.18, "e": 1179.18, "t": " दिदान भजु भीप्रह कारी", "w": []}
{"chunk": 1, "s": 1179.18, "e": 1187.18, "t": " पूजी ग्राम देभी सुर्प्नागा", "w": []}
{"chunk": 1, "s": 1187.18, "e": 1194.18, "t": " कहे उ बहुरी देन बली भागा", "w": []}
{"chunk": 1, "s": 1194.18, "e": 1200.18, "t": " जेही भी दिहो एडाम कल्याम", "w": []}
{"chunk": 2, "s": 1200.0, "e": 1215.0, "t": " देवूदया करी सो बर्दानू गावही मंगल को खिल बयानी", "w": []}
{"chunk": 2, "s": 1215.0, "e": 1223.0, "t": " बिदु बद्नी म्रिग सावक नयानी", "w": []}
{"chunk": 2, "s": 1225.0, "e": 1235.0, "t": " राम राज अभिषे कुस्न यह रर्शे नरनार", "w": []}
{"chunk": 2, "s": 1235.0, "e": 1246.0, "t": " लगे सुमंगल सजन सब भिदि अन्कूल भीचारी", "w": []}
{"chunk": 2, "s": 1247.0, "e": 1254.0, "t": " तब नर नाजबसीश्ट बुलाए", "w": []}
{"chunk": 2, "s": 1255.0, "e": 1261.0, "t": " राम दाम सिख देन पठाए", "w": []}
{"chunk": 2, "s": 1261.0, "e": 1268.0, "t": " गुर। आगमन सुनत रगुना था", "w": []}
{"chunk": 2, "s": 1268.0, "e": 1275.0, "t": " दौर आई पद नायव माता", "w": []}
{"chunk": 2, "s": 1275.0, "e": 1282.0, "t": " सादर आरगग देई गर आने", "w": []}
{"chunk": 2, "s": 1282.0, "e": 1289.0, "t": " सोरह बाति पूजी सन्माने", "w": []}
{"chunk": 2, "s": 1289.0, "e": 1297.0, "t": " गज़न सी आसाइत भवोरी", "w": []}
{"chunk": 2, "s": 1297.0, "e": 1304.0, "t": " बोले रामु कमल करजोरी", "w": []}
{"chunk": 2, "s": 1304.0, "e": 1311.0, "t": " सेवक सदन स्वामी आगमानु", "w": []}
{"chunk": 2, "s": 1311.0, "e": 1318.0, "t": " मंगल मुल आमंगल जमानु", "w": []}
{"chunk": 2, "s": 1318.0, "e": 1325.08, "t": " तदपी उचित जन भोली सप्रीती", "w": []}
{"chunk": 2, "s": 1325.08, "e": 1332.12, "t": " पथ्यएं काजनात अस्नीती", "w": []}
{"chunk": 2, "s": 1332.12, "e": 1339.16, "t": " प्रभु ता ता जी प्रभु की नहसने हूँ", "w": []}
{"chunk": 2, "s": 1339.16, "e": 1346.08, "t": " मैंया उपनीत आजु यज गे हूँ", "w": []}
{"chunk": 2, "s": 1346.08, "e": 1353.16, "t": " आएस हो इसो कराओ गुसाई", "w": []}
{"chunk": 2, "s": 1353.16, "e": 1360.2, "t": " सेवक लहाई स्वामी सेवकाई", "w": []}
{"chunk": 2, "s": 1360.2, "e": 1368.04, "t": " सूनि सने हसाने बचन", "w": []}
{"chunk": 2, "s": 1368.04, "e": 1372.92, "t": " मुनि रग बरही प्रसंस", "w": []}
{"chunk": 2, "s": 1372.92, "e": 1384.92, "t": " राम कसन तुम कहाहू आस, हन्स बन्स अवतन्स,", "w": []}
{"chunk": 2, "s": 1384.92, "e": 1391.92, "t": " बरन राम गुन सील सु भाओ,", "w": []}
{"chunk": 2, "s": 1391.92, "e": 1398.92, "t": " बोले प्रेम पुलकिम निराओ,", "w": []}
{"chunk": 2, "s": 1398.92, "e": 1405.88, "t": " बूप सजेओ अभीशेक समाजू", "w": []}
{"chunk": 2, "s": 1405.88, "e": 1412.88, "t": " चाहत देन तुमही जुबराजू", "w": []}
{"chunk": 2, "s": 1412.88, "e": 1419.88, "t": " राम कराहु सब संजम आजू", "w": []}
{"chunk": 2, "s": 1419.88, "e": 1426.88, "t": " जो भिदि कुसलनिभा है काजू", "w": []}
{"chunk": 2, "s": 1426.88, "e": 1434.88, "t": " बूरु सिखडे ही राय पहे गयाूं", "w": []}
{"chunk": 2, "s": 1434.88, "e": 1441.88, "t": " रामगर दे आस भिस में भायाूं", "w": []}
{"chunk": 2, "s": 1441.88, "e": 1448.88, "t": " जन में एक संग सब बाई", "w": []}
{"chunk": 2, "s": 1448.88, "e": 1455.88, "t": " बो जन सायन के लिए लरी काई", "w": []}
{"chunk": 2, "s": 1455.88, "e": 1462.88, "t": " करन भेद उप भीत भीार", "w": []}
{"chunk": 2, "s": 1462.88, "e": 1469.88, "t": " संग संग सब भध उचार", "w": []}
{"chunk": 2, "s": 1469.88, "e": 1476.88, "t": " भीमल बन्स यहु अनुचित एकु", "w": []}
{"chunk": 2, "s": 1476.88, "e": 1483.88, "t": " बन्द भीहाई बड़े ही अभिशे कु", "w": []}
{"chunk": 2, "s": 1483.88, "e": 1491.32, "t": " प्रभु सप्रेम पच्छितानी सुहाई", "w": []}
{"chunk": 2, "s": 1491.32, "e": 1498.44, "t": " रहु भगत मन के कुतिलाई", "w": []}
{"chunk": 2, "s": 1498.44, "e": 1505.1, "t": " तेही आव सर आए लखन", "w": []}
{"chunk": 2, "s": 1505.1, "e": 1510.4, "t": " मगन प्रेम आनन्द", "w": []}
{"chunk": 2, "s": 1510.4, "e": 1521.4, "t": " सन्माने प्री अप्चन कही रगुकुल कहे रव चन्द", "w": []}
{"chunk": 2, "s": 1524.4, "e": 1530.4, "t": " बाजे ही बाजेने भी भीदध भीदाना", "w": []}
{"chunk": 2, "s": 1530.4, "e": 1535.4, "t": " पुर प्रमोदु नहीं जाई बखाना", "w": []}
{"chunk": 2, "s": 1535.4, "e": 1546.4, "t": " भरत आग मनु सकल मनावही आववग देगी नयन पल पावही", "w": []}
{"chunk": 2, "s": 1546.4, "e": 1557.4, "t": " राट भाट गर गली आताएी कहाई परस पर नोग लोगाई", "w": []}
{"chunk": 2, "s": 1557.4, "e": 1563.4, "t": " काली लगन भाले के तिक बारा", "w": []}
{"chunk": 2, "s": 1563.4, "e": 1568.4, "t": " पूजी हभिधि अदिलाश वमारा", "w": []}
{"chunk": 2, "s": 1568.4, "e": 1574.4, "t": " कन कस्म आसन सीय सनेता", "w": []}
{"chunk": 2, "s": 1574.4, "e": 1580.4, "t": " बेट है रांग फोई चित चेता", "w": []}
{"chunk": 2, "s": 1580.4, "e": 1583.4, "t": " सकल कहै ही कभ?", "w": []}
{"chunk": 2, "s": 1583.4, "e": 1591.4, "t": " खोई ही काली भिगन मनावही देव कुचाली", "w": []}
{"chunk": 2, "s": 1591.4, "e": 1597.4, "t": " दिनही सुहाईन अवध बदावा", "w": []}
{"chunk": 2, "s": 1597.4, "e": 1603.4, "t": " चोरही चंदिन रातिन भावा", "w": []}
{"chunk": 2, "s": 1603.4, "e": 1608.4, "t": " सारत बोली भिने सुर करही", "w": []}
{"chunk": 2, "s": 1608.4, "e": 1614.4, "t": " बारेभार पायले परहीं", "w": []}
{"chunk": 2, "s": 1618.4, "e": 1623.4, "t": " भी पति हमारी भिलो की बड़ि", "w": []}
{"chunk": 2, "s": 1623.4, "e": 1628.4, "t": " मातु करी आर सुई आज", "w": []}
{"chunk": 2, "s": 1629.4, "e": 1633.4, "t": " राम जाही बन राजु तजी", "w": []}
{"chunk": 2, "s": 1633.4, "e": 1638.4, "t": " हो इसकल सुर काज", "w": []}
{"chunk": 2, "s": 1641.4, "e": 1647.4, "t": " सुनि सुर भीन यधाडी पची आती", "w": []}
{"chunk": 2, "s": 1647.4, "e": 1652.4, "t": " भईयां सरोज भी पीन ही मराती", "w": []}
{"chunk": 2, "s": 1652.4, "e": 1658.4, "t": " देखी देवपुनी कहाही निहोरी", "w": []}
{"chunk": 2, "s": 1658.4, "e": 1664.4, "t": " मात तो ही नहीं दोरी या खोरी", "w": []}
{"chunk": 2, "s": 1664.4, "e": 1670.4, "t": " भिस मैं हरश्ठ रहित रग वुराओ", "w": []}
{"chunk": 2, "s": 1670.4, "e": 1675.4, "t": " तुम जान हु सब राम कर बाओ", "w": []}
{"chunk": 2, "s": 1675.4, "e": 1681.4, "t": " जीव करम भस सुक्धुक बागी", "w": []}
{"chunk": 2, "s": 1681.4, "e": 1686.4, "t": " जाए आवद देव ही तलारगे", "w": []}
{"chunk": 2, "s": 1686.4, "e": 1692.4, "t": " बार भार गई चरन सकोची", "w": []}
{"chunk": 2, "s": 1692.4, "e": 1697.4, "t": " चली बिचारी भिबुद मति कोची", "w": []}
{"chunk": 2, "s": 1697.4, "e": 1703.4, "t": " उच निवासु निच कर तूती", "w": []}
{"chunk": 2, "s": 1703.4, "e": 1709.4, "t": " देखिन सकही पराई भिबुती", "w": []}
{"chunk": 2, "s": 1709.4, "e": 1714.4, "t": " आगिल काजु बिचारी भहोनी", "w": []}
{"chunk": 2, "s": 1744.4, "e": 1756.4, "t": " अजस पेटारी ताहिकर गए गिरामत फेरे", "w": []}
{"chunk": 2, "s": 1756.4, "e": 1764.4, "t": " दिख मंत्रा नगर बनावा", "w": []}
{"chunk": 2, "s": 1764.4, "e": 1770.4, "t": " मनजुल मंगल बाज बदावा", "w": []}
{"chunk": 2, "s": 1770.4, "e": 1776.4, "t": " उचे सिलोगन काह उचा हूँ", "w": []}
{"chunk": 2, "s": 1776.4, "e": 1781.4, "t": " रामतिलक तुब सूनि भावर दाओ", "w": []}
{"chunk": 2, "s": 1781.4, "e": 1787.4, "t": " करै बिचारो कुबूदि कुजाति", "w": []}
{"chunk": 2, "s": 1787.4, "e": 1793.4, "t": " हो इ अकाजु कवन भिदिराति", "w": []}
{"chunk": 2, "s": 1793.4, "e": 1798.4, "t": " देखि लागी मदूख पूटिलक राति", "w": []}
{"chunk": 3, "s": 1830.0, "e": 1838.0, "t": " आल बद खोरे दीन लखन सिक आस्मन मोरे", "w": []}
{"chunk": 3, "s": 1838.0, "e": 1844.0, "t": " तब वून भोल चेर बडि पापिनी", "w": []}
{"chunk": 3, "s": 1844.0, "e": 1850.0, "t": " चारे स्वास कारे जन सापिनी", "w": []}
{"chunk": 3, "s": 1850.0, "e": 1863.0, "t": " सब हैरान कह कह सिकिम पूसल राम मही पाल", "w": []}
{"chunk": 3, "s": 1863.0, "e": 1873.0, "t": " लखन भ़रत रिपूदमन सुन भाए कुबरी उर सालू", "w": []}
{"chunk": 3, "s": 1873.0, "e": 1898.0, "t": " गाल करव के करबल पाए, रामए चारी पुसल के आजु, जेहि जने सुदे ही जुब राजु,", "w": []}
{"chunk": 3, "s": 1898.0, "e": 1910.0, "t": " बभाया उ कोस लेह भिदि अतिदाहीने, देक्ध गरव रहत उरनाहीने,", "w": []}
{"chunk": 3, "s": 1910.0, "e": 1921.0, "t": " देक्ध हुका सन जाई सब सोभा, जो अवलो की मुर मन चोभा,", "w": []}
{"chunk": 3, "s": 1921.0, "e": 1927.0, "t": " वूत भी देसन तोछ तुमहारे", "w": []}
{"chunk": 3, "s": 1927.0, "e": 1932.0, "t": " जानति हाँ बस ना हु रमारे", "w": []}
{"chunk": 3, "s": 1932.0, "e": 1938.0, "t": " नीद बवूत प्रीयः सेज तुराई", "w": []}
{"chunk": 3, "s": 1938.0, "e": 1944.0, "t": " लखा हु नबूप कपट चतुराई", "w": []}
{"chunk": 3, "s": 1944.0, "e": 1947.0, "t": " सूनी प्रीयः बचन मालिन", "w": []}
{"chunk": 3, "s": 1947.0, "e": 1955.0, "t": " वन मनु जाने जूकी रानी आब रहु अर्गानी", "w": []}
{"chunk": 3, "s": 1955.0, "e": 1961.0, "t": " उने आस कब हु कहसी गर पोडी", "w": []}
{"chunk": 3, "s": 1961.0, "e": 1967.0, "t": " कब द़ी जीब कडावाव तोडी", "w": []}
{"chunk": 3, "s": 1967.0, "e": 1980.0, "t": " काने, कोरे, कुबरे, कुटिले, कुचाली, जानी", "w": []}
{"chunk": 3, "s": 1980.0, "e": 1989.0, "t": " तियबि से शिपुन चेरी कही, भरत मात्म सुकान", "w": []}
{"chunk": 3, "s": 1989.0, "e": 2003.0, "t": " प्रीए बादिनी सिख देने उतो ही सपने उतो पर खोपन मुदन", "w": []}
{"chunk": 3, "s": 2003.0, "e": 2014.0, "t": " सुदिन सुमंगल दायक सोई तोर कहापफुर जेहि दिन गोई", "w": []}
{"chunk": 3, "s": 2014.0, "e": 2020.0, "t": " जेट स्वामी सेवाक्र लगवाई", "w": []}
{"chunk": 3, "s": 2020.0, "e": 2026.0, "t": " यह दिन करे कुले रीत सुहाई", "w": []}
{"chunk": 3, "s": 2026.0, "e": 2031.0, "t": " रामत लगवो साचे हुकाली", "w": []}
{"chunk": 3, "s": 2031.0, "e": 2037.0, "t": " देव मांगु मन भावत आली", "w": []}
{"chunk": 3, "s": 2037.0, "e": 2043.0, "t": " को सल्या सम सब महतारी", "w": []}
{"chunk": 3, "s": 2043.0, "e": 2048.32, "t": " राम ही सहज सुभाय प्यारी", "w": []}
{"chunk": 3, "s": 2048.32, "e": 2054.32, "t": " मों पर करही सने हुभी से की", "w": []}
{"chunk": 3, "s": 2054.32, "e": 2059.84, "t": " मैं करी क्रीत परीचा देखी", "w": []}
{"chunk": 3, "s": 2059.84, "e": 2065.72, "t": " जों भिदि जनम भे कर चो हुँ", "w": []}
{"chunk": 3, "s": 2065.72, "e": 2071.08, "t": " हो राम सी आप उद़ो हु", "w": []}
{"chunk": 3, "s": 2071.08, "e": 2077.04, "t": " प्रानत अदिक राम प्रीमोरे", "w": []}
{"chunk": 3, "s": 2077.04, "e": 2083.08, "t": " दिन्ह के तीलक चोब कस तोरे", "w": []}
{"chunk": 3, "s": 2085.72, "e": 2090.08, "t": " बहरत सपत्त तो ही साथ कहु", "w": []}
{"chunk": 3, "s": 2090.08, "e": 2095.08, "t": " परिहरी का पथ दुराँ", "w": []}
{"chunk": 3, "s": 2095.08, "e": 2105.08, "t": " रश़् समए भिस्मवो करस कारन मोही सूना", "w": []}
{"chunk": 3, "s": 2107.08, "e": 2113.08, "t": " एक यही भार आस सब पूजी", "w": []}
{"chunk": 3, "s": 2113.08, "e": 2119.08, "t": " अब कच्छा अब जीभ करी दूजी", "w": []}
{"chunk": 3, "s": 2119.08, "e": 2141.48, "t": " औरे जोग कपारू अबागा, भले उ कहत दुख रोरे दिलागा, कहाही जूटी फुरी बात बनाई, तेप्रिया तुम है, कर्वी मैंमाई.", "w": []}
{"chunk": 3, "s": 2141.48, "e": 2147.28, "t": " हम हु कहादी आब थھकृर सूहाती", "w": []}
{"chunk": 3, "s": 2147.28, "e": 2152.88, "t": " नहीं तमोन रहभ दिम राती", "w": []}
{"chunk": 3, "s": 2152.88, "e": 2158.48, "t": " करी कुरुप भिदी पर बस कीना", "w": []}
{"chunk": 3, "s": 2158.48, "e": 2164.28, "t": " बावा सोलुनी आलही आजो दीना", "w": []}
{"chunk": 3, "s": 2164.28, "e": 2169.68, "t": " औन पहो हा मैही का लानी", "w": []}
{"chunk": 3, "s": 2169.68, "e": 2175.0, "t": " चेरी चारी अब फोभ किरानी", "w": []}
{"chunk": 3, "s": 2175.0, "e": 2180.8, "t": " जारे जोग सुभाउ हमारा", "w": []}
{"chunk": 3, "s": 2180.8, "e": 2186.4, "t": " अनभल देखन जाए तुमारा", "w": []}
{"chunk": 3, "s": 2186.4, "e": 2192.08, "t": " ताते कचुक बात अनसारी", "w": []}
{"chunk": 3, "s": 2192.08, "e": 2198.4, "t": " च्हमी देभी बडी चुक हमारी", "w": []}
{"chunk": 3, "s": 2199.68, "e": 2210.68, "t": " बूड़ का पत्प्री आबचन सून, ती आदर बूदिरान,", "w": []}
{"chunk": 3, "s": 2210.68, "e": 2220.68, "t": " सुर्माया बस भेरिनि, सुर्द जानि पत्यानि,", "w": []}
{"chunk": 3, "s": 2220.68, "e": 2235.68, "t": " अदर पूनी पूनी पूछते ओही सबरी गान मरीगी जन्मोबी", "w": []}
{"chunk": 3, "s": 2235.68, "e": 2246.68, "t": " तसी मत्खेरी आही जसी भावी रहसी चेरी गात जन्बावी", "w": []}
{"chunk": 3, "s": 2246.68, "e": 2252.68, "t": " तुम पूचा हूँ मैं काहत दे राओ।", "w": []}
{"chunk": 3, "s": 2252.68, "e": 2257.68, "t": " तर हुमोर भर फोरी नाओ।", "w": []}
{"chunk": 3, "s": 2257.68, "e": 2263.68, "t": " सज्जि प्रती ती भजु भिदिगड ही चोली", "w": []}
{"chunk": 3, "s": 2263.68, "e": 2269.68, "t": " अवद साथ साती तब बोली", "w": []}
{"chunk": 3, "s": 2269.68, "e": 2274.68, "t": " प्रियसी राम काहा तुम रानी", "w": []}
{"chunk": 3, "s": 2274.68, "e": 2279.68, "t": " रामहि तुम हप्रीए सो फुरी भानी", "w": []}
{"chunk": 3, "s": 2280.68, "e": 2285.68, "t": " रहा प्रठम अब दे दिन भीते", "w": []}
{"chunk": 3, "s": 2286.68, "e": 2291.68, "t": " समव फिरे रिपुख हो ही पिरी ते", "w": []}
{"chunk": 3, "s": 2292.68, "e": 2297.68, "t": " मानु कमल खुल पोष निहारा", "w": []}
{"chunk": 3, "s": 2298.68, "e": 2302.68, "t": " बिनु जल जारी करही सो इचारा", "w": []}
{"chunk": 3, "s": 2302.68, "e": 2308.68, "t": " जर तुमहारी चह सवति उपारी", "w": []}
{"chunk": 3, "s": 2308.68, "e": 2314.68, "t": " रूदम करी पुपाया बरगारी", "w": []}
{"chunk": 3, "s": 2318.68, "e": 2322.68, "t": " तुमहाही नसोच उसुहाग भल", "w": []}
{"chunk": 3, "s": 2323.68, "e": 2328.68, "t": " निज भस जान हुराव", "w": []}
{"chunk": 3, "s": 2328.68, "e": 2338.68, "t": " मन्मलीन मुहमी तन्रपु रावृर सरल सुभा", "w": []}
{"chunk": 3, "s": 2340.68, "e": 2346.68, "t": " चतुर गमभीर राम महतारी", "w": []}
{"chunk": 3, "s": 2346.68, "e": 2352.68, "t": " भीच पाए निज बात सावारी", "w": []}
{"chunk": 3, "s": 2352.68, "e": 2358.0, "t": " पथे बहरत भूप नन्योरे", "w": []}
{"chunk": 3, "s": 2358.0, "e": 2363.68, "t": " राम मातु मत जान बरूरे", "w": []}
{"chunk": 3, "s": 2363.68, "e": 2369.52, "t": " सेवही साकल सवाती मूहिनी के", "w": []}
{"chunk": 3, "s": 2369.52, "e": 2374.96, "t": " गर्वित भारत मात भलपी के", "w": []}
{"chunk": 3, "s": 2374.96, "e": 2380.76, "t": " सालु तुमहार कोस लेहिमाई", "w": []}
{"chunk": 3, "s": 2380.76, "e": 2386.08, "t": " कपत चतुर नहीं होई जनाई", "w": []}
{"chunk": 3, "s": 2386.08, "e": 2392.16, "t": " लाज़े ही तुम्व पर प्रेमू भी सेखी", "w": []}
{"chunk": 3, "s": 2392.16, "e": 2395.76, "t": " सवति सुभाओ सकःी", "w": []}
{"chunk": 3, "s": 2395.76, "e": 2399.76, "t": " नहीं देखी रचिप्र पन्चु", "w": []}
{"chunk": 4, "s": 2400.0, "e": 2409.0, "t": " भो पहि आपनाई, राम तिलख हित लगन दھराई", "w": []}
{"chunk": 4, "s": 2409.0, "e": 2415.0, "t": " या खुल उचीत राम कहुती का", "w": []}
{"chunk": 4, "s": 2415.0, "e": 2420.0, "t": " सबहि सोहाई मोहि सुथिनी का", "w": []}
{"chunk": 4, "s": 2420.0, "e": 2426.0, "t": " आगिल बात समजी दर मोही", "w": []}
{"chunk": 4, "s": 2426.0, "e": 2432.0, "t": " देव देव पिरि सो पल ओही", "w": []}
{"chunk": 4, "s": 2435.0, "e": 2444.0, "t": " रच पच्खो टिक कुतिल पन कीने सिक पप्रभोद", "w": []}
{"chunk": 4, "s": 2446.0, "e": 2455.0, "t": " कही सिक ता सत सवति कैं जेही भिदिमाड भिरोद", "w": []}
{"chunk": 4, "s": 2456.0, "e": 2469.0, "t": " भावी पस प्रतीत वुर आई पूछ राहनी तूनी सपत दिवाई", "w": []}
{"chunk": 4, "s": 2469.0, "e": 2475.0, "t": " का पूछ हूँ तुम आब हून जाना", "w": []}
{"chunk": 4, "s": 2475.0, "e": 2480.0, "t": " निजेठ पानेइट पस पहिचाना", "w": []}
{"chunk": 4, "s": 2480.0, "e": 2486.0, "t": " भायव पात दिन सजत समाजू", "w": []}
{"chunk": 4, "s": 2486.0, "e": 2492.0, "t": " तुम पाए सुदे मुहिसन आजू", "w": []}
{"chunk": 4, "s": 2492.0, "e": 2497.0, "t": " खाय पाहीरिय राज तुमारे", "w": []}
{"chunk": 4, "s": 2497.0, "e": 2503.0, "t": " सद कहे नहीं दोश्रू हमारे", "w": []}
{"chunk": 4, "s": 2503.0, "e": 2509.0, "t": " जो असद कचु कहब बनाई", "w": []}
{"chunk": 4, "s": 2509.0, "e": 2514.32, "t": " कोवी भिदे हु, हमही सजाए", "w": []}
{"chunk": 4, "s": 2514.32, "e": 2520.08, "t": " लामही तिलक, काली जों भाया हु", "w": []}
{"chunk": 4, "s": 2520.08, "e": 2525.56, "t": " तुम हकाओ में पती, भीज भिदि भाया हु", "w": []}
{"chunk": 4, "s": 2525.56, "e": 2531.56, "t": " रेख खाचाए काहु, बल भाखी", "w": []}
{"chunk": 4, "s": 2531.56, "e": 2536.96, "t": " भामिली भाई हु, दूद कै माखी", "w": []}
{"chunk": 4, "s": 2536.96, "e": 2548.96, "t": " जों सुत सहीत करहु सेवकाई, तो गर रहा हुन आन कुपाई", "w": []}
{"chunk": 4, "s": 2550.96, "e": 2561.96, "t": " कद्रूब नतही दीन है दुपु, तुमही को सिलां देब", "w": []}
{"chunk": 4, "s": 2561.96, "e": 2570.96, "t": " बर्त बन्दिग्रिए सीहाई लखन राम के नेम", "w": []}
{"chunk": 4, "s": 2573.96, "e": 2579.96, "t": " कै कै सुता सुनत कट्वानी", "w": []}
{"chunk": 4, "s": 2579.96, "e": 2584.96, "t": " कहिन सकै कचु सहम सुखानी", "w": []}
{"chunk": 4, "s": 2584.96, "e": 2590.96, "t": " तन्पसे वु कदली जिन्कापी", "w": []}
{"chunk": 4, "s": 2590.96, "e": 2595.96, "t": " कुबरी दासनत चीव तब चापी", "w": []}
{"chunk": 4, "s": 2595.96, "e": 2601.96, "t": " कही कही को टिक का पत कहानी", "w": []}
{"chunk": 4, "s": 2601.96, "e": 2607.96, "t": " दिर जुदार हु प्रभो दिसिरानी", "w": []}
{"chunk": 4, "s": 2607.96, "e": 2612.96, "t": " फिरा करम उ प्रीया लागी कुचानी", "w": []}
{"chunk": 4, "s": 2612.96, "e": 2618.96, "t": " बकिज सराहे मानी मराली", "w": []}
{"chunk": 4, "s": 2618.96, "e": 2624.96, "t": " सुन मंख्रा बात पुरी तोरी", "w": []}
{"chunk": 4, "s": 2624.96, "e": 2629.96, "t": " दहनी आंखी नित खरक मोरी", "w": []}
{"chunk": 4, "s": 2629.96, "e": 2635.96, "t": " दिन प्रत्ती देखाँ लातिक वुसपने", "w": []}
{"chunk": 4, "s": 2635.96, "e": 2641.96, "t": " कहाँ नतो ही मोहबस अपने", "w": []}
{"chunk": 4, "s": 2641.96, "e": 2653.96, "t": " काह करो सकी सुद सुभाओ, दाहिन मामन जानव काओ", "w": []}
{"chunk": 4, "s": 2655.96, "e": 2665.96, "t": " आपने चलतन आजु लगी अनभल का हुक कीन", "w": []}
{"chunk": 4, "s": 2665.96, "e": 2676.26, "t": " कही अग एक एब आर मोझ, दैय दु सह दुख दीन है", "w": []}
{"chunk": 4, "s": 2676.26, "e": 2690.66, "t": " नई हर जन मुभार अब बरुजाई, जीयत नकरवी सवत सेवकाई", "w": []}
{"chunk": 4, "s": 2690.66, "e": 2695.98, "t": " आरी बस देव जी आवत जाही", "w": []}
{"chunk": 4, "s": 2695.98, "e": 2701.66, "t": " मरन लिक तेही जीवन चाही", "w": []}
{"chunk": 4, "s": 2701.66, "e": 2707.66, "t": " दीन बचन का हँ भाओ भी दिरानी", "w": []}
{"chunk": 4, "s": 2707.66, "e": 2712.66, "t": " सुनि कुबरी तियमाया ठानी", "w": []}
{"chunk": 4, "s": 2712.66, "e": 2718.66, "t": " आसका सका हु मानी मनूना", "w": []}
{"chunk": 4, "s": 2718.66, "e": 2724.3, "t": " सुkh suhaagu tum hu kahu din doona", "w": []}
{"chunk": 4, "s": 2724.3, "e": 2730.18, "t": " jehira aur ati anbalta ka", "w": []}
{"chunk": 4, "s": 2730.18, "e": 2735.5, "t": " soi pae hi yahu halu paripa ka", "w": []}
{"chunk": 4, "s": 2735.5, "e": 2741.34, "t": " jabte kumata suna main swamini", "w": []}
{"chunk": 4, "s": 2741.34, "e": 2746.94, "t": " bhukan baasar nidin jaamini", "w": []}
{"chunk": 4, "s": 2746.94, "e": 2752.94, "t": " भूछिएं भून्दिन रेख तिन्खाची", "w": []}
{"chunk": 4, "s": 2752.94, "e": 2757.94, "t": " भरत भूँल तोही आजसाची", "w": []}
{"chunk": 4, "s": 2757.94, "e": 2763.94, "t": " मामिन करहूत बहुपाू", "w": []}
{"chunk": 4, "s": 2763.94, "e": 2769.94, "t": " है तुम्हरी सेवा बस्राओ", "w": []}
{"chunk": 4, "s": 2769.94, "e": 2782.94, "t": " पराव कुपतुव बचन पर सकाव पूट पत्तित आगी", "w": []}
{"chunk": 4, "s": 2782.94, "e": 2792.94, "t": " काहसी मुर दुक देखि बड़ कासन करव हे तेलागी", "w": []}
{"chunk": 4, "s": 2792.94, "e": 2806.94, "t": " वूबरी करी कबूली कै के ही कपत चूरी पूर्पानते", "w": []}
{"chunk": 4, "s": 2806.94, "e": 2812.94, "t": " लखाई नानी निकत दुख कैसे", "w": []}
{"chunk": 4, "s": 2812.94, "e": 2817.94, "t": " चराई हरित तिन भलिपस जैसे", "w": []}
{"chunk": 4, "s": 2817.94, "e": 2823.94, "t": " सूनत बातम्रिदु अंत कतोरी", "w": []}
{"chunk": 4, "s": 2823.94, "e": 2829.94, "t": " देति मनहु मदु माहु रगोरी", "w": []}
{"chunk": 4, "s": 2829.94, "e": 2834.94, "t": " कहाई चेरी सुदि आहाई किनाही", "w": []}
{"chunk": 4, "s": 2834.94, "e": 2840.94, "t": " स्वामीन कही हु कता मही पाही", "w": []}
{"chunk": 4, "s": 2840.94, "e": 2846.94, "t": " दूई बरदान भूप सन्थाती", "w": []}
{"chunk": 4, "s": 2846.94, "e": 2851.94, "t": " माग हु आजु जुराव उचाती", "w": []}
{"chunk": 4, "s": 2851.94, "e": 2857.94, "t": " सुतही राजु रामही बन भासु", "w": []}
{"chunk": 4, "s": 2857.94, "e": 2862.94, "t": " देखु लेओ सब सवति हु लासु", "w": []}
{"chunk": 4, "s": 2862.94, "e": 2868.94, "t": " अपत्राम सबत जब कर आई", "w": []}
{"chunk": 4, "s": 2868.94, "e": 2874.94, "t": " तब मागे उजे ये बचन उन तर आई", "w": []}
{"chunk": 4, "s": 2874.94, "e": 2879.94, "t": " औई आखाजु आजु निस लिठे", "w": []}
{"chunk": 4, "s": 2879.94, "e": 2885.94, "t": " बचन वूर प्रीए मान उजे ते", "w": []}
{"chunk": 4, "s": 2885.94, "e": 2898.94, "t": " बड़े कुगा तु करी पात किन कहे से कोप गरी हे जान।", "w": []}
{"chunk": 4, "s": 2898.94, "e": 2907.94, "t": " काजू समारे हु सजग सब सहसा जन पत्या हु", "w": []}
{"chunk": 4, "s": 2907.94, "e": 2915.94, "t": " उबरी ही रानी प्राने प्रीए जानी", "w": []}
{"chunk": 4, "s": 2915.94, "e": 2921.94, "t": " बार बार बडी भूदी बखानी", "w": []}
{"chunk": 4, "s": 2921.94, "e": 2927.94, "t": " तो ही समही तन मोर संसारा", "w": []}
{"chunk": 4, "s": 2927.94, "e": 2933.94, "t": " बहे जात कई भाईस अदारा", "w": []}
{"chunk": 4, "s": 2933.94, "e": 2944.94, "t": " जो भिदि पुरभ मनो रत्खालि करो तो ही चक वूटर यालि", "w": []}
{"chunk": 4, "s": 2944.94, "e": 2955.94, "t": " बहु भिदि चेरि आदर देई कोप भवन गावनी के के", "w": []}
{"chunk": 4, "s": 2955.94, "e": 2961.94, "t": " भी पत्ति भीजु बरखारी तुचेरी", "w": []}
{"chunk": 4, "s": 2961.94, "e": 2967.94, "t": " भूई भाई कुमती कै कै केरी", "w": []}
{"chunk": 4, "s": 2967.94, "e": 2972.94, "t": " पाए कपटे जलू आंकुर जामा", "w": []}
{"chunk": 4, "s": 2972.94, "e": 2978.94, "t": " बर दो दल दॉख प्हल परिनामा", "w": []}
{"chunk": 4, "s": 2978.94, "e": 2984.94, "t": " खोप समाजु साजी सब शोई", "w": []}
{"chunk": 4, "s": 2984.94, "e": 2990.26, "t": " राजु करत निजे पुमति भिगोई", "w": []}
{"chunk": 4, "s": 2990.26, "e": 2996.1, "t": " रावुर नगर पुलाहलोई", "w": []}
{"chunk": 4, "s": 2996.1, "e": 3000.24, "t": " यह कुछानी कचु जाने", "w": []}
{"chunk": 5, "s": 3000.0, "e": 3007.0, "t": " प्रमुदित पुरनरनार ये सब सजहि सुमंगल चार", "w": []}
{"chunk": 5, "s": 3007.0, "e": 3014.0, "t": " एक प्रविसहि एक निर्गमहि भीर भूप दर्वार", "w": []}
{"chunk": 5, "s": 3014.0, "e": 3025.0, "t": " बाल सब बाल सब बाल चार", "w": []}
{"chunk": 5, "s": 3025.0, "e": 3040.0, "t": " बाल सका सुनी भी आरश्वाही मिल दस पाच राम पहिजाही", "w": []}
{"chunk": 5, "s": 3040.0, "e": 3046.0, "t": " प्रभू आदा रही प्रेम पहिचानी", "w": []}
{"chunk": 5, "s": 3046.0, "e": 3051.0, "t": " पूछ है कुसल खेम रे दुबानी", "w": []}
{"chunk": 5, "s": 3051.0, "e": 3057.0, "t": " फिरही भावान प्रिया आये सुपाई", "w": []}
{"chunk": 5, "s": 3057.0, "e": 3062.0, "t": " करत परस पर राम बडाई", "w": []}
{"chunk": 5, "s": 3062.0, "e": 3068.0, "t": " पोर गुभीर सरिस संसारा", "w": []}
{"chunk": 5, "s": 3068.0, "e": 3074.0, "t": " सीलु सने हु निभाह निहारा", "w": []}
{"chunk": 5, "s": 3074.0, "e": 3080.0, "t": " जेजेज जो निकारम भस ब्रमही", "w": []}
{"chunk": 5, "s": 3080.0, "e": 3085.12, "t": " ताठठ एस भेव यह रह मही", "w": []}
{"chunk": 5, "s": 3085.56, "e": 3090.92, "t": " सेवग हम स्वामी स्यना हु", "w": []}
{"chunk": 5, "s": 3091.32, "e": 3096.36, "t": " हो नात यह खोर निभा हु", "w": []}
{"chunk": 5, "s": 3096.88, "e": 3102.12, "t": " आस अभिलाश नगर सब का हु", "w": []}
{"chunk": 5, "s": 3102.56, "e": 3107.64, "t": " कै कै सुता ख्रिदन अतिदा हु", "w": []}
{"chunk": 5, "s": 3107.64, "e": 3119.64, "t": " औनक संगती पाए नसाई, रहाई ननीच मते चतुराई", "w": []}
{"chunk": 5, "s": 3122.64, "e": 3132.64, "t": " साज समे सानं दन्रिएप गयाउ कै कै गे है", "w": []}
{"chunk": 5, "s": 3132.64, "e": 3142.64, "t": " गवन न थूर ताने कटकीः जनुद हर देः सने है", "w": []}
{"chunk": 5, "s": 3145.64, "e": 3151.64, "t": " कोप भवन सूनी सकुच उराओ", "w": []}
{"chunk": 5, "s": 3151.64, "e": 3156.64, "t": " भैबस आग़ हुड़ पर एई न पाओ", "w": []}
{"chunk": 5, "s": 3156.64, "e": 3162.64, "t": " सुर पत्प्प्पस आईभाज बल जागे", "w": []}
{"chunk": 5, "s": 3162.64, "e": 3168.64, "t": " नर पति सकल रहाई रुख तागे", "w": []}
{"chunk": 5, "s": 3168.64, "e": 3173.64, "t": " सो सुन्ती यरी से गयां सुखाई", "w": []}
{"chunk": 5, "s": 3173.64, "e": 3179.64, "t": " देखाम काम प्रताप बडाई", "w": []}
{"chunk": 5, "s": 3179.64, "e": 3185.64, "t": " सुल खुलिस आसी आगवनि भारे", "w": []}
{"chunk": 5, "s": 3185.64, "e": 3190.96, "t": " तेर तिनाख सुमन सरमारे", "w": []}
{"chunk": 5, "s": 3190.96, "e": 3196.8, "t": " सबहयनरे सुप्याए पहिगयाओ", "w": []}
{"chunk": 5, "s": 3196.8, "e": 3202.36, "t": " देकि तसा दुख दारून भायाओ", "w": []}
{"chunk": 5, "s": 3202.36, "e": 3208.16, "t": " पूमि सयन पतु मोट पूराना", "w": []}
{"chunk": 5, "s": 3208.16, "e": 3213.72, "t": " दिये डारी तन भूशन नाना", "w": []}
{"chunk": 5, "s": 3213.72, "e": 3219.72, "t": " उमति ही कसी कुबेश्ता भाभी", "w": []}
{"chunk": 5, "s": 3219.72, "e": 3224.72, "t": " अन अहिवातु सुच जनु भाभी", "w": []}
{"chunk": 5, "s": 3224.72, "e": 3230.72, "t": " जाएन कटन रिपू कहम्रि दुमानी", "w": []}
{"chunk": 5, "s": 3230.72, "e": 3236.72, "t": " प्रान प्रिया के हे तुरिसानी", "w": []}
{"chunk": 5, "s": 3236.72, "e": 3244.72, "t": " वानाज्सरोशबूंग भामिनि भीशम भातिनिवारें", "w": []}
{"chunk": 5, "s": 3244.72, "e": 3252.72, "t": " दोबासना रसना दसन बर मरम थाखर देख़ें", "w": []}
{"chunk": 5, "s": 3252.72, "e": 3259.72, "t": " तूल सेंड्रे पति भावता व्याद्या वावता", "w": []}
{"chunk": 5, "s": 3259.72, "e": 3263.38, "t": " बर मर मथा खर देखएं", "w": []}
{"chunk": 5, "s": 3263.38, "e": 3267.32, "t": " तुल सीन्री पति बवता वियता", "w": []}
{"chunk": 5, "s": 3267.32, "e": 3271.72, "t": " बस खाम को गुख लेखएं", "w": []}
{"chunk": 5, "s": 3273.52, "e": 3276.76, "t": " बार भार कहराओ", "w": []}
{"chunk": 5, "s": 3277.26, "e": 3281.24, "t": " सु मुखिस लोचन पिक बचनि", "w": []}
{"chunk": 5, "s": 3282.08, "e": 3284.88, "t": " कारन मोही सूनाओ", "w": []}
{"chunk": 5, "s": 3284.88, "e": 3289.88, "t": " गजगा मिन निज कोप कर", "w": []}
{"chunk": 5, "s": 3292.88, "e": 3298.88, "t": " अनहित तोर प्रिया कें की ना", "w": []}
{"chunk": 5, "s": 3298.88, "e": 3303.88, "t": " के दुए सिर के ही जम चाहली ना", "w": []}
{"chunk": 5, "s": 3303.88, "e": 3309.88, "t": " कोई की रं कही करो नरे सु", "w": []}
{"chunk": 5, "s": 3309.88, "e": 3315.88, "t": " कोग की हिन्रे पही मिका साँ दे सु", "w": []}
{"chunk": 5, "s": 3315.88, "e": 3321.88, "t": " सकाउ तोर आरी पामराउ मारी", "w": []}
{"chunk": 5, "s": 3321.88, "e": 3326.88, "t": " काह कीत बपुरे नरनारी", "w": []}
{"chunk": 5, "s": 3326.88, "e": 3332.88, "t": " जानसी मोर सुभावु परोरु", "w": []}
{"chunk": 5, "s": 3332.88, "e": 3337.88, "t": " मन्तव आनने चंद चकोरु", "w": []}
{"chunk": 5, "s": 3337.88, "e": 3343.88, "t": " प्रिया पान सुत्सर बस मोरे", "w": []}
{"chunk": 5, "s": 3343.88, "e": 3348.88, "t": " परिजन प्रजा सकल बस तोरे", "w": []}
{"chunk": 5, "s": 3348.88, "e": 3354.88, "t": " जों कच्छ कहाँ का पट्टू करी तोही", "w": []}
{"chunk": 5, "s": 3354.88, "e": 3360.88, "t": " भानी निराम सपत सत्मोही", "w": []}
{"chunk": 5, "s": 3360.88, "e": 3365.88, "t": " भिहसी मागु मन भावती वाता", "w": []}
{"chunk": 5, "s": 3365.88, "e": 3371.88, "t": " भूशन सजह मनु हर गाता", "w": []}
{"chunk": 5, "s": 3371.88, "e": 3377.88, "t": " गरी कुगरी समुजी जी आदेक।", "w": []}
{"chunk": 5, "s": 3377.88, "e": 3383.88, "t": " भेगी प्रिया परी हर आइ तु भेखु", "w": []}
{"chunk": 5, "s": 3386.88, "e": 3391.88, "t": " यहसुनी मने गुनि सपत बाडी", "w": []}
{"chunk": 5, "s": 3391.88, "e": 3397.88, "t": " बिहसी उठी मत्मन्द", "w": []}
{"chunk": 5, "s": 3397.88, "e": 3402.88, "t": " वूशन सजति भिलो किम्रिग", "w": []}
{"chunk": 5, "s": 3402.88, "e": 3407.88, "t": " मनहु कि राती निप्वंद", "w": []}
{"chunk": 5, "s": 3410.88, "e": 3415.88, "t": " उनके हराव सोगे दजी आजानी", "w": []}
{"chunk": 5, "s": 3415.88, "e": 3421.88, "t": " ब्रेम पुलक्कि म्रेदु मन्जुल भानी", "w": []}
{"chunk": 5, "s": 3421.88, "e": 3427.88, "t": " बामीनि भ्याओ तोर मन्बावा", "w": []}
{"chunk": 5, "s": 3427.88, "e": 3432.88, "t": " भर गर नगर परंद बनावा", "w": []}
{"chunk": 5, "s": 3432.88, "e": 3438.88, "t": " रामहि देओ काली जु बराजु", "w": []}
{"chunk": 5, "s": 3438.88, "e": 3443.88, "t": " सजहि सुलो चनु मंगल साजु", "w": []}
{"chunk": 5, "s": 3443.88, "e": 3455.88, "t": " दलकी उठेव, सून, गरे दाया कठोरू, जन चुई गया उ पाक बर खोरू,", "w": []}
{"chunk": 5, "s": 3455.88, "e": 3466.88, "t": " आएसी उपीर भी हसी तिहिगोई, चोर नामरे जिम प्रगति नरोई,", "w": []}
{"chunk": 5, "s": 3466.88, "e": 3472.88, "t": " लखहिन भूप का पद्चतुराई", "w": []}
{"chunk": 5, "s": 3472.88, "e": 3477.88, "t": " बोटि कुतिल मनि भूरू पडाई", "w": []}
{"chunk": 5, "s": 3477.88, "e": 3483.88, "t": " जदब नीप्ति निकुन नर ना हूँ", "w": []}
{"chunk": 5, "s": 3483.88, "e": 3489.88, "t": " नार चरित जलन भी अवगा हूँ", "w": []}
{"chunk": 5, "s": 3489.88, "e": 3494.88, "t": " कपट सने हूँ बड़ाई भहोरी", "w": []}
{"chunk": 5, "s": 3494.88, "e": 3500.88, "t": " बोली भी हसी नयन मुमुरे", "w": []}
{"chunk": 5, "s": 3503.88, "e": 3513.88, "t": " मागु मागु पे कहा हूँ पीय, कब हुन देव, नलेव", "w": []}
{"chunk": 5, "s": 3514.88, "e": 3523.88, "t": " देन कहे हो बर्दान दुई तेओ पावत संदे", "w": []}
{"chunk": 5, "s": 3524.88, "e": 3538.88, "t": " जाने उमरम राव, खस कहाई तुमही कोहाब परम प्रिया आगाई", "w": []}
{"chunk": 5, "s": 3538.88, "e": 3549.88, "t": " ताती राखिन मागी हुकाई भिसरी गया उमहु भोर सुबहाई", "w": []}
{"chunk": 5, "s": 3549.88, "e": 3555.88, "t": " जोटे हु हा मैं, गोशु जन दे हूँ", "w": []}
{"chunk": 5, "s": 3555.88, "e": 3560.88, "t": " दूई के चारी माग मकले हूँ", "w": []}
{"chunk": 5, "s": 3560.88, "e": 3566.88, "t": " रग हुए भूल रीत सदा चल याई", "w": []}
{"chunk": 5, "s": 3566.88, "e": 3571.88, "t": " प्रान जाए मु बारु बचन न जाए", "w": []}
{"chunk": 5, "s": 3571.88, "e": 3577.88, "t": " नहीं असाथ समप पातक पूंजा", "w": []}
{"chunk": 5, "s": 3577.88, "e": 3583.88, "t": " गिरि सम्होंगी खोटिक गंजा", "w": []}
{"chunk": 5, "s": 3583.88, "e": 3589.88, "t": " सात्मुले सब सुप्रित सुहाए", "w": []}
{"chunk": 5, "s": 3589.88, "e": 3594.88, "t": " भेद पुरान भिदित मनुगाए", "w": []}
{"chunk": 5, "s": 3594.88, "e": 3599.88, "t": " तेही पर राम सपत कर्या", "w": []}
{"chunk": 6, "s": 3600.0, "e": 3606.0, "t": " भो ब्रदे निवाई सुक्रते सनेज आवादीरभूराई", "w": []}
{"chunk": 6, "s": 3606.0, "e": 3612.0, "t": " बात द्रडाई कुमती हसी भोली", "w": []}
{"chunk": 6, "s": 3612.0, "e": 3618.0, "t": " कुमती कुबीजग कुलाजन खोली", "w": []}
{"chunk": 6, "s": 3618.0, "e": 3631.0, "t": " भूप मनोरत सुबहग बन सुखसु भिहंग समाज।", "w": []}
{"chunk": 6, "s": 3631.0, "e": 3640.0, "t": " भिल्लिन जिमी चारन चहत बचन भयं कर भाज।", "w": []}
{"chunk": 6, "s": 3640.0, "e": 3654.52, "t": " शुन्हु प्रान्प्र्यच्टु ब्हावात्ची का देवू एक बर शब रद तहीका", "w": []}
{"chunk": 6, "s": 3654.52, "e": 3666.0, "t": " मागम दू सर भर कर जोली कुर्व्वं अग्मनो रचनोरी", "w": []}
{"chunk": 6, "s": 3666.0, "e": 3671.32, "t": " तापस भेश भिसेशि भुदासी", "w": []}
{"chunk": 6, "s": 3671.32, "e": 3677.0, "t": " चोदग भरीस राम बनवासी", "w": []}
{"chunk": 6, "s": 3677.0, "e": 3682.6, "t": " सुनिम्रि दुबआचन दूपूही यसोगु", "w": []}
{"chunk": 6, "s": 3682.6, "e": 3688.0, "t": " ससि कर चूवत भिकल जिन्कोखु", "w": []}
{"chunk": 6, "s": 3688.0, "e": 3694.0, "t": " गया उसहमी नहीं कचु कही आवा", "w": []}
{"chunk": 6, "s": 3694.0, "e": 3699.32, "t": " जन सचान बन जबते वलावा", "w": []}
{"chunk": 6, "s": 3699.32, "e": 3705.32, "t": " भिबरन भयवू निपप्रनर पालू", "w": []}
{"chunk": 6, "s": 3705.32, "e": 3710.72, "t": " दामिनि हने वू मन हु तर तालू", "w": []}
{"chunk": 6, "s": 3710.72, "e": 3716.52, "t": " माते हात मुदि दो लोचन", "w": []}
{"chunk": 6, "s": 3716.52, "e": 3722.08, "t": " तन दर सोचु लाग जन सोचन", "w": []}
{"chunk": 6, "s": 3722.08, "e": 3728.08, "t": " मुर मनोरत, सुरतर, पूला", "w": []}
{"chunk": 6, "s": 3728.08, "e": 3733.58, "t": " फरत करीन, जीमी, हत्यो सम्ला", "w": []}
{"chunk": 6, "s": 3733.58, "e": 3745.08, "t": " अवध उजार कीन, के के, दीन सी आचल भी पती केने", "w": []}
{"chunk": 6, "s": 3745.08, "e": 3757.6, "t": " खुवने आवसर का भ्याउ गयाउ नारी भिस्वास", "w": []}
{"chunk": 6, "s": 3757.6, "e": 3767.72, "t": " जोग सिथ्दि प्ल समय जिम जतिही अभी दानास", "w": []}
{"chunk": 6, "s": 3767.72, "e": 3793.72, "t": " एह भिदिराउ मनही मनजाखा, देखि कुमाति कुमाति मनमाखा, भर तुक्राउर कुतन होही, आने हु मोल बिसाही कि मोही,", "w": []}
{"chunk": 6, "s": 3793.72, "e": 3799.04, "t": " जो सुन सर्वास लाग तुमारे", "w": []}
{"chunk": 6, "s": 3799.04, "e": 3804.68, "t": " काहे नबोल हु बचन समारे", "w": []}
{"chunk": 6, "s": 3804.68, "e": 3810.56, "t": " देहु उतरू आनु करहू किनाही", "w": []}
{"chunk": 6, "s": 3810.56, "e": 3816.12, "t": " सात संग है तुम रगु कुलमाही", "w": []}
{"chunk": 6, "s": 3816.12, "e": 3821.8, "t": " देन कहे हु आब जनी बरु देहु", "w": []}
{"chunk": 6, "s": 3821.8, "e": 3827.8, "t": " तजज़ हु सात जग आप जसु लेओ।", "w": []}
{"chunk": 6, "s": 3827.8, "e": 3832.8, "t": " सात्य सराहि कहु बरु देना", "w": []}
{"chunk": 6, "s": 3832.8, "e": 3838.8, "t": " जाने वुलेहि मागि चबेना", "w": []}
{"chunk": 6, "s": 3838.8, "e": 3844.8, "t": " सी भिददी ची पल जो का चु बाखा", "w": []}
{"chunk": 6, "s": 3844.8, "e": 3849.8, "t": " तनु धनु तजएओ बचन पनु राखा", "w": []}
{"chunk": 6, "s": 3849.8, "e": 3861.8, "t": " आति कत बचन काती कै के मान लोन जरे पर देई", "w": []}
{"chunk": 6, "s": 3863.8, "e": 3873.8, "t": " दर्म दूरन दर दीर दरी नयन उगार राई", "w": []}
{"chunk": 6, "s": 3873.8, "e": 3884.8, "t": " सिर्दूनलीन उसास आसी मार सि मोही कुताय", "w": []}
{"chunk": 6, "s": 3884.8, "e": 3897.8, "t": " आगे दिख जरद रिसि भारी मन हुरोष पर्वारी गुडारी", "w": []}
{"chunk": 6, "s": 3897.8, "e": 3908.8, "t": " मोदिक भूदि भारन तूराई दरी कुबरी सान बनाई", "w": []}
{"chunk": 6, "s": 3908.8, "e": 3920.8, "t": " लखी महीप कराल कटोरा सत की जीवन लेही मोरा", "w": []}
{"chunk": 6, "s": 3920.8, "e": 3926.8, "t": " बोले राओ कटिन कर चाति", "w": []}
{"chunk": 6, "s": 3926.8, "e": 3931.8, "t": " बानी सभीने तासु सुहाति", "w": []}
{"chunk": 6, "s": 3931.8, "e": 3937.8, "t": " प्रिया बचन कस कहसि कुब हाति", "w": []}
{"chunk": 6, "s": 3937.8, "e": 3943.8, "t": " भीर प्रतित प्रीट करिहाति", "w": []}
{"chunk": 6, "s": 3943.8, "e": 3954.8, "t": " मोरे भरत रामु दुयाएखी सत कहो करी संकर साखी", "w": []}
{"chunk": 6, "s": 3954.8, "e": 3960.8, "t": " आवसी दूत मैं बध्ठविप प्राता", "w": []}
{"chunk": 6, "s": 3960.8, "e": 3965.8, "t": " आई है भेगी सुनत दो ब्राता", "w": []}
{"chunk": 6, "s": 3965.8, "e": 3971.8, "t": " सु दिन सोथी सब साजु सजाई", "w": []}
{"chunk": 6, "s": 3971.8, "e": 3977.8, "t": " देव भरत कहु राज बजाए", "w": []}
{"chunk": 6, "s": 3979.8, "e": 3984.8, "t": " लोब नराम ही राज कर", "w": []}
{"chunk": 6, "s": 3984.8, "e": 3989.8, "t": " बहुत भरत पर प्रीत", "w": []}
{"chunk": 6, "s": 3990.8, "e": 3994.8, "t": " मैं बडचोट बिचार जी", "w": []}
{"chunk": 6, "s": 3994.8, "e": 3999.8, "t": " करत रहा हुन ब्रे पनीत", "w": []}
{"chunk": 6, "s": 4001.8, "e": 4013.8, "t": " राम सपत सत कहाँ सुभाओ, राम मातु कचु कहाँ नकाओ,", "w": []}
{"chunk": 6, "s": 4013.8, "e": 4024.8, "t": " मैं सब की न तो ही बिन पूछें, तेहिते परे हु मनोरत चूछें,", "w": []}
{"chunk": 6, "s": 4024.8, "e": 4030.8, "t": " रिसिपरि हरु अब मंगल साजू", "w": []}
{"chunk": 6, "s": 4030.8, "e": 4036.8, "t": " कचु दिन गए भरत जु बराजु", "w": []}
{"chunk": 6, "s": 4036.8, "e": 4041.8, "t": " एक फीबात मोही दुख लागा", "w": []}
{"chunk": 6, "s": 4041.8, "e": 4047.8, "t": " बर्दू सर आस्मन जस्मागा", "w": []}
{"chunk": 6, "s": 4047.8, "e": 4053.8, "t": " आजगु ख्रिदेओ जरत तेही आचा", "w": []}
{"chunk": 6, "s": 4053.8, "e": 4059.12, "t": " रिसि परिहास के साचे हु साचा", "w": []}
{"chunk": 6, "s": 4059.12, "e": 4064.96, "t": " कवत जी रोश रामु अपरादू", "w": []}
{"chunk": 6, "s": 4064.96, "e": 4070.46, "t": " सब पो कहाई राम सुटि सादू", "w": []}
{"chunk": 6, "s": 4070.46, "e": 4076.38, "t": " तो हु सराह सी करस सने हु", "w": []}
{"chunk": 6, "s": 4076.38, "e": 4081.8, "t": " आब सुन्मो ही भयाओ संदे हु", "w": []}
{"chunk": 6, "s": 4081.8, "e": 4087.8, "t": " जास सुबहाव एरिहे एनुपोला", "w": []}
{"chunk": 6, "s": 4087.8, "e": 4093.8, "t": " सो की मिकरे हि माहतु प्रतिकोला", "w": []}
{"chunk": 6, "s": 4095.8, "e": 4100.8, "t": " प्रिया हासर से परिहर है", "w": []}
{"chunk": 6, "s": 4100.8, "e": 4106.8, "t": " मागु भीचार भी बेख", "w": []}
{"chunk": 6, "s": 4106.8, "e": 4110.8, "t": " जे ही देखाओ अब नयन भरि", "w": []}
{"chunk": 6, "s": 4110.8, "e": 4115.46, "t": " भरत राज अभिशेक", "w": []}
{"chunk": 6, "s": 4118.46, "e": 4123.96, "t": " जे मीन बरुभारी भीना", "w": []}
{"chunk": 6, "s": 4123.96, "e": 4129.54, "t": " मन भीन भनिक जीे तुख दीना", "w": []}
{"chunk": 6, "s": 4129.54, "e": 4135.24, "t": " कहाओ सुभाउन चल मन माही", "w": []}
{"chunk": 6, "s": 4135.24, "e": 4140.56, "t": " जीवन मोर राम बिनाई", "w": []}
{"chunk": 6, "s": 4140.56, "e": 4146.36, "t": " समज देख जीया प्रिया प्रभीना", "w": []}
{"chunk": 6, "s": 4146.36, "e": 4152.08, "t": " जीवन राम दरस आभीना", "w": []}
{"chunk": 6, "s": 4152.08, "e": 4157.68, "t": " सुन्म्रित बचन कुमाती अत्जराई", "w": []}
{"chunk": 6, "s": 4157.68, "e": 4163.32, "t": " मन हु आनल आउते ग्रित पराई", "w": []}
{"chunk": 6, "s": 4163.32, "e": 4169.32, "t": " ख़फ़ कर हु किन भोटी उपाया", "w": []}
{"chunk": 6, "s": 4169.32, "e": 4174.32, "t": " इहान लागी हु त्रावूरिमाया", "w": []}
{"chunk": 6, "s": 4174.32, "e": 4180.32, "t": " देव कि लेहु आजसु करिनाही", "w": []}
{"chunk": 6, "s": 4180.32, "e": 4186.32, "t": " मोहिन भवोत प्रपन्चे सुहाही", "w": []}
{"chunk": 6, "s": 4186.32, "e": 4191.32, "t": " राम सादू तुम सादू सयाने", "w": []}
{"chunk": 6, "s": 4191.32, "e": 4196.32, "t": " राम मातु भली सब पवजाने", "w": []}
{"chunk": 6, "s": 4197.32, "e": 4199.32, "t": " जैसिको से लाम", "w": []}
