{"chunk": 0, "s": 30.0, "e": 48.0, "t": " सब्द अश्वरत्राजित, एक चक्र दारी, दुक्ठारी सुख्कारी, मान समलारी", "w": []}
{"chunk": 0, "s": 48.0, "e": 58.0, "t": " जै कश्छपनन्दन, औंजै अदिती नंदन,", "w": []}
{"chunk": 0, "s": 58.0, "e": 67.0, "t": " सुर्मूनि भूसुर्वन्दित, रिमलडविभवशाली,", "w": []}
{"chunk": 0, "s": 67.0, "e": 76.0, "t": " अग्दल दलन दिवाकर दिव्यकी रन्माली,", "w": []}
{"chunk": 0, "s": 76.0, "e": 85.0, "t": " जै कश्यपनं दनं, औं जैय दितीनं दनं", "w": []}
{"chunk": 0, "s": 85.0, "e": 94.0, "t": " सकल सुकर्म प्रसविता, सविता शुबकारी", "w": []}
{"chunk": 0, "s": 94.0, "e": 103.0, "t": " विश्व विलो चनमो चनम, भाव बन्धन भारी", "w": []}
{"chunk": 0, "s": 103.0, "e": 112.0, "t": " जे कश्यपनन्दन, औंजे अदितीनन्दन,", "w": []}
{"chunk": 0, "s": 122.0, "e": 130.0, "t": " कमल समुह विकासक नाशक त्रेतापा,", "w": []}
{"chunk": 0, "s": 130.0, "e": 140.0, "t": " सेवत साहज हर अती मन सीज सन्तापा", "w": []}
{"chunk": 0, "s": 140.0, "e": 149.0, "t": " जै कश्यपनन्दनन, औं जै एदितीनन्दनन", "w": []}
{"chunk": 0, "s": 149.0, "e": 158.0, "t": " नेत्र व्यादि हर सुर्वर भूपीडा हारी", "w": []}
{"chunk": 0, "s": 158.0, "e": 167.0, "t": " व्रिष्ती विमो चन सन्तत परहित व्रत्दारी", "w": []}
{"chunk": 0, "s": 167.0, "e": 176.0, "t": " जैकश्पनन दन औंजै अगिती नंदन", "w": []}
{"chunk": 0, "s": 176.0, "e": 186.0, "t": " शूर्य देब करूना कर, अब करूना की जैं", "w": []}
{"chunk": 0, "s": 186.0, "e": 195.0, "t": " रग आग्यान मोह सब तब आग्यान दीजैं", "w": []}
{"chunk": 0, "s": 195.0, "e": 204.0, "t": " जै कश्य पनन्दन, औं जै आदितीनन, डन अग्यान दीजैं", "w": []}
