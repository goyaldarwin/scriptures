 "मदामदं": {"hi": "आनन्दमय और आनन्दरहित (हर्षयुक्त और हर्षरहित) को", "en": "joyful and joyless (with and without elation)", "r": "मदामद", "g": "द्वितीया एकवचन"},
 "मदन्यो": {"hi": "मेरे सिवा दूसरा", "en": "other than me", "g": "संधि", "p": [["मत्", "मुझसे"], ["अन्यः", "दूसरा"]]},
 "ज्ञातुमर्हति": {"hi": "जान सकता है", "en": "is able to know", "g": "संधि", "p": [["ज्ञातुम्", "जाननेको"], ["अर्हति", "योग्य है, सकता है"]]},
 "अशरीरँ": {"hi": "शरीररहित", "en": "bodiless", "r": "अशरीर", "g": "द्वितीया एकवचन (अशरीरम्, अनुनासिक)"},
