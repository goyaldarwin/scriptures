 "क्षत्रं": {"hi": "क्षत्रिय (वर्ग)", "en": "the warrior class", "r": "क्षत्र", "g": "प्रथमा एकवचन"},
 "भवत": {"hi": "होते हैं", "en": "become", "r": "भू", "g": "लट् प्रथम पुरुष द्विवचन (भवतः, संधिमें विसर्गका लोप)"},
