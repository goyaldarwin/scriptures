 "महान्तं": {"hi": "महान्‌को", "en": "the great", "r": "महत्", "g": "द्वितीया एकवचन"},
 "विभुमात्मानं": {"hi": "व्यापक आत्माको", "en": "the all-pervading Self", "g": "संधि", "p": [["विभुम्", "व्यापक"], ["आत्मानम्", "आत्माको"]]},
