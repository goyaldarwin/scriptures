 "नासमाहितः": {"hi": "असमाहित (चंचल मन) नहीं", "en": "not the unconcentrated", "g": "संधि", "p": [["न", "नहीं"], ["असमाहितः", "असमाहित, एकाग्र न हुआ"]]},
