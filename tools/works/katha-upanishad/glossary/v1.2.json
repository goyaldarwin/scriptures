 "अणोरणीयान्महतो": {"hi": "अणुसे भी सूक्ष्म, महान्‌से", "en": "subtler than the subtle, than the great", "g": "संधि", "p": [["अणोः", "अणुसे, सूक्ष्मसे"], ["अणीयान्", "अधिक सूक्ष्म"], ["महतः", "महान्‌से"]]},
 "महीया": {"hi": "अधिक महान् (महीयान्, अगली पंक्तिमें)", "en": "greater (mahīyān, continued on the next line)", "r": "महीयस्", "g": "प्रथमा एकवचन (पंक्तिके अन्तमें टूटा हुआ पद)"},
 "नात्माऽस्य": {"hi": "(महीया)न् आत्मा इस", "en": "(mahīyā)n; the Self of this", "g": "संधि", "p": [["न्", "(महीयान्‌का अन्त)"], ["आत्मा", "आत्मा"], ["अस्य", "इस"]]},
 "जन्तोर्निहितो": {"hi": "जीवकी (हृदयरूपी गुहामें) स्थित", "en": "of the creature, seated (in the heart)", "g": "संधि", "p": [["जन्तोः", "जीवकी, प्राणीकी"], ["निहितः", "स्थित, रखा हुआ"]]},
 "तमक्रतुः": {"hi": "उसे, कामनारहित (पुरुष)", "en": "him, one free of desire", "g": "संधि", "p": [["तम्", "उसे"], ["अक्रतुः", "संकल्प-कामनासे रहित"]]},
 "वीतशोको": {"hi": "शोकरहित", "en": "free of sorrow", "r": "वीतशोक", "g": "प्रथमा एकवचन (वीतशोकः)"},
 "धातुप्रसादान्महिमानमात्मनः": {"hi": "इन्द्रियों और मनकी निर्मलतासे आत्माकी महिमाको", "en": "through the serenity of the senses and mind, the glory of the Self", "g": "संधि", "p": [["धातुप्रसादात्", "धातुओं (इन्द्रिय, मन) की प्रसन्नता, निर्मलतासे"], ["महिमानम्", "महिमाको"], ["आत्मनः", "आत्माकी"]]},
 "आसीनो": {"hi": "बैठा हुआ", "en": "sitting", "r": "आसीन", "g": "प्रथमा एकवचन (आसीनः)"},
