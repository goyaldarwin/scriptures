 "हन्ता": {"hi": "मारनेवाला", "en": "the killer", "r": "हन्तृ", "g": "प्रथमा एकवचन"},
 "चेन्मन्यते": {"hi": "यदि मानता है", "en": "if he thinks", "g": "संधि", "p": [["चेत्", "यदि"], ["मन्यते", "मानता है"]]},
 "हन्तुँ": {"hi": "मारनेको", "en": "to kill", "r": "हन्", "g": "तुमुन् (हन्तुम्, अनुनासिक)"},
 "हतश्चेन्मन्यते": {"hi": "मारा गया, यदि मानता है", "en": "the killed, if he thinks", "g": "संधि", "p": [["हतः", "मारा गया"], ["चेत्", "यदि"], ["मन्यते", "मानता है"]]},
 "हतम्": {"hi": "मारा हुआ", "en": "killed", "r": "हत", "g": "द्वितीया एकवचन"},
 "उभौ": {"hi": "दोनों", "en": "both", "r": "उभ", "g": "प्रथमा द्विवचन"},
 "विजानीतो": {"hi": "जानते हैं (न विजानीतः = नहीं जानते)", "en": "understand (na vijānītaḥ: do not understand)", "r": "वि+ज्ञा", "g": "लट् प्रथम पुरुष द्विवचन (विजानीतः)"},
 "नायँ": {"hi": "यह नहीं", "en": "this not", "g": "संधि", "p": [["न", "नहीं"], ["अयम्", "यह"]]},
