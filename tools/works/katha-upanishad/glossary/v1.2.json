 "व्रजति": {"hi": "जाता है", "en": "goes, travels", "r": "व्रज्", "g": "लट् प्रथम पुरुष एकवचन"},
 "शयानो": {"hi": "सोया हुआ", "en": "lying down", "r": "शयान", "g": "प्रथमा एकवचन (शयानः)"},
