 "श्रुतेन": {"hi": "सुननेसे, शास्त्रश्रवणसे", "en": "by hearing (of scripture)", "r": "श्रुत", "g": "तृतीया एकवचन"},
 "यमेवैष": {"hi": "जिसे ही यह (आत्मा)", "en": "whom alone this (Self)", "g": "संधि", "p": [["यम्", "जिसे"], ["एव", "ही"], ["एषः", "यह"]]},
 "वृणुते": {"hi": "चुनता है, वरण करता है", "en": "chooses", "r": "वृ", "g": "लट् प्रथम पुरुष एकवचन (आत्मनेपद)"},
 "तस्यैष": {"hi": "उसके लिये यह", "en": "to him this", "g": "संधि", "p": [["तस्य", "उसके लिये"], ["एषः", "यह"]]},
 "विवृणुते": {"hi": "प्रकट कर देता है", "en": "reveals", "r": "वि+वृ", "g": "लट् प्रथम पुरुष एकवचन (आत्मनेपद)"},
 "तनूं": {"hi": "स्वरूपको, शरीरको", "en": "its form, its body", "r": "तनू", "g": "द्वितीया एकवचन"},
