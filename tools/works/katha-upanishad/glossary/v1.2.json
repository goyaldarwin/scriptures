 "नायमात्मा": {"hi": "यह आत्मा नहीं", "en": "this Self is not", "g": "संधि", "p": [["न", "नहीं"], ["अयम्", "यह"], ["आत्मा", "आत्मा"]]},
 "प्रवचनेन": {"hi": "प्रवचनसे (बहुत पढ़ने-पढ़ानेसे)", "en": "by discourse, by much teaching", "r": "प्रवचन", "g": "तृतीया एकवचन"},
 "मेधया": {"hi": "बुद्धिसे", "en": "by intellect", "r": "मेधा", "g": "तृतीया एकवचन"},
