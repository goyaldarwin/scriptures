 "शुद्धे": {"hi": "शुद्ध (जल) में", "en": "into pure (water)", "r": "शुद्ध", "g": "सप्तमी एकवचन"},
 "शुद्धमासिक्तं": {"hi": "शुद्ध (जल) डाला हुआ", "en": "pure (water) poured", "g": "संधि", "p": [["शुद्धम्", "शुद्ध"], ["आसिक्तम्", "डाला हुआ"]]},
 "तादृगेव": {"hi": "वैसा ही", "en": "just the same", "g": "संधि", "p": [["तादृक्", "वैसा"], ["एव", "ही"]]},
 "मुनेर्विजानत": {"hi": "जाननेवाले मुनिका", "en": "of the sage who knows", "g": "संधि", "p": [["मुनेः", "मुनिका"], ["विजानतः", "जाननेवालेका"]]},
 "गौतम": {"hi": "हे गौतम (नचिकेता)!", "en": "O Gautama (Naciketā)!", "r": "गौतम", "g": "सम्बोधन एकवचन"}
