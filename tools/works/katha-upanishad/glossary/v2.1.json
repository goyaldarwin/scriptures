 "विधावति": {"hi": "बिखरकर बह जाता है", "en": "runs down in all directions", "r": "वि+धाव्", "g": "लट् प्रथम पुरुष एकवचन"},
 "धर्मान्": {"hi": "धर्मों (आत्माओं, पदार्थों) को", "en": "the selves, the things (as separate)", "r": "धर्म", "g": "द्वितीया बहुवचन"},
 "पृथक्": {"hi": "अलग-अलग", "en": "as separate", "g": "अव्यय"},
