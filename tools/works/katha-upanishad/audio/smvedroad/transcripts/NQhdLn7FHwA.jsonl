{"chunk": 0, "s": 275.72, "e": 280.68, "t": " प्रभ्रोहि तम्ष्रद्धानायमज्यम", "w": []}
{"chunk": 0, "s": 280.68, "e": 285.32, "t": " स्वर्गलोका आम्रुतत्वम भजन्ते", "w": []}
{"chunk": 0, "s": 285.32, "e": 289.72, "t": " एत द्ध्वितिये नव्रूने वरेन", "w": []}
{"chunk": 0, "s": 289.72, "e": 307.72, "t": " प्रते ब्रवी मी तदू में इबोध, स्वर्ज्यम अग्निम नचिके तव प्रजानन, अनन्त लोका अप्तिम अथो प्रतिष्ठाम, विद्ध्वमे तन्निहि तम गोहायाम,", "w": []}
{"chunk": 0, "s": 307.72, "e": 312.68, "t": " लोका दिम अग्निम तमुवाचतस्मै", "w": []}
{"chunk": 0, "s": 312.68, "e": 317.68, "t": " या इष्ट काया वतीर्वाय थावा", "w": []}
{"chunk": 0, "s": 317.68, "e": 322.32, "t": " सचाचा पितक प्रक्यवददध्यतोब्धम", "w": []}
{"chunk": 0, "s": 322.32, "e": 327.06, "t": " अठास्सम्रच्यव पुनराह तुष्टह", "w": []}
{"chunk": 0, "s": 327.06, "e": 332.44, "t": " तमप्रवीद प्रीयमानो महात्मा", "w": []}
{"chunk": 0, "s": 332.44, "e": 337.28, "t": " वरम तवेहाद जददानी भूयाज", "w": []}
{"chunk": 0, "s": 397.28, "e": 412.28, "t": " सएव भूथ्वा ब्रम्जग्यात्मभूतः, करोति तग्येन पुनर्न जायते, एशते गनिरन चिके तस्वर्ग्यो,", "w": []}
{"chunk": 0, "s": 412.28, "e": 427.28, "t": " यम व्रुनी था द्वितिये नवरेन, ये तम अग्निम तवेव प्रवक्षन्ति जनासव, त्रूतियम वरम नचिके तो व्रुनिश्व,", "w": []}
{"chunk": 0, "s": 427.28, "e": 432.28, "t": " येयम प्रेते विचि किट्सा मनुशे", "w": []}
{"chunk": 0, "s": 432.28, "e": 437.28, "t": " अस्तीत्ये के नायम अस्तीति चैके", "w": []}
{"chunk": 0, "s": 437.28, "e": 442.28, "t": " एत अग्विद्या मनुशिष्त्त्वायाजम", "w": []}
{"chunk": 0, "s": 442.28, "e": 446.28, "t": " वराना मेशवरस्त्रूतिया हा", "w": []}
{"chunk": 0, "s": 446.28, "e": 451.28, "t": " देवैरत्रापि विचि किट्सि तम्पूरा", "w": []}
{"chunk": 0, "s": 451.28, "e": 456.28, "t": " नहीं सुभ्ये मनुरेश ध्हर्महा", "w": []}
{"chunk": 0, "s": 456.28, "e": 460.96, "t": " अन्यम वरम नचिके तोब्रुणिश्व", "w": []}
{"chunk": 0, "s": 460.96, "e": 466.08, "t": " मामो परोथ सीरति मास्रुजेनम", "w": []}
{"chunk": 0, "s": 466.08, "e": 470.62, "t": " दैवर अत्रापि विजिकिच्सि तम्किलग", "w": []}
{"chunk": 0, "s": 470.62, "e": 475.62, "t": " त्वम्चम्रुच्यो यन्न सुक्ये मात्ठ", "w": []}
{"chunk": 0, "s": 475.62, "e": 480.62, "t": " वक्ताचा सित्वाद्रुगण्यो नलभ्यो", "w": []}
{"chunk": 0, "s": 480.62, "e": 485.86, "t": " नान्यो वरस्तुल्य एतस्य कष्चिता", "w": []}
{"chunk": 0, "s": 485.86, "e": 504.86, "t": " शतायु सब उत्र पोट्रान व्रूनिश्व, बहुन पशुन लस्तिहिरन्यमश्वान, भूमेर महदायतनम् व्रूनिश्व, स्वयम्च जीव शर दोया वदिच्छसी,", "w": []}
{"chunk": 0, "s": 504.86, "e": 513.86, "t": " एतत्तुल्यम्यदि मन्यसेवरम् व्रुनिश्ववित्तम्चिर जीवि काम्च्छ", "w": []}
{"chunk": 0, "s": 513.86, "e": 523.86, "t": " महा भूमो नचिके तस्ट्वमेदि कामा नाम्थ्वा काम भाजम करोमि", "w": []}
{"chunk": 0, "s": 523.86, "e": 528.86, "t": " ये-ए कामा दूरल भामर्त्यलोके", "w": []}
{"chunk": 0, "s": 528.86, "e": 534.86, "t": " सर्वान कामान चंद तव्प्रार्त्यस्वा", "w": []}
{"chunk": 0, "s": 534.86, "e": 538.86, "t": " इमा रामा सर्था सतूर्या", "w": []}
{"chunk": 0, "s": 538.86, "e": 544.86, "t": " नहिंद्रुशा बंभनीया मनुष्च्यी", "w": []}
