{"chunk": 0, "s": 30.0, "e": 38.0, "t": " शान्ति मन्त्रहा भारिहि ओों", "w": []}
{"chunk": 0, "s": 38.0, "e": 48.0, "t": " ओों सहनाववतु सहनो भूनक्तु", "w": []}
{"chunk": 0, "s": 48.0, "e": 57.0, "t": " सहवीर्यम कर्वावहें तेजस्श्विनाववधि तमस्तू", "w": []}
{"chunk": 0, "s": 57.0, "e": 69.0, "t": " वो माविद्विशाबहाई वो मशान्दिशान्दिशान्दिशान्दिइ", "w": []}
{"chunk": 0, "s": 69.0, "e": 76.0, "t": " वो शन्जवैवाजश्रवससर्ववेदसम्ददो", "w": []}
