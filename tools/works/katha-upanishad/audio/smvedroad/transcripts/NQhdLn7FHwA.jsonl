{"chunk": 2, "s": 1770.52, "e": 1774.84, "t": " एकंभी जंभाहुदा यह करोती,", "w": []}
{"chunk": 2, "s": 1774.84, "e": 1780.56, "t": " तमात्मस्तम येनु पश्यंति दिरास्ते शाम,", "w": []}
{"chunk": 2, "s": 1780.56, "e": 1784.36, "t": " सुखम शाश्वतम ने तरेशां,", "w": []}
{"chunk": 2, "s": 1784.36, "e": 1789.44, "t": " नित्यो नित्या नाम, चेतनस, चेतना नाम,", "w": []}
{"chunk": 2, "s": 1789.44, "e": 1800.0, "t": " एको बहुनाम यो विदधाति कामान तमात्मस्त्ठम येनु पश्षंति दिरास्ते शाम्शाः", "w": []}
{"chunk": 3, "s": 1800.0, "e": 1806.82, "t": " अन्दिश्याश्वतीने तरेशाम तदे तदिति मन्यंते", "w": []}
{"chunk": 3, "s": 1806.82, "e": 1813.16, "t": " भिर्देश्यम परमम सुखम कतन तद्विजानियाम", "w": []}
{"chunk": 3, "s": 1813.16, "e": 1821.0, "t": " कि मुबाति विबातिवा नतत्र सुर्यो भातिन चंद्रतार कमनेमा", "w": []}
{"chunk": 3, "s": 1821.0, "e": 1825.0, "t": " विद्य।ो भान्ति कुतो यमगनिः", "w": []}
{"chunk": 3, "s": 1825.0, "e": 1832.44, "t": " तमेवबान तमनबाति सर्वम तस्यभासा सर्वम दम्विभाति", "w": []}
{"chunk": 3, "s": 1833.16, "e": 1838.42, "t": " इतिपन्चमि वल्लि अखषष्थि वल्लि", "w": []}
{"chunk": 3, "s": 1839.14, "e": 1842.54, "t": " वूर्द्वमुलो अवाख्षाखा", "w": []}
{"chunk": 3, "s": 1842.96, "e": 1846.04, "t": " एशोश्वत्धस्शना तनहन", "w": []}
{"chunk": 3, "s": 1846.68, "e": 1849.6, "t": " तदेवः शुक्रम तद्ख्ब्रम्म", "w": []}
{"chunk": 3, "s": 1850.0, "e": 1852.42, "t": " तदेवाम्र्दमुच्यते", "w": []}
{"chunk": 3, "s": 1852.42, "e": 1859.42, "t": " तस्मिन लोकाश्रिता सर्वे तदूनात्ये तिकष्चना", "w": []}
{"chunk": 3, "s": 1859.42, "e": 1865.42, "t": " एत दवैतता यदिदम किन्चजगद सर्वम", "w": []}
{"chunk": 3, "s": 1865.42, "e": 1871.42, "t": " रान एजद तिनिस्रतम महद भयम वज्रमुद्यतम्या", "w": []}
{"chunk": 3, "s": 1871.42, "e": 1875.42, "t": " एत दविदुरम्र्तास्ते भवन्ति", "w": []}
{"chunk": 3, "s": 1875.42, "e": 1879.42, "t": " भयादस्याग्मिस्तपति", "w": []}
{"chunk": 3, "s": 1879.42, "e": 1888.54, "t": " भ्यातबति सुर्यहा, भ्यानिन्द्रष्च्वायुष्च्झा, ब्रुत्यर्दावति पन्चमहा.", "w": []}
{"chunk": 3, "s": 1888.54, "e": 1895.14, "t": " इह चेदशकद्ड्वोद्धुम प्राथशरी रस्च्विष्र सहा,", "w": []}
{"chunk": 3, "s": 1895.14, "e": 1901.5, "t": " ततस सर्गेषु लोकेशु, सरी रत्वाय कल्पते.", "w": []}
{"chunk": 3, "s": 1901.5, "e": 1908.5, "t": " यतादर्शेत तदात्मनी, यतास्वपने तदा पिट्रु लोके,", "w": []}
{"chunk": 3, "s": 1908.5, "e": 1913.5, "t": " यताप्सु परीव दद्ध्रुषेत तदागन्दर्वलोके,", "w": []}
{"chunk": 3, "s": 1913.5, "e": 1917.5, "t": " चायात पयोरिववप्रम्मलोके,", "w": []}
{"chunk": 3, "s": 1917.5, "e": 1923.5, "t": " इंद्रियानाम प्रधभावम, उदयास्तम योचयत,", "w": []}
{"chunk": 3, "s": 1923.5, "e": 1927.5, "t": " प्रधवद्पद्यमानाना,", "w": []}
{"chunk": 3, "s": 1927.5, "e": 1933.9, "t": " मत्वादीरो नशोचति इंद्रिये ब्यप्र बनो", "w": []}
{"chunk": 3, "s": 1934.1, "e": 1940.2, "t": " मनसस्सच्ट्व्ष्ट्वम, सच्ट्वादधि महानाद्वा", "w": []}
{"chunk": 3, "s": 1940.4, "e": 1946.8, "t": " महतो व्यक्ट्व्ष्ट्वम, अव्यक्तार्टु परफ्पुरुशो", "w": []}
{"chunk": 3, "s": 1946.8, "e": 1956.8, "t": " याप को लिंग एवच्या यम ग्यात्वा मुच्यते जन्तो रम्रुतट्वाम चगच्यति", "w": []}
{"chunk": 3, "s": 1956.8, "e": 1964.8, "t": " नसन्द्र शे दिष्ठति रूपमस्या नजक्षू शापश्यति कष्चनेनम", "w": []}
{"chunk": 3, "s": 1964.8, "e": 1972.8, "t": " रदा मनीशा मन साविक्रुप्तो या एदद विदु रम्रुतास्ते भवन्ति", "w": []}
{"chunk": 3, "s": 1972.8, "e": 1979.2, "t": " यदा पन्चाव दिष्ठन्ते ग्यानानी मन्सासध,", "w": []}
{"chunk": 3, "s": 1979.2, "e": 1985.32, "t": " बुत्टिष्चन विचेष्टेत, तमाहुफ परमाम गतिम,", "w": []}
{"chunk": 3, "s": 1985.32, "e": 1991.64, "t": " ताम योगमित्म अन्यंते स्थिरामिंद्रि अदारनाम,", "w": []}
{"chunk": 3, "s": 1991.64, "e": 1998.12, "t": " अप्रमत्स्तदा भवति, योगो हिप्रभवाप्यो,", "w": []}
{"chunk": 3, "s": 1998.12, "e": 2004.12, "t": " नेव वाचानमन सा द्राब्तुम शक्यों चक्षुशा", "w": []}
{"chunk": 3, "s": 2004.12, "e": 2010.12, "t": " अस्ती तिब्र्वतों न्यत्र, कतंत तदूपलभ्यते", "w": []}
{"chunk": 3, "s": 2010.12, "e": 2017.12, "t": " अस्ती त्येवो पलब्धम्यास्, तत्व भावेन चोभयोग", "w": []}
{"chunk": 3, "s": 2017.12, "e": 2023.12, "t": " अस्ती त्येवो पलब्धस्या, तत्व भावव्प्रसीधति", "w": []}
{"chunk": 3, "s": 2053.12, "e": 2057.12, "t": " आसामुर दानम विनिस्र तेएका", "w": []}
{"chunk": 3, "s": 2057.12, "e": 2061.12, "t": " तयोर्द्वा मायन्नम्रु तप्वमेती", "w": []}
{"chunk": 3, "s": 2061.12, "e": 2065.12, "t": " विश्वंगन्या उद्क्रमने भबन्ती", "w": []}
{"chunk": 3, "s": 2065.12, "e": 2070.12, "t": " आंगुष्ठ्ः माद्ध्रफ्पुरुशों तराद्मा", "w": []}
{"chunk": 3, "s": 2070.12, "e": 2075.12, "t": " सदाजना नाम्रगये सन्निविष्टहा", "w": []}
{"chunk": 3, "s": 2075.12, "e": 2078.12, "t": " तम स्वाच्चरी राद्प्रव्रुहें", "w": []}
{"chunk": 3, "s": 2108.12, "e": 2114.12, "t": " तो बवाड़ी समाप्ताज कदो पनिषकर", "w": []}
