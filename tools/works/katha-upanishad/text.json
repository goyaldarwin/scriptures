    "कश्चिद्धीरः प्रत्यगात्मानमैक्षद्",
    "आवृत्तचक्षुरमृतत्वमिच्छन् ।।१।।"
   ],
   "t": [
    "parāñci khāni vyatṛṇat svayambhūḥ",
    "tasmātparāṅpaśyati nāntarātman,",
    "kaściddhīraḥ pratyagātmānamaikṣad",
    "āvṛttacakṣuramṛtatvamicchan ॥1॥"
   ]
  },
  {
   "id": "2.1.2",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.2",
   "v": [
    "पराचः कामाननुयन्ति बाला-",
    "स्ते मृत्योर्यन्ति विततस्य पाशम् ।",
    "अथ धीरा अमृतत्वं विदित्वा",
    "ध्रुवमध्रुवेष्विह न प्रार्थयन्ते ।।२।।"
   ],
   "t": [
    "parācaḥ kāmānanuyanti bālā-",
    "ste mṛtyoryanti vitatasya pāśam,",
    "atha dhīrā amṛtatvaṁ viditvā",
    "dhruvamadhruveṣviha na prārthayante ॥2॥"
   ]
  },
  {
   "id": "2.1.3",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.3",
   "v": [
    "येन रूपं रसं गन्धं शब्दान् स्पर्शाꣳश्च मैथुनान् ।",
    "एतेनैव विजानाति किमत्र परिशिष्यते ।",
    "एतद्वै तत् ।।३।।"
   ],
   "t": [
    "yena rūpaṁ rasaṁ gandhaṁ śabdān sparśāgͫśca maithunān,",
    "etenaiva vijānāti kimatra pariśiṣyate,",
    "etadvai tat ॥3॥"
   ]
  },
  {
   "id": "2.1.4",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.4",
   "v": [
    "स्वप्नान्तं जागरितान्तं चोभौ येनानुपश्यति ।",
    "महान्तं विभुमात्मानं मत्वा धीरो न शोचति ।।४।।"
   ],
   "t": [
    "svapnāntaṁ jāgaritāntaṁ cobhau yenānupaśyati,",
    "mahāntaṁ vibhumātmānaṁ matvā dhīro na śocati ॥4॥"
   ]
  },
  {
   "id": "2.1.5",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.5",
   "v": [
    "य इमं मध्वदं वेद आत्मानं जीवमन्तिकात् ।",
    "ईशानं भूतभव्यस्य न ततो विजुगुप्सते ।",
    "एतद्वै तत् ।।५।।"
   ],
   "t": [
    "ya imaṁ madhvadaṁ veda ātmānaṁ jīvamantikāt,",
    "īśānaṁ bhūtabhavyasya na tato vijugupsate,",
    "etadvai tat ॥5॥"
   ]
  },
  {
   "id": "2.1.6",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.6",
   "v": [
    "यः पूर्वं तपसो जातमद्भ्यः पूर्वमजायत ।",
    "गुहां प्रविश्य तिष्ठन्तं यो भूतेभिर्व्यपश्यत ।",
    "एतद्वै तत् ।।६।।"
   ],
   "t": [
    "yaḥ pūrvaṁ tapaso jātamadbhyaḥ pūrvamajāyata,",
    "guhāṁ praviśya tiṣṭhantaṁ yo bhūtebhirvyapaśyata,",
    "etadvai tat ॥6॥"
   ]
  },
  {
   "id": "2.1.7",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.7",
   "v": [
    "या प्राणेन संभवत्यदितिर्देवतामयी ।",
    "गुहां प्रविश्य तिष्ठन्तीं या भूतेभिर्व्यजायत ।",
    "एतद्वै तत् ।।७।।"
   ],
   "t": [
    "yā prāṇena saṁbhavatyaditirdevatāmayī,",
    "guhāṁ praviśya tiṣṭhantīṁ yā bhūtebhirvyajāyata,",
    "etadvai tat ॥7॥"
   ]
  },
  {
   "id": "2.1.8",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.8",
   "v": [
    "अरण्योर्निहितो जातवेदा गर्भ इव सुभृतो गर्भिणीभिः ।",
    "दिवे दिवे ईड्यो जागृवद्भिर्हविष्मद्भिर्मनुष्येभिरग्निः ।",
    "एतद्वै तत् ।।८।।"
   ],
   "t": [
    "araṇyornihito jātavedā garbha iva subhṛto garbhiṇībhiḥ,",
    "dive dive īḍyo jāgṛvadbhirhaviṣmadbhirmanuṣyebhiragniḥ,",
    "etadvai tat ॥8॥"
   ]
  },
  {
   "id": "2.1.9",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.9",
   "v": [
    "यतश्चोदेति सूर्योऽस्तं यत्र च गच्छति ।",
    "तं देवाः सर्वेऽर्पितास्तदु नात्येति कश्चन ।",
    "एतद्वै तत् ।।९।।"
   ],
   "t": [
    "yataścodeti sūryo’staṁ yatra ca gacchati,",
    "taṁ devāḥ sarve’rpitāstadu nātyeti kaścana,",
    "etadvai tat ॥9॥"
   ]
  },
  {
   "id": "2.1.10",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.10",
   "v": [
    "यदेवेह तदमुत्र यदमुत्र तदन्विह ।",
    "मृत्योः स मृत्युमाप्नोति य इह नानेव पश्यति ।।१०।।"
   ],
   "t": [
    "yadeveha tadamutra yadamutra tadanviha,",
    "mṛtyoḥ sa mṛtyumāpnoti ya iha nāneva paśyati ॥10॥"
   ]
  },
  {
   "id": "2.1.11",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.11",
   "v": [
    "मनसैवेदमाप्तव्यं नेह नानाऽस्ति किंचन ।",
    "मृत्योः स मृत्युं गच्छति य इह नानेव पश्यति ।।११।।"
   ],
   "t": [
    "manasaivedamāptavyaṁ neha nānā’sti kiṁcana,",
    "mṛtyoḥ sa mṛtyuṁ gacchati ya iha nāneva paśyati ॥11॥"
   ]
  },
  {
   "id": "2.1.12",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.12",
   "v": [
    "अङ्गुष्ठमात्रः पुरुषो मध्य आत्मनि तिष्ठति ।",
    "ईशानं भूतभव्यस्य न ततो विजुगुप्सते ।",
    "एतद्वै तत् ।।१२।।"
   ],
   "t": [
    "aṅguṣṭhamātraḥ puruṣo madhya ātmani tiṣṭhati,",
    "īśānaṁ bhūtabhavyasya na tato vijugupsate,",
    "etadvai tat ॥12॥"
   ]
  },
  {
   "id": "2.1.13",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.13",
   "v": [
    "अङ्गुष्ठमात्रः पुरुषो ज्योतिरिवाधूमकः ।",
    "ईशानो भूतभव्यस्य स एवाद्य स उ श्वः ।",
    "एतद्वै तत् ।।१३।।"
   ],
   "t": [
    "aṅguṣṭhamātraḥ puruṣo jyotirivādhūmakaḥ,",
    "īśāno bhūtabhavyasya sa evādya sa u śvaḥ,",
    "etadvai tat ॥13॥"
   ]
  },
  {
   "id": "2.1.14",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.14",
   "v": [
    "यथोदकं दुर्गे वृष्टं पर्वतेषु विधावति ।",
    "एवं धर्मान् पृथक् पश्यंस्तानेवानुविधावति ।।१४।।"
   ],
   "t": [
    "yathodakaṁ durge vṛṣṭaṁ parvateṣu vidhāvati,",
    "evaṁ dharmān pṛthak paśyaṁstānevānuvidhāvati ॥14॥"
   ]
  },
  {
   "id": "2.1.15",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.15",
   "v": [
    "यथोदकं शुद्धे शुद्धमासिक्तं तादृगेव भवति ।",
    "एवं मुनेर्विजानत आत्मा भवति गौतम ।।१५।।"
   ],
   "t": [
    "yathodakaṁ śuddhe śuddhamāsiktaṁ tādṛgeva bhavati,",
    "evaṁ munervijānata ātmā bhavati gautama ॥15॥"
   ]
  },
  {
   "id": "2.2.1",
   "p": 1,
   "s": "v2.2",
   "y": "mantra",
   "n": "2.2.1",
   "v": [
    "पुरमेकादशद्वारमजस्यावक्रचेतसः ।",
    "अनुष्ठाय न शोचति विमुक्तश्च विमुच्यते ।",
    "एतद्वै तत् ।।१।।"
   ],
   "t": [
    "puramekādaśadvāramajasyāvakracetasaḥ,",
    "anuṣṭhāya na śocati vimuktaśca vimucyate,",
    "etadvai tat ॥1॥"
   ]
  },
  {
   "id": "2.2.2",
   "p": 1,
   "s": "v2.2",
   "y": "mantra",
   "n": "2.2.2",
   "v": [
    "हँसः शुचिषद्वसुरन्तरिक्षसद्-",
    "होता वेदिषदतिथिर्दुरोणसत् ।",
    "नृषद्वरसदृतसद्व्योमसद्",
    "अब्जा गोजा ऋतजा अद्रिजा ऋतं बृहत् ।।२।।"
   ],
   "t": [
    "ha̐saḥ śuciṣadvasurantarikṣasad-",
    "hotā vediṣadatithirduroṇasat,",
    "nṛṣadvarasadṛtasadvyomasad",
    "abjā gojā ṛtajā adrijā ṛtaṁ bṛhat ॥2॥"
   ]
  },
  {
   "id": "2.2.3",
   "p": 1,
   "s": "v2.2",
   "y": "mantra",
   "n": "2.2.3",
   "v": [
    "ऊर्ध्वं प्राणमुन्नयत्यपानं प्रत्यगस्यति ।",
    "मध्ये वामनमासीनं विश्वे देवा उपासते ।।३।।"
   ],
   "t": [
    "ūrdhvaṁ prāṇamunnayatyapānaṁ pratyagasyati,",
    "madhye vāmanamāsīnaṁ viśve devā upāsate ॥3॥"
   ]
  },
  {
   "id": "2.2.4",
   "p": 1,
   "s": "v2.2",
   "y": "mantra",
   "n": "2.2.4",
   "v": [
    "अस्य विस्रंसमानस्य शरीरस्थस्य देहिनः ।",
    "देहाद्विमुच्यमानस्य किमत्र परिशिष्यते ।",
    "एतद्वै तत् ।।४।।"
   ],
   "t": [
    "asya visraṁsamānasya śarīrasthasya dehinaḥ,",
    "dehādvimucyamānasya kimatra pariśiṣyate,",
    "etadvai tat ॥4॥"
   ]
  },
  {
   "id": "2.2.5",
   "p": 1,
   "s": "v2.2",
   "y": "mantra",
   "n": "2.2.5",
   "v": [
    "न प्राणेन नापानेन मर्त्यो जीवति कश्चन ।",
    "इतरेण तु जीवन्ति यस्मिन्नेतावुपाश्रितौ ।।५।।"
   ],
   "t": [
    "na prāṇena nāpānena martyo jīvati kaścana,",
    "itareṇa tu jīvanti yasminnetāvupāśritau ॥5॥"
   ]
  },
  {
   "id": "2.2.6",
   "p": 1,
   "s": "v2.2",
   "y": "mantra",
   "n": "2.2.6",
   "v": [
