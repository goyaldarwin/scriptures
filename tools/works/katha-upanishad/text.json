   "t": [
    "ya imaṁ paramaṁ guhyaṁ śrāvayed brahmasaṁsadi,",
    "prayataḥ śrāddhakāle vā",
    "tadānantyāya kalpate, tadānantyāya kalpata iti ॥17॥"
   ]
  },
  {
   "id": "2.1.1",
   "p": 1,
   "s": "v2.1",
   "y": "mantra",
   "n": "2.1.1",
   "v": [
    "पराञ्चि खानि व्यतृणत् स्वयम्भूः",
