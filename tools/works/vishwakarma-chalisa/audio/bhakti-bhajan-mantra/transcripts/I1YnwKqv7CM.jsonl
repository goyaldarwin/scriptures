{"chunk": 0, "s": 61.2, "e": 63.6, "t": " जग महाजे परमारत वादी", "w": []}
{"chunk": 0, "s": 63.6, "e": 65.92, "t": " अर्मदुरंगर शुबसन कादी", "w": []}
