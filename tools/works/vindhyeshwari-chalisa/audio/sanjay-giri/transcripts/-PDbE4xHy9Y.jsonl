{"chunk": 0, "s": 0.0, "e": 7.48, "t": " नमो-नमो विंदेश्वरी", "w": []}
{"chunk": 0, "s": 7.48, "e": 12.32, "t": " नमो-नमो जग्दंब", "w": []}
{"chunk": 0, "s": 12.32, "e": 17.52, "t": " संत जनो के काज में", "w": []}
{"chunk": 0, "s": 17.52, "e": 23.0, "t": " करती नहीं भिलंब", "w": []}
{"chunk": 0, "s": 23.0, "e": 28.72, "t": " शुरू करू विंदेश्वरी", "w": []}
{"chunk": 0, "s": 28.72, "e": 34.04, "t": " चाली सामने लाई", "w": []}
{"chunk": 0, "s": 34.68, "e": 40.08, "t": " दया करो मा भगवती", "w": []}
{"chunk": 0, "s": 40.6, "e": 45.64, "t": " काम सभी हो जा", "w": []}
{"chunk": 0, "s": 51.48, "e": 56.8, "t": " जे-जे-विंद्या चल रानी", "w": []}
{"chunk": 0, "s": 56.8, "e": 61.92, "t": " आद्शत जग विदेते भ्वानी", "w": []}
{"chunk": 0, "s": 61.92, "e": 67.4, "t": " सीहवाहीनी जे जग माता", "w": []}
{"chunk": 0, "s": 67.4, "e": 73.0, "t": " जे जे जे त्रभूवन सुख्दाता", "w": []}
{"chunk": 0, "s": 78.0, "e": 83.32, "t": " कष्त निवारीनी जे जग देवी", "w": []}
{"chunk": 0, "s": 83.32, "e": 88.54, "t": " जे जे ये आसुरा आसुर सेवी", "w": []}
{"chunk": 0, "s": 88.54, "e": 93.92, "t": " महिमा आमित आपार तुमारी", "w": []}
{"chunk": 0, "s": 93.92, "e": 99.32, "t": " शेस सहस मुक्वरनत भारी", "w": []}
{"chunk": 0, "s": 99.32, "e": 104.32, "t": " भीनन के दुख हरत भावानी", "w": []}
{"chunk": 0, "s": 104.32, "e": 109.62, "t": " नहीं देख्यो तुम सम्कु उदानी", "w": []}
{"chunk": 0, "s": 109.62, "e": 114.94, "t": " सब कर मनसा पुर्वत माता", "w": []}
{"chunk": 0, "s": 114.94, "e": 120.62, "t": " मही मामेद जगत वे क्याता", "w": []}
{"chunk": 0, "s": 125.62, "e": 130.74, "t": " जो जन दान तुमारो लाओे", "w": []}
{"chunk": 0, "s": 130.74, "e": 136.14, "t": " सो तुर तही वान छित पल पाओे", "w": []}
{"chunk": 0, "s": 136.14, "e": 141.46, "t": " तुम ही वेश्नवी, तुम ही रुद्रानी,", "w": []}
{"chunk": 0, "s": 141.46, "e": 146.66, "t": " तुम ही शार्दा, अर्व्हम्मानी,", "w": []}
{"chunk": 0, "s": 146.66, "e": 151.86, "t": " रमा रादे का शामा काली,", "w": []}
{"chunk": 0, "s": 151.86, "e": 157.18, "t": " तुम ही मात संटन प्रते पाली,", "w": []}
{"chunk": 0, "s": 157.18, "e": 162.46, "t": " उमा माद्वी चंदी जाला,", "w": []}
{"chunk": 0, "s": 162.46, "e": 168.46, "t": " बेग मोहे पर हो हु दैयाला", "w": []}
{"chunk": 0, "s": 173.46, "e": 178.46, "t": " तुम ही हिंगलाज महारानी", "w": []}
{"chunk": 0, "s": 178.46, "e": 183.46, "t": " तुम ही शीतला अरोगे जानी", "w": []}
{"chunk": 0, "s": 183.46, "e": 188.46, "t": " दूर्गा दूर्ग विनाशनी माता", "w": []}
{"chunk": 0, "s": 188.46, "e": 193.46, "t": " तुमहिलच्मि जग सुख्दाका", "w": []}
{"chunk": 0, "s": 193.46, "e": 198.46, "t": " तुही जाहन्वि औरोट्रानी", "w": []}
{"chunk": 0, "s": 198.46, "e": 204.46, "t": " हे मावती आंभे निर्वानी", "w": []}
{"chunk": 0, "s": 204.46, "e": 209.46, "t": " आश्त भूजी वाराहिन देवी", "w": []}
{"chunk": 0, "s": 209.46, "e": 215.46, "t": " करत रेशनो शिव जा कर सेवी", "w": []}
{"chunk": 0, "s": 218.46, "e": 231.46, "t": " जो सत्ती देवी कल्यानी गोर मंगला सब गुडखानी", "w": []}
{"chunk": 0, "s": 231.46, "e": 241.46, "t": " पातन मुम्बा दंट कुमारी भद्र काले सुन्विने हमारी", "w": []}
{"chunk": 0, "s": 241.46, "e": 246.46, "t": " वज्द्हारनी शोक नाशनी", "w": []}
{"chunk": 0, "s": 246.46, "e": 251.46, "t": " आयु रक्षनी विंगे वासनी", "w": []}
{"chunk": 0, "s": 251.46, "e": 256.46, "t": " जया और विज्या भे ताली", "w": []}
{"chunk": 0, "s": 256.46, "e": 262.46, "t": " मातु सुगंदा अर विख्राली", "w": []}
{"chunk": 0, "s": 262.46, "e": 278.46, "t": " नाम अनन्त तुमार भावानी बरने किम मानुश अग्यानी", "w": []}
{"chunk": 0, "s": 278.46, "e": 283.62, "t": " जापर क्रिपा मातो तव होई", "w": []}
{"chunk": 0, "s": 283.62, "e": 289.06, "t": " तोव करे चहे मनजोई", "w": []}
{"chunk": 0, "s": 289.06, "e": 294.18, "t": " क्रिपा करहो मोपर महारानी", "w": []}
{"chunk": 0, "s": 294.18, "e": 299.5, "t": " सिथ करिये आंडे मम्बानी", "w": []}
{"chunk": 0, "s": 299.5, "e": 304.78, "t": " जो नरद हरे मात कर द्याना", "w": []}
{"chunk": 0, "s": 304.78, "e": 310.78, "t": " ताकर सदा हो एक ल्याना", "w": []}
{"chunk": 0, "s": 315.78, "e": 320.78, "t": " विपता ही सप्ने हु नहीं आवे", "w": []}
{"chunk": 0, "s": 320.78, "e": 325.78, "t": " जो देवी कर जाप तरावे", "w": []}
{"chunk": 0, "s": 325.78, "e": 330.78, "t": " जो नर कह स्रन हो एक आपारा", "w": []}
{"chunk": 0, "s": 330.78, "e": 335.78, "t": " तो नर पाथ करे शत्बारा", "w": []}
{"chunk": 0, "s": 335.78, "e": 341.78, "t": " निश्चे श्ण मोचने होई जाई", "w": []}
{"chunk": 0, "s": 341.78, "e": 346.78, "t": " जो नर पाथ करे मने लाई", "w": []}
{"chunk": 0, "s": 346.78, "e": 351.78, "t": " आश्तृते जो नर पडे पड़ावे", "w": []}
{"chunk": 0, "s": 351.78, "e": 357.78, "t": " या जग में सुवति सुख पावे", "w": []}
{"chunk": 0, "s": 360.78, "e": 373.78, "t": " जाखो व्याध्य सतावे भाई जाख करत सब दूर पराई", "w": []}
{"chunk": 0, "s": 373.78, "e": 383.78, "t": " जो नर अते बन्दी महोई बार हजार पात्त कर सोई", "w": []}
{"chunk": 0, "s": 383.78, "e": 388.78, "t": " निशचे बंदीते चुते जाए", "w": []}
{"chunk": 0, "s": 388.78, "e": 393.78, "t": " सत्यवचन मम मान हुभाई", "w": []}
{"chunk": 0, "s": 393.78, "e": 399.78, "t": " जापर जो कुछ संकत होई", "w": []}
{"chunk": 0, "s": 399.78, "e": 405.78, "t": " निशचे देवही सु मेरे सोई", "w": []}
{"chunk": 0, "s": 405.78, "e": 425.78, "t": " जो नर पूट्र हो एनही भाई, सो नर या विध करे उपाई, पाच वर्स शो पाथ करावे,", "w": []}
{"chunk": 0, "s": 425.78, "e": 430.78, "t": " नोरातन मेवी प्रजिमावे", "w": []}
{"chunk": 0, "s": 430.78, "e": 435.78, "t": " निष्चे हो ही पसन्द भावानी", "w": []}
{"chunk": 0, "s": 435.78, "e": 440.78, "t": " पुत्र देहिता को गुडखानी", "w": []}
{"chunk": 0, "s": 440.78, "e": 446.78, "t": " वजानारी यल आनी चडावे", "w": []}
{"chunk": 0, "s": 446.78, "e": 452.78, "t": " विध समेट पुजन कर वावे", "w": []}
{"chunk": 0, "s": 455.78, "e": 467.78, "t": " नित प्रत्पात करे मनलाई, पेम सहित नहीं आन उपाई,", "w": []}
{"chunk": 0, "s": 467.78, "e": 477.78, "t": " यह स्वी भिंद्या चल चाली सा, रंक पडद हो वेव नीसा,", "w": []}
{"chunk": 0, "s": 477.78, "e": 486.62, "t": " जेही जन अच्र ज्ँ मान हु भाई", "w": []}
{"chunk": 0, "s": 486.62, "e": 488.58, "t": " क्रिपाद रिष्टा पर हु यजाए", "w": []}
{"chunk": 0, "s": 488.58, "e": 495.98, "t": " जे जे जे जग मात भावानी", "w": []}
{"chunk": 0, "s": 495.98, "e": 500.38, "t": " क्रिपाझर हु मुहे पर जन जानी", "w": []}
{"chunk": 0, "s": 500.38, "e": 506.62, "t": " मैया इतना दी जी ए", "w": []}
{"chunk": 0, "s": 506.62, "e": 521.62, "t": " जामे कुत्म समाई में भी भीबूका नार हुं साधूनम हुखा जा", "w": []}
