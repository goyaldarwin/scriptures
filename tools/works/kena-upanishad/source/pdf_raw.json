{
 "1.1": {
  "t": [
   "om̐ keneṣitaṃ patati preṣitaṃ manaḥ",
   "kena prāṇaḥ prathamaḥ praiti yuktaḥ |",
   "keneṣitāṃ vācamimāṃ vadanti",
   "cakṣuḥ śrotraṃ ka u devo yunakti"
  ]
 },
 "1.2": {
  "t": [
   "śrotrasya śrotraṃ manaso mano yad",
   "vāco ha vācaṃ sa u prāṇasya prāṇaḥ |",
   "cakṣuṣaścakṣuratimucya dhīrāḥ",
   "pretyāsmāllokādamṛtā bhavanti"
  ]
 },
 "1.3": {
  "t": [
   "na tatra cakṣurgacchati na vāggacchati no manaḥ |",
   "na vidmo na vijānīmo yathaitadanuśiṣyāt",
   "anyadeva tadviditādatho aviditādadhi |",
   "iti śuśruma pūrveṣāṃ ye nastadvyācacakṣire"
  ]
 },
 "1.4": {
  "t": [
   "yadvācā'nabhyuditaṃ yena vāgabhyudyate |",
   "tadeva brahma tvaṃ viddhi nedaṃ yadidamupāsate"
  ]
 },
 "1.5": {
  "t": [
   "yanmanasā na manute yenāhurmano matam |",
   "tadeva brahma tvaṃ viddhi nedaṃ yadidamupāsate"
  ]
 },
 "1.6": {
  "t": [
   "yaccakṣuṣā na paśyati yena cakṣūm̐ṣi paśyati |",
   "tadeva brahma tvaṃ viddhi nedaṃ yadidamupāsate"
  ]
 },
 "1.7": {
  "t": [
   "yacchrotreṇa na śṛṇoti yena śrotramidaṃ śrutam |",
   "tadeva brahma tvaṃ viddhi nedaṃ yadidamupāsate"
  ]
 },
 "1.8": {
  "t": [
   "yatprāṇena na prāṇiti yena prāṇaḥ praṇīyate |",
   "tadeva brahma tvaṃ viddhi nedaṃ yadidamupāsate"
  ]
 },
 "2.1": {
  "t": [
   "yadi manyase suvedeti daharamevāpi",
   "nūnaṃ tvaṃ vettha brahmaṇo rūpam |",
   "yadasya tvaṃ yadasya deveṣvatha nu",
   "mīmām̐syemeva te manye viditam"
  ]
 },
 "2.2": {
  "t": [
   "nāhaṃ manye suvedeti no na vedeti veda ca |",
   "yo nastadveda tadveda no na vedeti veda ca"
  ]
 },
 "2.3": {
  "t": [
   "yasyāmataṃ tasya mataṃ mataṃ yasya na veda saḥ |",
   "avijñātaṃ vijānatāṃ vijñātamavijānatām"
  ]
 },
 "2.4": {
  "t": [
   "pratibodhaviditaṃ matamamṛtatvaṃ hi vindate |",
   "ātmanā vindate vīryaṃ vidyayā vindate'mṛtam"
  ]
 },
 "2.5": {
  "t": [
   "iha cedavedīdatha satyamasti",
   "na cedihāvedīnmahatī vinaṣṭiḥ |",
   "bhūteṣu bhūteṣu vicitya dhīrāḥ",
   "pretyāsmāllokādamṛtā bhavanti"
  ]
 },
 "3.1": {
  "t": [
   "brahma ha devebhyo vijigye tasya ha brahmaṇo vijaye",
   "devā amahīyanta, ta aikṣanta",
   "asmākamevāyaṃ vijayo'smākamevāyaṃ mahimeti |"
  ]
 },
 "3.2": {
  "t": [
   "taddhaiṣāṃ vijajñau tebhyo ha prādurbabhūva",
   "tanna vyajānata kimidaṃ yakṣamiti"
  ]
 },
 "3.3": {
  "t": [
   "te'gnimabruvañjātaveda",
   "etadvijānīhi kimidaṃ yakṣamiti tatheti"
  ]
 },
 "3.4": {
  "t": [
   "tadabhyadravattamabhyavadatko'sīti",
   "agnirvā ahamasmītyabravījjātavedā vā ahamasmīti"
  ]
 },
 "3.5": {
  "t": [
   "tasminstvayi kiṃ vīryamiti-",
   "apīdaṃ sarvaṃ daheyaṃ yadidaṃ pṛthivyāmiti"
  ]
 },
 "3.6": {
  "t": [
   "tasmai tṛṇaṃ nidadhāvetaddaheti |",
   "tadupapreyāya sarvajavena tanna śaśāka dagdhuṃ |",
   "sa tata eva nivavṛte",
   "naitadaśakaṃ vijñātuṃ yadetadyakṣamiti"
  ]
 },
 "3.7": {
  "t": [
   "atha vāyumabruvanvāyav-",
   "etadvijānīhi kimetadyakṣamiti tatheti"
  ]
 },
 "3.8": {
  "t": [
   "tadabhyadravattamabhyavadatko'sīti",
   "vāyurvā ahamasmītyabravīnmātariśvā vā ahamasmīti"
  ]
 },
 "3.9": {
  "t": [
   "tasmim̐stvayi kiṃ vīryamiti-",
   "apīdam̐ sarvamādadīya yadidaṃ pṛthivyāmiti"
  ]
 },
 "3.10": {
  "t": [
   "tasmai tṛṇaṃ nidadhāvetadādatsveti",
   "tadupapreyāya sarvajavena tanna śaśākādatuṃ",
   "sa tata eva nivavṛte",
   "naitadaśakaṃ vijñātuṃ yadetadyakṣamiti"
  ]
 },
 "3.11": {
  "t": [
   "athendramabruvan-",
   "maghavannetadvijānīhi kimetadyakṣamiti tatheti"
  ]
 },
 "3.12": {
  "t": [
   "tadabhyadravattasmāttirodadhe",
   "sa tasminnevākāśe striyamājagāma bahuśobhamānāmumām̐",
   "haimavatīṃ |  tām̐hovāca kimetadyakṣamiti"
  ]
 },
 "4.1": {
  "t": [
   "sā brahmeti hovāca ,   brahmaṇo vā etadvijaye mahīyadhvamiti",
   "tato haiva vidāñcakāra brahmeti"
  ]
 },
 "4.2": {
  "t": [
   "tasmādvā ete devā",
   "atitarāmivānyāndevān",
   "yadagnirvāyurindraste",
   "hyenannediṣṭhaṃ pasparśuh",
   "te hyenatprathamo vidāñ",
   "cakāra brahmeti"
  ]
 },
 "4.3": {
  "t": [
   "tasmādvā indro-",
   "'titarāmivānyāndevān",
   "sa hyenannediṣṭhaṃ pasparśa",
   "sa hyenatprathamo vidāñ",
   "cakāra brahmeti"
  ]
 },
 "4.4": {
  "t": [
   "tasyaiṣa ādeśo |  yadetadvidyuto vyadyutadā 3* |",
   "itīn nyamīmiṣadā 3 |  ityadhidaivatam"
  ]
 },
 "4.5": {
  "t": [
   "athādhyātmaṃ yaddetadgacchatīva ca mano-",
   "'nena caitadupasmaratyabhīkṣṇam̐ saṅkalpaḥ"
  ]
 },
 "4.6": {
  "t": [
   "taddha tadvanaṃ nāma tadvanamityupāsitavyaṃ",
   "sa ya etadevaṃ vedābhi hainaṃ,",
   "sarvāṇi bhūtāni saṃvāñchanti"
  ]
 },
 "4.7": {
  "t": [
   "upaniṣadaṃ bho brūhītyuktā",
   "ta upaniṣadbrāhmīṃ vāva ta upaniṣadamabrūmeti"
  ]
 },
 "4.8": {
  "t": [
   "tasai tapo damaḥ karmeti pratiṣṭhā vedāḥ sarvāṅgāni",
   "satyamāyatanam"
  ]
 },
 "4.9": {
  "t": [
   "yo vā etāmevaṃ vedāpahatya pāpmānam",
   "anante svarge loke jyeye pratitiṣṭhati pratitiṣṭhateeti"
  ]
 },
 "shanti": {
  "t": [
   "om̐ āpyāyantu mamāṅgāni",
   "vākprāṇaścakṣuḥ śrotram",
   "atho balamindriyāṇi ca sarvāṇi |",
   "sarvaṃ brahmaupaniṣadaṃ",
   "mā'haṃ brahma nirākuryāṃ",
   "mā mā brahma nirākarod |",
   "anirākaraṇamastvanirākaraṇaṃ me'stu |",
   "tadātmani nirate |",
   "ya upaniṣatsu dharmāh",
   "te mayi santu te mayi santu |",
   "om̐ śāntiḥ śāntiḥ śāntiḥ ||"
  ]
 },
 "iti": {
  "1": [
   "iti kenopaniṣadi prathamaḥ khaṇḍaḥ"
  ],
  "2": [
   "iti kenopaniṣadi dvitīyaḥ khaṇḍaḥ"
  ],
  "3": [
   "iti kenopaniṣadi tṛtīyaḥ khaṇḍaḥ"
  ],
  "4": [
   "iti kenopaniṣadi caturthaḥ khaṇḍaḥ",
   "iti kenopaniṣat"
  ]
 }
}