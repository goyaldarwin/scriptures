{
 "10.33.17": {"lines": ["एवं परिष्वङ्गकराभिमर्श-", "स्निग्धेक्षणोद्दामविलासहासैः ।", "रेमे रमेशो व्रजसुन्दरीभि-", "र्यथार्भकः स्वप्रतिबिम्बविभ्रमः ॥१७॥"], "witness": "vedabase.io ŚB 10.33.16 (BBT numbering is one lower here)"},
 "10.33.18": {"lines": ["तदङ्गसङ्गप्रमुदाकुलेन्द्रियाः", "केशान् दुकूलं कुचपट्टिकां वा ।", "नाञ्जः प्रतिव्योढुमलं व्रजस्त्रियो", "विस्रस्तमालाभरणाः कुरूद्वह ॥१८॥"], "witness": "vedabase.io ŚB 10.33.17"},
 "10.33.19": {"lines": ["कृष्णविक्रीडितं वीक्ष्य मुमुहुः खेचरस्त्रियः ।", "कामार्दिताः शशाङ्कश्च सगणो विस्मितोऽभवत् ॥१९॥"], "witness": "vedabase.io ŚB 10.33.18; vedapath.app 10.33.18"},
 "10.33.20": {"lines": ["कृत्वा तावन्तमात्मानं यावतीर्गोपयोषितः ।", "रेमे स भगवांस्ताभिरात्मारामोऽपि लीलया ॥२०॥"], "witness": "wisdomlib.org Bhagavata Purana [sanskrit] 10.33.20 (its words printed apart, joined here by sandhi as the book prints them)"},
 "10.33.21": {"lines": ["तासामतिविहारेण श्रान्तानां वदनानि सः ।", "प्रामृजत्करुणः प्रेम्णा शन्तमेनाङ्ग पाणिना ॥२१॥"], "witness": "wisdomlib.org 10.33.21 (words joined by sandhi)"},
 "10.33.22": {"lines": ["गोप्यः स्फुरत्पुरटकुण्डलकुन्तलत्विड्-", "गण्डश्रिया सुधितहासनिरीक्षणेन ।", "मानं दधत्य ऋषभस्य जगुः कृतानि", "पुण्यानि तत्कररुहस्पर्शप्रमोदाः ॥२२॥"], "witness": "wisdomlib.org 10.33.22"}
}
